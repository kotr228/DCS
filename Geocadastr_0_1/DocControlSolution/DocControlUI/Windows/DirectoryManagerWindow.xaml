<Controls:MetroWindow x:Class="DocControlUI.Windows.DirectoryManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
        Title="📁 Менеджер Директорій"
        Height="750" Width="1200"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/424.ico"
        Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок та пошук -->
        <Border Grid.Row="0" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="📁 Менеджер Директорій"
                               FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Пошук, редагування та перегляд інформації про директорії"
                               FontSize="12" Opacity="0.8" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Панель пошуку -->
                <Grid Grid.Row="1" Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SearchTextBox"
                             Grid.Column="0"
                             Padding="10"
                             FontSize="14"
                             Controls:TextBoxHelper.Watermark="🔍 Пошук по назві або шляху..."
                             Controls:TextBoxHelper.ClearTextButton="True"
                             KeyUp="SearchTextBox_KeyUp"/>

                    <Button Grid.Column="1" Content="🔍 Пошук"
                            Click="Search_Click"
                            Background="#2196F3" Foreground="White"
                            Padding="15,8" Margin="10,0,0,0"/>

                    <Button Grid.Column="2" Content="🔄 Оновити"
                            Click="Refresh_Click"
                            Padding="15,8" Margin="10,0,0,0"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Основний контент -->
        <Grid Grid.Row="1" Margin="15,0,15,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Список директорій -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Знайдено директорій: 0"
                           x:Name="ResultsCountText"
                           FontWeight="Bold" Margin="0,0,0,10"/>

                <DataGrid Grid.Row="1"
                          x:Name="DirectoriesGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionChanged="DirectoriesGrid_SelectionChanged"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                        <DataGridTextColumn Header="Назва" Binding="{Binding Name}" Width="200"/>
                        <DataGridTextColumn Header="Шлях" Binding="{Binding Browse}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="10"
                          HorizontalAlignment="Stretch"
                          Background="Transparent"/>

            <!-- Панель деталей -->
            <Border Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="1" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Деталі директорії -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="📋 Деталі директорії"
                                   FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                        <TextBlock Text="ID:" FontWeight="Bold" Margin="0,5,0,0"/>
                        <TextBlock x:Name="DetailIdText" Text="-" Margin="0,2,0,0"/>

                        <TextBlock Text="Назва:" FontWeight="Bold" Margin="0,10,0,0"/>
                        <TextBox x:Name="DetailNameTextBox" Margin="0,2,0,0" Padding="5"/>

                        <TextBlock Text="Шлях:" FontWeight="Bold" Margin="0,10,0,0"/>
                        <TextBox x:Name="DetailPathTextBox" Margin="0,2,0,0" Padding="5"/>
                    </StackPanel>

                    <Separator Grid.Row="1" Margin="0,15"/>

                    <!-- Статистика -->
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="📊 Статистика"
                                   FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Об'єкти:" Margin="0,5,0,0"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="StatsObjectsText" Text="-" FontWeight="Bold" Margin="10,5,0,0"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Папки:" Margin="0,5,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="StatsFoldersText" Text="-" FontWeight="Bold" Margin="10,5,0,0"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Файли:" Margin="0,5,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="StatsFilesText" Text="-" FontWeight="Bold" Margin="10,5,0,0"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Дозволені пристрої:" Margin="0,5,0,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="StatsDevicesText" Text="-" FontWeight="Bold" Margin="10,5,0,0"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Статус:" Margin="0,5,0,0"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="StatsSharedText" Text="-" FontWeight="Bold" Margin="10,5,0,0"/>
                        </Grid>
                    </StackPanel>

                    <!-- Кнопки дій -->
                    <StackPanel Grid.Row="4" Margin="0,20,0,0">
                        <Button Content="💾 Зберегти зміни"
                                Click="SaveChanges_Click"
                                Background="#4CAF50" Foreground="White"
                                Padding="10,8" Margin="0,5"/>

                        <Button Content="🔄 Скасувати"
                                Click="CancelChanges_Click"
                                Padding="10,8" Margin="0,5"/>

                        <Separator Margin="0,10"/>

                        <Button Content="🔍 Сканувати"
                                Click="ScanDirectory_Click"
                                Padding="10,8" Margin="0,5"/>

                        <Button Content="🗑️ Видалити"
                                Click="DeleteDirectory_Click"
                                Background="#F44336" Foreground="White"
                                Padding="10,8" Margin="0,5"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Статус бар -->
        <Border Grid.Row="2"
                Background="#F5F5F5"
                BorderBrush="#E0E0E0"
                BorderThickness="0,1,0,0"
                Padding="15,10">
            <TextBlock x:Name="StatusText" Text="Готово" FontSize="12"/>
        </Border>
    </Grid>
</Controls:MetroWindow>
