<Controls:MetroWindow x:Class="DocControlUI.Windows.RemoteDirectoryBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
        Title="🌐 Віддалені директорії"
        Height="650" Width="1000"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/424.ico"
        Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Padding="15" Background="#2196F3">
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="🌐 Віддалені директорії"
                           FontSize="20" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="DeviceNameText" Text="Пристрій: -"
                           FontSize="12" Foreground="White" Opacity="0.9" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Основний контент -->
        <Grid Grid.Row="1" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Список директорій -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#E0E0E0"
                        BorderThickness="1" Padding="10" Margin="0,0,0,10">
                    <Grid>
                        <TextBlock Text="📁 Shared директорії на віддаленому пристрої"
                                   FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock x:Name="DirectoryCountText" Text="0 директорій"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="#666" FontWeight="SemiBold"/>
                    </Grid>
                </Border>

                <DataGrid Grid.Row="1"
                          x:Name="DirectoriesGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionChanged="DirectoriesGrid_SelectionChanged"
                          CanUserAddRows="False"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          RowHeight="35">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="📁 Назва" Binding="{Binding Name}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="📂 Шлях" Binding="{Binding Browse}" Width="2*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Foreground" Value="#666"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="🔓 Статус" Binding="{Binding SharedStatusText}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="10"
                          HorizontalAlignment="Stretch"
                          Background="Transparent"/>

            <!-- Панель деталей -->
            <Border Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="1" Padding="15">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="📋 Деталі директорії"
                                   FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                        <TextBlock Text="Назва:" FontWeight="Bold" Margin="0,5,0,0"/>
                        <TextBlock x:Name="DetailNameText" Text="-" Margin="0,2,0,0" TextWrapping="Wrap"/>

                        <TextBlock Text="Шлях на віддаленому пристрої:" FontWeight="Bold" Margin="0,10,0,0"/>
                        <TextBlock x:Name="DetailPathText" Text="-" Margin="0,2,0,0"
                                   TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"/>

                        <Separator Margin="0,15"/>

                        <TextBlock Text="📊 Статистика"
                                   FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

                        <!-- Статистика -->
                        <Border BorderBrush="#E0E0E0" BorderThickness="1"
                                Background="#FAFAFA" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="📦 Об'єкти:" Width="80" FontWeight="Bold" FontSize="11"/>
                                    <TextBlock x:Name="StatsObjectsText" Text="-" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="📁 Папки:" Width="80" FontWeight="Bold" FontSize="11"/>
                                    <TextBlock x:Name="StatsFoldersText" Text="-" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="📄 Файли:" Width="80" FontWeight="Bold" FontSize="11"/>
                                    <TextBlock x:Name="StatsFilesText" Text="-" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="🔓 Статус:" Width="80" FontWeight="Bold" FontSize="11"/>
                                    <TextBlock x:Name="StatsSharedText" Text="-" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Separator Margin="0,10"/>

                        <TextBlock Text="ℹ️ Інформація"
                                   FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>

                        <TextBlock Text="Це read-only перегляд віддалених директорій. Редагування недоступне."
                                   FontSize="10" Foreground="#666" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <Button Content="🔄 Оновити список"
                                Click="RefreshButton_Click"
                                Padding="10,8" Margin="0,10,0,0"/>

                        <Button Content="❌ Закрити"
                                Click="CloseButton_Click"
                                Padding="10,8" Margin="0,5,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Статус бар -->
        <Border Grid.Row="2"
                Background="#F5F5F5"
                BorderBrush="#E0E0E0"
                BorderThickness="0,1,0,0"
                Padding="15,10">
            <Grid>
                <TextBlock x:Name="StatusText" Text="Готово" FontSize="12"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="🌐 Віддалений перегляд" FontSize="10" Foreground="#666"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="●" FontSize="14" Foreground="#4CAF50" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Controls:MetroWindow>
