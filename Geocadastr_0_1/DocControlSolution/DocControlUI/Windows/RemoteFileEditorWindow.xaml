<Window x:Class="DocControlUI.Windows.RemoteFileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редагування файлу"
        Width="900" Height="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource PrimaryDarkBrush}" BorderThickness="2" CornerRadius="0">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Chrome заголовок -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryDarkBrush}" Height="40" Padding="12,0"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/424.ico" Width="22" Height="22" Margin="0,0,10,0"/>
                    <TextBlock Text="Редагування файлу" FontWeight="Bold" FontSize="13"
                               Foreground="{StaticResource WhiteBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="✕" Click="CloseButton_Click" Style="{StaticResource ChromeCloseButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="#F5F5F5" Padding="10" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- File info -->
                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <TextBlock x:Name="FileNameText" FontSize="16" FontWeight="Bold" Foreground="#333"/>
                    <TextBlock x:Name="FilePathText" FontSize="11" Foreground="#999" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="💾 Зберегти"
                            x:Name="SaveButton"
                            Click="SaveButton_Click"
                            Padding="15,8"
                            Margin="5,0"
                            Background="#0078D7"
                            Foreground="White"/>
                    <Button Content="🔄 Оновити"
                            x:Name="RefreshButton"
                            Click="RefreshButton_Click"
                            Padding="15,8"
                            Margin="5,0"/>
                    <Button Content="✖ Закрити"
                            Click="CloseButton_Click"
                            Padding="15,8"
                            Margin="5,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Text Editor -->
        <Border Grid.Row="2" Padding="10" Background="White">
            <TextBox x:Name="ContentTextBox"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     FontSize="13"
                     TextWrapping="NoWrap"
                     BorderThickness="1"
                     BorderBrush="#CCCCCC"
                     Padding="5"
                     TextChanged="ContentTextBox_TextChanged"/>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="#F5F5F5" Padding="10" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status indicator -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Ellipse x:Name="StatusIndicator" Width="10" Height="10" Fill="Green" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" Text="Готово" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Info -->
                <TextBlock Grid.Column="2" x:Name="InfoText" Text="" VerticalAlignment="Center" Foreground="#666"/>
            </Grid>
        </Border>
    </Grid>
    </Border>
</Window>
