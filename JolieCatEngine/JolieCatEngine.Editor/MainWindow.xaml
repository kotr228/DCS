<Window x:Class="JolieCatEngine.Editor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:JolieCatEngine.Editor"
        mc:Ignorable="d"
        Title="JolieCatEngine Editor" Height="720" Width="1280"
        MinHeight="480" MinWidth="800"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#FF1E1C1A"
        StateChanged="MainWindow_StateChanged">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF1E1C1A" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FF252321" />
        <SolidColorBrush x:Key="PanelAltBackgroundBrush" Color="#FF2D2A27" />
        <SolidColorBrush x:Key="BorderBrush" Color="#FF302E2C" />
        <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#FF3A3733" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FFC8A265" />
        <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#FFE9C47D" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFE0DCD5" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFAFA89C" />
        <SolidColorBrush x:Key="OnAccentTextBrush" Color="#FF1E1C1A" />
        <SolidColorBrush x:Key="CloseHoverBackgroundBrush" Color="#FFC0392B" />

        <Style x:Key="WindowControlButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource OnAccentTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#33000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseWindowControlButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowControlButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource CloseHoverBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="8,6" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" MinHeight="200" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="180" MinHeight="80" />
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Border Grid.Row="0" Background="{StaticResource TitleBarBackgroundBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="JolieCatEngine Editor"
                           Foreground="{StaticResource OnAccentTextBrush}"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeButton" Style="{StaticResource WindowControlButtonStyle}"
                            Content="&#xE921;" ToolTip="Minimize" Click="MinimizeButton_Click" />
                    <Button x:Name="MaximizeRestoreButton" Style="{StaticResource WindowControlButtonStyle}"
                            ToolTip="Maximize" Click="MaximizeRestoreButton_Click">
                        <TextBlock x:Name="MaximizeRestoreGlyph" Text="&#xE922;" />
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource CloseWindowControlButtonStyle}"
                            Content="&#xE8BB;" ToolTip="Close" Click="CloseButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="300" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <!-- Hierarchy / Scene Graph -->
            <Border Grid.Column="0" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="HIERARCHY / SCENE GRAPH" Style="{StaticResource PanelHeaderStyle}" />
                    <TextBlock Text="No scene loaded"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontStyle="Italic" FontSize="11" />
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}" ShowsPreview="True" />

            <!-- Scene Viewport -->
            <Border Grid.Column="2" Background="{StaticResource PanelAltBackgroundBrush}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="SCENE VIEWPORT" Style="{StaticResource PanelHeaderStyle}" />
                    <TextBlock Text="Viewport"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontStyle="Italic" FontSize="12" />
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}" ShowsPreview="True" />

            <!-- Inspector / Properties -->
            <Border Grid.Column="4" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="INSPECTOR / PROPERTIES" Style="{StaticResource PanelHeaderStyle}" />
                    <TextBlock Text="No selection"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontStyle="Italic" FontSize="11" />
                </DockPanel>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch"
                      Background="{StaticResource BorderBrush}" ShowsPreview="True" />

        <!-- Asset Browser / Console -->
        <Border Grid.Row="3" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="ASSET BROWSER / CONSOLE" Style="{StaticResource PanelHeaderStyle}" />
                <TextBlock Text="No assets"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontStyle="Italic" FontSize="11" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
