<Project Sdk="Microsoft.NET.Sdk">

  <!-- net8.0-windows + UseWPF: the viewport control is a WPF element that shows the
       DirectX 11 renderer (Vortice) through a D3DImage. JolieCat3D.Core stays plain net8.0
       so the data model never depends on WPF, Windows or a graphics API. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- This sandbox has no Windows Desktop runtime, only the reference assemblies -
         needed to let a Windows-targeted project restore/compile here at all (see
         JolieCat.UI.csproj for the same setting, established in an earlier round). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D9" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JolieCat3D.Core\JolieCat3D.Core.csproj" />
  </ItemGroup>

</Project>
