<Window x:Class="JolieCat3D.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JolieCat3D.UI"
        xmlns:h="clr-namespace:HelixToolkit.Wpf;assembly=HelixToolkit.Wpf"
        xmlns:vm="clr-namespace:JolieCat3D.UI.ViewModels"
        xmlns:converters="clr-namespace:JolieCat3D.UI.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="JolieCat3D" Height="700" Width="1200"
        Icon="Assets/JolieCatLogo.ico"
        WindowStyle="None" ResizeMode="CanResize" StateChanged="MainWindow_StateChanged"
        Style="{StaticResource MainWindowStyle}"
        d:DataContext="{d:DesignInstance Type=vm:SceneViewModel, IsDesignTimeCreatable=True}"
        PreviewKeyDown="MainWindow_PreviewKeyDown">

    <!-- WindowStyle="None" (above) removes the native OS title bar/border entirely -
         Tier 1 below (now a custom, hand-drawn draggable title bar - see its own
         TitleBar_MouseLeftButtonDown remarks) replaces it. WindowChrome is what keeps
         the OS's own resize/Aero-Snap behavior working despite that: CaptionHeight="0"
         since Tier 1 has real interactive content of its own (Menu, Workspace tabs,
         window control buttons) rather than a single uniform drag strip, so dragging is
         handled by hand (DragMove()) instead of relying on WindowChrome's own automatic
         caption-region hit-testing; ResizeBorderThickness gives the edges/corners back
         their own invisible resize-cursor margin that WindowStyle="None" would otherwise
         remove outright.-->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                             ResizeBorderThickness="6"
                             GlassFrameThickness="0"
                             CornerRadius="0"
                             UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
        <converters:ColorToBrushConverter x:Key="ColorToBrush" />

        <!-- The classic WindowChrome + WindowStyle="None" maximize bug: a maximized
             window like this one is measured/arranged to the FULL monitor bounds (not
             just its work area), which normally overlaps the taskbar by design - a
             normally-chromed maximized window gets pulled back within the work area by
             the OS/WindowChrome's own non-client handling, but with that native chrome
             gone, nothing pulls THIS window's own content back in, so the bottom rows
             (the Timeline, the Status Bar) end up rendered UNDER the taskbar instead of
             just above it. Window derives from ContentControl, so its own default
             template already wraps its content in the Window's own Padding - this Style
             (applied to the root Window element itself, above) sets that Padding only
             while WindowState="Maximized", using SystemParameters.WindowResizeBorderThickness
             (the same inset a normally-chromed maximized window already gets) rather than
             a hardcoded pixel guess, so it stays correct across any DPI/theme. -->
        <Style x:Key="MainWindowStyle" TargetType="{x:Type Window}" BasedOn="{StaticResource {x:Type Window}}">
            <Style.Triggers>
                <Trigger Property="WindowState" Value="Maximized">
                    <Setter Property="Padding" Value="{x:Static SystemParameters.WindowResizeBorderThickness}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ================= Left Vertical Toolbar's own per-mode visibility ================= -->
        <!-- Each mode-gated section of the Left Vertical Toolbar (below) uses one of
             these against MainWindow.CurrentEditorMode (a real DependencyProperty kept
             in sync by ModeComboBox_SelectionChanged - see that property's own remarks)
             - the task's own "Use XAML DataTriggers based on the Interaction Mode to
             dynamically swap the contents of this left toolbar" ask, applied via
             ordinary Style/DataTrigger rather than any imperative Visibility assignment
             in code-behind (which the 4 paint-mode toolbars used to have, and which
             would otherwise silently fight these same Triggers - a local value always
             wins over a Style Trigger in WPF's own property-value precedence). -->
        <Style x:Key="EditModeToolStyle" TargetType="{x:Type StackPanel}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentEditorMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Edit">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WeightPaintToolStyle" TargetType="{x:Type StackPanel}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentEditorMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="WeightPaint">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="VertexPaintToolStyle" TargetType="{x:Type StackPanel}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentEditorMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="VertexPaint">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SculptToolStyle" TargetType="{x:Type StackPanel}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentEditorMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Sculpt">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TexturePaintToolStyle" TargetType="{x:Type StackPanel}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentEditorMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="TexturePaint">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The Tier 2 header's own "View"/"Shading" dropdown buttons (a ToggleButton
             whose own IsChecked drives a Popup's IsOpen - see each one's own remarks
             below) - ToggleButton has no theme-wide Style of its own in App.xaml the way
             Button/RadioButton/TextBox/Menu do, so left completely unstyled it would
             render with WPF's own default OS-light chrome (white background, dark-on-dark
             unreadable text against this window's own dark theme) - the exact bug this
             project's own established convention already fixed for every other control
             type. -->
        <Style x:Key="DropdownMenuButtonStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Background" Value="{StaticResource PanelAltBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The Popup body every dropdown below shares - a plain dark card, matching the
             existing Menu/MenuItem popup's own look (App.xaml's TopLevelHeader template). -->
        <Style x:Key="DropdownPopupBorderStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8" />
        </Style>

        <!-- ================= Properties panel's own vertical tab strip ================= -->
        <!-- TabStripPlacement="Left" is set on the TabControl element itself below. A plain
             Setter-only Style (Background/BorderThickness/Padding) still leaves WPF's own
             default TabControl ControlTemplate driving the actual chrome underneath -
             including the default vertical-tab TabItem template, which rotates each
             header's text 90 degrees (wrong for this task's own short "[OBJ]"/"[MOD]"
             placeholder labels) - AND whatever OS-theme border/background the default
             template's own chrome draws around the header strip and content area
             regardless of this Style's Setters, the same "OS-default chrome, not this
             app's own dark Style" bug already fixed for every other non-trivial control
             (Menu, ComboBox, TreeView, ...) - this was the one place it hadn't been fixed
             yet, and produced both a stray light divider line and a washed-out-looking
             header strip. Both Styles below fully replace their own ControlTemplate
             instead: PropertiesTabControlStyle lays the header strip and content area out
             in a plain Grid (assuming TabStripPlacement="Left", this app's only actual
             usage); PropertiesTabItemStyle replaces the default template with a plain
             Border+ContentPresenter (no rotation), following GizmoModeButtonStyle's own
             established "AccentBrush fill when active, Foreground left unchanged"
             convention for IsSelected. -->
        <Style x:Key="PropertiesTabControlStyle" TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid ClipToBounds="True" KeyboardNavigation.TabNavigation="Local">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TabPanel x:Name="HeaderPanel" Grid.Column="0" Panel.ZIndex="1"
                                      IsItemsHost="True" Background="Transparent"
                                      KeyboardNavigation.TabIndex="1" />
                            <Border Grid.Column="1" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  Margin="{TemplateBinding Padding}"
                                                  ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PropertiesTabItemStyle" TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="Bg" Width="42" Padding="2,10"
                                Background="{StaticResource PanelAltBackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,1">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextBlock.FontSize="10" TextBlock.TextAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The Left Toolbar's own vertically-stacked action buttons (Delete, Extrude,
             Subdivide, ...) - App.xaml's own Button style hard-codes its ContentPresenter's
             HorizontalAlignment to Center (fine for a short, fixed-width label), which would
             just clip a full "Subdivide" rather than ellipsize it once Column 0 (now a real,
             GridSplitter-draggable pixel width - see the main content Grid's own
             ColumnDefinitions) is dragged down near its own MinWidth. This Style's
             ContentPresenter instead stretches to the button's own width, so each button's
             own child TextBlock (TextAlignment="Left", TextTrimming="CharacterEllipsis")
             gets the full available width to either show the whole word or ellipsize it as
             the Left Toolbar narrows. -->
        <Style x:Key="ToolButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom title bar's own Minimize/Maximize-Restore/Close buttons - a compact
             46x32 caption-button footprint, flat and borderless like the global Button
             style (Theme.xaml) but without its centered-icon padding, since these hold a
             single small Segoe MDL2 Assets glyph, not a text label. -->
        <Style x:Key="WindowControlButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <!-- Dark glyph, not the usual light TextPrimaryBrush - these sit on Tier 1's
                 own gold/sand title bar background (AccentBrush), the same contrast fix
                 TitleBarMenuItemStyle/WorkspaceTabButtonStyle below give the Menu/
                 Workspace tabs beside them. -->
            <Setter Property="Foreground" Value="{StaticResource OnAccentTextBrush}" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close gets the near-universal "goes red on hover" treatment (Theme.xaml's own
             CloseHoverBackgroundBrush) instead of the neutral HoverBackgroundBrush every
             other window control button above uses. -->
        <Style x:Key="CloseWindowControlButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource WindowControlButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource CloseHoverBackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The 4 top-level "_File"/"_Edit"/"_Window"/"_Help" MenuItems inside Tier 1's
             own Menu, now sitting on the gold/sand title bar background (AccentBrush)
             instead of a dark panel - overrides ONLY the base (Theme.xaml) MenuItem
             Style's own Foreground Setter for dark-on-gold contrast; applied to the 4
             top-level MenuItems alone. Each one's own dropdown items (New Scene, Open,
             ...) still use the plain, un-derived MenuItem Style, since THEY pop up over
             a dark Popup (PanelBackgroundBrush), where the existing light
             TextPrimaryBrush is still correct. -->
        <Style x:Key="TitleBarMenuItemStyle" TargetType="{x:Type MenuItem}" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Foreground" Value="{StaticResource OnAccentTextBrush}" />
        </Style>

        <!-- The Workspace tab row (Layout/Modeling/Sculpting/...) - also now on Tier 1's
             gold/sand background, so it needs its own look rather than
             GizmoModeButtonStyle's (a dark chip with light text, correct everywhere ELSE
             it's used, all against dark panels, but illegible dark-on-gold here).
             Unchecked blends flush into the gold bar (Transparent) with dark text;
             IsChecked inverts to a dark chip with light text instead - this app's own
             "gold fill = active" convention flipped, since the surrounding bar is
             already gold here. -->
        <Style x:Key="WorkspaceTabButtonStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource OnAccentTextBrush}" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Tier 1: Main Application Header -->
            <RowDefinition Height="Auto" /> <!-- Tier 2: 3D Viewport Header -->
            <RowDefinition Height="*" />    <!-- Outliner | Left Toolbar | Viewport | Properties -->
            <!-- Animation playback transport (Frame Scrubber/Dopesheet/Play/Stop) - a real
                 MinHeight so this row can never be squeezed down to nothing regardless of
                 window size; Height="Auto" still lets it size to its own content (currently
                 well under 100px), MinHeight is only a floor, not a fixed height. -->
            <RowDefinition Height="Auto" MinHeight="100" />
            <RowDefinition Height="Auto" /> <!-- Status bar (Live Sync) -->
        </Grid.RowDefinitions>

        <!-- ================= Tier 1: Main Application Header ================= -->
        <!-- Now doubles as the custom title bar WindowStyle="None" (see this Window's own
             root-element remarks) needs - TitleBar_MouseLeftButtonDown calls DragMove() for
             an ordinary drag, or toggles Maximize/Restore on a double-click, exactly what
             the native OS caption used to do. A click that lands on the Menu, the Workspace
             tabs, or the window control buttons below never reaches this handler at all -
             each of those controls' own class handling already marks a MouseLeftButtonDown
             on itself Handled before it would bubble up here, so dragging and clicking a
             real control never conflict. -->
        <!-- Background is TitleBarBackgroundBrush - JolieCatLogo.ico's own exact
             background hex (#E9C47D), not the (close but not identical) AccentBrush
             every other highlight/active-state color in this app uses, and not a dark
             panel brush either - the one place in this app a dark control needs to
             become the exception rather than the rule: the Menu below gets a
             Transparent Background of its own so it doesn't paint a dark rectangle over
             this gold bar, TitleBarMenuItemStyle darkens ONLY the 4 top-level
             MenuItems' own text for contrast (their dropdown items still pop up over a
             dark Popup, so they keep the ordinary light MenuItem look), and
             WorkspaceTabButtonStyle replaces GizmoModeButtonStyle for the Workspace tabs
             for the same reason - see each Style's own remarks below. -->
        <DockPanel Grid.Row="0" LastChildFill="False" Background="{StaticResource TitleBarBackgroundBrush}"
                   MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <!-- The JolieCat brand logo - Assets/JolieCatLogo.ico, embedded as a WPF
                 Resource (see JolieCat3D.UI.csproj's own remarks) so this plain relative
                 pack URI resolves at runtime. -->
            <Image DockPanel.Dock="Left" Source="Assets/JolieCatLogo.ico"
                   Height="22" MaxHeight="24" Margin="10,0,8,0"
                   VerticalAlignment="Center" HorizontalAlignment="Left"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   ToolTip="JolieCat3D" />

            <!-- Window Controls (Minimize/Maximize-Restore/Close) - the far-right
                 replacement for the native OS caption buttons WindowStyle="None" removes.
                 Declared as the FIRST Dock="Right" child in this DockPanel so it lands
                 outermost - DockPanel docks same-side children in document order, each one
                 claiming space closer to its own edge than the next, so this ends up
                 further right than the Workspace tabs below it. -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="MinimizeButton" Style="{StaticResource WindowControlButtonStyle}"
                        Click="MinimizeButton_Click" ToolTip="Minimize">
                    <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                </Button>
                <Button x:Name="MaximizeRestoreButton" Style="{StaticResource WindowControlButtonStyle}"
                        Click="MaximizeRestoreButton_Click" ToolTip="Maximize">
                    <TextBlock x:Name="MaximizeRestoreGlyph" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                </Button>
                <Button x:Name="CloseButton" Style="{StaticResource CloseWindowControlButtonStyle}"
                        Click="CloseButton_Click" ToolTip="Close">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                </Button>
            </StackPanel>

            <Menu DockPanel.Dock="Left" Padding="0" VerticalAlignment="Center" Background="Transparent">
                <MenuItem Header="_File" Style="{StaticResource TitleBarMenuItemStyle}">
                    <MenuItem Header="_New Scene" Command="ApplicationCommands.New" />
                    <MenuItem Header="_Open..." Command="ApplicationCommands.Open" />
                    <Separator />
                    <MenuItem Header="_Save" Command="ApplicationCommands.Save" />
                    <MenuItem Header="Save _As..." Command="ApplicationCommands.SaveAs" />
                    <Separator />
                    <MenuItem Header="_Import..." Click="ImportMenuItem_Click" InputGestureText="Ctrl+I" />
                    <MenuItem Header="_Export..." Click="ExportMenuItem_Click" InputGestureText="Ctrl+E" />
                    <!-- The modern, animation/PBR-capable export path (JolieCat3D.Service.Export.GltfExporter) -
                         unlike ExportMenuItem_Click's own OBJ/STL, this carries the real node
                         hierarchy, PBR materials (diffuse/normal/metallic-roughness textures),
                         and every keyframe on _timeline, in one self-contained .glb. -->
                    <MenuItem Header="Export _GLB/glTF..." Click="ExportGltfMenuItem_Click" />
                    <Separator />
                    <!-- Saves the whole AnimationTimeline (every node's transform keyframes,
                         every material's texture-frame track) out to a file - two flavors
                         picked by which of the SaveFileDialog's own filter entries is
                         chosen: JolieCat3D's own native, full-fidelity interchange JSON, or
                         a JolieCat-2D-compatible "TimelineTracks" JSON fragment (keyframe
                         TIMES only - see JolieAnimationExporter's own remarks). -->
                    <MenuItem Header="Export _Animation..." Click="ExportAnimationMenuItem_Click" />
                    <!-- Bakes the current AnimationTimeline out to a numbered PNG sequence -
                         one High-res HelixToolkit.Wpf.Viewport3DHelper.SaveBitmap capture per
                         frame (see ViewportCaptureService's own remarks). -->
                    <MenuItem Header="_Render Animation Frames..." Click="RenderAnimationFramesMenuItem_Click" />
                    <Separator />
                    <!-- Starts JolieCat3D.Service.Interop.JolieWorkspaceWatcher on a chosen
                         folder - any .jolie project or exported image later created/changed
                         there automatically refreshes whichever node(s) last loaded a
                         texture from it (see MainWindow.xaml.cs's own remarks on
                         _textureSources/HandleWorkspaceAssetChanged). -->
                    <MenuItem Header="_Watch JolieCat Workspace..." Click="WatchWorkspaceMenuItem_Click" />
                    <Separator />
                    <MenuItem Header="E_xit" Click="ExitMenuItem_Click" />
                </MenuItem>
                <!-- Plain, unstyled functional entries (this whole UI is a temporary test
                     layout) - ApplicationCommands.Undo/Redo already carry their own default
                     Ctrl+Z/Ctrl+Y gestures and InputGestureText, wired to
                     MainWindow's own CommandHistory in its constructor. -->
                <MenuItem Header="_Edit" Style="{StaticResource TitleBarMenuItemStyle}">
                    <MenuItem Header="_Undo" Command="ApplicationCommands.Undo" />
                    <MenuItem Header="_Redo" Command="ApplicationCommands.Redo" />
                </MenuItem>
                <MenuItem Header="_Window" Style="{StaticResource TitleBarMenuItemStyle}">
                    <MenuItem Header="Toggle _Full Screen" Click="ToggleFullScreenMenuItem_Click" />
                </MenuItem>
                <MenuItem Header="_Help" Style="{StaticResource TitleBarMenuItemStyle}">
                    <MenuItem Header="_About JolieCat3D" Click="AboutMenuItem_Click" />
                </MenuItem>
            </Menu>

            <!-- Workspaces - a flat tab row that (today) just switches the Tier 2 Interaction
                 Mode combo to a sensible starting mode for that workflow, reusing every one
                 of ModeComboBox_SelectionChanged's own existing validation (see
                 WorkspaceButton_Checked's own remarks) - a real, working shortcut rather than
                 an inert placeholder, ahead of a genuine separate-UI-layout-per-workspace
                 system (the task's own "to switch overarching UI layouts in the future"
                 wording). -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                <RadioButton x:Name="LayoutWorkspaceButton" Content="Layout" GroupName="Workspace"
                             IsChecked="True" Style="{StaticResource WorkspaceTabButtonStyle}"
                             Margin="0,0,2,0" Checked="WorkspaceButton_Checked" Tag="Object" />
                <RadioButton x:Name="ModelingWorkspaceButton" Content="Modeling" GroupName="Workspace"
                             Style="{StaticResource WorkspaceTabButtonStyle}"
                             Margin="0,0,2,0" Checked="WorkspaceButton_Checked" Tag="Edit" />
                <RadioButton x:Name="SculptingWorkspaceButton" Content="Sculpting" GroupName="Workspace"
                             Style="{StaticResource WorkspaceTabButtonStyle}"
                             Margin="0,0,2,0" Checked="WorkspaceButton_Checked" Tag="Sculpt" />
                <RadioButton x:Name="TexturePaintWorkspaceButton" Content="Texture Paint" GroupName="Workspace"
                             Style="{StaticResource WorkspaceTabButtonStyle}"
                             Margin="0,0,2,0" Checked="WorkspaceButton_Checked" Tag="TexturePaint" />
                <RadioButton x:Name="AnimationWorkspaceButton" Content="Animation" GroupName="Workspace"
                             Style="{StaticResource WorkspaceTabButtonStyle}"
                             Checked="WorkspaceButton_Checked" Tag="Object" />
            </StackPanel>
        </DockPanel>

        <!-- ================= Tier 2: 3D Viewport Header ================= -->
        <Border Grid.Row="1" Background="{StaticResource PanelAltBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
        <DockPanel LastChildFill="False">
            <!-- === Left-aligned: Interaction Mode + contextual viewport menus ==== -->
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="6,3">
                <ComboBox x:Name="ModeComboBox" Width="110" Margin="0,0,8,0"
                          SelectionChanged="ModeComboBox_SelectionChanged">
                    <ComboBoxItem Content="Object Mode" Tag="Object" IsSelected="True" />
                    <ComboBoxItem Content="Edit Mode" Tag="Edit" />
                    <ComboBoxItem Content="Weight Paint" Tag="WeightPaint" />
                    <ComboBoxItem Content="Vertex Paint" Tag="VertexPaint" />
                    <ComboBoxItem Content="Sculpt" Tag="Sculpt" />
                    <ComboBoxItem Content="Texture Paint" Tag="TexturePaint" />
                </ComboBox>

                <!-- Component Select (Vertex/Edge/Face) - relocated here from the Left
                     Toolbar so it sits immediately next to the Interaction Mode combo it's
                     gated on, matching Blender's own header layout; reuses the SAME
                     EditModeToolStyle (a CurrentEditorMode=="Edit" DataTrigger on
                     Visibility) the Left Toolbar's own Mesh Tools section still uses, so it
                     stays Edit-Mode-only with zero new code-behind. -->
                <StackPanel Orientation="Horizontal" Style="{StaticResource EditModeToolStyle}" Margin="0,0,8,0">
                    <RadioButton x:Name="VertexModeButton" Content="V" GroupName="ComponentMode"
                                 IsChecked="True" IsEnabled="False" Style="{StaticResource GizmoModeButtonStyle}"
                                 Margin="0,0,1,0" Padding="4,2" Checked="ComponentModeButton_Checked" Tag="Vertex"
                                 ToolTip="Vertex select" />
                    <RadioButton x:Name="EdgeModeButton" Content="E" GroupName="ComponentMode"
                                 IsEnabled="False" Style="{StaticResource GizmoModeButtonStyle}"
                                 Margin="0,0,1,0" Padding="4,2" Checked="ComponentModeButton_Checked" Tag="Edge"
                                 ToolTip="Edge select" />
                    <RadioButton x:Name="FaceModeButton" Content="F" GroupName="ComponentMode"
                                 IsEnabled="False" Style="{StaticResource GizmoModeButtonStyle}"
                                 Padding="4,2" Checked="ComponentModeButton_Checked" Tag="Face"
                                 ToolTip="Face select" />
                </StackPanel>

                <!-- "View" - Perspective/Orthographic, the 6 axis-aligned view presets, and
                     the reference-grid visibility/spacing controls the Translate gizmos' own
                     Ctrl-drag snapping (Gizmos.TransformGizmo.GridSize/Editing.ComponentGizmo.GridSize)
                     is kept in step with - a compact dropdown (ToggleButton+Popup) rather than
                     a literal MenuItem submenu, since MenuItem's own custom template (App.xaml)
                     has no checkmark glyph for an IsCheckable item - these controls are the
                     SAME RadioButton/CheckBox/TextBox this app already used inline, just now
                     tucked behind a dropdown instead of always taking up header space. -->
                <ToggleButton x:Name="ViewMenuToggle" Content="View" Style="{StaticResource DropdownMenuButtonStyle}" Margin="0,0,4,0" />
                <Popup PlacementTarget="{Binding ElementName=ViewMenuToggle}" Placement="Bottom"
                       IsOpen="{Binding IsChecked, ElementName=ViewMenuToggle, Mode=TwoWay}"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Style="{StaticResource DropdownPopupBorderStyle}" MinWidth="220">
                        <StackPanel>
                            <TextBlock Text="Camera" Style="{StaticResource PanelHeaderStyle}" Margin="0,0,0,2" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <RadioButton x:Name="PerspectiveCameraButton" Content="Perspective" GroupName="CameraProjection"
                                             IsChecked="True" Style="{StaticResource GizmoModeButtonStyle}"
                                             Margin="0,0,4,0" Checked="CameraProjectionButton_Checked" Tag="Perspective" />
                                <RadioButton x:Name="OrthographicCameraButton" Content="Orthographic" GroupName="CameraProjection"
                                             Style="{StaticResource GizmoModeButtonStyle}"
                                             Checked="CameraProjectionButton_Checked" Tag="Orthographic" />
                            </StackPanel>

                            <TextBlock Text="View Preset" Style="{StaticResource PanelHeaderStyle}" Margin="0,0,0,2" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Button Content="Top" Margin="0,0,2,0" Padding="8,2" Click="ViewPresetButton_Click" Tag="Top" />
                                <Button Content="Bottom" Margin="0,0,2,0" Padding="8,2" Click="ViewPresetButton_Click" Tag="Bottom" />
                                <Button Content="Front" Margin="0,0,2,0" Padding="8,2" Click="ViewPresetButton_Click" Tag="Front" />
                                <Button Content="Back" Margin="0,0,2,0" Padding="8,2" Click="ViewPresetButton_Click" Tag="Back" />
                                <Button Content="Left" Margin="0,0,2,0" Padding="8,2" Click="ViewPresetButton_Click" Tag="Left" />
                                <Button Content="Right" Padding="8,2" Click="ViewPresetButton_Click" Tag="Right" />
                            </StackPanel>

                            <!-- "View > Active Camera" - locks the viewport onto Scene3D.ActiveCamera
                                 and pilots it (Engine.Rendering.Scene3DRenderer.EnterActiveCameraView/
                                 ExitActiveCameraView) - navigating the viewport while this is checked
                                 writes straight back onto that camera node's own transform. Also
                                 reachable via Numpad 0 from anywhere in the window - see
                                 MainWindow.xaml.cs's own MainWindow_PreviewKeyDown. -->
                            <CheckBox x:Name="ActiveCameraViewCheckBox" Content="Camera View (Numpad 0)" VerticalAlignment="Center"
                                      Margin="0,0,0,6" Checked="ActiveCameraViewCheckBox_Changed" Unchecked="ActiveCameraViewCheckBox_Changed" />

                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="ShowGridCheckBox" Content="Grid" IsChecked="True" VerticalAlignment="Center"
                                          Margin="0,0,10,0" Checked="ShowGridCheckBox_Changed" Unchecked="ShowGridCheckBox_Changed" />
                                <TextBlock Text="Size" VerticalAlignment="Center" Margin="0,0,4,0"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <!-- The SAME value both the reference grid visual AND a Ctrl-held
                                     Translate drag's own snapping increment use - see MainWindow.xaml.cs's
                                     own GridSizeTextBox_TextChanged. -->
                                <TextBox x:Name="GridSizeTextBox" Width="50" Text="1" TextChanged="GridSizeTextBox_TextChanged" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- "Add" - dynamic scene population; every entry adds one new ROOT node
                     with default settings, selectable/editable afterward exactly like any
                     other node (Position/Rotation/Scale, the Outliner, the Properties
                     Inspector). A real MenuItem submenu (not the ToggleButton+Popup pattern
                     "View"/"Shading" use) - every entry here is a plain one-shot action with
                     no toggle state at all, so App.xaml's existing MenuItem styling already
                     handles it correctly with no further template work needed. -->
                <Menu Padding="0" Margin="0,0,4,0">
                    <MenuItem Header="_Add">
                        <MenuItem Header="Add _Cube" Click="AddCubeMenuItem_Click" />
                        <MenuItem Header="Add _Sphere" Click="AddSphereMenuItem_Click" />
                        <MenuItem Header="Add _Plane" Click="AddPlaneMenuItem_Click" />
                        <MenuItem Header="Add C_ylinder" Click="AddCylinderMenuItem_Click" />
                        <Separator />
                        <MenuItem Header="Add Ca_mera" Click="AddCameraMenuItem_Click" />
                        <MenuItem Header="Add _Light" Click="AddLightMenuItem_Click" />
                        <MenuItem Header="Add C_urve" Click="AddCurveMenuItem_Click" />
                        <MenuItem Header="Add _Armature" Click="AddArmatureMenuItem_Click" />
                        <MenuItem Header="Add _Bone" Click="AddBoneMenuItem_Click" />
                        <Separator />
                        <!-- A scene-wide skybox/IBL setting (Core.Scene.Scene3D.Environment) -
                             round-trips through the .jolie3d project file, the same "a real
                             scene-level setting, not a per-node one" shape ActiveCamera already
                             has. See Engine.Rendering.EnvironmentVisualFactory's own remarks on
                             what picking one actually does. -->
                        <MenuItem Header="Set _Skybox..." Click="SetSkyboxMenuItem_Click" />
                        <MenuItem Header="Clear Skybox" Click="ClearSkyboxMenuItem_Click" />
                    </MenuItem>
                </Menu>

                <!-- "Object/Mesh" - object-level one-shot actions (Blender's own Object/Mesh
                     menu, kept under a single always-present header rather than swapping its
                     own text between "Object"/"Mesh" per mode - a real, disclosed
                     simplification). Duplicate means a whole-node deep clone in Object Mode or
                     the current vertex/edge/face selection in Edit Mode (see
                     DuplicateSelected's own remarks); Delete is the same dual-mode behavior
                     (see DeleteSelected's own remarks) - also reachable via Ctrl+D/Delete from
                     anywhere in the window (MainWindow_PreviewKeyDown). -->
                <Menu Padding="0">
                    <MenuItem Header="_Object / Mesh">
                        <MenuItem Header="_Duplicate" Click="DuplicateButton_Click" InputGestureText="Ctrl+D" />
                        <MenuItem Header="_Delete" Click="DeleteButton_Click" InputGestureText="Delete" />
                    </MenuItem>
                </Menu>
            </StackPanel>

            <!-- ==== Right-aligned: Transform Orientation/toggles, Snapping, Proportional
                 Editing, and the Shading/Post-processing pop-out ==== -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,3">
                <!-- Shading (Wireframe/Solid/Material/Rendered) + post-processing
                     (Shadows/Anti-Aliasing/SSAO/Bloom) - a compact right-aligned pop-out, the
                     task's own explicit wording, via the same ToggleButton+Popup pattern
                     "View" above already uses. -->
                <ToggleButton x:Name="ShadingMenuToggle" Content="Shading" Style="{StaticResource DropdownMenuButtonStyle}" Margin="16,0,0,0" />
                <Popup PlacementTarget="{Binding ElementName=ShadingMenuToggle}" Placement="Bottom" HorizontalOffset="-160"
                       IsOpen="{Binding IsChecked, ElementName=ShadingMenuToggle, Mode=TwoWay}"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Style="{StaticResource DropdownPopupBorderStyle}" MinWidth="200">
                        <StackPanel>
                            <TextBlock Text="Shading" Style="{StaticResource PanelHeaderStyle}" Margin="0,0,0,2" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <RadioButton x:Name="WireframeShadingButton" Content="Wireframe" GroupName="ShadingMode"
                                             Style="{StaticResource GizmoModeButtonStyle}"
                                             Margin="0,0,4,0" Checked="ShadingModeButton_Checked" Tag="Wireframe" />
                                <RadioButton x:Name="SolidShadingButton" Content="Solid" GroupName="ShadingMode"
                                             Style="{StaticResource GizmoModeButtonStyle}"
                                             Margin="0,0,4,0" Checked="ShadingModeButton_Checked" Tag="Solid" />
                                <RadioButton x:Name="MaterialShadingButton" Content="Material" GroupName="ShadingMode"
                                             Style="{StaticResource GizmoModeButtonStyle}"
                                             Margin="0,0,4,0" Checked="ShadingModeButton_Checked" Tag="Material" />
                                <RadioButton x:Name="RenderedShadingButton" Content="Rendered" GroupName="ShadingMode"
                                             IsChecked="True" Style="{StaticResource GizmoModeButtonStyle}"
                                             Checked="ShadingModeButton_Checked" Tag="Rendered" />
                            </StackPanel>

                            <TextBlock Text="Post-Processing" Style="{StaticResource PanelHeaderStyle}" Margin="0,0,0,2" />
                            <!-- Shadows: a planar-projected shadow onto the ground plane for
                                 every Directional/Spot light node. Anti-Aliasing: forces WPF's
                                 own software rasterizer (the one real way to anti-alias
                                 Viewport3D content in this pipeline). SSAO: darkening decals
                                 along every mesh's own concave (crease/corner) edges. Bloom: a
                                 blurred re-paint of the viewport layered on top at low opacity -
                                 see each CheckBox's own changed handler for the full remarks
                                 already established for these. -->
                            <CheckBox x:Name="ShowShadowsCheckBox" Content="Shadows" IsChecked="True" VerticalAlignment="Center"
                                      Margin="0,0,0,4" Checked="ShowShadowsCheckBox_Changed" Unchecked="ShowShadowsCheckBox_Changed" />
                            <CheckBox x:Name="AntiAliasingCheckBox" Content="Anti-Aliasing" IsChecked="True" VerticalAlignment="Center"
                                      Margin="0,0,0,4" Checked="AntiAliasingCheckBox_Changed" Unchecked="AntiAliasingCheckBox_Changed" />
                            <CheckBox x:Name="SsaoCheckBox" Content="SSAO" IsChecked="True" VerticalAlignment="Center"
                                      Margin="0,0,0,4" Checked="SsaoCheckBox_Changed" Unchecked="SsaoCheckBox_Changed" />
                            <CheckBox x:Name="BloomCheckBox" Content="Bloom" VerticalAlignment="Center"
                                      Checked="BloomCheckBox_Changed" Unchecked="BloomCheckBox_Changed" />
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- Proportional Editing (Soft Selection) - a Translate drag also nudges
                     nearby UNSELECTED vertices within Radius, smoothly falling off with
                     distance (see Editing.MeshEditSession.ProportionalEditingEnabled/
                     ProportionalRadius) - Edit-Mode-only (see ModeComboBox_SelectionChanged's
                     own IsEnabled toggle). -->
                <CheckBox x:Name="ProportionalEditingCheckBox" Content="Proportional" IsEnabled="False" VerticalAlignment="Center"
                          Margin="16,0,4,0" Checked="ProportionalEditingCheckBox_Changed" Unchecked="ProportionalEditingCheckBox_Changed"
                          ToolTip="Soft Selection - nearby unselected vertices also move, smoothly falling off with distance" />
                <Slider x:Name="ProportionalRadiusSlider" Width="60" Minimum="0.1" Maximum="10" Value="1"
                        VerticalAlignment="Center" IsEnabled="False" ValueChanged="ProportionalRadiusSlider_ValueChanged" />
                <TextBlock Text="{Binding Value, ElementName=ProportionalRadiusSlider, StringFormat={}{0:0.0}}"
                           VerticalAlignment="Center" Width="26" Margin="2,0,16,0"
                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />

                <!-- Snapping options - Face Snapping's own "Align to Surface" toggle (see
                     Gizmos.TransformGizmo.AlignToSurfaceEnabled's own remarks: only ever
                     takes effect during a Shift-held Translate drag that actually lands on
                     Face Snapping) and Custom Pivot Points' own "Affect Only: Origin" toggle
                     (Object Mode only - see Gizmos.TransformGizmo.AffectOnlyOrigin/
                     Core.Scene.Node.CompensateMeshForOriginChange). -->
                <CheckBox x:Name="AlignToSurfaceCheckBox" Content="Align to Surface" VerticalAlignment="Center"
                          Margin="0,0,16,0" Checked="AlignToSurfaceCheckBox_Changed" Unchecked="AlignToSurfaceCheckBox_Changed"
                          ToolTip="While Shift-dragging onto another object's face, also rotate the dragged object's local Z axis to match that face's normal" />
                <CheckBox x:Name="AffectOnlyOriginCheckBox" Content="Affect Only: Origin" VerticalAlignment="Center"
                          Margin="0,0,16,0" Checked="AffectOnlyOriginCheckBox_Changed" Unchecked="AffectOnlyOriginCheckBox_Changed"
                          ToolTip="Move/rotate/scale the selected object's own pivot without shifting its mesh geometry" />

                <!-- Transform toggles (Translate/Rotate/Scale) - unlike Interaction Mode
                     above, these stay plain RadioButtons ("toggles" per the task's own
                     wording), just relocated here from the old Gizmo Mode toolbar. -->
                <RadioButton x:Name="TranslateModeButton" Content="Translate" GroupName="GizmoMode"
                             IsChecked="True" Style="{StaticResource GizmoModeButtonStyle}"
                             Margin="0,0,2,0" Checked="GizmoModeButton_Checked" Tag="Translate" />
                <RadioButton x:Name="RotateModeButton" Content="Rotate" GroupName="GizmoMode"
                             Style="{StaticResource GizmoModeButtonStyle}"
                             Margin="0,0,2,0" Checked="GizmoModeButton_Checked" Tag="Rotate" />
                <RadioButton x:Name="ScaleModeButton" Content="Scale" GroupName="GizmoMode"
                             Style="{StaticResource GizmoModeButtonStyle}"
                             Margin="0,0,10,0" Checked="GizmoModeButton_Checked" Tag="Scale" />

                <!-- Transform Orientation - Global: gizmo axes always align with world
                     X/Y/Z, regardless of the selected object's own rotation. Local: they
                     rotate to match it instead (see TransformGizmo.Space's own remarks).
                     Scale is unaffected by this toggle either way. -->
                <ComboBox x:Name="TransformSpaceComboBox" Width="80"
                          SelectionChanged="TransformSpaceComboBox_SelectionChanged">
                    <ComboBoxItem Content="Global" Tag="Global" IsSelected="True" />
                    <ComboBoxItem Content="Local" Tag="Local" />
                </ComboBox>
            </StackPanel>
        </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <!-- Column 0 is a real, GridSplitter-draggable pixel Width (not Auto) - a
                 Blender-style T-panel the user can drag wider to read full tool names, or
                 push back down toward MinWidth for the compact icon-only look (see the
                 ToolButtonStyle'd buttons below, whose own TextBlock ellipsizes as this
                 column narrows). -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50" MinWidth="45" MaxWidth="200" /> <!-- Column 0: Left Tools Panel -->
                <ColumnDefinition Width="Auto" />              <!-- vertical splitter, Column 0 | Column 1 -->
                <ColumnDefinition Width="*" MinWidth="200" />  <!-- Column 1: 3D Viewport -->
                <ColumnDefinition Width="Auto" />              <!-- vertical splitter, Column 1 | Column 2 -->
                <ColumnDefinition Width="300" MinWidth="200" /> <!-- Column 2: Right Panel (Outliner/Properties) -->
            </Grid.ColumnDefinitions>

            <!-- ================= Left Vertical Toolbar (The Action Tools) ================= -->
            <!-- Docked directly to the left of the HelixViewport3D - every section below
                 uses one of the CurrentEditorMode-driven Styles defined in this window's own
                 Resources above, so only ONE section (matching whatever ModeComboBox is
                 currently set to) is ever visible at a time; DeleteButton alone sits outside
                 all of them, staying visible/enabled in every mode (it already meant
                 something different in Object vs. Edit Mode before this refactor - see
                 DeleteSelected's own remarks - so it was never mode-gated to begin with). Now
                 strictly modeling operations - Component select (Vertex/Edge/Face) moved next
                 to ModeComboBox in the Tier 2 header (see that ComboBox's own remarks), and
                 Delete moved to the bottom of this list, so neither interrupts the primary
                 top-to-bottom modeling workflow (Extrude -> Unwrap) below. -->
            <!-- A real, GridSplitter-resizable Blender-style T-panel (Column 0's own Width -
                 see the main content Grid's own ColumnDefinitions - defaults to 50, with
                 MinWidth="45"/MaxWidth="200") - drag the splitter to the right of this Border
                 wider to read each button's own full name, or push it back down toward
                 MinWidth for the compact icon-only look; every button below keeps its full
                 ToolTip too, for when it's showing only an ellipsized fragment. Radius/
                 Strength/Color (which never fit even at this panel's own MaxWidth, and which
                 the task itself calls out to relocate) now live in the Properties panel's own
                 "[TOOL]" tab instead; only each mode's own brush/bone/algorithm SELECTOR
                 controls stay here. -->
            <Border Grid.Column="0" Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="4,6">
                        <!-- ==== Edit Mode: Mesh tools (Component select now lives in the
                             Tier 2 header, next to ModeComboBox) ==== -->
                        <StackPanel Style="{StaticResource EditModeToolStyle}">
                            <!-- Extrude needs a single fully-selected Polygon face (Face mode);
                                 Subdivide always applies to the whole target mesh regardless of
                                 the current selection - see MeshEditSession's own remarks on
                                 both. -->
                            <Button x:Name="ExtrudeButton" Style="{StaticResource ToolButtonStyle}" IsEnabled="False"
                                    Margin="0,0,0,4" Padding="6,2" Click="ExtrudeButton_Click" ToolTip="Extrude">
                                <TextBlock Text="Extrude" TextAlignment="Left" TextTrimming="CharacterEllipsis" />
                            </Button>
                            <Button x:Name="SubdivideButton" Style="{StaticResource ToolButtonStyle}" IsEnabled="False"
                                    Margin="0,0,0,4" Padding="6,2" Click="SubdivideButton_Click" ToolTip="Subdivide">
                                <TextBlock Text="Subdivide" TextAlignment="Left" TextTrimming="CharacterEllipsis" />
                            </Button>
                            <!-- Loop Cut needs exactly one selected EDGE (2 vertices) that's
                                 part of at least one quad (see Mesh.LoopCut's own remarks);
                                 Bevel needs exactly one selected VERTEX with a closed, manifold
                                 fan of surrounding faces (see Mesh.BevelVertex's own remarks) -
                                 both report back and do nothing if the current selection
                                 doesn't qualify. -->
                            <Button x:Name="LoopCutButton" Style="{StaticResource ToolButtonStyle}" IsEnabled="False"
                                    Margin="0,0,0,4" Padding="6,2" Click="LoopCutButton_Click" ToolTip="Loop Cut">
                                <TextBlock Text="Loop Cut" TextAlignment="Left" TextTrimming="CharacterEllipsis" />
                            </Button>
                            <Button x:Name="BevelButton" Style="{StaticResource ToolButtonStyle}" IsEnabled="False"
                                    Margin="0,0,0,4" Padding="6,2" Click="BevelButton_Click" ToolTip="Bevel">
                                <TextBlock Text="Bevel" TextAlignment="Left" TextTrimming="CharacterEllipsis" />
                            </Button>
                            <!-- UV Seams/Unwrap - Mark/Clear Seam need a single selected edge
                                 (Edge mode), same requirement as Loop Cut above; Unwrap always
                                 applies to the whole target mesh (same "no partial-selection
                                 scope" convention Subdivide already has). See
                                 MeshEditSession's own remarks. -->
                            <Button x:Name="MarkSeamButton" Style="{StaticResource ToolButtonStyle}" IsEnabled="False"
                                    Margin="0,0,0,4" Padding="6,2" Click="MarkSeamButton_Click" ToolTip="Mark Seam">
                                <TextBlock Text="Mark Seam" TextAlignment="Left" TextTrimming="CharacterEllipsis" />
                            </Button>
                            <Button x:Name="ClearSeamButton" Style="{StaticResource ToolButtonStyle}" IsEnabled="False"
                                    Margin="0,0,0,4" Padding="6,2" Click="ClearSeamButton_Click" ToolTip="Clear Seam">
                                <TextBlock Text="Clear Seam" TextAlignment="Left" TextTrimming="CharacterEllipsis" />
                            </Button>
                            <Button x:Name="UnwrapButton" Style="{StaticResource ToolButtonStyle}" IsEnabled="False"
                                    Margin="0,0,0,4" Padding="6,2" Click="UnwrapButton_Click" ToolTip="Unwrap">
                                <TextBlock Text="Unwrap" TextAlignment="Left" TextTrimming="CharacterEllipsis" />
                            </Button>
                        </StackPanel>

                        <!-- Delete sits at the bottom, outside every mode-gated section above -
                             it stays visible/enabled in every mode (it already meant something
                             different in Object vs. Edit Mode before this refactor - see
                             DeleteSelected's own remarks), so it was never mode-gated to begin
                             with; moved here so it no longer interrupts the primary modeling
                             workflow (Extrude -> Unwrap) at the top of the list. -->
                        <Button x:Name="DeleteButton" Style="{StaticResource ToolButtonStyle}" Margin="0,8,0,0" Padding="6,4"
                                Click="DeleteButton_Click"
                                ToolTip="Object Mode: deletes the selected node. Edit Mode: deletes the selected vertices/edges/faces.">
                            <TextBlock Text="Delete" TextAlignment="Left" TextTrimming="CharacterEllipsis" />
                        </Button>

                        <!-- ==== Weight Paint mode's own bone/brush-mode selectors; Radius/
                             Strength now live in the Properties panel's own "[TOOL]" tab ==== -->
                        <StackPanel x:Name="WeightPaintToolbar" Style="{StaticResource WeightPaintToolStyle}">
                            <!-- ActiveBoneComboBox lists the currently-painted mesh's own
                                 SkinBinding.Bones (see MainWindow.xaml.cs's own
                                 RefreshActiveBoneCombo); "Add"/"Subtract" pick whether the
                                 brush paints toward full weight or erases toward none (see
                                 Core.Skinning.WeightPaintBrush.Apply's own TargetWeight
                                 remarks). -->
                            <ComboBox x:Name="ActiveBoneComboBox" Margin="0,0,0,6"
                                      SelectionChanged="ActiveBoneComboBox_SelectionChanged" ToolTip="Active Bone" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <RadioButton x:Name="BrushAddButton" Content="Ad" GroupName="WeightBrushMode"
                                             IsChecked="True" Style="{StaticResource GizmoModeButtonStyle}"
                                             Margin="0,0,1,0" Padding="4,2" Checked="BrushModeButton_Checked" Tag="Add"
                                             ToolTip="Add" />
                                <RadioButton x:Name="BrushSubtractButton" Content="Sb" GroupName="WeightBrushMode"
                                             Style="{StaticResource GizmoModeButtonStyle}"
                                             Padding="4,2" Checked="BrushModeButton_Checked" Tag="Subtract"
                                             ToolTip="Subtract" />
                            </StackPanel>
                        </StackPanel>

                        <!-- ==== Vertex Paint mode: no selector controls of its own (only a
                             color/radius/strength brush) - now entirely in "[TOOL]" tab; kept
                             as an empty mode-gated placeholder so ModeComboBox's own Vertex
                             Paint entry still has a (currently empty) toolbar section, matching
                             every other mode. ==== -->
                        <StackPanel x:Name="VertexPaintToolbar" Style="{StaticResource VertexPaintToolStyle}" />

                        <!-- ==== Sculpt mode's own brush-algorithm selector; Radius/Strength
                             now live in the Properties panel's own "[TOOL]" tab ==== -->
                        <StackPanel x:Name="SculptToolbar" Style="{StaticResource SculptToolStyle}">
                            <!-- Draw/Smooth/Grab pick which of Core.Sculpting.SculptBrush's
                                 own 3 algorithms the brush applies (see SculptSession.Mode);
                                 Invert (Shift) only affects Draw - see SculptSession.Invert's
                                 own remarks. -->
                            <StackPanel>
                                <RadioButton x:Name="SculptDrawButton" Content="Dr" GroupName="SculptBrushMode"
                                             IsChecked="True" Style="{StaticResource GizmoModeButtonStyle}"
                                             Margin="0,0,0,2" Padding="4,2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                             Checked="SculptBrushModeButton_Checked" Tag="Draw" ToolTip="Draw" />
                                <RadioButton x:Name="SculptSmoothButton" Content="Sm" GroupName="SculptBrushMode"
                                             Style="{StaticResource GizmoModeButtonStyle}"
                                             Margin="0,0,0,2" Padding="4,2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                             Checked="SculptBrushModeButton_Checked" Tag="Smooth" ToolTip="Smooth" />
                                <RadioButton x:Name="SculptGrabButton" Content="Gr" GroupName="SculptBrushMode"
                                             Style="{StaticResource GizmoModeButtonStyle}"
                                             Padding="4,2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                             Checked="SculptBrushModeButton_Checked" Tag="Grab" ToolTip="Grab" />
                            </StackPanel>
                        </StackPanel>

                        <!-- ==== Texture Paint mode: no selector controls of its own (only a
                             color/radius/strength brush) - now entirely in "[TOOL]" tab; kept
                             as an empty mode-gated placeholder, same as Vertex Paint above. ==== -->
                        <StackPanel x:Name="TexturePaintToolbar" Style="{StaticResource TexturePaintToolStyle}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Left Toolbar's own resize handle - drag to widen Column 0 for full tool
                 names, or push it back down toward its own MinWidth="45" for the compact
                 icon-only look. An explicit dark BorderBrush fill (matching every other
                 GridSplitter/divider in this app) rather than Transparent - Transparent
                 let whatever sits behind it show through, which rendered as a stark white
                 seam rather than the invisible-but-still-draggable strip it was meant to
                 be; a subtle, definitely-dark line is both correct and, as a bonus, a more
                 discoverable drag affordance. -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}" />

            <!-- ================= 3D Viewport ================= -->
            <!-- MouseLeftButtonDown bubbles here only from a click the gizmo's own
                 manipulator handles didn't already handle themselves (dragging a handle
                 marks its own mouse-down Handled) - see MainWindow.xaml.cs's own remarks
                 on Viewport_MouseLeftButtonDown for why that's what makes "click a handle
                 to drag it" and "click empty space/another mesh to select" never conflict. -->
            <h:HelixViewport3D x:Name="Viewport" Grid.Column="2"
                               ShowCoordinateSystem="True"
                               MouseLeftButtonDown="Viewport_MouseLeftButtonDown"
                               MouseMove="Viewport_MouseMove"
                               MouseLeftButtonUp="Viewport_MouseLeftButtonUp" />

            <!-- Bloom - see MainWindow.xaml.cs's own BloomCheckBox_Changed remarks on
                 why a blurred VisualBrush re-paint of the SAME viewport, layered on top
                 at low opacity, is what "Bloom" means in a pipeline with no programmable
                 pixel shader (and therefore no real bright-pass threshold filter) at
                 all. IsHitTestVisible="False" so it never steals a click meant for the
                 real viewport underneath it (Viewport_MouseLeftButtonDown, a gizmo drag,
                 ...) - purely a visual overlay, Collapsed (off) by default. -->
            <Rectangle x:Name="BloomOverlayRectangle" Grid.Column="2" IsHitTestVisible="False"
                       Visibility="Collapsed" Opacity="0.35">
                <Rectangle.Fill>
                    <VisualBrush Visual="{Binding ElementName=Viewport}" Stretch="None" />
                </Rectangle.Fill>
                <Rectangle.Effect>
                    <BlurEffect x:Name="BloomBlurEffect" Radius="14" />
                </Rectangle.Effect>
            </Rectangle>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" />

            <!-- ================= Right Panel: Scene Outliner (top) + Properties (bottom) ================= -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" MinHeight="80" />  <!-- Row 0: Scene Outliner -->
                    <RowDefinition Height="Auto" />               <!-- horizontal splitter, Row 0 | Row 1 -->
                    <RowDefinition Height="2*" MinHeight="120" /> <!-- Row 1: Properties -->
                </Grid.RowDefinitions>

                <!-- ================= Scene Outliner ================= -->
                <Border Grid.Row="0" Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="SCENE OUTLINER" Style="{StaticResource PanelHeaderStyle}" />

                        <!-- Drag-and-drop reparenting: dragging an item onto another node
                             re-parents it (Core.Scene.Scene3D.Reparent, which recomputes the
                             node's own Local Position/Rotation/Scale so its WORLD transform
                             never visibly jumps); dropping into the TreeView's own empty
                             background (see SceneTreeView_Drop) un-parents it to the scene
                             root instead. See MainWindow.xaml.cs's own
                             SceneTreeViewItem_PreviewMouseMove/_DragOver/_Drop. -->
                        <TreeView x:Name="SceneTreeView" ItemsSource="{Binding RootNodes}"
                                  Background="Transparent" AllowDrop="True"
                                  SelectedItemChanged="SceneTreeView_SelectedItemChanged"
                                  Drop="SceneTreeView_Drop">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                    <Setter Property="AllowDrop" Value="True" />
                                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="SceneTreeViewItem_PreviewMouseLeftButtonDown" />
                                    <EventSetter Event="PreviewMouseMove" Handler="SceneTreeViewItem_PreviewMouseMove" />
                                    <EventSetter Event="DragOver" Handler="SceneTreeViewItem_DragOver" />
                                    <EventSetter Event="Drop" Handler="SceneTreeViewItem_Drop" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate DataType="{x:Type vm:NodeViewModel}" ItemsSource="{Binding Children}">
                                    <TextBlock Text="{Binding Name}" FontSize="12" />
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center" />

            <!-- ================= Properties Inspector ================= -->
            <!-- Refactored into a Blender-style vertical TabControl (TabStripPlacement="Left",
                 PropertiesTabControlStyle/PropertiesTabItemStyle above) - [OBJ]/[MOD]/[MAT]/
                 [DATA]/[TOOL] placeholders for future icons, per the task's own explicit
                 mapping. Every relocated control below keeps its exact original Binding/
                 x:Name/event-handler wiring; only its container changed, so no DataContext
                 binding was broken by this split - each tab's own root StackPanel simply
                 re-declares "DataContext={Binding SelectedNode}" the way the single original
                 StackPanel already did. -->
            <Border Grid.Row="2" Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="PROPERTIES" Style="{StaticResource PanelHeaderStyle}" />

                    <TextBlock DockPanel.Dock="Top" Text="No object selected" Margin="8"
                               TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                               Visibility="{Binding SelectedNode, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}" />

                    <TabControl Style="{StaticResource PropertiesTabControlStyle}" TabStripPlacement="Left"
                                Visibility="{Binding SelectedNode, Converter={StaticResource NullToVisibility}}">

                        <!-- ================= [OBJ]: Transform + this node's own type-specific data ================= -->
                        <TabItem Header="[OBJ]" Style="{StaticResource PropertiesTabItemStyle}" ToolTip="Object">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel DataContext="{Binding SelectedNode}" Margin="0,0,0,12">

                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="8,4,8,10" TextTrimming="CharacterEllipsis" />

                                    <!-- Position -->
                                    <TextBlock Text="Position" Style="{StaticResource PanelHeaderStyle}" Margin="8,0,8,2" />
                                    <StackPanel Orientation="Horizontal" Margin="8,0">
                                        <TextBlock Text="X" Style="{StaticResource InspectorFieldLabelStyle}" />
                                        <TextBox Text="{Binding PositionX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InspectorFieldTextBoxStyle}" />
                                        <TextBlock Text="Y" Style="{StaticResource InspectorFieldLabelStyle}" />
                                        <TextBox Text="{Binding PositionY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InspectorFieldTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="8,0,8,8">
                                        <TextBlock Text="Z" Style="{StaticResource InspectorFieldLabelStyle}" />
                                        <TextBox Text="{Binding PositionZ, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InspectorFieldTextBoxStyle}" />
                                    </StackPanel>

                                    <!-- Rotation -->
                                    <TextBlock Text="Rotation (degrees)" Style="{StaticResource PanelHeaderStyle}" Margin="8,0,8,2" />
                                    <StackPanel Orientation="Horizontal" Margin="8,0">
                                        <TextBlock Text="X" Style="{StaticResource InspectorFieldLabelStyle}" />
                                        <TextBox Text="{Binding RotationX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InspectorFieldTextBoxStyle}" />
                                        <TextBlock Text="Y" Style="{StaticResource InspectorFieldLabelStyle}" />
                                        <TextBox Text="{Binding RotationY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InspectorFieldTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="8,0,8,8">
                                        <TextBlock Text="Z" Style="{StaticResource InspectorFieldLabelStyle}" />
                                        <TextBox Text="{Binding RotationZ, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InspectorFieldTextBoxStyle}" />
                                    </StackPanel>

                                    <!-- Scale -->
                                    <TextBlock Text="Scale" Style="{StaticResource PanelHeaderStyle}" Margin="8,0,8,2" />
                                    <StackPanel Orientation="Horizontal" Margin="8,0">
                                        <TextBlock Text="X" Style="{StaticResource InspectorFieldLabelStyle}" />
                                        <TextBox Text="{Binding ScaleX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InspectorFieldTextBoxStyle}" />
                                        <TextBlock Text="Y" Style="{StaticResource InspectorFieldLabelStyle}" />
                                        <TextBox Text="{Binding ScaleY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InspectorFieldTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="8,0,8,8">
                                        <TextBlock Text="Z" Style="{StaticResource InspectorFieldLabelStyle}" />
                                        <TextBox Text="{Binding ScaleZ, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InspectorFieldTextBoxStyle}" />
                                    </StackPanel>

                                    <!-- Shading - immediate, destructive authoring choices (the
                                         same "Blender itself treats these as instant mesh
                                         edits, not a modifier" precedent Core.Geometry.Mesh's
                                         own ShadeSmooth/ShadeFlat remarks give); "Auto Smooth"
                                         lives in the non-destructive Modifiers stack ([MOD] tab)
                                         instead (Add Edge Split), since its own angle
                                         threshold is meant to be tuned interactively. -->
                                    <StackPanel Visibility="{Binding HasMesh, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="SHADING" Style="{StaticResource PanelHeaderStyle}" Margin="8,4,8,2" />
                                        <WrapPanel Margin="8,0,8,8">
                                            <Button Content="Shade Smooth" Margin="0,0,4,4" Padding="8,2" Click="ShadeSmoothButton_Click" />
                                            <Button Content="Shade Flat" Margin="0,0,4,4" Padding="8,2" Click="ShadeFlatButton_Click" />
                                        </WrapPanel>
                                    </StackPanel>

                                    <!-- Constraints - a non-destructive, evaluated-every-render
                                         pipeline overriding this node's own rotation (see
                                         Core.Constraints.Constraint); shown for EVERY node (not
                                         gated on HasMesh like Modifiers), since a Track To
                                         constraint's own most common use is a camera/light,
                                         neither of which has a Mesh. -->
                                    <StackPanel>
                                        <TextBlock Text="CONSTRAINTS" Style="{StaticResource PanelHeaderStyle}" Margin="8,4,8,2" />
                                        <StackPanel Orientation="Horizontal" Margin="8,0,8,4">
                                            <Button Content="Add Track To" Padding="8,2" Click="AddTrackToConstraintButton_Click" />
                                        </StackPanel>

                                        <ItemsControl ItemsSource="{Binding Constraints}" Margin="8,0,8,8">
                                            <ItemsControl.Resources>
                                                <!-- Aims this node's own ForwardAxis at Target's
                                                     current world position every render (see
                                                     Core.Constraints.TrackToConstraint's own
                                                     remarks) - the Target combo box lists every
                                                     OTHER node in the scene, showing each one's
                                                     own Name. -->
                                                <DataTemplate DataType="{x:Type vm:TrackToConstraintViewModel}">
                                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,4" Padding="6">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                          ToolTip="Enable/disable this constraint without removing it" />
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                <Button Content="Remove" Margin="12,0,0,0" Padding="6,0" Click="RemoveConstraintButton_Click" />
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                <TextBlock Text="Target:" VerticalAlignment="Center" Margin="0,0,6,0"
                                                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                                <ComboBox ItemsSource="{Binding AvailableTargets}" SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                                                                          DisplayMemberPath="Name" Width="120" />
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                <TextBlock Text="Forward Axis:" VerticalAlignment="Center" Margin="0,0,6,0"
                                                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                                <ComboBox SelectedValue="{Binding ForwardAxis, Mode=TwoWay}" SelectedValuePath="Content" Width="90">
                                                                    <ComboBoxItem Content="PlusX" />
                                                                    <ComboBoxItem Content="MinusX" />
                                                                    <ComboBoxItem Content="PlusY" />
                                                                    <ComboBoxItem Content="MinusY" />
                                                                    <ComboBoxItem Content="PlusZ" />
                                                                    <ComboBoxItem Content="MinusZ" />
                                                                </ComboBox>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.Resources>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Camera Inspector - hidden entirely for a non-camera node.
                                         Position/Rotation/Scale above already drive where this
                                         camera looks (see Node.GetWorldForward's own remarks) -
                                         this section is only the CameraData-specific fields
                                         (projection/FOV/near-far) plus which camera is active. -->
                                    <StackPanel Visibility="{Binding HasCamera, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="CAMERA" Style="{StaticResource PanelHeaderStyle}" Margin="8,4,8,2" />
                                        <StackPanel Orientation="Horizontal" Margin="8,0,8,4">
                                            <TextBlock Text="Projection:" VerticalAlignment="Center" Margin="0,0,6,0"
                                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <ComboBox SelectedValue="{Binding CameraProjectionMode, Mode=TwoWay}" SelectedValuePath="Content" Width="110">
                                                <ComboBoxItem Content="Perspective" />
                                                <ComboBoxItem Content="Orthographic" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="8,0,8,4"
                                                    Visibility="{Binding IsPerspectiveCamera, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Field of View" Style="{StaticResource InspectorFieldLabelStyle}" />
                                            <TextBox Text="{Binding CameraFieldOfView, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InspectorFieldTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="8,0,8,4"
                                                    Visibility="{Binding IsOrthographicCamera, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Width" Style="{StaticResource InspectorFieldLabelStyle}" />
                                            <TextBox Text="{Binding CameraOrthographicWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InspectorFieldTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="8,0">
                                            <TextBlock Text="Near" Style="{StaticResource InspectorFieldLabelStyle}" />
                                            <TextBox Text="{Binding CameraNearPlaneDistance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InspectorFieldTextBoxStyle}" />
                                            <TextBlock Text="Far" Style="{StaticResource InspectorFieldLabelStyle}" />
                                            <TextBox Text="{Binding CameraFarPlaneDistance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InspectorFieldTextBoxStyle}" />
                                        </StackPanel>
                                        <!-- Sets Scene3D.ActiveCamera to THIS node - Engine.Camera.SceneCameraSync
                                             then pushes its world transform onto the viewport's
                                             actual rendering camera on the very next render. -->
                                        <Button Content="Set as Active Camera" Margin="8,4,8,8" Padding="8,4"
                                                HorizontalAlignment="Left" Click="SetActiveCameraButton_Click" />
                                    </StackPanel>

                                    <!-- Light Inspector - hidden entirely for a non-light node. -->
                                    <StackPanel Visibility="{Binding HasLight, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="LIGHT" Style="{StaticResource PanelHeaderStyle}" Margin="8,4,8,2" />
                                        <StackPanel Orientation="Horizontal" Margin="8,0,8,4">
                                            <TextBlock Text="Type:" VerticalAlignment="Center" Margin="0,0,6,0"
                                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <ComboBox SelectedValue="{Binding LightType, Mode=TwoWay}" SelectedValuePath="Content" Width="110">
                                                <ComboBoxItem Content="Directional" />
                                                <ComboBoxItem Content="Point" />
                                                <ComboBoxItem Content="Spot" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="8,0,8,4">
                                            <TextBlock Text="Color" Style="{StaticResource InspectorFieldLabelStyle}" />
                                            <TextBox Text="{Binding LightColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InspectorFieldTextBoxStyle}" />
                                            <TextBlock Text="Intensity" Style="{StaticResource InspectorFieldLabelStyle}" />
                                            <TextBox Text="{Binding LightIntensity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InspectorFieldTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="8,0,8,4"
                                                    Visibility="{Binding IsPointOrSpotLight, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Range" Style="{StaticResource InspectorFieldLabelStyle}" />
                                            <TextBox Text="{Binding LightRange, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InspectorFieldTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="8,0,8,8"
                                                    Visibility="{Binding IsSpotLight, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Spot Angle" Style="{StaticResource InspectorFieldLabelStyle}" />
                                            <TextBox Text="{Binding LightSpotAngle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InspectorFieldTextBoxStyle}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Curve Inspector - hidden entirely for a non-curve node.
                                         Every field here edits CurveData directly and
                                         regenerates Node.Mesh (the tube/cable) immediately -
                                         see NodeViewModel.RegenerateCurveMesh's own remarks. -->
                                    <StackPanel Visibility="{Binding HasCurve, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="CURVE" Style="{StaticResource PanelHeaderStyle}" Margin="8,4,8,2" />
                                        <StackPanel Orientation="Horizontal" Margin="8,0,8,4">
                                            <TextBlock Text="Bevel Depth" Style="{StaticResource InspectorFieldLabelStyle}" />
                                            <TextBox Text="{Binding CurveBevelDepth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InspectorFieldTextBoxStyle}" />
                                            <CheckBox Content="Closed" IsChecked="{Binding CurveClosed, Mode=TwoWay}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="8,0,8,4">
                                            <TextBlock Text="Segments/Span" Style="{StaticResource InspectorFieldLabelStyle}" />
                                            <TextBox Text="{Binding CurveSegmentsPerSpan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InspectorFieldTextBoxStyle}" />
                                            <TextBlock Text="Radial Segments" Style="{StaticResource InspectorFieldLabelStyle}" />
                                            <TextBox Text="{Binding CurveRadialSegments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InspectorFieldTextBoxStyle}" />
                                        </StackPanel>

                                        <TextBlock Text="Control Points" Margin="8,4,8,2" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <ItemsControl ItemsSource="{Binding CurvePoints}" Margin="8,0,8,4">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,4" Padding="6">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="Point" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                <Button Content="Remove" Margin="12,0,0,0" Padding="6,0" Click="RemoveCurvePointButton_Click" />
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                <TextBlock Text="Position:" VerticalAlignment="Center" Margin="0,0,6,0"
                                                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Width="70" />
                                                                <TextBox Text="{Binding PositionX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="45" Margin="0,0,2,0" />
                                                                <TextBox Text="{Binding PositionY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="45" Margin="0,0,2,0" />
                                                                <TextBox Text="{Binding PositionZ, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="45" />
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                <TextBlock Text="Handle In:" VerticalAlignment="Center" Margin="0,0,6,0"
                                                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Width="70" />
                                                                <TextBox Text="{Binding HandleInX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="45" Margin="0,0,2,0" />
                                                                <TextBox Text="{Binding HandleInY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="45" Margin="0,0,2,0" />
                                                                <TextBox Text="{Binding HandleInZ, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="45" />
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                <TextBlock Text="Handle Out:" VerticalAlignment="Center" Margin="0,0,6,0"
                                                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Width="70" />
                                                                <TextBox Text="{Binding HandleOutX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="45" Margin="0,0,2,0" />
                                                                <TextBox Text="{Binding HandleOutY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="45" Margin="0,0,2,0" />
                                                                <TextBox Text="{Binding HandleOutZ, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="45" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Content="Add Point" Margin="8,0,8,8" Padding="8,4"
                                                HorizontalAlignment="Left" Click="AddCurvePointButton_Click" />
                                    </StackPanel>

                                    <!-- Bone Inspector - hidden entirely for a non-bone node.
                                         Head/Tail edits regenerate the bone's own small
                                         octahedron shape immediately (see
                                         NodeViewModel.RegenerateBoneMesh's own remarks); "Set
                                         Rest Pose" bakes the bone's CURRENT world transform in
                                         as its own new skinning baseline (see
                                         Core.Scene.BoneData.CaptureRestPose). Rotating the bone
                                         itself uses the SAME Object Mode Transform Gizmo every
                                         other node already uses - a bone is just a Node with
                                         BoneData attached, nothing gizmo-specific needed. -->
                                    <StackPanel Visibility="{Binding HasBone, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="BONE" Style="{StaticResource PanelHeaderStyle}" Margin="8,4,8,2" />
                                        <StackPanel Orientation="Horizontal" Margin="8,0,8,2">
                                            <TextBlock Text="Head:" VerticalAlignment="Center" Margin="0,0,6,0"
                                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Width="40" />
                                            <TextBox Text="{Binding BoneHeadX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="45" Margin="0,0,2,0" />
                                            <TextBox Text="{Binding BoneHeadY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="45" Margin="0,0,2,0" />
                                            <TextBox Text="{Binding BoneHeadZ, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="45" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="8,0,8,4">
                                            <TextBlock Text="Tail:" VerticalAlignment="Center" Margin="0,0,6,0"
                                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Width="40" />
                                            <TextBox Text="{Binding BoneTailX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="45" Margin="0,0,2,0" />
                                            <TextBox Text="{Binding BoneTailY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="45" Margin="0,0,2,0" />
                                            <TextBox Text="{Binding BoneTailZ, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="45" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="8,0,8,8">
                                            <TextBlock Text="Length:" VerticalAlignment="Center" Margin="0,0,6,0"
                                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding BoneLength, StringFormat={}{0:F3}}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <Button Content="Set Rest Pose" Padding="8,2" Click="SetBoneRestPoseButton_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ================= [MOD]: Modifier stack ================= -->
                        <TabItem Header="[MOD]" Style="{StaticResource PropertiesTabItemStyle}" ToolTip="Modifiers">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel DataContext="{Binding SelectedNode}" Margin="0,0,0,12">
                                    <!-- Modifiers - a non-destructive stack evaluated at render
                                         time only (see Core.Modifiers.ModifierStack); hidden
                                         entirely for a mesh-less node, which no modifier would
                                         ever have anything to evaluate against. -->
                                    <StackPanel Visibility="{Binding HasMesh, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="MODIFIERS" Style="{StaticResource PanelHeaderStyle}" Margin="8,4,8,2" />
                                        <!-- WrapPanel (not a horizontal StackPanel) so these 6 "Add"
                                             buttons flow onto additional lines instead of overflowing
                                             off-screen when the right panel is narrow. -->
                                        <WrapPanel Margin="8,0,8,4">
                                            <Button Content="Add Mirror" Margin="0,0,4,4" Padding="8,2" Click="AddMirrorModifierButton_Click" />
                                            <Button Content="Add Subsurf" Margin="0,0,4,4" Padding="8,2" Click="AddSubsurfModifierButton_Click" />
                                            <Button Content="Add Boolean" Margin="0,0,4,4" Padding="8,2" Click="AddBooleanModifierButton_Click" />
                                            <Button Content="Add Array" Margin="0,0,4,4" Padding="8,2" Click="AddArrayModifierButton_Click" />
                                            <Button Content="Add Solidify" Margin="0,0,4,4" Padding="8,2" Click="AddSolidifyModifierButton_Click" />
                                            <Button Content="Add Edge Split" Margin="0,0,4,4" Padding="8,2" Click="AddEdgeSplitModifierButton_Click" />
                                        </WrapPanel>

                                        <ItemsControl ItemsSource="{Binding Modifiers}" Margin="8,0,8,8">
                                    <ItemsControl.Resources>
                                        <DataTemplate DataType="{x:Type vm:MirrorModifierViewModel}">
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,4" Padding="6">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                  ToolTip="Enable/disable this modifier without removing it" />
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <Button Content="Remove" Margin="12,0,0,0" Padding="6,0" Click="RemoveModifierButton_Click" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Text="Axis:" VerticalAlignment="Center" Margin="0,0,6,0"
                                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                        <ComboBox SelectedValue="{Binding Axis, Mode=TwoWay}" SelectedValuePath="Content" Width="60">
                                                            <ComboBoxItem Content="X" />
                                                            <ComboBoxItem Content="Y" />
                                                            <ComboBoxItem Content="Z" />
                                                        </ComboBox>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                        <DataTemplate DataType="{x:Type vm:SubdivisionSurfaceModifierViewModel}">
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,4" Padding="6">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                  ToolTip="Enable/disable this modifier without removing it" />
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <Button Content="Remove" Margin="12,0,0,0" Padding="6,0" Click="RemoveModifierButton_Click" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Text="Iterations:" VerticalAlignment="Center" Margin="0,0,6,0"
                                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                        <TextBox Text="{Binding Iterations, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="40" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                        <!-- Union/Difference/Intersection against another
                                             scene object (see Core.Modifiers.BooleanModifier) -
                                             the Target combo box lists every OTHER mesh-bearing
                                             node (BooleanModifierViewModel.AvailableTargets),
                                             showing each one's own Name. -->
                                        <DataTemplate DataType="{x:Type vm:BooleanModifierViewModel}">
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,4" Padding="6">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                  ToolTip="Enable/disable this modifier without removing it" />
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <Button Content="Remove" Margin="12,0,0,0" Padding="6,0" Click="RemoveModifierButton_Click" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Text="Operation:" VerticalAlignment="Center" Margin="0,0,6,0"
                                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                        <ComboBox SelectedValue="{Binding Operation, Mode=TwoWay}" SelectedValuePath="Content" Width="90">
                                                            <ComboBoxItem Content="Union" />
                                                            <ComboBoxItem Content="Difference" />
                                                            <ComboBoxItem Content="Intersection" />
                                                        </ComboBox>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Text="Target:" VerticalAlignment="Center" Margin="0,0,6,0"
                                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                        <ComboBox ItemsSource="{Binding AvailableTargets}" SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                                                                  DisplayMemberPath="Name" Width="120" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                        <!-- Replicates the mesh Count times, each successive
                                             copy offset further along a cumulative translation
                                             (RelativeOffset as a fraction of the mesh's own
                                             bounding-box size per axis - see Core.Modifiers.ArrayModifier's
                                             own remarks). -->
                                        <DataTemplate DataType="{x:Type vm:ArrayModifierViewModel}">
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,4" Padding="6">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                  ToolTip="Enable/disable this modifier without removing it" />
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <Button Content="Remove" Margin="12,0,0,0" Padding="6,0" Click="RemoveModifierButton_Click" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Text="Count:" VerticalAlignment="Center" Margin="0,0,6,0"
                                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                        <TextBox Text="{Binding Count, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="40" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Text="Relative Offset X/Y/Z:" VerticalAlignment="Center" Margin="0,0,6,0"
                                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                        <TextBox Text="{Binding RelativeOffsetX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="40" Margin="0,0,2,0" />
                                                        <TextBox Text="{Binding RelativeOffsetY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="40" Margin="0,0,2,0" />
                                                        <TextBox Text="{Binding RelativeOffsetZ, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="40" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                        <!-- Extrudes the mesh's faces along their own vertex
                                             normals by Thickness, closing every boundary edge
                                             with a new side wall - see Core.Modifiers.SolidifyModifier's
                                             own remarks (including its known hard-edge limitation). -->
                                        <DataTemplate DataType="{x:Type vm:SolidifyModifierViewModel}">
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,4" Padding="6">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                  ToolTip="Enable/disable this modifier without removing it" />
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <Button Content="Remove" Margin="12,0,0,0" Padding="6,0" Click="RemoveModifierButton_Click" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Text="Thickness:" VerticalAlignment="Center" Margin="0,0,6,0"
                                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                        <TextBox Text="{Binding Thickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="40" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                        <!-- "Auto Smooth" - see Core.Modifiers.EdgeSplitModifier's
                                             own remarks on why this, not Shade Smooth/Flat
                                             above, is the one shading choice that belongs in
                                             the non-destructive stack. -->
                                        <DataTemplate DataType="{x:Type vm:EdgeSplitModifierViewModel}">
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,4" Padding="6">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                  ToolTip="Enable/disable this modifier without removing it" />
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <Button Content="Remove" Margin="12,0,0,0" Padding="6,0" Click="RemoveModifierButton_Click" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Text="Angle Threshold:" VerticalAlignment="Center" Margin="0,0,6,0"
                                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                        <TextBox Text="{Binding AngleThresholdDegrees, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="40" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                        </ItemsControl.Resources>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ================= [MAT]: Material Inspector ================= -->
                        <TabItem Header="[MAT]" Style="{StaticResource PropertiesTabItemStyle}" ToolTip="Material">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel DataContext="{Binding SelectedNode}" Margin="0,0,0,12">
                                    <!-- Material Inspector - hidden entirely for a mesh-less/materialless node. -->
                                    <StackPanel Visibility="{Binding HasMaterial, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="MATERIAL INSPECTOR" Style="{StaticResource PanelHeaderStyle}" Margin="8,4,8,2" />

                                        <!-- Diffuse/albedo -->
                                        <StackPanel Orientation="Horizontal" Margin="8,0,8,8">
                                            <Border Width="26" Height="26" Margin="0,0,8,0"
                                                    Background="{Binding DiffuseColor, Converter={StaticResource ColorToBrush}}"
                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                    ToolTip="Diffuse/albedo color" />
                                            <TextBox Text="{Binding DiffuseColorHex, Mode=TwoWay}"
                                                     Style="{StaticResource InspectorFieldTextBoxStyle}" Width="90"
                                                     ToolTip="Diffuse/albedo color (hex)" />
                                        </StackPanel>

                                        <!-- Roughness/Metallic - see Core.Materials.Material's own
                                             remarks for what these do and how Engine.Geometry.MaterialFactory
                                             approximates them on WPF's fixed-function pipeline. -->
                                        <StackPanel Orientation="Horizontal" Margin="8,0,8,2">
                                            <TextBlock Text="Roughness" Width="70" VerticalAlignment="Center"
                                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding Roughness, StringFormat={}{0:0.00}}" Width="36" VerticalAlignment="Center"
                                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                        <Slider Margin="8,0,8,8" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1"
                                                Value="{Binding Roughness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <StackPanel Orientation="Horizontal" Margin="8,0,8,2">
                                            <TextBlock Text="Metallic" Width="70" VerticalAlignment="Center"
                                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding Metallic, StringFormat={}{0:0.00}}" Width="36" VerticalAlignment="Center"
                                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                        <Slider Margin="8,0,8,8" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1"
                                                Value="{Binding Metallic, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <!-- Texture - either a plain exported image, or one layer of a
                                             whole .jolie project (see JolieCat3D.Service.Interop). -->
                                        <Button Content="Load Texture..." Margin="8,0,8,4" Padding="8,4"
                                                HorizontalAlignment="Left" Click="LoadTextureButton_Click" />
                                        <Button Content="Load From JolieCat Project..." Margin="8,0,8,4" Padding="8,4"
                                                HorizontalAlignment="Left" Click="LoadFromJolieProjectButton_Click" />
                                        <!-- Imports a JolieCat 2D Clipbar Animation (one frame
                                             per "Frame NNN" layer) or Sprite Sheet (one frame
                                             per grid cell) project as an animated texture
                                             sequence, driven by the playback transport below
                                             (see JolieCat3D.Service.Interop.ClipbarAnimationBridge). -->
                                        <Button Content="Load Clipbar Animation..." Margin="8,0,8,4" Padding="8,4"
                                                HorizontalAlignment="Left" Click="LoadClipbarAnimationButton_Click" />
                                        <TextBlock Text="{Binding DiffuseTextureFileName}" Margin="8,0,8,8"
                                                   TextTrimming="CharacterEllipsis" FontStyle="Italic"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Visibility="{Binding HasDiffuseTexture, Converter={StaticResource BoolToVisibility}}" />

                                        <!-- Normal map / packed metallic-roughness map - see
                                             Core.Materials.Material's own remarks on why the live
                                             viewport can only approximate these (a normal map not
                                             at all; metallic-roughness as one averaged scalar),
                                             while the exported glTF (Service.Export.GltfExporter)
                                             samples both correctly, per-pixel. -->
                                        <Button Content="Load Normal Map..." Margin="8,0,8,4" Padding="8,4"
                                                HorizontalAlignment="Left" Click="LoadNormalMapButton_Click" />
                                        <TextBlock Text="{Binding NormalTextureFileName}" Margin="8,0,8,8"
                                                   TextTrimming="CharacterEllipsis" FontStyle="Italic"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Visibility="{Binding HasNormalTexture, Converter={StaticResource BoolToVisibility}}" />

                                        <Button Content="Load Metallic/Roughness Map..." Margin="8,0,8,4" Padding="8,4"
                                                HorizontalAlignment="Left" Click="LoadMetallicRoughnessMapButton_Click" />
                                        <TextBlock Text="{Binding MetallicRoughnessTextureFileName}" Margin="8,0,8,8"
                                                   TextTrimming="CharacterEllipsis" FontStyle="Italic"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Visibility="{Binding HasMetallicRoughnessTexture, Converter={StaticResource BoolToVisibility}}" />

                                        <!-- UV Projection - (re)maps this mesh's own UVs, for a custom
                                             primitive or an Edit-Mode-reshaped mesh whose authored UVs
                                             no longer make sense (see Core.Geometry.UVProjector). -->
                                        <TextBlock Text="UV Projection" Style="{StaticResource PanelHeaderStyle}" Margin="8,4,8,2" />
                                        <WrapPanel Margin="8,0,8,8">
                                            <Button Content="Planar" Margin="0,0,4,4" Padding="8,4" Click="PlanarProjectionButton_Click" />
                                            <Button Content="Box" Margin="0,0,4,4" Padding="8,4" Click="BoxProjectionButton_Click" />
                                            <Button Content="Spherical" Margin="0,0,4,4" Padding="8,4" Click="SphericalProjectionButton_Click" />
                                        </WrapPanel>

                                        <!-- Opens JolieCat3D.UI.UVVisualizerWindow - a non-modal
                                             "leave it open while you paint in JolieCat 2D" tool
                                             window showing this mesh's own UV wireframe over its
                                             currently-loaded diffuse texture. -->
                                        <Button Content="View UV Map..." Margin="8,0,8,8" Padding="8,4"
                                                HorizontalAlignment="Left" Click="ViewUVMapButton_Click" />

                                        <!-- Multi-Material Support: one Material per slot, beyond
                                             the plain diffuse/roughness/metallic material above -
                                             see Core.Geometry.Mesh.MaterialSlots/Polygon.MaterialSlotIndex.
                                             "Assign to Selection" points whichever single fully-
                                             selected Face (Edit Mode, Face component) at this row's
                                             own slot; a face with no slot assigned at all keeps
                                             rendering with the plain material above. -->
                                        <TextBlock Text="Material Slots" Style="{StaticResource PanelHeaderStyle}" Margin="8,4,8,2" />
                                        <ItemsControl ItemsSource="{Binding MaterialSlots}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="8,0,8,4">
                                                        <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Width="90" Margin="0,0,4,0" />
                                                        <Button Content="Assign" Padding="6,2" Margin="0,0,4,0"
                                                                Click="AssignMaterialSlotButton_Click"
                                                                ToolTip="Assign the currently fully-selected face (Edit Mode, Face) to this slot" />
                                                        <Button Content="Remove" Padding="6,2" Click="RemoveMaterialSlotButton_Click" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Content="Add Slot" Margin="8,0,8,8" Padding="8,4"
                                                HorizontalAlignment="Left" Click="AddMaterialSlotButton_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ================= [DATA]: Keyframes + Armature/Vertex-group (Skinning) data ================= -->
                        <TabItem Header="[DATA]" Style="{StaticResource PropertiesTabItemStyle}" ToolTip="Object Data">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel DataContext="{Binding SelectedNode}" Margin="0,0,0,12">
                                    <!-- Records this node's CURRENT Position/Rotation/Scale as a
                                         keyframe at the timeline's own current frame (see
                                         JolieCat3D.Service.Animation.AnimationTrack.AddKeyframeFromCurrentTransform),
                                         leaving the segment AFTER it blended per whichever of
                                         these two is checked (see JolieCat3D.Service.Animation.InterpolationMode). -->
                                    <TextBlock Text="KEYFRAMES" Style="{StaticResource PanelHeaderStyle}" Margin="8,4,8,2" />
                                    <StackPanel Orientation="Horizontal" Margin="8,0,8,4">
                                        <RadioButton x:Name="LinearInterpolationButton" Content="Linear" GroupName="Interpolation"
                                                     IsChecked="True" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <RadioButton x:Name="BezierInterpolationButton" Content="Bezier" GroupName="Interpolation"
                                                     VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button Content="Add Keyframe" Margin="8,0,8,8" Padding="8,4"
                                            HorizontalAlignment="Left" Click="AddKeyframeButton_Click" />

                                    <!-- Skinning - shown for any meshed node (bound or not);
                                         picking an Armature here immediately (re-)binds via
                                         automatic nearest-bone weights (see
                                         Core.Skinning.SkinBindingFactory). Weight Paint mode's
                                         own brush controls live in the Properties panel's own
                                         "[TOOL]" tab (visible only while that mode is active),
                                         not here. -->
                                    <StackPanel Visibility="{Binding HasMesh, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="SKINNING" Style="{StaticResource PanelHeaderStyle}" Margin="8,4,8,2" />
                                        <StackPanel Orientation="Horizontal" Margin="8,0,8,4">
                                            <TextBlock Text="Armature:" VerticalAlignment="Center" Margin="0,0,6,0"
                                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <ComboBox ItemsSource="{Binding AvailableArmatures}" SelectedItem="{Binding BoundArmature, Mode=TwoWay}"
                                                      DisplayMemberPath="Name" Width="120" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="8,0,8,8" Visibility="{Binding HasSkinBinding, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Bound bones:" VerticalAlignment="Center" Margin="0,0,6,0"
                                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <ItemsControl ItemsSource="{Binding BoundBoneNames}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" Margin="0,0,6,0" FontSize="11" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ================= [TOOL]: Active Tool - the brush Radius/Strength/
                             Color settings relocated out of the (now icon-only) Left Toolbar;
                             each section below reuses the SAME CurrentEditorMode-driven Style
                             the Left Toolbar's own per-mode sections already use, so only the
                             currently active paint mode's own brush settings show here. ================= -->
                        <TabItem Header="[TOOL]" Style="{StaticResource PropertiesTabItemStyle}" ToolTip="Active Tool">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="8,8,8,12">
                                    <StackPanel Style="{StaticResource WeightPaintToolStyle}">
                                        <TextBlock Text="Weight Brush" Style="{StaticResource PanelHeaderStyle}" Margin="0,0,0,2" />
                                        <TextBlock Text="Radius" VerticalAlignment="Center" Margin="0,0,0,2"
                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <Slider x:Name="BrushRadiusSlider" Minimum="0.05" Maximum="3" Value="0.3"
                                                Margin="0,0,0,6" ValueChanged="BrushRadiusSlider_ValueChanged" />
                                        <TextBlock Text="Strength" VerticalAlignment="Center" Margin="0,0,0,2"
                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <Slider x:Name="BrushStrengthSlider" Minimum="0.05" Maximum="1" Value="0.5"
                                                ValueChanged="BrushStrengthSlider_ValueChanged" />
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource VertexPaintToolStyle}">
                                        <TextBlock Text="Vertex Paint Brush" Style="{StaticResource PanelHeaderStyle}" Margin="0,0,0,2" />
                                        <!-- A plain "#RRGGBB" hex color field, the same convention the
                                             Properties Inspector's own DiffuseColorHex/LightColorHex
                                             fields already use. -->
                                        <TextBlock Text="Color" VerticalAlignment="Center" Margin="0,0,0,2"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBox x:Name="VertexPaintColorTextBox" Text="#FF0000" Margin="0,0,0,6"
                                                 TextChanged="VertexPaintColorTextBox_TextChanged" />
                                        <TextBlock Text="Radius" VerticalAlignment="Center" Margin="0,0,0,2"
                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <Slider x:Name="VertexBrushRadiusSlider" Minimum="0.05" Maximum="3" Value="0.3"
                                                Margin="0,0,0,6" ValueChanged="VertexBrushRadiusSlider_ValueChanged" />
                                        <TextBlock Text="Strength" VerticalAlignment="Center" Margin="0,0,0,2"
                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <Slider x:Name="VertexBrushStrengthSlider" Minimum="0.05" Maximum="1" Value="0.5"
                                                ValueChanged="VertexBrushStrengthSlider_ValueChanged" />
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource SculptToolStyle}">
                                        <TextBlock Text="Sculpt Brush" Style="{StaticResource PanelHeaderStyle}" Margin="0,0,0,2" />
                                        <TextBlock Text="Radius" VerticalAlignment="Center" Margin="0,0,0,2"
                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <Slider x:Name="SculptBrushRadiusSlider" Minimum="0.05" Maximum="3" Value="0.3"
                                                Margin="0,0,0,6" ValueChanged="SculptBrushRadiusSlider_ValueChanged" />
                                        <TextBlock Text="Strength" VerticalAlignment="Center" Margin="0,0,0,2"
                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <Slider x:Name="SculptBrushStrengthSlider" Minimum="0.05" Maximum="1" Value="0.5"
                                                ValueChanged="SculptBrushStrengthSlider_ValueChanged" />
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource TexturePaintToolStyle}">
                                        <TextBlock Text="Texture Paint Brush" Style="{StaticResource PanelHeaderStyle}" Margin="0,0,0,2" />
                                        <!-- Radius here is a PIXEL distance into the material's own
                                             painted texture (see Engine.Editing.TexturePaintSession.BrushRadius's
                                             own remarks), unlike every other brush's own world-space
                                             radius - a wider Min/Max reflects that different unit. -->
                                        <TextBlock Text="Color" VerticalAlignment="Center" Margin="0,0,0,2"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBox x:Name="TexturePaintColorTextBox" Text="#FF0000" Margin="0,0,0,6"
                                                 TextChanged="TexturePaintColorTextBox_TextChanged" />
                                        <TextBlock Text="Radius" VerticalAlignment="Center" Margin="0,0,0,2"
                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <Slider x:Name="TextureBrushRadiusSlider" Minimum="2" Maximum="120" Value="20"
                                                Margin="0,0,0,6" ValueChanged="TextureBrushRadiusSlider_ValueChanged" />
                                        <TextBlock Text="Strength" VerticalAlignment="Center" Margin="0,0,0,2"
                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <Slider x:Name="TextureBrushStrengthSlider" Minimum="0.05" Maximum="1" Value="0.5"
                                                ValueChanged="TextureBrushStrengthSlider_ValueChanged" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
            </Grid>
        </Grid>

        <!-- ================= Animation Playback Transport ================= -->
        <Border Grid.Row="3" Background="{StaticResource PanelAltBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <!-- This row's own MinHeight="100" (see the outer Grid.RowDefinitions above)
                 gives this StackPanel far more vertical room than its own content needs -
                 VerticalAlignment="Center" here keeps the StackPanel itself (and every
                 child inside it, none of which set their own Height) sized to its natural
                 content height and centered in that taller row, instead of each control
                 individually stretching to fill the full 100px (which is what produced the
                 FPS TextBox - and every other control here - stretching vertically to fill
                 the whole bar). -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,6">
                <Button x:Name="PlayPauseButton" Content="Play" VerticalAlignment="Center" Padding="12,2" Margin="0,0,4,0" Click="PlayPauseButton_Click" />
                <Button Content="Stop" VerticalAlignment="Center" Padding="12,2" Margin="0,0,16,0" Click="StopButton_Click" />

                <TextBlock Text="Frame:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}" />
                <!-- The Dopesheet: DopesheetCanvas overlays FrameScrubber (same Width, so
                     a keyframe's own pixel X position always lines up with the frame it
                     represents), drawing one small diamond marker per keyframe on the
                     currently selected node's own AnimationTrack - see RefreshDopesheet's
                     own remarks. Left with a null Background (WPF only hit-tests a
                     Panel's own drawn CHILDREN, never its transparent background - see
                     RefreshDopesheet's own remarks), so an ordinary scrub click anywhere
                     that ISN'T exactly on a marker still reaches FrameScrubber underneath
                     unimpeded; only a marker itself (an actual drawn Polygon) intercepts
                     a click, for CreateKeyframeMarker's own select/drag/retime
                     handlers. -->
                <Grid Width="280" Height="Auto" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Slider x:Name="FrameScrubber" Minimum="0" VerticalAlignment="Center"
                            ValueChanged="FrameScrubber_ValueChanged" />
                    <Canvas x:Name="DopesheetCanvas" Height="10" VerticalAlignment="Bottom" />
                </Grid>
                <TextBlock x:Name="FrameLabel" Text="0 / 120" VerticalAlignment="Center" Margin="0,0,16,0"
                           Foreground="{StaticResource TextSecondaryBrush}" MinWidth="60" />

                <TextBlock Text="FPS:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBox x:Name="FpsTextBox" Width="50" VerticalAlignment="Center" Text="24" TextChanged="FpsTextBox_TextChanged" />

                <!-- Dopesheet's own "Delete" - removes whichever keyframe marker was
                     last clicked (see CreateKeyframeMarker's own MouseLeftButtonDown
                     handler); disabled with nothing currently selected. -->
                <Button x:Name="DeleteKeyframeButton" Content="Delete Key" IsEnabled="False" VerticalAlignment="Center"
                        Padding="8,2" Margin="16,0,0,0" Click="DeleteKeyframeButton_Click" />
            </StackPanel>
        </Border>

        <!-- ================= Status Bar (Live Sync) ================= -->
        <!-- The JolieCat 2D workspace bridge's own connection status - see
             MainWindow.xaml.cs's own RefreshLiveSyncStatus/JolieWorkspaceWatcher. The
             dot is ActiveIndicatorBrush (green) while a watch is running, BorderBrush
             (dim/off) otherwise - the same "gold = active" convention this window's own
             GizmoModeButtonStyle already uses, just for a status light instead of a
             toggle button. -->
        <Border Grid.Row="4" Background="{StaticResource PanelAltBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Margin="8,4">
                <Ellipse x:Name="LiveSyncIndicatorEllipse" Width="10" Height="10" Margin="0,0,6,0"
                         VerticalAlignment="Center" Fill="{StaticResource BorderBrush}" />
                <TextBlock x:Name="LiveSyncStatusText" Text="Live Sync: Off" VerticalAlignment="Center"
                           Margin="0,0,10,0" Foreground="{StaticResource TextSecondaryBrush}" />
                <Button x:Name="LiveSyncToggleButton" Content="Watch..." Padding="10,2" Click="LiveSyncToggleButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
