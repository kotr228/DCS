<Window x:Class="JolieCat3D.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JolieCat3D.UI"
        xmlns:h="clr-namespace:HelixToolkit.Wpf;assembly=HelixToolkit.Wpf"
        xmlns:vm="clr-namespace:JolieCat3D.UI.ViewModels"
        xmlns:converters="clr-namespace:JolieCat3D.UI.Converters"
        mc:Ignorable="d"
        Title="JolieCat3D" Height="700" Width="1200"
        d:DataContext="{d:DesignInstance Type=vm:SceneViewModel, IsDesignTimeCreatable=True}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
        <converters:ColorToBrushConverter x:Key="ColorToBrush" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- File menu -->
            <RowDefinition Height="Auto" /> <!-- Gizmo mode toolbar -->
            <RowDefinition Height="*" />    <!-- Outliner | Viewport | Properties -->
        </Grid.RowDefinitions>

        <!-- ================= File Menu ================= -->
        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="_New Scene" Command="ApplicationCommands.New" />
                <MenuItem Header="_Open..." Command="ApplicationCommands.Open" />
                <Separator />
                <MenuItem Header="_Save" Command="ApplicationCommands.Save" />
                <MenuItem Header="Save _As..." Command="ApplicationCommands.SaveAs" />
                <Separator />
                <MenuItem Header="_Import..." Click="ImportMenuItem_Click" InputGestureText="Ctrl+I" />
                <MenuItem Header="_Export..." Click="ExportMenuItem_Click" InputGestureText="Ctrl+E" />
                <Separator />
                <MenuItem Header="E_xit" Click="ExitMenuItem_Click" />
            </MenuItem>
        </Menu>

        <!-- ================= Gizmo Mode Toolbar ================= -->
        <Border Grid.Row="1" Background="{StaticResource PanelAltBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="8,6">
                <TextBlock Text="Transform:" VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <RadioButton x:Name="TranslateModeButton" Content="Translate" GroupName="GizmoMode"
                             IsChecked="True" Style="{StaticResource GizmoModeButtonStyle}"
                             Margin="0,0,4,0" Checked="GizmoModeButton_Checked" Tag="Translate" />
                <RadioButton x:Name="RotateModeButton" Content="Rotate" GroupName="GizmoMode"
                             Style="{StaticResource GizmoModeButtonStyle}"
                             Margin="0,0,4,0" Checked="GizmoModeButton_Checked" Tag="Rotate" />
                <RadioButton x:Name="ScaleModeButton" Content="Scale" GroupName="GizmoMode"
                             Style="{StaticResource GizmoModeButtonStyle}"
                             Checked="GizmoModeButton_Checked" Tag="Scale" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="280" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <!-- ================= Scene Outliner ================= -->
            <Border Grid.Column="0" Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="SCENE OUTLINER" Style="{StaticResource PanelHeaderStyle}" />

                    <TreeView x:Name="SceneTreeView" ItemsSource="{Binding RootNodes}"
                              Background="Transparent"
                              SelectedItemChanged="SceneTreeView_SelectedItemChanged">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type vm:NodeViewModel}" ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding Name}" FontSize="12" />
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" />

            <!-- ================= 3D Viewport ================= -->
            <!-- MouseLeftButtonDown bubbles here only from a click the gizmo's own
                 manipulator handles didn't already handle themselves (dragging a handle
                 marks its own mouse-down Handled) - see MainWindow.xaml.cs's own remarks
                 on Viewport_MouseLeftButtonDown for why that's what makes "click a handle
                 to drag it" and "click empty space/another mesh to select" never conflict. -->
            <h:HelixViewport3D x:Name="Viewport" Grid.Column="2"
                               ShowCoordinateSystem="True"
                               MouseLeftButtonDown="Viewport_MouseLeftButtonDown" />

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" />

            <!-- ================= Properties Inspector ================= -->
            <Border Grid.Column="4" Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="PROPERTIES" Style="{StaticResource PanelHeaderStyle}" />

                    <TextBlock DockPanel.Dock="Top" Text="No object selected" Margin="8"
                               TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                               Visibility="{Binding SelectedNode, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding SelectedNode, Converter={StaticResource NullToVisibility}}">
                        <StackPanel DataContext="{Binding SelectedNode}" Margin="0,0,0,12">

                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="8,4,8,10" TextTrimming="CharacterEllipsis" />

                            <!-- Position -->
                            <TextBlock Text="Position" Style="{StaticResource PanelHeaderStyle}" Margin="8,0,8,2" />
                            <StackPanel Orientation="Horizontal" Margin="8,0">
                                <TextBlock Text="X" Style="{StaticResource InspectorFieldLabelStyle}" />
                                <TextBox Text="{Binding PositionX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InspectorFieldTextBoxStyle}" />
                                <TextBlock Text="Y" Style="{StaticResource InspectorFieldLabelStyle}" />
                                <TextBox Text="{Binding PositionY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InspectorFieldTextBoxStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="8,0,8,8">
                                <TextBlock Text="Z" Style="{StaticResource InspectorFieldLabelStyle}" />
                                <TextBox Text="{Binding PositionZ, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InspectorFieldTextBoxStyle}" />
                            </StackPanel>

                            <!-- Rotation -->
                            <TextBlock Text="Rotation (degrees)" Style="{StaticResource PanelHeaderStyle}" Margin="8,0,8,2" />
                            <StackPanel Orientation="Horizontal" Margin="8,0">
                                <TextBlock Text="X" Style="{StaticResource InspectorFieldLabelStyle}" />
                                <TextBox Text="{Binding RotationX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InspectorFieldTextBoxStyle}" />
                                <TextBlock Text="Y" Style="{StaticResource InspectorFieldLabelStyle}" />
                                <TextBox Text="{Binding RotationY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InspectorFieldTextBoxStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="8,0,8,8">
                                <TextBlock Text="Z" Style="{StaticResource InspectorFieldLabelStyle}" />
                                <TextBox Text="{Binding RotationZ, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InspectorFieldTextBoxStyle}" />
                            </StackPanel>

                            <!-- Scale -->
                            <TextBlock Text="Scale" Style="{StaticResource PanelHeaderStyle}" Margin="8,0,8,2" />
                            <StackPanel Orientation="Horizontal" Margin="8,0">
                                <TextBlock Text="X" Style="{StaticResource InspectorFieldLabelStyle}" />
                                <TextBox Text="{Binding ScaleX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InspectorFieldTextBoxStyle}" />
                                <TextBlock Text="Y" Style="{StaticResource InspectorFieldLabelStyle}" />
                                <TextBox Text="{Binding ScaleY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InspectorFieldTextBoxStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="8,0,8,8">
                                <TextBlock Text="Z" Style="{StaticResource InspectorFieldLabelStyle}" />
                                <TextBox Text="{Binding ScaleZ, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InspectorFieldTextBoxStyle}" />
                            </StackPanel>

                            <!-- Material - hidden entirely for a mesh-less/materialless node. -->
                            <StackPanel Visibility="{Binding HasMaterial, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Material" Style="{StaticResource PanelHeaderStyle}" Margin="8,0,8,2" />
                                <StackPanel Orientation="Horizontal" Margin="8,0,8,8">
                                    <Border Width="26" Height="26" Margin="0,0,8,0"
                                            Background="{Binding DiffuseColor, Converter={StaticResource ColorToBrush}}"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            ToolTip="Diffuse color" />
                                    <TextBox Text="{Binding DiffuseColorHex, Mode=TwoWay}"
                                             Style="{StaticResource InspectorFieldTextBoxStyle}" Width="90"
                                             ToolTip="Diffuse color (hex)" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
