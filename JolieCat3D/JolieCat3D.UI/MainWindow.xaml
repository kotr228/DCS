<Window x:Class="JolieCat3D.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JolieCat3D.UI"
        xmlns:h="clr-namespace:HelixToolkit.Wpf;assembly=HelixToolkit.Wpf"
        xmlns:vm="clr-namespace:JolieCat3D.UI.ViewModels"
        xmlns:converters="clr-namespace:JolieCat3D.UI.Converters"
        mc:Ignorable="d"
        Title="JolieCat3D" Height="700" Width="1200"
        d:DataContext="{d:DesignInstance Type=vm:SceneViewModel, IsDesignTimeCreatable=True}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
        <converters:ColorToBrushConverter x:Key="ColorToBrush" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- File menu -->
            <RowDefinition Height="Auto" /> <!-- Gizmo mode toolbar -->
            <RowDefinition Height="Auto" /> <!-- Object/Edit mode + component toolbar -->
            <RowDefinition Height="Auto" /> <!-- Shading mode toolbar -->
            <RowDefinition Height="*" />    <!-- Outliner | Viewport | Properties -->
            <RowDefinition Height="Auto" /> <!-- Animation playback transport -->
        </Grid.RowDefinitions>

        <!-- ================= File Menu ================= -->
        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="_New Scene" Command="ApplicationCommands.New" />
                <MenuItem Header="_Open..." Command="ApplicationCommands.Open" />
                <Separator />
                <MenuItem Header="_Save" Command="ApplicationCommands.Save" />
                <MenuItem Header="Save _As..." Command="ApplicationCommands.SaveAs" />
                <Separator />
                <MenuItem Header="_Import..." Click="ImportMenuItem_Click" InputGestureText="Ctrl+I" />
                <MenuItem Header="_Export..." Click="ExportMenuItem_Click" InputGestureText="Ctrl+E" />
                <Separator />
                <!-- Saves the whole AnimationTimeline (every node's transform keyframes,
                     every material's texture-frame track) out to a file - two flavors
                     picked by which of the SaveFileDialog's own filter entries is
                     chosen: JolieCat3D's own native, full-fidelity interchange JSON, or
                     a JolieCat-2D-compatible "TimelineTracks" JSON fragment (keyframe
                     TIMES only - see JolieAnimationExporter's own remarks). -->
                <MenuItem Header="Export _Animation..." Click="ExportAnimationMenuItem_Click" />
                <!-- Bakes the current AnimationTimeline out to a numbered PNG sequence -
                     one High-res HelixToolkit.Wpf.Viewport3DHelper.SaveBitmap capture per
                     frame (see ViewportCaptureService's own remarks). -->
                <MenuItem Header="_Render Animation Frames..." Click="RenderAnimationFramesMenuItem_Click" />
                <Separator />
                <!-- Starts JolieCat3D.Service.Interop.JolieWorkspaceWatcher on a chosen
                     folder - any .jolie project or exported image later created/changed
                     there automatically refreshes whichever node(s) last loaded a
                     texture from it (see MainWindow.xaml.cs's own remarks on
                     _textureSources/HandleWorkspaceAssetChanged). -->
                <MenuItem Header="_Watch JolieCat Workspace..." Click="WatchWorkspaceMenuItem_Click" />
                <Separator />
                <MenuItem Header="E_xit" Click="ExitMenuItem_Click" />
            </MenuItem>
            <!-- Plain, unstyled functional entries (this whole UI is a temporary test
                 layout) - ApplicationCommands.Undo/Redo already carry their own default
                 Ctrl+Z/Ctrl+Y gestures and InputGestureText, wired to
                 MainWindow's own CommandHistory in its constructor. -->
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Command="ApplicationCommands.Undo" />
                <MenuItem Header="_Redo" Command="ApplicationCommands.Redo" />
            </MenuItem>
            <!-- Scene composition entities (Core.Scene.CameraData/LightData) - added as
                 a new ROOT node with default settings, selectable/editable afterward
                 exactly like a meshed node (Position/Rotation/Scale, the Outliner, the
                 Camera/Light Inspector sections above). -->
            <MenuItem Header="_Scene">
                <MenuItem Header="Add _Camera" Click="AddCameraMenuItem_Click" />
                <MenuItem Header="Add _Light" Click="AddLightMenuItem_Click" />
            </MenuItem>
        </Menu>

        <!-- ================= Gizmo Mode Toolbar ================= -->
        <Border Grid.Row="1" Background="{StaticResource PanelAltBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="8,6">
                <TextBlock Text="Transform:" VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <RadioButton x:Name="TranslateModeButton" Content="Translate" GroupName="GizmoMode"
                             IsChecked="True" Style="{StaticResource GizmoModeButtonStyle}"
                             Margin="0,0,4,0" Checked="GizmoModeButton_Checked" Tag="Translate" />
                <RadioButton x:Name="RotateModeButton" Content="Rotate" GroupName="GizmoMode"
                             Style="{StaticResource GizmoModeButtonStyle}"
                             Margin="0,0,4,0" Checked="GizmoModeButton_Checked" Tag="Rotate" />
                <RadioButton x:Name="ScaleModeButton" Content="Scale" GroupName="GizmoMode"
                             Style="{StaticResource GizmoModeButtonStyle}"
                             Checked="GizmoModeButton_Checked" Tag="Scale" />
            </StackPanel>
        </Border>

        <!-- ================= Object/Edit Mode + Component Toolbar ================= -->
        <Border Grid.Row="2" Background="{StaticResource PanelAltBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="8,6">
                <TextBlock Text="Mode:" VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <RadioButton x:Name="ObjectModeButton" Content="Object" GroupName="EditorMode"
                             IsChecked="True" Style="{StaticResource GizmoModeButtonStyle}"
                             Margin="0,0,4,0" Checked="EditorModeButton_Checked" Tag="Object" />
                <RadioButton x:Name="EditModeButton" Content="Edit" GroupName="EditorMode"
                             Style="{StaticResource GizmoModeButtonStyle}"
                             Margin="0,0,20,0" Checked="EditorModeButton_Checked" Tag="Edit" />

                <TextBlock Text="Component:" VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <RadioButton x:Name="VertexModeButton" Content="Vertex" GroupName="ComponentMode"
                             IsChecked="True" IsEnabled="False" Style="{StaticResource GizmoModeButtonStyle}"
                             Margin="0,0,4,0" Checked="ComponentModeButton_Checked" Tag="Vertex" />
                <RadioButton x:Name="EdgeModeButton" Content="Edge" GroupName="ComponentMode"
                             IsEnabled="False" Style="{StaticResource GizmoModeButtonStyle}"
                             Margin="0,0,4,0" Checked="ComponentModeButton_Checked" Tag="Edge" />
                <RadioButton x:Name="FaceModeButton" Content="Face" GroupName="ComponentMode"
                             IsEnabled="False" Style="{StaticResource GizmoModeButtonStyle}"
                             Checked="ComponentModeButton_Checked" Tag="Face" />

                <!-- Extrude needs a single fully-selected Polygon face (Face mode);
                     Subdivide always applies to the whole target mesh regardless of the
                     current selection - see MeshEditSession's own remarks on both. -->
                <Button x:Name="ExtrudeButton" Content="Extrude" IsEnabled="False"
                        Margin="16,0,4,0" Padding="8,2" Click="ExtrudeButton_Click" />
                <Button x:Name="SubdivideButton" Content="Subdivide" IsEnabled="False"
                        Padding="8,2" Click="SubdivideButton_Click" />
            </StackPanel>
        </Border>

        <!-- ================= Shading Mode Toolbar ================= -->
        <Border Grid.Row="3" Background="{StaticResource PanelAltBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="8,6">
                <TextBlock Text="Shading:" VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <RadioButton x:Name="WireframeShadingButton" Content="Wireframe" GroupName="ShadingMode"
                             Style="{StaticResource GizmoModeButtonStyle}"
                             Margin="0,0,4,0" Checked="ShadingModeButton_Checked" Tag="Wireframe" />
                <RadioButton x:Name="SolidShadingButton" Content="Solid" GroupName="ShadingMode"
                             Style="{StaticResource GizmoModeButtonStyle}"
                             Margin="0,0,4,0" Checked="ShadingModeButton_Checked" Tag="Solid" />
                <RadioButton x:Name="MaterialShadingButton" Content="Material" GroupName="ShadingMode"
                             Style="{StaticResource GizmoModeButtonStyle}"
                             Margin="0,0,4,0" Checked="ShadingModeButton_Checked" Tag="Material" />
                <RadioButton x:Name="RenderedShadingButton" Content="Rendered" GroupName="ShadingMode"
                             IsChecked="True" Style="{StaticResource GizmoModeButtonStyle}"
                             Checked="ShadingModeButton_Checked" Tag="Rendered" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="280" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <!-- ================= Scene Outliner ================= -->
            <Border Grid.Column="0" Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="SCENE OUTLINER" Style="{StaticResource PanelHeaderStyle}" />

                    <TreeView x:Name="SceneTreeView" ItemsSource="{Binding RootNodes}"
                              Background="Transparent"
                              SelectedItemChanged="SceneTreeView_SelectedItemChanged">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type vm:NodeViewModel}" ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding Name}" FontSize="12" />
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" />

            <!-- ================= 3D Viewport ================= -->
            <!-- MouseLeftButtonDown bubbles here only from a click the gizmo's own
                 manipulator handles didn't already handle themselves (dragging a handle
                 marks its own mouse-down Handled) - see MainWindow.xaml.cs's own remarks
                 on Viewport_MouseLeftButtonDown for why that's what makes "click a handle
                 to drag it" and "click empty space/another mesh to select" never conflict. -->
            <h:HelixViewport3D x:Name="Viewport" Grid.Column="2"
                               ShowCoordinateSystem="True"
                               MouseLeftButtonDown="Viewport_MouseLeftButtonDown" />

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" />

            <!-- ================= Properties Inspector ================= -->
            <Border Grid.Column="4" Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="PROPERTIES" Style="{StaticResource PanelHeaderStyle}" />

                    <TextBlock DockPanel.Dock="Top" Text="No object selected" Margin="8"
                               TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                               Visibility="{Binding SelectedNode, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding SelectedNode, Converter={StaticResource NullToVisibility}}">
                        <StackPanel DataContext="{Binding SelectedNode}" Margin="0,0,0,12">

                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="8,4,8,10" TextTrimming="CharacterEllipsis" />

                            <!-- Position -->
                            <TextBlock Text="Position" Style="{StaticResource PanelHeaderStyle}" Margin="8,0,8,2" />
                            <StackPanel Orientation="Horizontal" Margin="8,0">
                                <TextBlock Text="X" Style="{StaticResource InspectorFieldLabelStyle}" />
                                <TextBox Text="{Binding PositionX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InspectorFieldTextBoxStyle}" />
                                <TextBlock Text="Y" Style="{StaticResource InspectorFieldLabelStyle}" />
                                <TextBox Text="{Binding PositionY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InspectorFieldTextBoxStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="8,0,8,8">
                                <TextBlock Text="Z" Style="{StaticResource InspectorFieldLabelStyle}" />
                                <TextBox Text="{Binding PositionZ, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InspectorFieldTextBoxStyle}" />
                            </StackPanel>

                            <!-- Rotation -->
                            <TextBlock Text="Rotation (degrees)" Style="{StaticResource PanelHeaderStyle}" Margin="8,0,8,2" />
                            <StackPanel Orientation="Horizontal" Margin="8,0">
                                <TextBlock Text="X" Style="{StaticResource InspectorFieldLabelStyle}" />
                                <TextBox Text="{Binding RotationX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InspectorFieldTextBoxStyle}" />
                                <TextBlock Text="Y" Style="{StaticResource InspectorFieldLabelStyle}" />
                                <TextBox Text="{Binding RotationY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InspectorFieldTextBoxStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="8,0,8,8">
                                <TextBlock Text="Z" Style="{StaticResource InspectorFieldLabelStyle}" />
                                <TextBox Text="{Binding RotationZ, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InspectorFieldTextBoxStyle}" />
                            </StackPanel>

                            <!-- Scale -->
                            <TextBlock Text="Scale" Style="{StaticResource PanelHeaderStyle}" Margin="8,0,8,2" />
                            <StackPanel Orientation="Horizontal" Margin="8,0">
                                <TextBlock Text="X" Style="{StaticResource InspectorFieldLabelStyle}" />
                                <TextBox Text="{Binding ScaleX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InspectorFieldTextBoxStyle}" />
                                <TextBlock Text="Y" Style="{StaticResource InspectorFieldLabelStyle}" />
                                <TextBox Text="{Binding ScaleY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InspectorFieldTextBoxStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="8,0,8,8">
                                <TextBlock Text="Z" Style="{StaticResource InspectorFieldLabelStyle}" />
                                <TextBox Text="{Binding ScaleZ, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InspectorFieldTextBoxStyle}" />
                            </StackPanel>

                            <!-- Records this node's CURRENT Position/Rotation/Scale as a
                                 keyframe at the timeline's own current frame (see
                                 JolieCat3D.Service.Animation.AnimationTrack.AddKeyframeFromCurrentTransform),
                                 leaving the segment AFTER it blended per whichever of
                                 these two is checked (see JolieCat3D.Service.Animation.InterpolationMode). -->
                            <StackPanel Orientation="Horizontal" Margin="8,0,8,4">
                                <RadioButton x:Name="LinearInterpolationButton" Content="Linear" GroupName="Interpolation"
                                             IsChecked="True" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <RadioButton x:Name="BezierInterpolationButton" Content="Bezier" GroupName="Interpolation"
                                             VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Content="Add Keyframe" Margin="8,0,8,8" Padding="8,4"
                                    HorizontalAlignment="Left" Click="AddKeyframeButton_Click" />

                            <!-- Material Inspector - hidden entirely for a mesh-less/materialless node. -->
                            <StackPanel Visibility="{Binding HasMaterial, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="MATERIAL INSPECTOR" Style="{StaticResource PanelHeaderStyle}" Margin="8,4,8,2" />

                                <!-- Diffuse/albedo -->
                                <StackPanel Orientation="Horizontal" Margin="8,0,8,8">
                                    <Border Width="26" Height="26" Margin="0,0,8,0"
                                            Background="{Binding DiffuseColor, Converter={StaticResource ColorToBrush}}"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            ToolTip="Diffuse/albedo color" />
                                    <TextBox Text="{Binding DiffuseColorHex, Mode=TwoWay}"
                                             Style="{StaticResource InspectorFieldTextBoxStyle}" Width="90"
                                             ToolTip="Diffuse/albedo color (hex)" />
                                </StackPanel>

                                <!-- Roughness/Metallic - see Core.Materials.Material's own
                                     remarks for what these do and how Engine.Geometry.MaterialFactory
                                     approximates them on WPF's fixed-function pipeline. -->
                                <StackPanel Orientation="Horizontal" Margin="8,0,8,2">
                                    <TextBlock Text="Roughness" Width="70" VerticalAlignment="Center"
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Roughness, StringFormat={}{0:0.00}}" Width="36" VerticalAlignment="Center"
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                                <Slider Margin="8,0,8,8" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1"
                                        Value="{Binding Roughness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <StackPanel Orientation="Horizontal" Margin="8,0,8,2">
                                    <TextBlock Text="Metallic" Width="70" VerticalAlignment="Center"
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Metallic, StringFormat={}{0:0.00}}" Width="36" VerticalAlignment="Center"
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                                <Slider Margin="8,0,8,8" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1"
                                        Value="{Binding Metallic, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <!-- Texture - either a plain exported image, or one layer of a
                                     whole .jolie project (see JolieCat3D.Service.Interop). -->
                                <Button Content="Load Texture..." Margin="8,0,8,4" Padding="8,4"
                                        HorizontalAlignment="Left" Click="LoadTextureButton_Click" />
                                <Button Content="Load From JolieCat Project..." Margin="8,0,8,4" Padding="8,4"
                                        HorizontalAlignment="Left" Click="LoadFromJolieProjectButton_Click" />
                                <!-- Imports a JolieCat 2D Clipbar Animation (one frame
                                     per "Frame NNN" layer) or Sprite Sheet (one frame
                                     per grid cell) project as an animated texture
                                     sequence, driven by the playback transport below
                                     (see JolieCat3D.Service.Interop.ClipbarAnimationBridge). -->
                                <Button Content="Load Clipbar Animation..." Margin="8,0,8,4" Padding="8,4"
                                        HorizontalAlignment="Left" Click="LoadClipbarAnimationButton_Click" />
                                <TextBlock Text="{Binding DiffuseTextureFileName}" Margin="8,0,8,8"
                                           TextTrimming="CharacterEllipsis" FontStyle="Italic"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Visibility="{Binding HasDiffuseTexture, Converter={StaticResource BoolToVisibility}}" />

                                <!-- UV Projection - (re)maps this mesh's own UVs, for a custom
                                     primitive or an Edit-Mode-reshaped mesh whose authored UVs
                                     no longer make sense (see Core.Geometry.UVProjector). -->
                                <TextBlock Text="UV Projection" Style="{StaticResource PanelHeaderStyle}" Margin="8,4,8,2" />
                                <StackPanel Orientation="Horizontal" Margin="8,0,8,8">
                                    <Button Content="Planar" Margin="0,0,4,0" Padding="8,4" Click="PlanarProjectionButton_Click" />
                                    <Button Content="Box" Margin="0,0,4,0" Padding="8,4" Click="BoxProjectionButton_Click" />
                                    <Button Content="Spherical" Padding="8,4" Click="SphericalProjectionButton_Click" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Modifiers - a non-destructive stack evaluated at render
                                 time only (see Core.Modifiers.ModifierStack); hidden
                                 entirely for a mesh-less node, which no modifier would
                                 ever have anything to evaluate against. -->
                            <StackPanel Visibility="{Binding HasMesh, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="MODIFIERS" Style="{StaticResource PanelHeaderStyle}" Margin="8,4,8,2" />
                                <StackPanel Orientation="Horizontal" Margin="8,0,8,4">
                                    <Button Content="Add Mirror" Margin="0,0,4,0" Padding="8,2" Click="AddMirrorModifierButton_Click" />
                                    <Button Content="Add Subsurf" Padding="8,2" Click="AddSubsurfModifierButton_Click" />
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding Modifiers}" Margin="8,0,8,8">
                                    <ItemsControl.Resources>
                                        <DataTemplate DataType="{x:Type vm:MirrorModifierViewModel}">
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,4" Padding="6">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                  ToolTip="Enable/disable this modifier without removing it" />
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <Button Content="Remove" Margin="12,0,0,0" Padding="6,0" Click="RemoveModifierButton_Click" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Text="Axis:" VerticalAlignment="Center" Margin="0,0,6,0"
                                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                        <ComboBox SelectedValue="{Binding Axis, Mode=TwoWay}" SelectedValuePath="Content" Width="60">
                                                            <ComboBoxItem Content="X" />
                                                            <ComboBoxItem Content="Y" />
                                                            <ComboBoxItem Content="Z" />
                                                        </ComboBox>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                        <DataTemplate DataType="{x:Type vm:SubdivisionSurfaceModifierViewModel}">
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,4" Padding="6">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                  ToolTip="Enable/disable this modifier without removing it" />
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <Button Content="Remove" Margin="12,0,0,0" Padding="6,0" Click="RemoveModifierButton_Click" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Text="Iterations:" VerticalAlignment="Center" Margin="0,0,6,0"
                                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                        <TextBox Text="{Binding Iterations, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="40" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.Resources>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Camera Inspector - hidden entirely for a non-camera node.
                                 Position/Rotation/Scale above already drive where this
                                 camera looks (see Node.GetWorldForward's own remarks) -
                                 this section is only the CameraData-specific fields
                                 (projection/FOV/near-far) plus which camera is active. -->
                            <StackPanel Visibility="{Binding HasCamera, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="CAMERA" Style="{StaticResource PanelHeaderStyle}" Margin="8,4,8,2" />
                                <StackPanel Orientation="Horizontal" Margin="8,0,8,4">
                                    <TextBlock Text="Projection:" VerticalAlignment="Center" Margin="0,0,6,0"
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <ComboBox SelectedValue="{Binding CameraProjectionMode, Mode=TwoWay}" SelectedValuePath="Content" Width="110">
                                        <ComboBoxItem Content="Perspective" />
                                        <ComboBoxItem Content="Orthographic" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="8,0,8,4"
                                            Visibility="{Binding IsPerspectiveCamera, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Field of View" Style="{StaticResource InspectorFieldLabelStyle}" />
                                    <TextBox Text="{Binding CameraFieldOfView, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InspectorFieldTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="8,0,8,4"
                                            Visibility="{Binding IsOrthographicCamera, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Width" Style="{StaticResource InspectorFieldLabelStyle}" />
                                    <TextBox Text="{Binding CameraOrthographicWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InspectorFieldTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="8,0">
                                    <TextBlock Text="Near" Style="{StaticResource InspectorFieldLabelStyle}" />
                                    <TextBox Text="{Binding CameraNearPlaneDistance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InspectorFieldTextBoxStyle}" />
                                    <TextBlock Text="Far" Style="{StaticResource InspectorFieldLabelStyle}" />
                                    <TextBox Text="{Binding CameraFarPlaneDistance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InspectorFieldTextBoxStyle}" />
                                </StackPanel>
                                <!-- Sets Scene3D.ActiveCamera to THIS node - Engine.Camera.SceneCameraSync
                                     then pushes its world transform onto the viewport's
                                     actual rendering camera on the very next render. -->
                                <Button Content="Set as Active Camera" Margin="8,4,8,8" Padding="8,4"
                                        HorizontalAlignment="Left" Click="SetActiveCameraButton_Click" />
                            </StackPanel>

                            <!-- Light Inspector - hidden entirely for a non-light node. -->
                            <StackPanel Visibility="{Binding HasLight, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="LIGHT" Style="{StaticResource PanelHeaderStyle}" Margin="8,4,8,2" />
                                <StackPanel Orientation="Horizontal" Margin="8,0,8,4">
                                    <TextBlock Text="Type:" VerticalAlignment="Center" Margin="0,0,6,0"
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <ComboBox SelectedValue="{Binding LightType, Mode=TwoWay}" SelectedValuePath="Content" Width="110">
                                        <ComboBoxItem Content="Directional" />
                                        <ComboBoxItem Content="Point" />
                                        <ComboBoxItem Content="Spot" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="8,0,8,4">
                                    <TextBlock Text="Color" Style="{StaticResource InspectorFieldLabelStyle}" />
                                    <TextBox Text="{Binding LightColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InspectorFieldTextBoxStyle}" />
                                    <TextBlock Text="Intensity" Style="{StaticResource InspectorFieldLabelStyle}" />
                                    <TextBox Text="{Binding LightIntensity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InspectorFieldTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="8,0,8,4"
                                            Visibility="{Binding IsPointOrSpotLight, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Range" Style="{StaticResource InspectorFieldLabelStyle}" />
                                    <TextBox Text="{Binding LightRange, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InspectorFieldTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="8,0,8,8"
                                            Visibility="{Binding IsSpotLight, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Spot Angle" Style="{StaticResource InspectorFieldLabelStyle}" />
                                    <TextBox Text="{Binding LightSpotAngle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InspectorFieldTextBoxStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ================= Animation Playback Transport ================= -->
        <Border Grid.Row="5" Background="{StaticResource PanelAltBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Margin="8,6">
                <Button x:Name="PlayPauseButton" Content="Play" Padding="12,2" Margin="0,0,4,0" Click="PlayPauseButton_Click" />
                <Button Content="Stop" Padding="12,2" Margin="0,0,16,0" Click="StopButton_Click" />

                <TextBlock Text="Frame:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}" />
                <Slider x:Name="FrameScrubber" Width="280" Minimum="0" VerticalAlignment="Center"
                        ValueChanged="FrameScrubber_ValueChanged" />
                <TextBlock x:Name="FrameLabel" Text="0 / 120" VerticalAlignment="Center" Margin="8,0,16,0"
                           Foreground="{StaticResource TextSecondaryBrush}" MinWidth="60" />

                <TextBlock Text="FPS:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBox x:Name="FpsTextBox" Width="50" Text="24" TextChanged="FpsTextBox_TextChanged" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
