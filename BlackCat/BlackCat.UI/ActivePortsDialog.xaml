<Window x:Class="BlackCat.UI.ActivePortsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Активні порти" Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        Background="Transparent">

    <Border Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource PrimaryBrush}"
            BorderThickness="2" CornerRadius="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Chrome header -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceAltBrush}" Height="40" Padding="12,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="АКТИВНІ ПОРТИ" FontWeight="Bold" FontSize="12"
                               Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                    <Button Content="✕" Width="44" Height="40" HorizontalAlignment="Right"
                            FontSize="14" Cursor="Hand" Click="CloseButton_Click"
                            Style="{StaticResource ChromeCloseButton}"/>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок -->
                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="Активні TCP з'єднання" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Виберіть порт або кілька портів для додавання до правила"
                               FontSize="12" Foreground="Gray" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Список з'єднань -->
                <DataGrid Grid.Row="1" x:Name="ConnectionsDataGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Extended"
                          SelectionChanged="ConnectionsDataGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Процес" Binding="{Binding ProcessName}" Width="150"/>
                        <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="60"/>
                        <DataGridTextColumn Header="Локальна адреса" Binding="{Binding LocalAddress}" Width="120"/>
                        <DataGridTextColumn Header="Порт" Binding="{Binding LocalPort}" Width="80"/>
                        <DataGridTextColumn Header="Віддалена адреса" Binding="{Binding RemoteAddress}" Width="120"/>
                        <DataGridTextColumn Header="Віддалений порт" Binding="{Binding RemotePort}" Width="100"/>
                        <DataGridTextColumn Header="Протокол" Binding="{Binding Protocol}" Width="70"/>
                        <DataGridTextColumn Header="Стан" Binding="{Binding State}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Кнопки -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <TextBlock x:Name="SelectionInfoTextBlock"
                               Text="Не вибрано"
                               VerticalAlignment="Center"
                               Margin="0,0,20,0"
                               Foreground="Gray"/>
                    <Button x:Name="SelectButton" Content="Вибрати"
                            Width="100" Padding="10,5" Margin="0,0,10,0"
                            Click="SelectButton_Click"
                            IsEnabled="False"/>
                    <Button x:Name="CancelButton" Content="Скасувати"
                            Width="100" Padding="10,5"
                            Click="CancelButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
