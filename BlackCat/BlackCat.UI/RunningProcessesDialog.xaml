<Window x:Class="BlackCat.UI.RunningProcessesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Запущені процеси" Height="500" Width="700"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        Background="Transparent">

    <Border Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource PrimaryBrush}"
            BorderThickness="2" CornerRadius="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Chrome header -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceAltBrush}" Height="40" Padding="12,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="ЗАПУЩЕНІ ПРОЦЕСИ" FontWeight="Bold" FontSize="12"
                               Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                    <Button Content="✕" Width="44" Height="40" HorizontalAlignment="Right"
                            FontSize="14" Cursor="Hand" Click="CloseButton_Click"
                            Style="{StaticResource ChromeCloseButton}"/>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок -->
                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="Процеси з активними з'єднаннями" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Виберіть процес для додавання до правила фільтрації"
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Список процесів -->
                <DataGrid Grid.Row="1" x:Name="ProcessesDataGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionChanged="ProcessesDataGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Назва процесу" Binding="{Binding ProcessName}" Width="200"/>
                        <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="80"/>
                        <DataGridTextColumn Header="З'єднань" Binding="{Binding ConnectionCount}" Width="100"/>
                        <DataGridTextColumn Header="Активні порти" Binding="{Binding PortsDisplay}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Кнопки -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <TextBlock x:Name="SelectionInfoTextBlock"
                               Text="Не вибрано"
                               VerticalAlignment="Center"
                               Margin="0,0,20,0"
                               Foreground="{StaticResource TextMutedBrush}"/>
                    <Button x:Name="SelectButton" Content="Вибрати"
                            Width="100" Padding="10,5" Margin="0,0,10,0"
                            Click="SelectButton_Click"
                            IsEnabled="False"/>
                    <Button x:Name="CancelButton" Content="Скасувати"
                            Width="100" Padding="10,5"
                            Click="CancelButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
