<Window x:Class="BlackCat.UI.BlackIDCreationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Створити Black-ID" Height="400" Width="500"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        Background="Transparent">

    <Border Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource PrimaryBrush}"
            BorderThickness="2" CornerRadius="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Chrome header -->
            <Border Grid.Row="0" Background="{StaticResource PrimaryDarkBrush}" Padding="12,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="СТВОРИТИ BLACK-ID" FontWeight="Bold" FontSize="12"
                               Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                    <Button Content="✕" Width="36" Height="36" HorizontalAlignment="Right"
                            FontSize="16" Cursor="Hand" Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{TemplateBinding Background}" Width="36" Height="36">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#F44336"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Створення унікального Black-ID"
                           FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

                <StackPanel Grid.Row="1">
                    <!-- Роль -->
                    <TextBlock Text="Роль:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <ComboBox x:Name="RoleComboBox" Margin="0,0,0,15">
                        <ComboBoxItem Content="SKLAD (Склад)" Tag="SKLAD"/>
                        <ComboBoxItem Content="OFFICE (Офіс)" Tag="OFFICE"/>
                        <ComboBoxItem Content="MAIN (Головний сервер)" Tag="MAIN" IsSelected="True"/>
                        <ComboBoxItem Content="BACKUP (Резервний)" Tag="BACKUP"/>
                        <ComboBoxItem Content="SERVER (Сервер)" Tag="SERVER"/>
                        <ComboBoxItem Content="WORKSTATION (Робоча станція)" Tag="WORKSTATION"/>
                    </ComboBox>

                    <!-- Місто -->
                    <TextBlock Text="Місто:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <ComboBox x:Name="CityComboBox" Margin="0,0,0,15">
                        <ComboBoxItem Content="KYIV (Київ)" Tag="KYIV" IsSelected="True"/>
                        <ComboBoxItem Content="KHARKIV (Харків)" Tag="KHARKIV"/>
                        <ComboBoxItem Content="ODESA (Одеса)" Tag="ODESA"/>
                        <ComboBoxItem Content="DNIPRO (Дніпро)" Tag="DNIPRO"/>
                        <ComboBoxItem Content="LVIV (Львів)" Tag="LVIV"/>
                        <ComboBoxItem Content="ZAPORIZHZHIA (Запоріжжя)" Tag="ZAPORIZHZHIA"/>
                        <ComboBoxItem Content="VINNYTSIA (Вінниця)" Tag="VINNYTSIA"/>
                        <ComboBoxItem Content="MYKOLAIV (Миколаїв)" Tag="MYKOLAIV"/>
                        <ComboBoxItem Content="POLTAVA (Полтава)" Tag="POLTAVA"/>
                        <ComboBoxItem Content="CHERNIHIV (Чернігів)" Tag="CHERNIHIV"/>
                        <ComboBoxItem Content="SUMY (Суми)" Tag="SUMY"/>
                        <ComboBoxItem Content="ZHYTOMYR (Житомир)" Tag="ZHYTOMYR"/>
                    </ComboBox>

                    <!-- Назва -->
                    <TextBlock Text="Назва:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox x:Name="NameTextBox" Margin="0,0,0,10"
                             Text="SERVER" MaxLength="20"/>
                    <TextBlock Text="Тільки англійські літери та цифри, без пробілів"
                               Foreground="Gray" FontSize="11" Margin="0,0,0,15"/>

                    <!-- Попередній перегляд -->
                    <Border BorderBrush="{StaticResource PrimaryBrush}"
                            BorderThickness="2" Padding="10" Background="{StaticResource PanelBrush}">
                        <StackPanel>
                            <TextBlock Text="Попередній перегляд:" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBlock x:Name="PreviewTextBlock"
                                       FontFamily="Consolas" FontSize="16"
                                       Text="MAIN-KYIV-SERVER-XXXX"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button x:Name="CreateButton" Content="Створити"
                            Width="100" Padding="10,5" Margin="0,0,10,0"
                            Click="CreateButton_Click" IsDefault="True"/>
                    <Button x:Name="CancelButton" Content="Скасувати"
                            Width="100" Padding="10,5"
                            Click="CancelButton_Click" IsCancel="True"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
