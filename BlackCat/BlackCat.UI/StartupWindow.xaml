<Window x:Class="BlackCat.UI.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BlackCat Firewall - Запуск"
        Height="620" Width="660"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="/Assets/BC.ico"
        Background="{StaticResource BackgroundBrush}"
        WindowStyle="None"
        AllowsTransparency="True">

    <Border BorderBrush="{StaticResource PrimaryBrush}"
            BorderThickness="2"
            CornerRadius="0"
            Background="{StaticResource BackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Border Grid.Row="0"
                    Background="{StaticResource PrimaryDarkBrush}"
                    CornerRadius="0"
                    Padding="20"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0"
                           Source="/Assets/BC.ico"
                           Width="64" Height="64"
                           Margin="0,0,20,0"
                           VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="BlackCat Firewall"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock Text="Network Security Suite v1.0.0"
                                   FontSize="13"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- Кнопка закриття -->
                    <Button Grid.Column="2"
                            Content="✕"
                            Width="40" Height="40"
                            FontSize="18"
                            Background="Transparent"
                            Foreground="{StaticResource TextBrush}"
                            BorderThickness="0"
                            Click="CloseButton_Click"
                            VerticalAlignment="Top"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="0"
                                                    Width="40" Height="40">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#F44336"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Основний контент -->
            <Grid Grid.Row="1" Margin="28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Статус перевірки -->
                <GroupBox Grid.Row="0" Header="Статус системи" Margin="0,0,0,18">
                    <StackPanel>
                        <!-- Права адміністратора -->
                        <Border BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="0"
                                Padding="14"
                                Margin="0,0,0,8"
                                Background="{StaticResource PanelBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="🛡"
                                           FontSize="22"
                                           Margin="0,0,14,0"
                                           VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Права адміністратора"
                                               FontWeight="Bold" FontSize="13"
                                               Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock x:Name="AdminStatusText"
                                               Text="Перевірка..."
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           x:Name="AdminStatusIcon"
                                           Text="⏳"
                                           FontSize="28"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- База даних -->
                        <Border BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="0"
                                Padding="14"
                                Background="{StaticResource PanelBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="🗄"
                                           FontSize="22"
                                           Margin="0,0,14,0"
                                           VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="База даних"
                                               FontWeight="Bold" FontSize="13"
                                               Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock x:Name="DbStatusText"
                                               Text="Перевірка..."
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           x:Name="DbStatusIcon"
                                           Text="⏳"
                                           FontSize="28"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <!-- Прогрес -->
                <StackPanel Grid.Row="1" Margin="0,0,0,18">
                    <TextBlock x:Name="StatusMessageText"
                               Text="Ініціалізація системи..."
                               FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"
                               TextAlignment="Center"
                               Margin="0,0,0,10"/>
                    <ProgressBar x:Name="LoadingProgress"
                                 Height="6"
                                 IsIndeterminate="True"/>
                </StackPanel>

                <!-- Кнопки дій -->
                <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                    <!-- Панель помилки -->
                    <Border x:Name="ErrorPanel"
                            Visibility="Collapsed"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource ErrorBrush}"
                            BorderThickness="1"
                            CornerRadius="0"
                            Padding="14"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="⚠ Увага"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource ErrorBrush}"
                                       FontSize="13"
                                       Margin="0,0,0,5"/>
                            <TextBlock x:Name="ErrorMessageText"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource ErrorBrush}"
                                       FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <!-- Кнопки -->
                    <UniformGrid Columns="2" Rows="2">
                        <Button x:Name="RestartAdminButton"
                                Content="🛡 Від імені адміна"
                                Click="RestartAdmin_Click"
                                Visibility="Collapsed"
                                Margin="0,0,4,4"
                                ToolTip="Перезапустити з правами адміністратора"/>

                        <Button x:Name="ContinueButton"
                                Content="▶  Продовжити"
                                Style="{StaticResource SuccessButton}"
                                Click="Continue_Click"
                                Visibility="Collapsed"
                                Margin="4,0,0,4"/>

                        <Button x:Name="UIOnlyButton"
                                Content="💻 Обмежений режим"
                                Click="UIOnly_Click"
                                Margin="0,4,4,0"
                                ToolTip="Запустити без прав адміністратора (деякі функції недоступні)"/>

                        <Button x:Name="ExitButton"
                                Content="✕  Вихід"
                                Style="{StaticResource DangerButton}"
                                Click="Exit_Click"
                                Margin="4,4,0,0"/>
                    </UniformGrid>
                </StackPanel>
            </Grid>

            <!-- Футер -->
            <Border Grid.Row="2"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="0"
                    Padding="14,10">
                <TextBlock Text="© 2025 BlackCat Security | Network Firewall &amp; Tunnel Management"
                           FontSize="10"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</Window>
