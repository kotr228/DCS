<Window x:Class="BlackCat.UI.IncomingConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вхідне підключення"
        Width="340" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Loaded="Window_Loaded">

    <Border Background="#1E1E1E" BorderBrush="#4EC9B0" BorderThickness="2"
            CornerRadius="8" Padding="16">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" Opacity="0.6" ShadowDepth="4"/>
        </Border.Effect>

        <StackPanel>
            <!-- Заголовок -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Ellipse Width="12" Height="12" Fill="#4EC9B0" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="1" To="0.2" Duration="0:0:0.8"
                                                     AutoReverse="True"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
                <TextBlock Text="ВХІДНЕ ПІДКЛЮЧЕННЯ" Foreground="#4EC9B0"
                           FontWeight="Bold" FontSize="12" LetterSpacing="1"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Black-ID -->
            <TextBlock Text="Запит від:" Foreground="#808080" FontSize="11" Margin="0,0,0,4"/>
            <Border Background="#252526" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                <TextBlock x:Name="PeerBlackIDText" Text="..."
                           FontFamily="Consolas" FontSize="14" Foreground="#4EC9B0"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- IP -->
            <TextBlock Text="IP адреса:" Foreground="#808080" FontSize="11" Margin="0,0,0,4"/>
            <Border Background="#252526" CornerRadius="4" Padding="10,6" Margin="0,0,0,14">
                <TextBlock x:Name="PeerIPText" Text="..."
                           FontFamily="Consolas" FontSize="12" Foreground="#D4D4D4"/>
            </Border>

            <!-- Таймер -->
            <TextBlock x:Name="TimerText" Text="Автовідхилення через 30 сек..."
                       Foreground="#606060" FontSize="11" Margin="0,0,0,12"
                       HorizontalAlignment="Center"/>

            <!-- Кнопки -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="AcceptButton" Content="✓  Прийняти"
                        Height="38" FontSize="14" FontWeight="Bold"
                        Background="#1E6E3C" Foreground="White" BorderThickness="0"
                        Cursor="Hand" Click="AcceptButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                    CornerRadius="5" Padding="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#27A355"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Grid.Column="2" x:Name="RejectButton" Content="✕  Відхилити"
                        Height="38" FontSize="14" FontWeight="Bold"
                        Background="#7A1E1E" Foreground="White" BorderThickness="0"
                        Cursor="Hand" Click="RejectButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                    CornerRadius="5" Padding="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#C0392B"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</Window>
