<Window x:Class="BlackCat.UI.IncomingConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вхідне підключення"
        Width="340" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Loaded="Window_Loaded">

    <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="2"
            CornerRadius="8" Padding="16">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" Opacity="0.6" ShadowDepth="4"/>
        </Border.Effect>

        <StackPanel>
            <!-- Заголовок -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Ellipse Width="12" Height="12" Fill="{StaticResource PrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="1" To="0.2" Duration="0:0:0.8"
                                                     AutoReverse="True"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
                <TextBlock Text="ВХІДНЕ ПІДКЛЮЧЕННЯ" Foreground="{StaticResource PrimaryBrush}"
                           FontWeight="Bold" FontSize="12"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Black-ID -->
            <TextBlock Text="Запит від:" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
            <Border Background="{StaticResource PanelBrush}" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                <TextBlock x:Name="PeerBlackIDText" Text="..."
                           FontFamily="Consolas" FontSize="14" Foreground="{StaticResource PrimaryBrush}"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- IP -->
            <TextBlock Text="IP адреса:" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
            <Border Background="{StaticResource PanelBrush}" CornerRadius="4" Padding="10,6" Margin="0,0,0,14">
                <TextBlock x:Name="PeerIPText" Text="..."
                           FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextBrush}"/>
            </Border>

            <!-- Таймер -->
            <TextBlock x:Name="TimerText" Text="Автовідхилення через 30 сек..."
                       Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,12"
                       HorizontalAlignment="Center"/>

            <!-- Кнопки -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="AcceptButton" Content="✓  Прийняти"
                        Height="38" FontSize="14" FontWeight="Bold"
                        Style="{StaticResource SuccessButton}"
                        MinWidth="0" Margin="0"
                        Click="AcceptButton_Click"/>

                <Button Grid.Column="2" x:Name="RejectButton" Content="✕  Відхилити"
                        Height="38" FontSize="14" FontWeight="Bold"
                        Style="{StaticResource DangerButton}"
                        MinWidth="0" Margin="0"
                        Click="RejectButton_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
