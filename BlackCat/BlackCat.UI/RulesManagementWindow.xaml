<mah:MetroWindow x:Class="BlackCat.UI.RulesManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        Title="Керування правилами фільтрації" Height="700" Width="1200"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Правила фільтрації"
                   FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- Список правил -->
        <DataGrid Grid.Row="1" Grid.Column="0"
                  x:Name="RulesDataGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Background="Black" Foreground="White" BorderThickness="1" BorderBrush="#4EC9B0"
                  SelectionChanged="RulesDataGrid_SelectionChanged"
                  Margin="0,0,10,0">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Увімкнено" Binding="{Binding IsEnabled}" Width="80"/>
                <DataGridTextColumn Header="Пріоритет" Binding="{Binding Priority}" Width="70"/>
                <DataGridTextColumn Header="Назва" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="IP/Підмережа" Binding="{Binding IPAddress}" Width="140"/>
                <DataGridTextColumn Header="Порт" Binding="{Binding Port}" Width="60"/>
                <DataGridTextColumn Header="Протокол" Binding="{Binding Protocol}" Width="80"/>
                <DataGridTextColumn Header="Дія" Binding="{Binding Action}" Width="80"/>
                <DataGridTextColumn Header="Процес" Binding="{Binding ProcessName}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Розділювач -->
        <GridSplitter Grid.Row="1" Grid.Column="1"
                      Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

        <!-- Деталі правила -->
        <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10,0,0,0">
                <TextBlock Text="Деталі правила" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                <!-- Назва -->
                <TextBlock Text="Назва:" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="RuleNameTextBox" Margin="0,0,0,10"/>

                <!-- IP адреса -->
                <TextBlock Text="IP адреса / Підмережа:" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="RuleIPTextBox" Margin="0,0,0,5"
                         ToolTip="Наприклад: 192.168.1.100 або 192.168.0.0/24"/>
                <TextBlock Text="CIDR підтримується" Foreground="Gray" FontSize="10" Margin="0,0,0,10"/>

                <!-- Порт -->
                <TextBlock Text="Порт:" FontWeight="Bold" Margin="0,0,0,5"/>
                <mah:NumericUpDown x:Name="RulePortNumeric"
                                   Minimum="0" Maximum="65535"
                                   Value="0" Margin="0,0,0,5"/>
                <TextBlock Text="0 = будь-який порт" Foreground="Gray" FontSize="10" Margin="0,0,0,10"/>

                <!-- Діапазон портів -->
                <TextBlock Text="Діапазон портів (опціонально):" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="RulePortRangeTextBox" Margin="0,0,0,5"
                         ToolTip="Наприклад: 80,443 або 8000-9000"/>
                <Button Content="Вибрати з активних..." Click="SelectActivePortButton_Click"
                        Padding="5,2" Margin="0,0,0,10" HorizontalAlignment="Left"/>

                <!-- Протокол -->
                <TextBlock Text="Протокол:" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox x:Name="RuleProtocolComboBox" Margin="0,0,0,10">
                    <ComboBoxItem Content="Будь-який" Tag="0"/>
                    <ComboBoxItem Content="TCP" Tag="6"/>
                    <ComboBoxItem Content="UDP" Tag="17"/>
                    <ComboBoxItem Content="ICMP" Tag="1"/>
                </ComboBox>

                <!-- Дія -->
                <TextBlock Text="Дія:" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox x:Name="RuleActionComboBox" Margin="0,0,0,10">
                    <ComboBoxItem Content="Дозволити" Tag="0"/>
                    <ComboBoxItem Content="Блокувати" Tag="1"/>
                    <ComboBoxItem Content="Через тунель" Tag="2"/>
                </ComboBox>

                <!-- Напрямок -->
                <TextBlock Text="Напрямок:" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox x:Name="RuleDirectionComboBox" Margin="0,0,0,10">
                    <ComboBoxItem Content="Обидва" Tag="0"/>
                    <ComboBoxItem Content="Вхідний" Tag="1"/>
                    <ComboBoxItem Content="Вихідний" Tag="2"/>
                </ComboBox>

                <!-- Application Control -->
                <TextBlock Text="Назва процесу (опціонально):" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="RuleProcessNameTextBox" Margin="0,0,0,5"
                         ToolTip="Наприклад: chrome.exe, WINWORD.EXE"/>
                <Button Content="Вибрати з запущених..." Click="SelectRunningProcessButton_Click"
                        Padding="5,2" Margin="0,0,0,10" HorizontalAlignment="Left"/>

                <!-- Пріоритет -->
                <TextBlock Text="Пріоритет:" FontWeight="Bold" Margin="0,0,0,5"/>
                <mah:NumericUpDown x:Name="RulePriorityNumeric"
                                   Minimum="1" Maximum="999"
                                   Value="100" Margin="0,0,0,5"/>
                <TextBlock Text="Нижче = вища пріоритетність" Foreground="Gray" FontSize="10" Margin="0,0,0,10"/>

                <!-- Увімкнено -->
                <CheckBox x:Name="RuleEnabledCheckBox" Content="Правило увімкнено"
                          IsChecked="True" Margin="0,0,0,15"/>

                <!-- Опис -->
                <TextBlock Text="Опис:" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="RuleDescriptionTextBox" Height="60"
                         TextWrapping="Wrap" AcceptsReturn="True"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки керування -->
        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,20,0,0">
            <Button x:Name="AddButton" Content="+ Додати"
                    Width="100" Padding="10,5" Margin="0,0,10,0"
                    Click="AddButton_Click"/>
            <Button x:Name="SaveButton" Content="💾 Зберегти"
                    Width="100" Padding="10,5" Margin="0,0,10,0"
                    Click="SaveButton_Click"
                    IsEnabled="False"/>
            <Button x:Name="DeleteButton" Content="🗑 Видалити"
                    Width="100" Padding="10,5" Margin="0,0,10,0"
                    Click="DeleteButton_Click"
                    IsEnabled="False"/>
        </StackPanel>

        <!-- Кнопка закриття -->
        <Button Grid.Row="2" Grid.Column="2"
                x:Name="CloseButton" Content="Закрити"
                Width="100" Padding="10,5" Margin="10,20,0,0"
                HorizontalAlignment="Right"
                Click="CloseButton_Click"/>
    </Grid>
</mah:MetroWindow>
