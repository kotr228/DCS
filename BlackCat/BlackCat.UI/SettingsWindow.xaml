<Window x:Class="BlackCat.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        Title="Налаштування BlackCat" Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        Background="Transparent">

    <Border Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource PrimaryBrush}"
            BorderThickness="2" CornerRadius="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Chrome header -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceAltBrush}" Height="40" Padding="12,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="НАЛАШТУВАННЯ" FontWeight="Bold" FontSize="12"
                               Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                    <Button Content="✕" Width="44" Height="40" HorizontalAlignment="Right"
                            FontSize="14" Cursor="Hand" Click="CloseButton_Click"
                            Style="{StaticResource ChromeCloseButton}"/>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок -->
                <TextBlock Grid.Row="0" Text="Налаштування брандмауера"
                           FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

                <!-- Табконтрол з налаштуваннями -->
                <TabControl Grid.Row="1" Margin="0,0,0,20">

                    <!-- Загальні налаштування -->
                    <TabItem Header="Загальні">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">

                                <GroupBox Header="Black-ID" Margin="0,0,0,20">
                                    <StackPanel Margin="10">
                                        <TextBlock Text="Поточний Black-ID:" FontWeight="Bold" Margin="0,0,0,5"/>
                                        <TextBox x:Name="CurrentBlackIDTextBox" IsReadOnly="True"
                                                 FontFamily="Consolas" FontSize="14" Padding="5"/>
                                        <Button x:Name="CreateBlackIDButton" Content="Створити новий Black-ID"
                                                Margin="0,10,0,0" Padding="10,5" Click="CreateBlackIDButton_Click"/>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="Мережа" Margin="0,0,0,20">
                                    <StackPanel Margin="10">
                                        <TextBlock Text="Порт тунелю:" Margin="0,0,0,5"/>
                                        <mah:NumericUpDown x:Name="TunnelPortNumeric"
                                                           Minimum="1024" Maximum="65535"
                                                           Value="9999" Width="150" HorizontalAlignment="Left"/>
                                        <TextBlock Text="Змінюється після перезапуску"
                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="Безпека" Margin="0,0,0,20">
                                    <StackPanel Margin="10">
                                        <CheckBox x:Name="StealthModeCheckBox"
                                                  Content="Увімкнути Stealth Mode (рекомендовано)"
                                                  IsChecked="True" Margin="0,0,0,10"/>
                                        <TextBlock Text="В режимі невидимки порт виглядає закритим для сканерів"
                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="Автозапуск">
                                    <StackPanel Margin="10">
                                        <CheckBox x:Name="AutoStartCheckBox"
                                                  Content="Запускати BlackCat при старті системи"
                                                  Margin="0,0,0,10"/>
                                        <CheckBox x:Name="StartMinimizedCheckBox"
                                                  Content="Запускати згорнутим в трей"/>
                                    </StackPanel>
                                </GroupBox>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Логування -->
                    <TabItem Header="Логування">
                        <StackPanel Margin="10">
                            <GroupBox Header="Журнал подій">
                                <StackPanel Margin="10">
                                    <CheckBox x:Name="LogToFileCheckBox"
                                              Content="Зберігати логи в файл"
                                              IsChecked="True" Margin="0,0,0,10"/>
                                    <TextBlock Text="Зберігати логи за останні:" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="LogRetentionComboBox" Width="200" HorizontalAlignment="Left">
                                        <ComboBoxItem Content="7 днів" Tag="7"/>
                                        <ComboBoxItem Content="30 днів" Tag="30" IsSelected="True"/>
                                        <ComboBoxItem Content="90 днів" Tag="90"/>
                                        <ComboBoxItem Content="1 рік" Tag="365"/>
                                    </ComboBox>
                                    <Button x:Name="OpenLogFolderButton" Content="Відкрити папку з логами"
                                            Margin="0,15,0,0" Padding="10,5" Click="OpenLogFolderButton_Click"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </TabItem>

                    <!-- Для з'єднання -->
                    <TabItem Header="Для з'єднання">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">

                                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="0" Padding="15" Margin="0,0,0,15">
                                    <StackPanel>
                                        <TextBlock Text="📋 Дані для підключення до цього вузла" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                                        <TextBlock Text="Надайте ці дані іншому користувачу для встановлення з'єднання з вашим вузлом."
                                                   TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                </Border>

                                <GroupBox Header="Основна інформація" Margin="0,0,0,15">
                                    <Grid Margin="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="🆔 Black-ID:" FontWeight="Bold" Margin="0,5" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="ConnectionBlackIDTextBox" IsReadOnly="True"
                                                 FontFamily="Consolas" Margin="0,5" FontSize="13"/>
                                        <Button Grid.Row="0" Grid.Column="2" Content="📋 Копіювати" Margin="5,5,0,5" Padding="8,4"
                                                Click="CopyBlackID_Click"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="🏠 Локальна IP:" FontWeight="Bold" Margin="0,5" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="LocalIPTextBox" IsReadOnly="True"
                                                 FontFamily="Consolas" Margin="0,5" FontSize="13"/>
                                        <Button Grid.Row="1" Grid.Column="2" Content="📋 Копіювати" Margin="5,5,0,5" Padding="8,4"
                                                Click="CopyLocalIP_Click"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="🌐 Зовнішня IP:" FontWeight="Bold" Margin="0,5" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="ExternalIPTextBox" IsReadOnly="True"
                                                 FontFamily="Consolas" Margin="0,5" FontSize="13"/>
                                        <Button Grid.Row="2" Grid.Column="2" Content="📋 Копіювати" Margin="5,5,0,5" Padding="8,4"
                                                Click="CopyExternalIP_Click"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="🔌 Порт:" FontWeight="Bold" Margin="0,5" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="ConnectionPortTextBox" IsReadOnly="True"
                                                 FontFamily="Consolas" Margin="0,5" FontSize="13"/>
                                        <Button Grid.Row="3" Grid.Column="2" Content="📋 Копіювати" Margin="5,5,0,5" Padding="8,4"
                                                Click="CopyPort_Click"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="🔑 HW Fingerprint:" FontWeight="Bold" Margin="0,5" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="ConnectionFingerprintTextBox" IsReadOnly="True"
                                                 FontFamily="Consolas" Margin="0,5" FontSize="11"/>
                                        <Button Grid.Row="4" Grid.Column="2" Content="📋 Копіювати" Margin="5,5,0,5" Padding="8,4"
                                                Click="CopyFingerprint_Click"/>

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="📍 Повна адреса:" FontWeight="Bold" Margin="0,5" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="5" Grid.Column="1" x:Name="FullAddressTextBox" IsReadOnly="True"
                                                 FontFamily="Consolas" Margin="0,5" FontSize="13" Foreground="{StaticResource PrimaryBrush}"/>
                                        <Button Grid.Row="5" Grid.Column="2" Content="📋 Копіювати" Margin="5,5,0,5" Padding="8,4"
                                                Click="CopyFullAddress_Click"/>
                                    </Grid>
                                </GroupBox>

                                <GroupBox Header="Додаткова інформація" Margin="0,0,0,15">
                                    <Grid Margin="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="🖥️ Ім'я хоста:" FontWeight="Bold" Margin="0,5"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="HostNameTextBox" IsReadOnly="True"
                                                 FontFamily="Consolas" Margin="0,5"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="🔄 Статус порту:" FontWeight="Bold" Margin="0,5"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="PortStatusTextBox" IsReadOnly="True"
                                                 FontFamily="Consolas" Margin="0,5"/>
                                    </Grid>
                                </GroupBox>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                    <Button x:Name="RefreshConnectionInfoButton" Content="🔄 Оновити дані"
                                            Padding="15,8" Margin="0,0,10,0" Click="RefreshConnectionInfo_Click"/>
                                    <Button x:Name="CopyAllConnectionInfoButton" Content="📋 Копіювати все"
                                            Padding="15,8" Click="CopyAllConnectionInfo_Click"/>
                                </StackPanel>

                                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="0" Padding="15" Margin="0,15,0,0">
                                    <StackPanel>
                                        <TextBlock Text="💡 Як використовувати:" FontWeight="Bold" Margin="0,0,0,10"/>
                                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}">
                                            <Run Text="1. "/>
                                            <Run Text="Локальна IP" FontWeight="Bold"/>
                                            <Run Text=" - для з'єднання в межах однієї мережі (Wi-Fi, LAN)"/>
                                            <LineBreak/><LineBreak/>
                                            <Run Text="2. "/>
                                            <Run Text="Зовнішня IP" FontWeight="Bold"/>
                                            <Run Text=" - для з'єднання через Інтернет (потрібно налаштувати Port Forwarding на роутері)"/>
                                            <LineBreak/><LineBreak/>
                                            <Run Text="3. "/>
                                            <Run Text="Black-ID та HW Fingerprint" FontWeight="Bold"/>
                                            <Run Text=" - необхідні для автентифікації вузла"/>
                                            <LineBreak/><LineBreak/>
                                            <Run Text="4. Натисніть "/>
                                            <Run Text="'Копіювати все'" FontWeight="Bold"/>
                                            <Run Text=" та надішліть інформацію іншому користувачу через захищений канал"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Система -->
                    <TabItem Header="Система">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">
                                <GroupBox Header="Апаратна інформація">
                                    <Grid Margin="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="CPU ID:" FontWeight="Bold" Margin="0,5"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="CpuIdTextBox" IsReadOnly="True"
                                                 FontFamily="Consolas" Margin="0,5"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Motherboard:" FontWeight="Bold" Margin="0,5"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="MotherboardTextBox" IsReadOnly="True"
                                                 FontFamily="Consolas" Margin="0,5"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="MAC Address:" FontWeight="Bold" Margin="0,5"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="MacAddressTextBox" IsReadOnly="True"
                                                 FontFamily="Consolas" Margin="0,5"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Fingerprint:" FontWeight="Bold" Margin="0,5"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="FingerprintTextBox" IsReadOnly="True"
                                                 FontFamily="Consolas" Margin="0,5"/>
                                    </Grid>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                </TabControl>

                <!-- Кнопки -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SaveButton" Content="Зберегти"
                            Width="100" Padding="10,5" Margin="0,0,10,0"
                            Click="SaveButton_Click"/>
                    <Button x:Name="CancelButton" Content="Скасувати"
                            Width="100" Padding="10,5"
                            Click="CancelButton_Click"/>
                </StackPanel>

            </Grid>
        </Grid>
    </Border>
</Window>
