<Window x:Class="AsmodayCat.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="AsmodayCat — Control Panel"
        Icon="pack://application:,,,/Assets/AC.ico"
        Height="720" Width="1280"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        Background="Transparent">

    <Window.Resources>
        <!-- Nav item: light bg, dark text; gold when selected -->
        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground"      Value="{StaticResource BrushDark}"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Padding"         Value="16,11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D9B86A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushAccent}"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushLight}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BrushBackground}"
            BorderBrush="{StaticResource BrushAccent}"
            BorderThickness="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>   <!-- chrome header -->
                <RowDefinition Height="*"/>    <!-- content      -->
            </Grid.RowDefinitions>

            <!-- ── Chrome header ──────────────────────────────────────── -->
            <Border Grid.Row="0"
                    Background="{StaticResource BrushNav}"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown"
                    Padding="14,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/AC.ico"
                               Width="22" Height="22" Margin="0,0,10,0"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="AsmodayCat" FontWeight="Bold" FontSize="13"
                                   Foreground="{StaticResource BrushLight}"
                                   VerticalAlignment="Center" Margin="0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="—" Click="MinimizeButton_Click"
                                Style="{StaticResource ChromeButton}"/>
                        <Button x:Name="MaximizeButton" Content="□" Click="MaximizeButton_Click"
                                Style="{StaticResource ChromeButton}"/>
                        <Button Content="✕" Click="AppCloseButton_Click"
                                Style="{StaticResource ChromeCloseButton}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Main area: sidebar + content ──────────────────────── -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar — light sand bg, dark text (кольори поміняні) -->
                <DockPanel Grid.Column="0" Background="{StaticResource BrushBackground}">

                    <!-- Logo + brand -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                                Margin="12,18,12,20">
                        <Image Source="pack://application:,,,/Assets/AC.ico"
                               Width="28" Height="28" VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="ASMODAYCAT"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource BrushNav}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" Margin="0"/>
                    </StackPanel>

                    <!-- Divider -->
                    <Border DockPanel.Dock="Top" Height="1"
                            Background="{StaticResource BrushAccent}"
                            Margin="12,0,12,8" Opacity="0.5"/>

                    <!-- Nav links -->
                    <ListBox x:Name="NavList"
                             DockPanel.Dock="Top"
                             SelectionChanged="NavList_SelectionChanged"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource NavItemStyle}">
                        <ListBoxItem Content="Dashboard"   Tag="Dashboard"/>
                        <ListBoxItem Content="Chat"        Tag="Chat"/>
                        <ListBoxItem Content="Models"      Tag="Models"/>
                        <ListBoxItem Content="Hardware"    Tag="Hardware"/>
                        <ListBoxItem Content="Agent Rules" Tag="AgentRules"/>
                        <ListBoxItem Content="Terminal"    Tag="Terminal"/>
                    </ListBox>
                </DockPanel>

                <!-- Content frame — nav-brown bg; views set their own bg -->
                <Frame x:Name="ContentFrame"
                       Grid.Column="1"
                       Background="{StaticResource BrushNav}"
                       NavigationUIVisibility="Hidden"/>
            </Grid>
        </Grid>
    </Border>
</Window>
