<Window x:Class="AsmodayCat.UI.Views.StartupView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:l="clr-namespace:AsmodayCat.UI.Localization"
        xmlns:v="clr-namespace:AsmodayCat.UI.Views"
        Title="{l:Tr startup.title}"
        Icon="pack://application:,,,/Assets/AC.ico"
        Height="560" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{StaticResource BrushBackground}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="150" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="CheckRow" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrushSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- brand -->
                <RowDefinition Height="*"/>      <!-- checks -->
                <RowDefinition Height="Auto"/>   <!-- buttons -->
                <RowDefinition Height="Auto"/>   <!-- footer -->
            </Grid.RowDefinitions>

            <!-- ── Brand band (drag area) ── -->
            <Grid Grid.Row="0" Background="{StaticResource BrushSidebar}" Height="150"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <v:LanguageSwitcher Margin="0,6,8,0" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Click="MinimizeButton_Click" Style="{StaticResource ChromeButton}" Foreground="#B8AF95"
                            WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{l:Tr common.minimize}">
                        <materialDesign:PackIcon Kind="WindowMinimize" Width="16" Height="16"/>
                    </Button>
                    <Button Click="CloseButton_Click" Style="{StaticResource ChromeCloseButton}" Foreground="#B8AF95"
                            WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{l:Tr common.exit}">
                        <materialDesign:PackIcon Kind="WindowClose" Width="16" Height="16"/>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="36,0,0,0">
                    <Border Width="72" Height="72" CornerRadius="18" Background="#4A4429">
                        <Image Source="pack://application:,,,/Assets/AC.ico" Width="50" Height="50"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="AsmodayCat" FontSize="28" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="{l:Tr startup.tagline}" FontSize="13"
                                   Foreground="{StaticResource BrushSidebarText}" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ── Checks ── -->
            <StackPanel Grid.Row="1" Margin="36,28,36,0">
                <TextBlock Text="{l:Tr startup.checksTitle}" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>

                <Border Style="{StaticResource CheckRow}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource BrushAccentSoft}" Margin="0,0,14,0">
                            <materialDesign:PackIcon Kind="ServerOutline" Width="20" Height="20" Foreground="{StaticResource BrushAccent}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{l:Tr startup.service}" FontWeight="SemiBold" FontSize="13.5"
                                       Foreground="{StaticResource BrushDark}"/>
                            <TextBlock Text="{Binding ServiceStatus}" FontSize="12" Foreground="{Binding ServiceColor}"
                                       Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <materialDesign:PackIcon Grid.Column="2" x:Name="ServiceIcon" Kind="ClockOutline"
                                                 Width="24" Height="24" Foreground="{StaticResource BrushMuted}"
                                                 VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CheckRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource BrushAccentSoft}" Margin="0,0,14,0">
                            <materialDesign:PackIcon Kind="CubeOutline" Width="20" Height="20" Foreground="{StaticResource BrushAccent}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{l:Tr startup.llm}" FontWeight="SemiBold" FontSize="13.5"
                                       Foreground="{StaticResource BrushDark}"/>
                            <TextBlock Text="{Binding LlmStatus}" FontSize="12" Foreground="{Binding LlmColor}"
                                       Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <materialDesign:PackIcon Grid.Column="2" x:Name="LlmIcon" Kind="ClockOutline"
                                                 Width="24" Height="24" Foreground="{StaticResource BrushMuted}"
                                                 VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Progress + first-run fixes -->
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" FontSize="12"
                           TextAlignment="Center" Margin="0,18,0,8"/>
                <ProgressBar x:Name="LoadingProgress" Height="4"
                             Foreground="{StaticResource BrushAccent}" Background="{StaticResource BrushSurfaceAlt}"
                             BorderThickness="0" Maximum="100"
                             Value="{Binding InstallPercent}" IsIndeterminate="{Binding IsChecking}"/>

                <Button Command="{Binding InstallOllamaCommand}" Style="{StaticResource AccentButton}" Height="38"
                        Visibility="{Binding OllamaMissing, Converter={StaticResource BoolToVisConverter}}"
                        IsEnabled="{Binding IsInstalling, Converter={StaticResource InverseBoolConverter}}"
                        Margin="0,14,0,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Download" Width="17" Height="17" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{l:Tr startup.installOllama}"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding InstallRecommendedModelCommand}" Style="{StaticResource AccentButton}" Height="38"
                        Visibility="{Binding NoModels, Converter={StaticResource BoolToVisConverter}}"
                        IsEnabled="{Binding IsInstalling, Converter={StaticResource InverseBoolConverter}}"
                        Margin="0,14,0,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Download" Width="17" Height="17" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{l:Tr startup.installModel}"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- ── Buttons ── -->
            <Grid Grid.Row="2" Margin="36,20,36,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="ContinueButton" Grid.Column="0" Content="{l:Tr startup.continue}"
                        IsEnabled="{Binding CanContinue}" Click="ContinueButton_Click"
                        Style="{StaticResource AccentButton}" Height="42" FontSize="14"/>
                <Button x:Name="ExitButton" Grid.Column="2" Content="{l:Tr startup.exit}"
                        Command="{Binding ExitCommand}"
                        Style="{StaticResource QuietButton}" Height="42" FontSize="14"/>
            </Grid>

            <!-- ── Footer ── -->
            <Border Grid.Row="3" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="14,10">
                <TextBlock Text="{Binding VersionFooter}" Style="{StaticResource Caption}" TextAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</Window>
