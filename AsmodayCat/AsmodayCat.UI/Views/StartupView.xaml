<Window x:Class="AsmodayCat.UI.Views.StartupView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AsmodayCat — Запуск"
        Icon="pack://application:,,,/Assets/AC.ico"
        Height="620" Width="660"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BrushBackground}"
        WindowStyle="None"
        AllowsTransparency="True">

    <Border BorderBrush="{StaticResource BrushAccent}"
            BorderThickness="2"
            Background="{StaticResource BrushBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- header   -->
                <RowDefinition Height="*"/>      <!-- content  -->
                <RowDefinition Height="Auto"/>   <!-- footer   -->
            </Grid.RowDefinitions>

            <!-- ── Заголовок ────────────────────────────────────────────── -->
            <Border Grid.Row="0"
                    Background="{StaticResource BrushNav}"
                    Padding="20,16"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0"
                           Source="pack://application:,,,/Assets/AC.ico"
                           Width="56" Height="56"
                           Margin="0,0,18,0"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="AsmodayCat"
                                   FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource BrushAccent}"
                                   Margin="0"/>
                        <TextBlock Text="Local LLM Control Suite"
                                   FontSize="12"
                                   Foreground="{StaticResource BrushLight}"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- Chrome кнопки -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Top">
                        <Button Content="—" Click="MinimizeButton_Click"
                                Style="{StaticResource ChromeButton}"/>
                        <Button Content="✕" Click="CloseButton_Click"
                                Style="{StaticResource ChromeCloseButton}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Основний контент ──────────────────────────────────────── -->
            <Grid Grid.Row="1" Margin="28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- статус-картки  -->
                    <RowDefinition Height="Auto"/>   <!-- прогрес        -->
                    <RowDefinition Height="*"/>      <!-- кнопки (знизу) -->
                </Grid.RowDefinitions>

                <!-- Статус системи (GroupBox-подібний) -->
                <Border Grid.Row="0" Margin="0,0,0,18"
                        Background="{StaticResource BrushSurface}"
                        BorderBrush="{StaticResource BrushAccent}"
                        BorderThickness="1">
                    <StackPanel>
                        <!-- GroupBox header -->
                        <Border Background="{StaticResource BrushNav}"
                                Padding="14,9">
                            <TextBlock Text="Статус системи"
                                       FontWeight="SemiBold" FontSize="13"
                                       Foreground="{StaticResource BrushAccent}"
                                       Margin="0"/>
                        </Border>

                        <StackPanel Margin="14,14,14,14">

                            <!-- Рядок 1: Windows Service -->
                            <Border BorderBrush="{StaticResource BrushAccent}"
                                    BorderThickness="1"
                                    Padding="14"
                                    Margin="0,0,0,8"
                                    Background="{StaticResource BrushBackground}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="⚙"
                                               FontSize="22" Margin="0,0,14,0"
                                               VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Windows Service"
                                                   FontWeight="Bold" FontSize="13"
                                                   Foreground="{StaticResource BrushDark}"
                                                   Margin="0"/>
                                        <TextBlock Text="{Binding ServiceStatus}"
                                                   FontSize="11"
                                                   Foreground="{Binding ServiceColor}"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                                               x:Name="ServiceIcon"
                                               Text="⏳"
                                               FontSize="28"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Рядок 2: LLM Engine -->
                            <Border BorderBrush="{StaticResource BrushAccent}"
                                    BorderThickness="1"
                                    Padding="14"
                                    Background="{StaticResource BrushBackground}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="🤖"
                                               FontSize="22" Margin="0,0,14,0"
                                               VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="LLM Engine (Ollama)"
                                                   FontWeight="Bold" FontSize="13"
                                                   Foreground="{StaticResource BrushDark}"
                                                   Margin="0"/>
                                        <TextBlock Text="{Binding LlmStatus}"
                                                   FontSize="11"
                                                   Foreground="{Binding LlmColor}"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                                               x:Name="LlmIcon"
                                               Text="⏳"
                                               FontSize="28"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Прогрес -->
                <StackPanel Grid.Row="1" Margin="0,0,0,18">
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="12"
                               Foreground="{StaticResource BrushNav}"
                               TextAlignment="Center"
                               Margin="0,0,0,10"/>
                    <ProgressBar x:Name="LoadingProgress"
                                 Height="6"
                                 Foreground="{StaticResource BrushAccent}"
                                 Background="#D9B86A"
                                 IsIndeterminate="{Binding IsChecking}"/>
                </StackPanel>

                <!-- Кнопки дій -->
                <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                    <UniformGrid Columns="2" Rows="1">
                        <Button x:Name="ContinueButton"
                                Content="▶  Продовжити"
                                IsEnabled="{Binding CanContinue}"
                                Click="ContinueButton_Click"
                                Background="{StaticResource BrushAccent}"
                                Foreground="{StaticResource BrushLight}"
                                Margin="0,0,4,0"
                                Height="42" FontSize="13" FontWeight="SemiBold"/>

                        <Button x:Name="ExitButton"
                                Content="✕  Вихід"
                                Command="{Binding ExitCommand}"
                                Background="{StaticResource BrushSurface}"
                                Foreground="{StaticResource BrushWarning}"
                                BorderBrush="{StaticResource BrushWarning}"
                                BorderThickness="1"
                                Margin="4,0,0,0"
                                Height="42" FontSize="13" FontWeight="SemiBold"/>
                    </UniformGrid>
                </StackPanel>
            </Grid>

            <!-- ── Футер ─────────────────────────────────────────────────── -->
            <Border Grid.Row="2"
                    Background="{StaticResource BrushSurface}"
                    Padding="14,10">
                <TextBlock Text="© 2025 CatSuite | AsmodayCat — Local LLM Control Suite"
                           FontSize="10"
                           Foreground="{StaticResource BrushNav}"
                           TextAlignment="Center"
                           Margin="0"/>
            </Border>
        </Grid>
    </Border>
</Window>
