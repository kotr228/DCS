<UserControl x:Class="AsmodayCat.UI.Views.TerminalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:AsmodayCat.UI.Localization"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <!-- Level filter chip: a pill with a colored dot (color comes from Tag) -->
        <Style x:Key="FilterChip" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource BrushMuted}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="15" Padding="12,5" BorderThickness="1"
                                Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Opacity="0.35"
                                         VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushAccentSoft}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E6D6A8"/>
                                <Setter TargetName="Dot" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushDark}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BrushBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- header -->
            <RowDefinition Height="Auto"/>  <!-- filter chips -->
            <RowDefinition Height="*"/>     <!-- console -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="32,8,32,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox Content="{l:Tr term.autoscroll}" IsChecked="{Binding AutoScroll}"
                          Foreground="{StaticResource BrushDark}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button Command="{Binding ExportLogsCommand}" Style="{StaticResource QuietButton}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Export" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{l:Tr term.export}"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ClearCommand}" Style="{StaticResource QuietButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="NotificationClearAll" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{l:Tr term.clear}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{l:Tr term.title}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{l:Tr term.subtitle}" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
        </DockPanel>

        <!-- Level filters -->
        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="32,0,32,12">
            <ToggleButton Content="{l:Tr term.info}"     IsChecked="{Binding ShowInfo}"    Style="{StaticResource FilterChip}" Tag="#4F8A4A"/>
            <ToggleButton Content="{l:Tr term.warning}"    IsChecked="{Binding ShowWarning}" Style="{StaticResource FilterChip}" Tag="#C98A2E"/>
            <ToggleButton Content="{l:Tr term.errors}"  IsChecked="{Binding ShowError}"   Style="{StaticResource FilterChip}" Tag="#B3362B"/>
            <ToggleButton Content="{l:Tr term.agents}"   IsChecked="{Binding ShowAgent}"   Style="{StaticResource FilterChip}" Tag="#AE8530"/>
            <ToggleButton Content="{l:Tr term.system}"  IsChecked="{Binding ShowSystem}"  Style="{StaticResource FilterChip}" Tag="#9C9270"/>
            <ToggleButton Content="{l:Tr term.network}"   IsChecked="{Binding ShowNetwork}" Style="{StaticResource FilterChip}" Tag="#4A7FA8"/>
        </WrapPanel>

        <!-- Console: log + command line in one dark panel -->
        <Border Grid.Row="2" Margin="32,0,32,24" CornerRadius="10" Background="{StaticResource BrushTerminal}"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer x:Name="Scroller" Grid.Row="0" Padding="16,12"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                              CanContentScroll="False">
                    <ItemsControl ItemsSource="{Binding FilteredLogs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="Tb" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                                           Margin="0,1" Foreground="#CFE3C8">
                                    <Run Text="{Binding Timestamp, StringFormat=HH:mm:ss}" Foreground="#7D7660"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding Level}" Foreground="#9C937A"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding Source}" Foreground="#D9B45A"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding Message}"/>
                                </TextBlock>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Level}" Value="Warning">
                                        <Setter TargetName="Tb" Property="Foreground" Value="#E8B86A"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="Error">
                                        <Setter TargetName="Tb" Property="Foreground" Value="#F08A7E"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="Agent">
                                        <Setter TargetName="Tb" Property="Foreground" Value="#EEDDA8"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="System">
                                        <Setter TargetName="Tb" Property="Foreground" Value="#B8AF95"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="Network">
                                        <Setter TargetName="Tb" Property="Foreground" Value="#8FBCE0"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Command line -->
                <Border Grid.Row="1" Background="#201E14" BorderBrush="#454029" BorderThickness="0,1,0,0" Padding="12,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0" Kind="ChevronRight" Width="18" Height="18"
                                                 Foreground="#D9B45A" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" FontFamily="Consolas" FontSize="13"
                                 Background="Transparent" Foreground="#F2EBD8" CaretBrush="#D9B45A" BorderThickness="0"
                                 materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                                 materialDesign:HintAssist.Foreground="#7D7660"
                                 Text="{Binding CurrentCommand, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center" Padding="6,6" Margin="4,0"
                                 materialDesign:HintAssist.Hint="/help  /status  /memory  /rules  /kill_all">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SendCommandCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="2" Command="{Binding SendCommandCommand}" Style="{StaticResource AccentButton}"
                                Height="30">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{l:Tr term.run}"/>
                                <materialDesign:PackIcon Kind="KeyboardReturn" Width="15" Height="15" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
