<UserControl x:Class="AsmodayCat.UI.Views.TerminalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="20" Background="{StaticResource BrushBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- title + controls -->
            <RowDefinition Height="Auto"/>  <!-- filter chips -->
            <RowDefinition Height="*"/>     <!-- log area -->
            <RowDefinition Height="Auto"/>  <!-- CLI input -->
        </Grid.RowDefinitions>

        <!-- Title row + controls -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="TERMINAL" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource BrushNav}" VerticalAlignment="Center"
                       DockPanel.Dock="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="CLEAR"
                        Command="{Binding ClearCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Foreground="{StaticResource BrushDark}"
                        BorderBrush="{StaticResource BrushNav}"
                        Height="28" Padding="10,0" Margin="0,0,6,0"/>
                <Button Content="EXPORT"
                        Command="{Binding ExportLogsCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Foreground="{StaticResource BrushDark}"
                        BorderBrush="{StaticResource BrushNav}"
                        Height="28" Padding="10,0" Margin="0,0,10,0"/>
                <CheckBox Content="Auto-scroll"
                          IsChecked="{Binding AutoScroll}"
                          Foreground="{StaticResource BrushDark}"
                          VerticalAlignment="Center"/>
            </StackPanel>
        </DockPanel>

        <!-- Level filter chips -->
        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <ToggleButton Content="INFO"
                          IsChecked="{Binding ShowInfo}"
                          Style="{StaticResource MaterialDesignFlatToggleButton}"
                          Foreground="#5E9D55" Padding="8,2" Margin="0,0,4,0" Height="24"/>
            <ToggleButton Content="WARN"
                          IsChecked="{Binding ShowWarning}"
                          Style="{StaticResource MaterialDesignFlatToggleButton}"
                          Foreground="#BC907E" Padding="8,2" Margin="0,0,4,0" Height="24"/>
            <ToggleButton Content="ERROR"
                          IsChecked="{Binding ShowError}"
                          Style="{StaticResource MaterialDesignFlatToggleButton}"
                          Foreground="#EF5350" Padding="8,2" Margin="0,0,4,0" Height="24"/>
            <ToggleButton Content="AGENT"
                          IsChecked="{Binding ShowAgent}"
                          Style="{StaticResource MaterialDesignFlatToggleButton}"
                          Foreground="#BC8F3C" Padding="8,2" Margin="0,0,4,0" Height="24"/>
            <ToggleButton Content="SYSTEM"
                          IsChecked="{Binding ShowSystem}"
                          Style="{StaticResource MaterialDesignFlatToggleButton}"
                          Foreground="#79644D" Padding="8,2" Margin="0,0,4,0" Height="24"/>
            <ToggleButton Content="NET"
                          IsChecked="{Binding ShowNetwork}"
                          Style="{StaticResource MaterialDesignFlatToggleButton}"
                          Foreground="#42A5F5" Padding="8,2" Height="24"/>
        </WrapPanel>

        <!-- Log area -->
        <Border Grid.Row="2" Background="#2A1F12" CornerRadius="4" Padding="6">
            <ScrollViewer x:Name="Scroller"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          CanContentScroll="False">
                <ItemsControl ItemsSource="{Binding FilteredLogs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="Tb"
                                       FontFamily="Consolas" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,1"
                                       Foreground="#A5D6A7">
                                <Run Text="{Binding Timestamp, StringFormat=HH:mm:ss}"/>
                                <Run Text=" [" Foreground="#6B5B45"/>
                                <Run Text="{Binding Level}" Foreground="#8C7254"/>
                                <Run Text="] " Foreground="#6B5B45"/>
                                <Run Text="{Binding Source}" Foreground="#BC8F3C"/>
                                <Run Text=": "/>
                                <Run Text="{Binding Message}"/>
                            </TextBlock>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Level}" Value="Warning">
                                    <Setter TargetName="Tb" Property="Foreground" Value="#BC907E"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="Error">
                                    <Setter TargetName="Tb" Property="Foreground" Value="#EF5350"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="Agent">
                                    <Setter TargetName="Tb" Property="Foreground" Value="#BC8F3C"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="System">
                                    <Setter TargetName="Tb" Property="Foreground" Value="#79644D"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="Network">
                                    <Setter TargetName="Tb" Property="Foreground" Value="#42A5F5"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- CLI input -->
        <Grid Grid.Row="3" Background="#2A1F12" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="&gt;"
                       FontFamily="Consolas" FontSize="13"
                       Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center"
                       Margin="8,0,4,0"/>

            <TextBox Grid.Column="1"
                     FontFamily="Consolas" FontSize="12"
                     Background="Transparent" Foreground="#F9F6F0"
                     CaretBrush="{StaticResource BrushAccent}" BorderThickness="0"
                     Text="{Binding CurrentCommand, UpdateSourceTrigger=PropertyChanged}"
                     VerticalAlignment="Center" Padding="4,6"
                     materialDesign:HintAssist.Hint="/ping  /status  /help  /kill_all">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding SendCommandCommand}"/>
                </TextBox.InputBindings>
            </TextBox>

            <Button Grid.Column="2" Content="EXECUTE"
                    Command="{Binding SendCommandCommand}"
                    Background="{StaticResource BrushAccent}"
                    Foreground="{StaticResource BrushLight}"
                    Height="32" Margin="4,4" Padding="10,0"/>
        </Grid>

    </Grid>
</UserControl>
