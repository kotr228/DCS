<UserControl x:Class="AsmodayCat.UI.Views.ModelsManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="20" Background="{StaticResource BrushBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- header + custom pull -->
            <RowDefinition Height="Auto"/>  <!-- status bar -->
            <RowDefinition Height="*"/>     <!-- data grid -->
        </Grid.RowDefinitions>

        <!-- Header row -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="MODEL POOL" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource BrushNav}" VerticalAlignment="Center"/>

            <Button Grid.Column="1" Content="REFRESH"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Foreground="{StaticResource BrushDark}"
                    BorderBrush="{StaticResource BrushNav}"
                    Margin="12,0,0,0" Height="32" Padding="10,0"/>

            <TextBox Grid.Column="3"
                     materialDesign:HintAssist.Hint="custom-model-name:tag"
                     Text="{Binding CustomModelInput, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Width="220" Height="32" Margin="0,0,8,0"
                     VerticalAlignment="Center"/>

            <Button Grid.Column="4" Content="PULL CUSTOM"
                    Command="{Binding PullCustomModelCommand}"
                    Background="{StaticResource BrushAccent}"
                    Foreground="{StaticResource BrushLight}"
                    Height="32" Padding="10,0"/>
        </Grid>

        <!-- Status bar -->
        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}"
                   FontSize="11" Foreground="#888" Margin="0,0,0,8"/>

        <!-- Model pool DataGrid -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding ModelPool}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserResizeRows="False"
                  IsReadOnly="True"
                  Background="Transparent"
                  BorderThickness="0"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#C8B89A"
                  RowBackground="Transparent"
                  AlternatingRowBackground="#F5EDD9"
                  ColumnHeaderHeight="36">

            <DataGrid.Columns>

                <DataGridTextColumn Header="MODEL" Binding="{Binding Name}"
                                    Width="200" FontFamily="Consolas" FontSize="12"/>

                <DataGridTextColumn Header="TASK" Binding="{Binding RecommendedTask}"
                                    Width="130" FontSize="11"/>

                <DataGridTextColumn Header="VRAM" Binding="{Binding VramDisplayText}"
                                    Width="80" FontSize="11"/>

                <DataGridTemplateColumn Header="STATUS" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="StatusLabel"
                                       Text="{Binding Status}"
                                       FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="4,0"/>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="NotInstalled">
                                    <Setter TargetName="StatusLabel" Property="Foreground" Value="#888"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Downloading">
                                    <Setter TargetName="StatusLabel" Property="Foreground" Value="#BC8F3C"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Ready">
                                    <Setter TargetName="StatusLabel" Property="Foreground" Value="#5E9D55"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Loaded">
                                    <Setter TargetName="StatusLabel" Property="Foreground" Value="#79644D"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="PROGRESS" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,0">
                                <ProgressBar x:Name="PBar"
                                             Value="{Binding DownloadProgress}"
                                             Maximum="100" Height="6"
                                             Foreground="#BC8F3C"
                                             Visibility="Collapsed"/>
                                <TextBlock x:Name="PText"
                                           Text="{Binding DownloadProgress, StringFormat={}{0:F0}%}"
                                           FontSize="10" Foreground="#BC8F3C"
                                           Margin="0,2,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Downloading">
                                    <Setter TargetName="PBar"  Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="PText" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="ACTION" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="2,0">
                                <Button x:Name="BtnDownload"
                                        Visibility="Collapsed"
                                        ToolTip="Download"
                                        Style="{StaticResource MaterialDesignIconButton}"
                                        Width="28" Height="28"
                                        Foreground="{StaticResource BrushAccent}"
                                        Command="{Binding DataContext.ActionCommand,
                                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}">
                                    <materialDesign:PackIcon Kind="Download" Width="16" Height="16"/>
                                </Button>

                                <Button x:Name="BtnUnload"
                                        Visibility="Collapsed"
                                        ToolTip="Unload from VRAM"
                                        Style="{StaticResource MaterialDesignIconButton}"
                                        Width="28" Height="28"
                                        Foreground="{StaticResource BrushWarning}"
                                        Command="{Binding DataContext.ActionCommand,
                                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}">
                                    <materialDesign:PackIcon Kind="Stop" Width="16" Height="16"/>
                                </Button>
                            </StackPanel>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="NotInstalled">
                                    <Setter TargetName="BtnDownload" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Loaded">
                                    <Setter TargetName="BtnUnload" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
