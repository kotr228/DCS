<UserControl x:Class="AsmodayCat.UI.Views.ModelsManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="MODEL POOL" FontSize="18" FontWeight="Bold"
                       Foreground="#B39DDB" VerticalAlignment="Center"/>
            <Button Content="REFRESH" Command="{Binding RefreshCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Margin="12,0,0,0" Height="28" Padding="8,0"/>
        </StackPanel>

        <!-- Models list -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Models}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  Background="Transparent"
                  BorderThickness="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Model"    Binding="{Binding ModelId}"       Width="180"/>
                <DataGridTextColumn Header="Task"     Binding="{Binding TaskType}"      Width="140"/>
                <DataGridTextColumn Header="VRAM MB"  Binding="{Binding RequiredVramMb}" Width="80"/>
                <DataGridTextColumn Header="Status"   Binding="{Binding Status}"        Width="120"/>
                <DataGridTemplateColumn Header="Progress" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ProgressBar Value="{Binding PullPercent}" Maximum="100"
                                         Height="8" Margin="4,0"
                                         Visibility="{Binding IsLocal, Converter={StaticResource BoolToVisConverter},
                                                      ConverterParameter=inverse}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Action" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="PULL"
                                    Command="{Binding DataContext.PullModelCommand,
                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Visibility="{Binding IsLocal, Converter={StaticResource BoolToVisConverter},
                                                 ConverterParameter=inverse}"
                                    Height="24" Padding="6,0" FontSize="10"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
