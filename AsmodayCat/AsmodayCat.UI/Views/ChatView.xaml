<UserControl x:Class="AsmodayCat.UI.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mdxam="clr-namespace:Markdig.Wpf;assembly=Markdig.Wpf">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="CHAT" FontSize="18" FontWeight="Bold"
                       Foreground="#B39DDB" VerticalAlignment="Center"/>
            <Button Content="CLEAR" Command="{Binding ClearChatCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Margin="12,0,0,0" Height="28" Padding="8,0"/>
        </StackPanel>

        <!-- Messages list -->
        <ScrollViewer Grid.Row="1" x:Name="Scroller"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,4" Padding="12,8"
                                CornerRadius="6"
                                Background="{Binding Role, Converter={StaticResource RoleToBrushConverter}}">
                            <StackPanel>
                                <TextBlock Text="{Binding Role}" FontSize="10"
                                           Foreground="#888" Margin="0,0,0,4"
                                           FontWeight="Bold"
                                           Typography.Capitals="AllSmallCaps"/>
                                <!-- Markdown rendering -->
                                <mdxam:MarkdownViewer Markdown="{Binding Content}"
                                                       Foreground="White"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Thinking / Tool indicator -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8">
            <materialDesign:PackIcon Kind="Robot" Width="16" Height="16"
                                     Foreground="#B39DDB"
                                     Visibility="{Binding IsThinking, Converter={StaticResource BoolToVisConverter}}"/>
            <TextBlock Foreground="#B39DDB" Margin="4,0,0,0" FontStyle="Italic"
                       Visibility="{Binding IsThinking, Converter={StaticResource BoolToVisConverter}}">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0}">
                        <Binding Path="ActiveToolName"
                                 StringFormat="Agent using tool: {0}..."
                                 FallbackValue="Agent is thinking..."/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </StackPanel>

        <!-- Input row -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputBox"
                     materialDesign:HintAssist.Hint="Type a message..."
                     Text="{Binding UserInput, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="False"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     KeyDown="InputBox_KeyDown"/>
            <Button Grid.Column="1" Content="SEND"
                    Command="{Binding SendCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Margin="8,0,0,0"
                    IsEnabled="{Binding IsThinking, Converter={StaticResource InverseBoolConverter}}"/>
        </Grid>
    </Grid>
</UserControl>
