<UserControl x:Class="AsmodayCat.UI.Views.AgentRulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="AGENT RULES" FontSize="18" FontWeight="Bold"
                   Foreground="#B39DDB" Margin="0,0,0,16"/>

        <!-- Add new folder form -->
        <materialDesign:Card Grid.Row="1" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Add Watched Folder" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBox materialDesign:HintAssist.Hint="Folder path (e.g. C:\CatSuite\Tasks)"
                         Text="{Binding NewFolderPath, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,8"/>
                <TextBox materialDesign:HintAssist.Hint="System prompt for this folder"
                         Text="{Binding NewSystemPrompt, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" Height="60" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,8"/>
                <TextBox materialDesign:HintAssist.Hint="Allowed extensions (.txt,.md,.pdf)"
                         Text="{Binding NewExtensions, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                               Foreground="#EF9A9A" Margin="0,0,12,0"/>
                    <Button Content="ADD FOLDER"
                            Command="{Binding AddFolderCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"/>
                </StackPanel>
            </StackPanel>
        </materialDesign:Card>

        <!-- Watched folders list -->
        <ListView Grid.Row="2" ItemsSource="{Binding WatchedFolders}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Path}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding SystemPrompt}" Foreground="#888"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="STOP"
                                CommandParameter="{Binding}"
                                Command="{Binding DataContext.RemoveFolderCommand,
                                          RelativeSource={RelativeSource AncestorType=ListView}}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
