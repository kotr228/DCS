<UserControl x:Class="AsmodayCat.UI.Views.AgentRulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" MaxWidth="700">

            <!-- Title -->
            <TextBlock Text="AGENT RULES" FontSize="18" FontWeight="Bold"
                       Foreground="#B39DDB" Margin="0,0,0,20"/>

            <!-- Add Watched Folder form -->
            <materialDesign:Card Padding="20" Margin="0,0,0,16" Background="#1A1A1A">
                <StackPanel>
                    <TextBlock Text="Add Watched Folder" FontSize="13" FontWeight="Bold"
                               Foreground="#B39DDB" Margin="0,0,0,16"/>

                    <TextBox materialDesign:HintAssist.Hint="Input folder path (e.g. C:\CatSuite\Tasks)"
                             Text="{Binding NewFolderPath, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,0,10"/>

                    <TextBox materialDesign:HintAssist.Hint="Output folder path (leave empty = same as input)"
                             Text="{Binding NewOutputPath, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,0,10"/>

                    <ComboBox materialDesign:HintAssist.Hint="Action"
                              ItemsSource="{Binding AvailableActions}"
                              SelectedItem="{Binding NewAction}"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              Margin="0,0,0,10"/>

                    <TextBox materialDesign:HintAssist.Hint="System prompt override (optional)"
                             Text="{Binding NewSystemPrompt, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             AcceptsReturn="True" Height="64" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,10"/>

                    <TextBox materialDesign:HintAssist.Hint="Allowed extensions (*.*  or  .txt,.md,.pdf)"
                             Text="{Binding NewExtensions, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,0,12"/>

                    <!-- FR-A2: Internet Access toggle -->
                    <DockPanel Margin="0,0,0,16">
                        <TextBlock Text="Allow Internet Access for this agent"
                                   FontSize="12" VerticalAlignment="Center"
                                   DockPanel.Dock="Left"/>
                        <ToggleButton IsChecked="{Binding AllowInternetAccess}"
                                      HorizontalAlignment="Right"
                                      Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                      ToolTip="Agent can call WebSearchTool via BlackCat Bridge"/>
                    </DockPanel>

                    <!-- Status + Add button -->
                    <DockPanel>
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="#EF9A9A" FontSize="11"
                                   VerticalAlignment="Center" DockPanel.Dock="Left"/>
                        <Button Content="ADD FOLDER"
                                Command="{Binding AddRuleCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                HorizontalAlignment="Right"/>
                    </DockPanel>
                </StackPanel>
            </materialDesign:Card>

            <!-- FR-A1: Active Workspaces section -->
            <DockPanel Margin="0,0,0,10">
                <TextBlock Text="ACTIVE WORKSPACES" FontSize="13" FontWeight="Bold"
                           Foreground="#B39DDB" VerticalAlignment="Center"
                           DockPanel.Dock="Left"/>
                <Button Content="REFRESH"
                        Command="{Binding LoadRulesCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        HorizontalAlignment="Right"
                        Height="30" Padding="10,0"/>
            </DockPanel>

            <!-- Empty state -->
            <TextBlock Text="No workspaces configured yet."
                       Foreground="#555" FontSize="12"
                       Margin="0,8,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveRules.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- FR-A1: Rules list as material cards -->
            <ItemsControl ItemsSource="{Binding ActiveRules}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <materialDesign:Card Padding="14" Margin="0,0,0,8"
                                             Background="#111">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Status dot -->
                                <Ellipse Grid.Column="0" Width="8" Height="8"
                                         Fill="#66BB6A" VerticalAlignment="Center"
                                         Margin="0,0,10,0"/>

                                <!-- Path + action -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding InputPath}"
                                               FontFamily="Consolas" FontSize="12"
                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock FontSize="11" Foreground="#888" Margin="0,2,0,0">
                                        <Run Text="{Binding ActionType}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding AllowedExtensions}"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Internet icon (FR-A2) -->
                                <materialDesign:PackIcon Grid.Column="2"
                                    Kind="Web" Width="18" Height="18"
                                    VerticalAlignment="Center" Margin="8,0">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Foreground" Value="#555"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AllowInternetAccess}" Value="True">
                                                    <Setter Property="Foreground" Value="#42A5F5"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>

                                <!-- Remove button (FR-A4) -->
                                <Button Grid.Column="3"
                                        Style="{StaticResource MaterialDesignIconButton}"
                                        Width="32" Height="32"
                                        Foreground="#EF5350"
                                        ToolTip="Stop monitoring and remove rule"
                                        Command="{Binding DataContext.RemoveRuleCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding Id}">
                                    <materialDesign:PackIcon Kind="Delete" Width="16" Height="16"/>
                                </Button>
                            </Grid>
                        </materialDesign:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
