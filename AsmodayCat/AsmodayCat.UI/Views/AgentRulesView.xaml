<UserControl x:Class="AsmodayCat.UI.Views.AgentRulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:AsmodayCat.UI.Localization"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <Style x:Key="FormBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="RuleAction" TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource BrushNav}"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource BrushBackground}">
        <StackPanel Margin="32,8,32,28" MaxWidth="1240">

            <!-- Header -->
            <DockPanel Margin="0,0,0,20">
                <Button DockPanel.Dock="Right" Command="{Binding LoadRulesCommand}" Style="{StaticResource QuietButton}"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{l:Tr common.refresh}"/>
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="{l:Tr agents.title}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{l:Tr agents.subtitle}"
                               Style="{StaticResource PageSubtitle}"/>
                </StackPanel>
            </DockPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="400"/>
                </Grid.ColumnDefinitions>

                <!-- ── Left: watched folders ── -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{l:Tr agents.list}" Style="{StaticResource SectionTitle}" Margin="2,0,0,10"/>

                    <!-- Empty state -->
                    <materialDesign:Card>
                        <materialDesign:Card.Style>
                            <Style TargetType="materialDesign:Card" BasedOn="{StaticResource {x:Type materialDesign:Card}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveRules.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </materialDesign:Card.Style>
                        <StackPanel Margin="0,24">
                            <materialDesign:PackIcon Kind="FolderPlusOutline" Style="{StaticResource EmptyIcon}"/>
                            <TextBlock Text="{l:Tr agents.emptyTitle}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushDark}" HorizontalAlignment="Center" Margin="0,10,0,4"/>
                            <TextBlock Text="{l:Tr agents.emptyText}"
                                       Style="{StaticResource Caption}" TextAlignment="Center" MaxWidth="380"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <ItemsControl ItemsSource="{Binding ActiveRules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <materialDesign:Card Padding="16,14" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                                                Background="{StaticResource BrushAccentSoft}" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="FolderEyeOutline" Width="20" Height="20"
                                                                     Foreground="{StaticResource BrushAccent}"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding InputPath}" FontSize="13.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource BrushDark}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding InputPath}"/>
                                            <WrapPanel Margin="0,6,0,0">
                                                <Border Background="{StaticResource BrushAccentSoft}" CornerRadius="10" Padding="9,2" Margin="0,0,6,2">
                                                    <TextBlock Text="{l:TrLabel ActionType}"
                                                               FontSize="11.5" Foreground="#7D6020"/>
                                                </Border>
                                                <Border Background="{StaticResource BrushSurfaceAlt}" CornerRadius="10" Padding="9,2" Margin="0,0,6,2">
                                                    <TextBlock Text="{Binding AllowedExtensions}" FontSize="11.5" Foreground="{StaticResource BrushNav}"/>
                                                </Border>
                                                <Border CornerRadius="10" Padding="9,2" Margin="0,0,6,2">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Setter Property="Background" Value="#E6F0E3"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding AllowInternetAccess}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Web" Width="12" Height="12" VerticalAlignment="Center"
                                                                                 Foreground="{StaticResource BrushSuccess}"/>
                                                        <TextBlock Text="{l:Tr agents.internetChip}" FontSize="11.5" Foreground="{StaticResource BrushSuccess}" Margin="4,0,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </WrapPanel>
                                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap" ToolTip="{Binding OutputPath}">
                                                <Run Text="{l:Tr agents.resultsTo}"/><Run Text="{Binding OutputPath, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <ToggleButton IsChecked="{Binding IsActive}" Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                          VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="{l:Tr agents.toggleTip}"
                                                          Command="{Binding DataContext.ToggleRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          CommandParameter="{Binding}"/>
                                            <Button Style="{StaticResource RuleAction}" ToolTip="{l:Tr agents.reprocessTip}"
                                                    Command="{Binding DataContext.ReprocessRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="Restart" Width="17" Height="17"/>
                                            </Button>
                                            <Button Style="{StaticResource RuleAction}" ToolTip="{l:Tr agents.editTip}"
                                                    Command="{Binding DataContext.EditRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="PencilOutline" Width="17" Height="17"/>
                                            </Button>
                                            <Button Style="{StaticResource RuleAction}" Foreground="{StaticResource BrushWarning}"
                                                    ToolTip="{l:Tr agents.removeTip}"
                                                    Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Id}">
                                                <materialDesign:PackIcon Kind="DeleteOutline" Width="17" Height="17"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </materialDesign:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ── Right: add / edit form ── -->
                <materialDesign:Card Grid.Column="2" VerticalAlignment="Top">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <materialDesign:PackIcon Kind="FolderPlusOutline" Width="18" Height="18" VerticalAlignment="Center"
                                                     Foreground="{StaticResource BrushAccent}" Margin="0,0,10,0"/>
                            <TextBlock Text="{l:Tr agents.formTitle}" Style="{StaticResource SectionTitle}" Margin="0"/>
                        </StackPanel>

                        <TextBox materialDesign:HintAssist.Hint="{l:Tr agents.folderHint}"
                                 Text="{Binding NewFolderPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormBox}"/>
                        <TextBox materialDesign:HintAssist.Hint="{l:Tr agents.outputHint}"
                                 Text="{Binding NewOutputPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormBox}"
                                 ToolTip="{l:Tr agents.outputTip}"/>
                        <ComboBox materialDesign:HintAssist.Hint="{l:Tr agents.actionHint}"
                                  ItemsSource="{Binding AvailableActions}" SelectedItem="{Binding NewAction}"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}" Padding="10,9" Margin="0,0,0,12">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{l:TrLabel}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBox materialDesign:HintAssist.Hint="{l:Tr agents.promptHint}"
                                 Text="{Binding NewSystemPrompt, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormBox}"
                                 AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"/>
                        <TextBox materialDesign:HintAssist.Hint="{l:Tr agents.extHint}"
                                 Text="{Binding NewExtensions, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormBox}"/>

                        <DockPanel Margin="0,4,0,12">
                            <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding AllowInternetAccess}"
                                          Style="{StaticResource MaterialDesignSwitchToggleButton}" VerticalAlignment="Center"
                                          ToolTip="{l:Tr agents.internetTip}"/>
                            <TextBlock Text="{l:Tr agents.internet}" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,18">
                            <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding ProcessExisting}"
                                          Style="{StaticResource MaterialDesignSwitchToggleButton}" VerticalAlignment="Center"
                                          ToolTip="{l:Tr agents.existingTip}"/>
                            <TextBlock Text="{l:Tr agents.existing}" Style="{StaticResource Label}"
                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>

                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource BrushWarning}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,0,0,10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{l:Tr common.cancel}" Command="{Binding CancelEditCommand}" Style="{StaticResource QuietButton}"
                                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisConverter}}" Margin="0,0,8,0"/>
                            <Button Command="{Binding AddRuleCommand}" Style="{StaticResource AccentButton}">
                                <TextBlock Text="{Binding SubmitText}"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
