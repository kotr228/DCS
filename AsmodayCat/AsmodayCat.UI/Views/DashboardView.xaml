<UserControl x:Class="AsmodayCat.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <TextBlock Text="DASHBOARD" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource BrushNav}" Margin="0,0,0,16"/>

            <!-- Row 1: Service + Active Model + Kill Switch -->
            <UniformGrid Rows="1" Columns="3" Margin="0,0,0,12">

                <materialDesign:Card Padding="16" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="SERVICE" FontSize="10" Foreground="#888" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding ServiceStatus}" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource BrushDark}"/>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Padding="16" Margin="3,0">
                    <StackPanel>
                        <TextBlock Text="ACTIVE MODEL" FontSize="10" Foreground="#888" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding ActiveModelName}" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource BrushDark}"
                                   TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding ActiveModelStatus}" FontSize="11"
                                       Foreground="{StaticResource BrushAccent}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button Content="UNLOAD"
                                    Command="{Binding UnloadActiveModelCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    BorderBrush="{StaticResource BrushWarning}"
                                    Foreground="{StaticResource BrushWarning}"
                                    Padding="8,1" Height="22" FontSize="10"/>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Kill Switch -->
                <materialDesign:Card Padding="16" Margin="6,0,0,0"
                                     Background="#BC4A4A">
                    <StackPanel>
                        <TextBlock Text="EMERGENCY" FontSize="10" Foreground="#F9D0D0" Margin="0,0,0,4"/>
                        <Button Content="⬛ KILL SWITCH"
                                Command="{Binding KillAllCommand}"
                                Background="#8B0000" Foreground="White"
                                Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding KillSwitchStatus}"
                                   Foreground="#F9D0D0" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </materialDesign:Card>

            </UniformGrid>

            <!-- Row 2: Hardware metrics -->
            <UniformGrid Rows="1" Columns="4" Margin="0,0,0,12">

                <materialDesign:Card Padding="16" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="CPU LOAD" FontSize="10" Foreground="#888" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding CpuLoad, StringFormat={}{0:F1}%}"
                                   FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource BrushAccent}"/>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Padding="16" Margin="3,0">
                    <StackPanel>
                        <TextBlock Text="RAM FREE" FontSize="10" Foreground="#888" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding RamFreeMb, StringFormat={}{0:N0} MB}"
                                   FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource BrushSuccess}"/>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Padding="16" Margin="3,0">
                    <StackPanel>
                        <TextBlock Text="GPU LOAD" FontSize="10" Foreground="#888" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding GpuLoad, StringFormat={}{0:F1}%}"
                                   FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource BrushWarning}"/>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Padding="16" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="VRAM USED" FontSize="10" Foreground="#888" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding VramUsedMb, StringFormat={}{0:N0} MB}"
                                   FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource BrushAccent}"/>
                        <TextBlock Text="{Binding VramTotalMb, StringFormat=of {0:N0} MB}"
                                   FontSize="10" Foreground="#888"/>
                    </StackPanel>
                </materialDesign:Card>

            </UniformGrid>

            <!-- Row 3: Charts -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <materialDesign:Card Grid.Column="0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="SYSTEM LOAD (%)" FontSize="10" Foreground="#888" Margin="0,0,0,8"/>
                        <lvc:CartesianChart Series="{Binding Charts.CpuGpuSeries}"
                                           Height="160" DisableAnimations="True"
                                           Hoverable="False" DataTooltip="{x:Null}">
                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis MinValue="0" MaxValue="100" Foreground="#888" FontSize="10">
                                    <lvc:Axis.Separator>
                                        <lvc:Separator StrokeThickness="0.5" Stroke="#C8B89A"/>
                                    </lvc:Axis.Separator>
                                </lvc:Axis>
                            </lvc:CartesianChart.AxisY>
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis Foreground="#888" FontSize="10" ShowLabels="False">
                                    <lvc:Axis.Separator>
                                        <lvc:Separator StrokeThickness="0"/>
                                    </lvc:Axis.Separator>
                                </lvc:Axis>
                            </lvc:CartesianChart.AxisX>
                        </lvc:CartesianChart>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Column="2" Padding="16">
                    <StackPanel>
                        <TextBlock Text="MEMORY USAGE (MB)" FontSize="10" Foreground="#888" Margin="0,0,0,8"/>
                        <lvc:CartesianChart Series="{Binding Charts.MemorySeries}"
                                           Height="160" DisableAnimations="True"
                                           Hoverable="False" DataTooltip="{x:Null}">
                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis Foreground="#888" FontSize="10">
                                    <lvc:Axis.Separator>
                                        <lvc:Separator StrokeThickness="0.5" Stroke="#C8B89A"/>
                                    </lvc:Axis.Separator>
                                </lvc:Axis>
                            </lvc:CartesianChart.AxisY>
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis Foreground="#888" FontSize="10" ShowLabels="False">
                                    <lvc:Axis.Separator>
                                        <lvc:Separator StrokeThickness="0"/>
                                    </lvc:Axis.Separator>
                                </lvc:Axis>
                            </lvc:CartesianChart.AxisX>
                        </lvc:CartesianChart>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

            <!-- Row 4: Network + Recent Activity -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <materialDesign:Card Grid.Column="0" Padding="16" MinWidth="140">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="NETWORK NODES" FontSize="10" Foreground="#888"
                                   HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding AvailableNodes}" FontSize="40" FontWeight="Bold"
                                   Foreground="{StaticResource BrushAccent}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="available" FontSize="11" Foreground="#888"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Column="2" Padding="16">
                    <StackPanel>
                        <TextBlock Text="RECENT ACTIVITY" FontSize="10" Foreground="#888" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding RecentActivity}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Timestamp, StringFormat=HH:mm:ss}"
                                                   FontSize="11" Foreground="#888" FontFamily="Consolas"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ActionDescription}"
                                                   FontSize="12" Foreground="{StaticResource BrushDark}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="8,0"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Status}"
                                                   FontSize="11" Foreground="{StaticResource BrushAccent}"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

            <Button Content="REFRESH NOW"
                    Command="{Binding RefreshCommand}"
                    HorizontalAlignment="Left" Margin="0,12,0,0"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Foreground="{StaticResource BrushDark}"
                    BorderBrush="{StaticResource BrushNav}"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
