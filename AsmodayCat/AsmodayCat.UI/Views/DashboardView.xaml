<UserControl x:Class="AsmodayCat.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:AsmodayCat.UI.Localization"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf">
    <UserControl.Resources>
        <!-- Small rounded square with an icon at the top of each metric card -->
        <Style x:Key="IconBadge" TargetType="Border">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Background" Value="{StaticResource BrushAccentSoft}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="BadgeIcon" TargetType="materialDesign:PackIcon">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
        </Style>
        <Style x:Key="ChartAxisSep" TargetType="lvc:Separator">
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="Stroke" Value="#EEE7D4"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource BrushBackground}">
        <StackPanel Margin="32,8,32,28" MaxWidth="1240">

            <!-- Header -->
            <DockPanel Margin="0,0,0,20">
                <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}"
                        Style="{StaticResource QuietButton}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{l:Tr common.refresh}"/>
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="{l:Tr dash.title}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{l:Tr dash.subtitle}" Style="{StaticResource PageSubtitle}"/>
                </StackPanel>
            </DockPanel>

            <!-- Row 1: service, model, emergency stop -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <materialDesign:Card Grid.Column="0">
                    <StackPanel>
                        <Border Style="{StaticResource IconBadge}">
                            <materialDesign:PackIcon Kind="ServerOutline" Style="{StaticResource BadgeIcon}"/>
                        </Border>
                        <TextBlock Text="{l:Tr dash.service}" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{l:TrLabel ServiceStatus}"
                                   Style="{StaticResource MetricValue}" FontSize="22" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Column="2">
                    <StackPanel>
                        <Border Style="{StaticResource IconBadge}">
                            <materialDesign:PackIcon Kind="CubeOutline" Style="{StaticResource BadgeIcon}"/>
                        </Border>
                        <TextBlock Text="{l:Tr dash.model}" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding ActiveModelName}" Style="{StaticResource MetricValue}" FontSize="20"
                                   TextTrimming="CharacterEllipsis"/>
                        <DockPanel Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" Content="{l:Tr dash.unload}"
                                    Command="{Binding UnloadActiveModelCommand}"
                                    Style="{StaticResource QuietButton}" Height="28" Padding="10,0" FontSize="12"/>
                            <TextBlock Text="{l:TrLabel ActiveModelStatus}"
                                       Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Emergency stop: calm card, only the button is red -->
                <materialDesign:Card Grid.Column="4">
                    <StackPanel>
                        <Border Style="{StaticResource IconBadge}" Background="#F8E3E0">
                            <materialDesign:PackIcon Kind="StopCircleOutline" Style="{StaticResource BadgeIcon}"
                                                     Foreground="{StaticResource BrushDanger}"/>
                        </Border>
                        <TextBlock Text="{l:Tr dash.emergency}" Style="{StaticResource MetricLabel}"/>
                        <Button Command="{Binding KillAllCommand}" Style="{StaticResource DangerButton}"
                                HorizontalAlignment="Stretch" Margin="0,10,0,6">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Stop" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{l:Tr dash.stopAll}"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding KillSwitchStatus}" Style="{StaticResource Caption}"/>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

            <!-- Row 2: hardware metrics -->
            <UniformGrid Rows="1" Columns="4" Margin="-8,0,-8,16">
                <materialDesign:Card Margin="8,0">
                    <StackPanel>
                        <Border Style="{StaticResource IconBadge}">
                            <materialDesign:PackIcon Kind="Cpu64Bit" Style="{StaticResource BadgeIcon}"/>
                        </Border>
                        <TextBlock Text="{l:Tr dash.cpu}" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding CpuLoad, StringFormat={}{0:F1}%}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                </materialDesign:Card>
                <materialDesign:Card Margin="8,0">
                    <StackPanel>
                        <Border Style="{StaticResource IconBadge}">
                            <materialDesign:PackIcon Kind="Memory" Style="{StaticResource BadgeIcon}"/>
                        </Border>
                        <TextBlock Text="{l:Tr dash.ram}" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{l:TrFormat fmt.mb, Path=RamFreeMb}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                </materialDesign:Card>
                <materialDesign:Card Margin="8,0">
                    <StackPanel>
                        <Border Style="{StaticResource IconBadge}">
                            <materialDesign:PackIcon Kind="ExpansionCardVariant" Style="{StaticResource BadgeIcon}"/>
                        </Border>
                        <TextBlock Text="{l:Tr dash.gpu}" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding GpuLoad, StringFormat={}{0:F1}%}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                </materialDesign:Card>
                <materialDesign:Card Margin="8,0">
                    <StackPanel>
                        <Border Style="{StaticResource IconBadge}">
                            <materialDesign:PackIcon Kind="Chip" Style="{StaticResource BadgeIcon}"/>
                        </Border>
                        <TextBlock Text="{l:Tr dash.vram}" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{l:TrFormat fmt.mb, Path=VramUsedMb}" Style="{StaticResource MetricValue}"/>
                        <TextBlock Text="{l:TrFormat fmt.ofMb, Path=VramTotalMb}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                    </StackPanel>
                </materialDesign:Card>
            </UniformGrid>

            <!-- Row 3: charts -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <materialDesign:Card Grid.Column="0">
                    <StackPanel>
                        <TextBlock Text="{l:Tr dash.loadChart}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{l:Tr dash.loadChartSub}" Style="{StaticResource Caption}" Margin="0,0,0,10"/>
                        <lvc:CartesianChart Series="{Binding Charts.CpuGpuSeries}" Height="170"
                                            DisableAnimations="True" Hoverable="False" DataTooltip="{x:Null}"
                                            LegendLocation="Bottom" Foreground="{StaticResource BrushNav}">
                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis MinValue="0" MaxValue="100" Foreground="{StaticResource BrushMuted}" FontSize="10">
                                    <lvc:Axis.Separator><lvc:Separator Style="{StaticResource ChartAxisSep}"/></lvc:Axis.Separator>
                                </lvc:Axis>
                            </lvc:CartesianChart.AxisY>
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis ShowLabels="False">
                                    <lvc:Axis.Separator><lvc:Separator StrokeThickness="0"/></lvc:Axis.Separator>
                                </lvc:Axis>
                            </lvc:CartesianChart.AxisX>
                        </lvc:CartesianChart>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Column="2">
                    <StackPanel>
                        <TextBlock Text="{l:Tr dash.memChart}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{l:Tr dash.memChartSub}" Style="{StaticResource Caption}" Margin="0,0,0,10"/>
                        <lvc:CartesianChart Series="{Binding Charts.MemorySeries}" Height="170"
                                            DisableAnimations="True" Hoverable="False" DataTooltip="{x:Null}"
                                            LegendLocation="Bottom" Foreground="{StaticResource BrushNav}">
                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis MinValue="0" Foreground="{StaticResource BrushMuted}" FontSize="10">
                                    <lvc:Axis.Separator><lvc:Separator Style="{StaticResource ChartAxisSep}"/></lvc:Axis.Separator>
                                </lvc:Axis>
                            </lvc:CartesianChart.AxisY>
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis ShowLabels="False">
                                    <lvc:Axis.Separator><lvc:Separator StrokeThickness="0"/></lvc:Axis.Separator>
                                </lvc:Axis>
                            </lvc:CartesianChart.AxisX>
                        </lvc:CartesianChart>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

            <!-- Row 4: folder agents + recent activity -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <materialDesign:Card Grid.Column="0">
                    <StackPanel>
                        <Border Style="{StaticResource IconBadge}">
                            <materialDesign:PackIcon Kind="FolderEyeOutline" Style="{StaticResource BadgeIcon}"/>
                        </Border>
                        <TextBlock Text="{l:Tr dash.agents}" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding AvailableNodes}" Style="{StaticResource MetricValue}" FontSize="34"/>
                        <TextBlock Text="{l:Tr dash.agentsSub}" Style="{StaticResource Caption}"/>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Column="2">
                    <StackPanel>
                        <TextBlock Text="{l:Tr dash.activity}" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>

                        <!-- Empty state -->
                        <StackPanel Margin="0,14,0,10">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RecentActivity.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <materialDesign:PackIcon Kind="ClipboardTextClockOutline" Style="{StaticResource EmptyIcon}"/>
                            <TextBlock Text="{l:Tr dash.activityEmpty}" Style="{StaticResource Caption}"
                                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding RecentActivity}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat=HH:mm:ss}"
                                                       FontSize="12" Foreground="{StaticResource BrushMuted}" FontFamily="Consolas"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ActionDescription}" FontSize="13"
                                                       Foreground="{StaticResource BrushDark}" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <Border Grid.Column="2" Background="{StaticResource BrushSurfaceAlt}"
                                                    CornerRadius="10" Padding="10,2">
                                                <TextBlock Text="{l:TrLabel Status}" FontSize="11.5"
                                                           Foreground="{StaticResource BrushNav}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
