<UserControl x:Class="AsmodayCat.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="DASHBOARD" FontSize="18" FontWeight="Bold"
                   Foreground="#B39DDB" Margin="0,0,0,16"/>

        <!-- Stats row -->
        <UniformGrid Grid.Row="1" Rows="1" Columns="3" Margin="0,0,0,16">
            <materialDesign:Card Padding="16" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="SERVICE" FontSize="11" Foreground="#888"/>
                    <TextBlock Text="{Binding ServiceStatus}" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
            </materialDesign:Card>
            <materialDesign:Card Padding="16" Margin="4,0">
                <StackPanel>
                    <TextBlock Text="CPU LOAD" FontSize="11" Foreground="#888"/>
                    <TextBlock Text="{Binding CpuLoad, StringFormat={}{0:F1}%}" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
            </materialDesign:Card>
            <materialDesign:Card Padding="16" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="RAM FREE" FontSize="11" Foreground="#888"/>
                    <TextBlock Text="{Binding RamFreeMb, StringFormat={}{0:F0} MB}" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
            </materialDesign:Card>
        </UniformGrid>

        <!-- Kill Switch (FR6.3) -->
        <materialDesign:Card Grid.Row="2" Padding="12" Margin="0,0,0,12"
                             Background="#3E1A1A">
            <StackPanel Orientation="Horizontal">
                <Button Content="⬛ KILL SWITCH"
                        Command="{Binding KillAllCommand}"
                        Background="#C62828" Foreground="White"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Margin="0,0,12,0"/>
                <TextBlock Text="{Binding KillSwitchStatus}"
                           Foreground="#EF9A9A" VerticalAlignment="Center"/>
            </StackPanel>
        </materialDesign:Card>

        <Button Grid.Row="3" Content="REFRESH"
                Command="{Binding RefreshCommand}"
                HorizontalAlignment="Left"
                Style="{StaticResource MaterialDesignRaisedButton}"/>
    </Grid>
</UserControl>
