<Window x:Class="AsmodayCat.UI.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:l="clr-namespace:AsmodayCat.UI.Localization"
        Background="Transparent"
        Title="" Height="360" Width="660"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Deactivated="Window_Deactivated">
    <!-- Margin leaves room for the shadow -->
    <Border Margin="16" CornerRadius="14" Background="{StaticResource BrushSurface}"
            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.25" Color="#2B2718"/>
        </Border.Effect>
        <Grid Margin="20,16,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,10">
                <TextBlock DockPanel.Dock="Right" Text="{l:Tr overlay.escHint}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource BrushAccentSoft}">
                    <materialDesign:PackIcon Kind="Cat" Width="17" Height="17" Foreground="{StaticResource BrushAccent}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{l:Tr overlay.title}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrushDark}"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
            </DockPanel>

            <Border Grid.Row="1" Background="{StaticResource BrushSurfaceAlt}" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ResponseBlock" TextWrapping="Wrap" FontSize="13.5" LineHeight="20"
                               Foreground="{StaticResource BrushDark}"/>
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="QuickInput"
                         materialDesign:HintAssist.Hint="{l:Tr overlay.hint}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="12,9" FontSize="13.5"
                         KeyDown="QuickInput_KeyDown"/>
                <Button Grid.Column="1" Click="SendButton_Click" Style="{StaticResource AccentButton}"
                        Height="40" Margin="10,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{l:Tr overlay.ask}"/>
                        <materialDesign:PackIcon Kind="Send" Width="15" Height="15" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
