<UserControl x:Class="AsmodayCat.UI.Views.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="HARDWARE" FontSize="18" FontWeight="Bold"
                   Foreground="#B39DDB" Margin="0,0,0,16"/>

        <materialDesign:Card Grid.Row="1" Padding="16">
            <StackPanel>
                <TextBlock Text="Execution Device" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <ComboBox ItemsSource="{Binding AvailableDevices}"
                          SelectedItem="{Binding SelectedDevice}"
                          Margin="0,0,0,12"/>
                <Button Content="APPLY"
                        Command="{Binding ApplyDeviceCommand}"
                        HorizontalAlignment="Left"
                        Style="{StaticResource MaterialDesignRaisedButton}"/>
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="#A5D6A7" Margin="0,8,0,0"/>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>
