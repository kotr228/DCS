<UserControl x:Class="AsmodayCat.UI.Views.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:AsmodayCat.UI.Localization"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <Style x:Key="CardIcon" TargetType="materialDesign:PackIcon">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{StaticResource BrushBorder}"/>
            <Setter Property="Margin" Value="0,16"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource BrushBackground}">
        <StackPanel Margin="32,8,32,28" MaxWidth="1160">

            <!-- Header -->
            <DockPanel Margin="0,0,0,20">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource BrushSuccess}" FontSize="12.5"
                               VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Button Command="{Binding SaveConfigCommand}" Style="{StaticResource AccentButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSaveOutline" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{l:Tr common.save}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{l:Tr settings.title}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{l:Tr settings.subtitle}"
                               Style="{StaticResource PageSubtitle}"/>
                </StackPanel>
            </DockPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── Left: performance ── -->
                <StackPanel Grid.Column="0">
                    <materialDesign:Card Margin="0,0,0,20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <materialDesign:PackIcon Kind="ExpansionCardVariant" Style="{StaticResource CardIcon}"/>
                                <TextBlock Text="{l:Tr settings.gpuCard}" Style="{StaticResource SectionTitle}" Margin="0"/>
                            </StackPanel>
                            <TextBlock Text="{l:Tr settings.afterSave}" Style="{StaticResource Caption}" Margin="28,0,0,16"/>

                            <TextBlock Text="{l:Tr settings.device}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding DeviceOptions}" SelectedItem="{Binding PreferredDevice}"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      materialDesign:TextFieldAssist.TextFieldCornerRadius="6"
                                      Padding="10,8" Width="220" HorizontalAlignment="Left">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{l:TrLabel}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Border Style="{StaticResource Divider}"/>

                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="{l:Tr settings.context}" Style="{StaticResource Label}"/>
                                <TextBlock Text="{l:TrFormat fmt.tokens, Path=ContextWindowSize}" Style="{StaticResource ValueText}"/>
                            </DockPanel>
                            <Slider Minimum="2048" Maximum="32768" TickFrequency="1024" IsSnapToTickEnabled="True"
                                    Value="{Binding ContextWindowSize}"/>
                            <TextBlock Text="{l:Tr settings.contextHelp}"
                                       Style="{StaticResource Caption}" Margin="0,4,0,0"/>

                            <Border Style="{StaticResource Divider}"/>

                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="{l:Tr settings.vramLimit}" Style="{StaticResource Label}"/>
                                <TextBlock HorizontalAlignment="Right">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource ValueText}">
                                            <Setter Property="Text" Value="{l:TrFormat fmt.mbPlain, Path=MaxVramAllocationMb}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MaxVramAllocationMb}" Value="0">
                                                    <Setter Property="Text" Value="{l:Tr settings.noLimit}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                            <Slider Minimum="0" Maximum="24576" TickFrequency="512" IsSnapToTickEnabled="True"
                                    Value="{Binding MaxVramAllocationMb}"/>
                            <TextBlock Text="{l:Tr settings.vramHelp}"
                                       Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <materialDesign:PackIcon Kind="Cpu64Bit" Style="{StaticResource CardIcon}"/>
                                <TextBlock Text="{l:Tr settings.cpuCard}" Style="{StaticResource SectionTitle}" Margin="0"/>
                            </StackPanel>

                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="{l:Tr settings.threads}" Style="{StaticResource Label}"/>
                                <TextBlock Text="{l:TrFormat fmt.threads, Path=CpuThreads}" Style="{StaticResource ValueText}"/>
                            </DockPanel>
                            <Slider Minimum="1" Maximum="{Binding MaxSystemThreads}" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding CpuThreads}"/>
                            <TextBlock Text="{l:TrFormat fmt.maxThreads, Path=MaxSystemThreads}"
                                       Style="{StaticResource Caption}" Margin="0,4,0,0"/>

                            <Border Style="{StaticResource Divider}"/>

                            <DockPanel>
                                <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding AllowCpuFallback}" VerticalAlignment="Center"
                                              Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                              ToolTip="{l:Tr settings.fallbackTip}"/>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{l:Tr settings.fallback}" Style="{StaticResource Label}"/>
                                    <TextBlock Text="{l:Tr settings.fallbackHelp}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </materialDesign:Card>
                </StackPanel>

                <!-- ── Right: connections + system ── -->
                <StackPanel Grid.Column="2">
                    <materialDesign:Card Margin="0,0,0,20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <materialDesign:PackIcon Kind="LanConnect" Style="{StaticResource CardIcon}"/>
                                <TextBlock Text="{l:Tr settings.connCard}" Style="{StaticResource SectionTitle}" Margin="0"/>
                            </StackPanel>
                            <TextBlock Text="{l:Tr settings.connHelp}" Style="{StaticResource Caption}" Margin="28,0,0,16"/>

                            <TextBox materialDesign:HintAssist.Hint="{l:Tr settings.ollamaHint}"
                                     Text="{Binding OllamaBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="10,9" Margin="0,0,0,12"/>
                            <TextBox materialDesign:HintAssist.Hint="{l:Tr settings.sdHint}"
                                     Text="{Binding StableDiffusionBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="10,9" Margin="0,0,0,12"/>
                            <TextBox materialDesign:HintAssist.Hint="{l:Tr settings.workspaceHint}"
                                     Text="{Binding ChatWorkspacePath, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="10,9" Margin="0,0,0,16"/>
                            <Button Command="{Binding SaveConnectionsCommand}" Style="{StaticResource QuietButton}"
                                    IsEnabled="{Binding IsRestarting, Converter={StaticResource InverseBoolConverter}}"
                                    HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Restart" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{l:Tr settings.saveRestart}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <materialDesign:PackIcon Kind="MicrosoftWindows" Style="{StaticResource CardIcon}"/>
                                <TextBlock Text="{l:Tr settings.systemCard}" Style="{StaticResource SectionTitle}" Margin="0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding VersionText}" Style="{StaticResource Caption}" Margin="28,0,0,16"/>

                            <DockPanel>
                                <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding AutostartEnabled}" VerticalAlignment="Center"
                                              Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{l:Tr settings.autostart}" Style="{StaticResource Label}"/>
                                    <TextBlock Text="{l:Tr settings.autostartHelp}"
                                               Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </materialDesign:Card>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
