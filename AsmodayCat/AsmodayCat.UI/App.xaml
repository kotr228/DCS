<Application x:Class="AsmodayCat.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:AsmodayCat.UI.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Dark"
                                             PrimaryColor="DeepPurple"
                                             SecondaryColor="Lime" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:RoleToBrushConverter         x:Key="RoleToBrushConverter"/>
            <conv:InverseBoolConverter         x:Key="InverseBoolConverter"/>
            <conv:BoolToVisibilityConverter    x:Key="BoolToVisConverter"/>
            <conv:ChatRoleToAlignmentConverter x:Key="RoleToAlignmentConverter"/>
            <conv:FileNameConverter            x:Key="FileNameConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
