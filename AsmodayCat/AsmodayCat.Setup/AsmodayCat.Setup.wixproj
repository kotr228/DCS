<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <OutputName>AsmodayCat</OutputName>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <ProductVersion Condition="'$(ProductVersion)' == ''">4.0.0</ProductVersion>
    <DefineConstants>ProductVersion=$(ProductVersion);PublishDir=$(MSBuildProjectDirectory)\..\publish\AsmodayCat</DefineConstants>
    <!-- Per-user package: ICE checks for per-machine shortcuts don't apply -->
    <SuppressIces>ICE38;ICE64;ICE91</SuppressIces>
  </PropertyGroup>

</Project>
