<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Explicit Windows SDK version (not bare net8.0-windows, which normalizes to the
         Windows 7.0 API level) - SkiaSharp.Views.WPF requires net8.0-windows10.0.19041;
         without this, NuGet can't match it and silently falls back to a .NET Framework
         4.6.2 compatibility shim instead of the real .NET 8 assembly (see NU1701). -->
    <TargetFramework>net8.0-windows10.0.19041</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Lets the WPF client be restored/compiled (not run) from a non-Windows dev
         machine or a Linux CI runner, since the studio's tooling spans Windows and Linux. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- The published .exe's own file/taskbar icon (a native PE resource, separate
         from Window.Icon below, which only sets the small icon shown in a running
         window's own title bar/Alt-Tab entry). -->
    <ApplicationIcon>Assets\JolieCatLogo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embeds both as WPF "Resource" build-action pack-URI content, so MainWindow's
         own Icon="/Assets/JolieCatLogo.ico" and SplashScreenWindow's
         Image Source="/Assets/JolieCatLogo.png" can actually resolve them at runtime -
         ApplicationIcon above only covers the compiled .exe's own file icon, a
         separate mechanism that doesn't make the file reachable from XAML at all. -->
    <Resource Include="Assets\JolieCatLogo.ico" />
    <Resource Include="Assets\JolieCatLogo.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Pinned to the last release that ships a net8.0-windows build (4.x moved on to
         net9.0-windows/net10.0-windows only). -->
    <PackageReference Include="SkiaSharp" Version="3.116.1" />
    <PackageReference Include="SkiaSharp.Views.WPF" Version="3.116.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JolieCat.Core\JolieCat.Core.csproj" />
    <ProjectReference Include="..\JolieCat.Shared\JolieCat.Shared.csproj" />
  </ItemGroup>

</Project>
