<Window x:Class="JolieCat.UI.Views.PatternManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:JolieCat.UI.ViewModels"
        mc:Ignorable="d"
        Title="Patterns" Width="460" Height="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        d:DataContext="{d:DesignInstance Type=vm:PatternManagerViewModel, IsDesignTimeCreatable=False}">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Width="80" IsCancel="True" IsDefault="True" Click="Close_Click" />
            <TextBlock Text="{Binding Message}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,12,0" />
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Delete" Width="70" Margin="6,0,0,0" Command="{Binding DeleteCommand}" />
            <Button DockPanel.Dock="Right" Content="Rename" Width="70" Margin="6,0,0,0" Command="{Binding RenameCommand}" />
            <TextBox Text="{Binding Selected.EditName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Pattern name"
                     KeyDown="NameBox_KeyDown" />
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{StaticResource TextSecondaryBrush}"
                   Text="Your patterns, made with Edit &gt; Define Pattern. They appear in Layer Style &gt; Pattern Overlay." />

        <Grid>
            <ListBox ItemsSource="{Binding Patterns}" SelectedItem="{Binding Selected}"
                     Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="84" Margin="4">
                            <Border Width="72" Height="72" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Thumbnail}" TileMode="Tile" Stretch="None"
                                                Viewport="0,0,1,1" ViewportUnits="RelativeToBoundingBox" />
                                </Border.Background>
                            </Border>
                            <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="No patterns yet. Select part of an image and use Edit &gt; Define Pattern."
                       TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30" TextAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}" IsHitTestVisible="False"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </DockPanel>
</Window>
