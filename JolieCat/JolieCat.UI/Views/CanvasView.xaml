<UserControl x:Class="JolieCat.UI.Views.CanvasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
             xmlns:converters="clr-namespace:JolieCat.UI.Converters"
             mc:Ignorable="d">
    <UserControl.Resources>
        <converters:ToolTypeToCursorConverter x:Key="ToolTypeToCursor" />
        <converters:BoolToFontWeightConverter x:Key="BoolToFontWeight" />
        <converters:BoolToFontStyleConverter x:Key="BoolToFontStyle" />
    </UserControl.Resources>
    <Grid>
        <!-- SKElement (not the GPU/OpenGL-backed SKGLElement) - see CanvasView.xaml.cs's
             class remarks for why: SKGLElement's framebuffer is hosted via the
             third-party GLWpfControl, which flips it to reconcile OpenGL's bottom-left
             origin with WPF's top-left one, a coordinate-handling layer this app's own
             pixel data (top-left-origin CPU raster throughout) never otherwise passes
             through. PaintSurface fires on every repaint, including on resize, so
             CanvasRenderer always redraws at the current size. Mouse capture is taken on
             press (see code-behind) so drag gestures - paint strokes, marquee drags,
             panning - keep tracking correctly even if the pointer leaves the control
             mid-drag. Cursor follows the active tool so the pointer itself hints at what
             a click/drag will do. -->
        <!-- AllowDrop + the three Drag*/Drop handlers below let the user drop image
             files (PNG/JPG/JPEG/BMP/WEBP) straight onto the canvas to import them - see
             the code-behind for how a drop is turned into new layers. -->
        <skia:SKElement x:Name="Surface"
                        Focusable="True"
                        AllowDrop="True"
                        Cursor="{Binding ActiveToolType, Converter={StaticResource ToolTypeToCursor}}"
                        PaintSurface="OnPaintSurface"
                        MouseLeftButtonDown="Surface_MouseLeftButtonDown"
                        MouseMove="Surface_MouseMove"
                        MouseLeftButtonUp="Surface_MouseLeftButtonUp"
                        MouseWheel="Surface_MouseWheel"
                        LostMouseCapture="Surface_LostMouseCapture"
                        DragEnter="Surface_DragEnterOrOver"
                        DragOver="Surface_DragEnterOrOver"
                        Drop="Surface_Drop" />

        <!-- Inline text-input overlay for the Horizontal/Vertical Text tools: a plain
             multi-line WPF textbox, positioned in code-behind (see PositionTextEditOverlay)
             directly over the clicked document point - converting the view model's
             screen-space anchor back to DIPs via the same DPI scale pointer events use in
             reverse. Hidden until IsTextEditing is set; its font/color preview the active
             Text tool's own Properties-panel settings (FontFamily/FontSize/Bold/Italic)
             and the current primary color, though the actual pixels only get drawn once
             CommitTextEdit runs - see the code-behind's key handlers for Enter/Escape. -->
        <TextBox x:Name="TextEditBox"
                 Visibility="Collapsed"
                 HorizontalAlignment="Left" VerticalAlignment="Top"
                 MinWidth="140" MinHeight="28" Padding="2"
                 AcceptsReturn="True" TextWrapping="NoWrap"
                 Background="#CC1B1B1C" Foreground="{Binding PrimaryColorBrush}"
                 BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                 FontFamily="{Binding Toolbox.CurrentToolOptions.FontFamily}"
                 FontSize="{Binding Toolbox.CurrentToolOptions.FontSize}"
                 FontWeight="{Binding Toolbox.CurrentToolOptions.IsBold, Converter={StaticResource BoolToFontWeight}}"
                 FontStyle="{Binding Toolbox.CurrentToolOptions.IsItalic, Converter={StaticResource BoolToFontStyle}}"
                 Text="{Binding TextEditContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 PreviewKeyDown="TextEditBox_PreviewKeyDown" />
    </Grid>
</UserControl>
