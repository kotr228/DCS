<UserControl x:Class="JolieCat.UI.Views.CanvasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
             mc:Ignorable="d">
    <Grid>
        <!-- SKGLElement (not the software-rendered SKElement) so the canvas is
             hardware-accelerated via OpenGL/ANGLE. PaintSurface fires on every repaint,
             including on resize, so CanvasRenderer always redraws at the current size. -->
        <skia:SKGLElement x:Name="Surface" PaintSurface="OnPaintSurface" />
    </Grid>
</UserControl>
