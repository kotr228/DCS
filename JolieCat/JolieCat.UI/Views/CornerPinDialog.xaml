<Window x:Class="JolieCat.UI.Views.CornerPinDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:JolieCat.UI.ViewModels"
        mc:Ignorable="d"
        Title="Distort / Perspective" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource PanelBackgroundBrush}"
        d:DataContext="{d:DesignInstance Type=vm:CornerPinViewModel, IsDesignTimeCreatable=False}">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Right" Width="220" Margin="12,0,0,0">
            <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"
                       Text="Drag the four blue corners of the layer. Use it to fit a picture into a frame or a screen, or to straighten a photo taken at an angle." />
            <CheckBox Content="Perspective" IsChecked="{Binding Perspective}" Foreground="{StaticResource TextPrimaryBrush}"
                      ToolTip="Dragging a corner along an edge moves the corner across from it the opposite way, so the layer narrows or widens evenly" />
            <Button Content="Reset" HorizontalAlignment="Left" Padding="10,2" Margin="0,10,0,0" Click="Reset_Click" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancel" IsCancel="True" Padding="16,4" Margin="0,0,8,0" />
                <Button Content="OK" IsDefault="True" Padding="20,4" Style="{StaticResource PrimaryButtonStyle}" Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
        <Grid Width="{Binding PreviewWidth}" Height="{Binding PreviewHeight}">
            <Image Source="{Binding Preview}" Stretch="Fill" />
            <Path Data="{Binding Outline}" Stroke="#CC5AC8FA" StrokeThickness="1" IsHitTestVisible="False" />
            <Canvas x:Name="Handles" />
        </Grid>
    </DockPanel>
</Window>
