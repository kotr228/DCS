<Window x:Class="JolieCat.UI.Views.SimpleAdjustmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:JolieCat.UI.ViewModels"
        xmlns:controls="clr-namespace:JolieCat.UI.Controls"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="280" Width="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        d:DataContext="{d:DesignInstance Type=vm:SimpleAdjustmentViewModel, IsDesignTimeCreatable=False}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" VerticalAlignment="Top">
            <controls:LabeledSlider Label="{Binding Slider1Label}" Minimum="{Binding Slider1Min}" Maximum="{Binding Slider1Max}"
                                     Value="{Binding Slider1Value, Mode=TwoWay}" Margin="0,0,0,8" />
            <controls:LabeledSlider Label="{Binding Slider2Label}" Minimum="{Binding Slider2Min}" Maximum="{Binding Slider2Max}"
                                     Value="{Binding Slider2Value, Mode=TwoWay}" Margin="0,0,0,8" />
            <controls:LabeledSlider Label="{Binding Slider3Label}" Minimum="{Binding Slider3Min}" Maximum="{Binding Slider3Max}"
                                     Value="{Binding Slider3Value, Mode=TwoWay}"
                                     Visibility="{Binding HasSlider3, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click" />
            <Button Content="Apply" Width="80" IsDefault="True" Click="Apply_Click" />
        </StackPanel>
    </Grid>
</Window>
