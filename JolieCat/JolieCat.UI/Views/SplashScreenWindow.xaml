<Window x:Class="JolieCat.UI.Views.SplashScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="JolieCat"
        Width="420" Height="320"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" Topmost="True"
        Icon="/Assets/JolieCatLogo.ico"
        Background="{StaticResource PanelAltBackgroundBrush}">
    <!-- A single Border, not the Window itself, carries the accent ring - Window has
         no BorderBrush/BorderThickness of its own to draw a frame with, and this needs
         no AllowsTransparency/rounded-corner complexity (not attempted here: nothing
         about it can be visually verified in a sandbox with no Windows Desktop
         runtime, so the simpler, reliably-correct rectangular option was chosen over a
         fancier one this session has no way to actually check). -->
    <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="2">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image Source="/Assets/JolieCatLogo.png" Width="140" Height="140" Stretch="Uniform" />

            <TextBlock Text="JolieCat" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,18,0,4" />
            <TextBlock Text="Loading..." FontSize="12" HorizontalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,18" />

            <!-- An indeterminate spinner, not a real percentage - there's no discrete,
                 measurable multi-step load process here to report actual progress
                 against (MainWindow's whole view-model graph constructs in one
                 near-instant call), so a fabricated "37%" would be more misleading
                 than an honest "something is happening" indicator. Reuses the exact
                 spinning-arc pattern MainWindow.xaml's own Saving Overlay already
                 uses (Path + RotateTransform + an EventTrigger'd Storyboard), just in
                 the palette's Active Indicator green instead of the golden Accent, so
                 it reads as "in progress" the same way a checked toggle reads "on". -->
            <Path Width="36" Height="36" Stretch="Uniform" HorizontalAlignment="Center"
                  Stroke="{StaticResource ActiveIndicatorBrush}" StrokeThickness="4"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                <Path.Data>
                    <PathGeometry>
                        <PathFigure StartPoint="18,2" IsClosed="False">
                            <ArcSegment Point="34,18" Size="16,16" SweepDirection="Clockwise" IsLargeArc="True" />
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
                <Path.RenderTransform>
                    <RotateTransform CenterX="18" CenterY="18" />
                </Path.RenderTransform>
                <Path.Triggers>
                    <EventTrigger RoutedEvent="Path.Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)"
                                                 From="0" To="360" Duration="0:0:0.9" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Path.Triggers>
            </Path>
        </StackPanel>
    </Border>
</Window>
