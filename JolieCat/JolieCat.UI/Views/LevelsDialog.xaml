<Window x:Class="JolieCat.UI.Views.LevelsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:JolieCat.UI.ViewModels"
        xmlns:controls="clr-namespace:JolieCat.UI.Controls"
        mc:Ignorable="d"
        Title="Levels" Height="430" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        d:DataContext="{d:DesignInstance Type=vm:LevelsViewModel, IsDesignTimeCreatable=False}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The histogram shows the layer's original, pre-adjustment luminance
             distribution - see LevelsViewModel's own remarks for why it's computed
             once at open time and never recomputed as the sliders move. Stretched
             to fill from its own fixed 0-255 x 0-100 coordinate space. -->
        <Border Grid.Row="0" Height="120" Background="#FF1B1B1C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,12">
            <Viewbox Stretch="Fill">
                <Canvas Width="255" Height="100">
                    <Polygon Points="{Binding HistogramPoints}" Fill="{StaticResource TextSecondaryBrush}" />
                </Canvas>
            </Viewbox>
        </Border>

        <StackPanel Grid.Row="1" VerticalAlignment="Top">
            <TextBlock Text="Input" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
            <controls:LabeledSlider Label="Black Point" Minimum="0" Maximum="254" Value="{Binding InputBlack, Mode=TwoWay}" Margin="0,0,0,4" />
            <controls:LabeledSlider Label="White Point" Minimum="1" Maximum="255" Value="{Binding InputWhite, Mode=TwoWay}" Margin="0,0,0,4" />
            <controls:LabeledSlider Label="Gamma" Minimum="0.1" Maximum="9.99" Value="{Binding Gamma, Mode=TwoWay}" Margin="0,0,0,12" />

            <TextBlock Text="Output" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
            <controls:LabeledSlider Label="Black Point" Minimum="0" Maximum="255" Value="{Binding OutputBlack, Mode=TwoWay}" Margin="0,0,0,4" />
            <controls:LabeledSlider Label="White Point" Minimum="0" Maximum="255" Value="{Binding OutputWhite, Mode=TwoWay}" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click" />
            <Button Content="Apply" Width="80" IsDefault="True" Click="Apply_Click" />
        </StackPanel>
    </Grid>
</Window>
