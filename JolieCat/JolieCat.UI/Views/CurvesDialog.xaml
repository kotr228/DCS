<Window x:Class="JolieCat.UI.Views.CurvesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:JolieCat.UI.ViewModels"
        mc:Ignorable="d"
        Title="Curves" Height="400" Width="340"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        d:DataContext="{d:DesignInstance Type=vm:CurvesViewModel, IsDesignTimeCreatable=False}">
    <Window.Resources>
        <!-- A small round handle - clicking its own body starts a drag; the
             background Canvas beneath it (see the code-behind's own click handler)
             only ever sees a click that missed every point, so the two never race
             over the same click. -->
        <Style x:Key="CurvePointThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="White" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Text="Click the graph to add a point, drag a point to move it, right-click a point to remove it." />

        <!-- Fixed at exactly 256x256 logical units so a click/drag position maps
             directly to an input/output value 0-255 with only a Y-flip (see
             CurvePointViewModel.CanvasTop) - no separate pixel-to-data scale
             conversion needed anywhere in the code-behind. -->
        <Border Grid.Row="1" Background="{StaticResource PanelAltBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Viewbox Stretch="Uniform">
                <Grid Width="256" Height="256">
                    <Canvas x:Name="GraphCanvas" Width="256" Height="256" Background="Transparent"
                            MouseLeftButtonDown="GraphCanvas_MouseLeftButtonDown">
                        <!-- The identity diagonal, as a fixed reference guide. -->
                        <Line X1="0" Y1="256" X2="256" Y2="0" Stroke="{StaticResource BorderBrush}" StrokeThickness="1" />

                        <Polyline Points="{Binding CurveLinePoints}" Stroke="White" StrokeThickness="2" IsHitTestVisible="False" />

                        <ItemsControl ItemsSource="{Binding Points}" IsHitTestVisible="True">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                                    <Setter Property="Canvas.Top" Value="{Binding CanvasTop}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- -5,-5 centers the 10x10 handle on its own (X, CanvasTop) point
                                         rather than anchoring that point at the handle's own corner. -->
                                    <Thumb Style="{StaticResource CurvePointThumbStyle}" Margin="-5,-5,0,0"
                                           DragDelta="PointThumb_DragDelta"
                                           MouseRightButtonDown="PointThumb_MouseRightButtonDown" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Canvas>
                </Grid>
            </Viewbox>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click" />
            <Button Content="Apply" Width="80" IsDefault="True" Click="Apply_Click" />
        </StackPanel>
    </Grid>
</Window>
