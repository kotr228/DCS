<UserControl x:Class="JolieCat.UI.Views.ColorPickerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:JolieCat.UI.Controls"
             mc:Ignorable="d">
    <UserControl.Resources>
        <!-- Flat, chrome-free square swatch - just the fill color and a thin border,
             no hover/pressed animation. Small enough that 20 presets plus the preview
             still read as one compact row-and-a-half, not a standalone panel. -->
        <Style x:Key="SwatchButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Margin" Value="1.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="0,0,0,4">
        <TextBlock Text="COLOR" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4"
                   Foreground="{StaticResource TextSecondaryBrush}" />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <!-- Active color preview -->
            <Border Width="30" Height="30" Margin="0,0,8,0" Background="{Binding PrimaryColorBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ToolTip="Foreground color" />

            <!-- Quick-pick palette, 10 columns x 2 rows -->
            <UniformGrid Columns="10" Rows="2" Width="180">
                <Button Style="{StaticResource SwatchButtonStyle}" Background="#000000" ToolTip="Black"
                        Command="{Binding SetColorFromHexCommand}" CommandParameter="#000000" />
                <Button Style="{StaticResource SwatchButtonStyle}" Background="#FFFFFF" ToolTip="White"
                        Command="{Binding SetColorFromHexCommand}" CommandParameter="#FFFFFF" />
                <Button Style="{StaticResource SwatchButtonStyle}" Background="#9E9E9E" ToolTip="Gray"
                        Command="{Binding SetColorFromHexCommand}" CommandParameter="#9E9E9E" />
                <Button Style="{StaticResource SwatchButtonStyle}" Background="#607D8B" ToolTip="Blue Gray"
                        Command="{Binding SetColorFromHexCommand}" CommandParameter="#607D8B" />
                <Button Style="{StaticResource SwatchButtonStyle}" Background="#3D8BFD" ToolTip="Accent Blue"
                        Command="{Binding SetColorFromHexCommand}" CommandParameter="#3D8BFD" />
                <Button Style="{StaticResource SwatchButtonStyle}" Background="#F44336" ToolTip="Red"
                        Command="{Binding SetColorFromHexCommand}" CommandParameter="#F44336" />
                <Button Style="{StaticResource SwatchButtonStyle}" Background="#FF9800" ToolTip="Orange"
                        Command="{Binding SetColorFromHexCommand}" CommandParameter="#FF9800" />
                <Button Style="{StaticResource SwatchButtonStyle}" Background="#FFEB3B" ToolTip="Yellow"
                        Command="{Binding SetColorFromHexCommand}" CommandParameter="#FFEB3B" />
                <Button Style="{StaticResource SwatchButtonStyle}" Background="#8BC34A" ToolTip="Light Green"
                        Command="{Binding SetColorFromHexCommand}" CommandParameter="#8BC34A" />
                <Button Style="{StaticResource SwatchButtonStyle}" Background="#4CAF50" ToolTip="Green"
                        Command="{Binding SetColorFromHexCommand}" CommandParameter="#4CAF50" />

                <Button Style="{StaticResource SwatchButtonStyle}" Background="#009688" ToolTip="Teal"
                        Command="{Binding SetColorFromHexCommand}" CommandParameter="#009688" />
                <Button Style="{StaticResource SwatchButtonStyle}" Background="#00BCD4" ToolTip="Cyan"
                        Command="{Binding SetColorFromHexCommand}" CommandParameter="#00BCD4" />
                <Button Style="{StaticResource SwatchButtonStyle}" Background="#2196F3" ToolTip="Blue"
                        Command="{Binding SetColorFromHexCommand}" CommandParameter="#2196F3" />
                <Button Style="{StaticResource SwatchButtonStyle}" Background="#3F51B5" ToolTip="Indigo"
                        Command="{Binding SetColorFromHexCommand}" CommandParameter="#3F51B5" />
                <Button Style="{StaticResource SwatchButtonStyle}" Background="#673AB7" ToolTip="Deep Purple"
                        Command="{Binding SetColorFromHexCommand}" CommandParameter="#673AB7" />
                <Button Style="{StaticResource SwatchButtonStyle}" Background="#9C27B0" ToolTip="Purple"
                        Command="{Binding SetColorFromHexCommand}" CommandParameter="#9C27B0" />
                <Button Style="{StaticResource SwatchButtonStyle}" Background="#E91E63" ToolTip="Pink"
                        Command="{Binding SetColorFromHexCommand}" CommandParameter="#E91E63" />
                <Button Style="{StaticResource SwatchButtonStyle}" Background="#795548" ToolTip="Brown"
                        Command="{Binding SetColorFromHexCommand}" CommandParameter="#795548" />
                <Button Style="{StaticResource SwatchButtonStyle}" Background="#FFC107" ToolTip="Amber"
                        Command="{Binding SetColorFromHexCommand}" CommandParameter="#FFC107" />
                <Button Style="{StaticResource SwatchButtonStyle}" Background="#FF5722" ToolTip="Deep Orange"
                        Command="{Binding SetColorFromHexCommand}" CommandParameter="#FF5722" />
            </UniformGrid>
        </StackPanel>

        <!-- Minimalist RGB sliders - no popup, no extra chrome, just the three rows. -->
        <controls:LabeledSlider Label="R" Minimum="0" Maximum="255" Value="{Binding RedComponent, Mode=TwoWay}" />
        <controls:LabeledSlider Label="G" Minimum="0" Maximum="255" Value="{Binding GreenComponent, Mode=TwoWay}" />
        <controls:LabeledSlider Label="B" Minimum="0" Maximum="255" Value="{Binding BlueComponent, Mode=TwoWay}" />
    </StackPanel>
</UserControl>
