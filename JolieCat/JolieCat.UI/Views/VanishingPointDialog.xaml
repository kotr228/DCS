<Window x:Class="JolieCat.UI.Views.VanishingPointDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:JolieCat.UI.ViewModels"
        xmlns:controls="clr-namespace:JolieCat.UI.Controls"
        mc:Ignorable="d"
        Title="Vanishing Point" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource PanelBackgroundBrush}"
        d:DataContext="{d:DesignInstance Type=vm:VanishingPointViewModel, IsDesignTimeCreatable=False}">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Right" Width="240" Margin="12,0,0,0">
            <TextBlock Text="SURFACE" Style="{StaticResource PanelHeaderStyle}" Margin="0,0,0,4" />
            <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"
                       Text="Drag the four blue corners onto the corners of a flat surface in the photo: a wall, a floor, a screen, a sign. The grid shows its perspective." />
            <CheckBox Content="Show Grid" IsChecked="{Binding ShowGrid}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />

            <TextBlock Text="PICTURE" Style="{StaticResource PanelHeaderStyle}" Margin="0,0,0,4" />
            <ComboBox ItemsSource="{Binding SourceNames}" SelectedItem="{Binding Source}" Margin="0,0,0,8"
                      AutomationProperties.Name="Picture" ToolTip="What to lay on the surface: the copied pixels, a layer, or a file" />
            <controls:LabeledSlider Label="Across" Suffix="%" Minimum="0" Maximum="100" Value="{Binding PlaceX, Mode=TwoWay}" />
            <controls:LabeledSlider Label="Down" Suffix="%" Minimum="0" Maximum="100" Value="{Binding PlaceY, Mode=TwoWay}" />
            <controls:LabeledSlider Label="Size" Suffix="%" Minimum="1" Maximum="200" Value="{Binding Size, Mode=TwoWay}"
                                    ToolTip="The picture's width as a part of the surface's width" />
            <controls:LabeledSlider Label="Opacity" Suffix="%" Minimum="0" Maximum="100" Value="{Binding Opacity, Mode=TwoWay}" />
            <CheckBox Content="Tile (repeat over the surface)" IsChecked="{Binding Tile}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8,0,0"
                      ToolTip="Repeats the picture over the whole surface: tiles on a floor, bricks on a wall" />
            <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0"
                       Text="OK adds the result as a new layer, so you can still change its opacity or blend mode (Multiply lets the wall's shading show through)." />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel" IsCancel="True" Padding="16,4" Margin="0,0,8,0" />
                <Button Content="OK" IsDefault="True" Padding="20,4" Style="{StaticResource PrimaryButtonStyle}" Click="Ok_Click" />
            </StackPanel>
        </StackPanel>

        <Grid Width="{Binding PreviewWidth}" Height="{Binding PreviewHeight}" ClipToBounds="False">
            <Image Source="{Binding Preview}" Stretch="Fill" />
            <Path Data="{Binding GridPath}" Stroke="#CC5AC8FA" StrokeThickness="1" IsHitTestVisible="False" />
            <Canvas x:Name="Handles" />
        </Grid>
    </DockPanel>
</Window>
