<Window x:Class="JolieCat.UI.Views.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:JolieCat.UI.ViewModels"
        xmlns:controls="clr-namespace:JolieCat.UI.Controls"
        mc:Ignorable="d"
        Title="Color Picker" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        d:DataContext="{d:DesignInstance Type=vm:ColorPickerDialogViewModel, IsDesignTimeCreatable=False}">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="22" />
        </Style>
        <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="76" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="124" />
            </Grid.ColumnDefinitions>

            <controls:HsvColorPicker Grid.Column="0" Margin="0,0,16,0"
                                      Hue="{Binding Hue, Mode=TwoWay}"
                                      Saturation="{Binding Saturation, Mode=TwoWay}"
                                      Brightness="{Binding Brightness, Mode=TwoWay}" />

            <StackPanel Grid.Column="1">
                <!-- New over current, like Photoshop -->
                <TextBlock Text="new" FontSize="10" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                <Border Height="34" Background="{Binding NewBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,1,0" />
                <Border Height="34" Background="{Binding OriginalBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,1,1"
                        Cursor="Hand" ToolTip="Click to go back to the current color" MouseLeftButtonDown="Original_MouseLeftButtonDown" />
                <TextBlock Text="current" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,12" Foreground="{StaticResource TextSecondaryBrush}" />

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="R" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Red, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" AutomationProperties.Name="Red" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="G" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Green, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" AutomationProperties.Name="Green" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="B" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Blue, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" AutomationProperties.Name="Blue" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="#" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" AutomationProperties.Name="Hex" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="OK" Width="80" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
