<UserControl x:Class="JolieCat.UI.Views.Properties.ShapeToolOptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:JolieCat.UI.Controls"
             mc:Ignorable="d">
    <StackPanel Margin="10">
        <controls:LabeledSlider Label="Stroke Width" Minimum="0" Maximum="40" Suffix="px" Value="{Binding StrokeWidth, Mode=TwoWay}" />
        <CheckBox Content="Fill Shape" Foreground="{StaticResource TextPrimaryBrush}"
                  IsChecked="{Binding FillEnabled, Mode=TwoWay}" Margin="0,4,0,0" />
    </StackPanel>
</UserControl>
