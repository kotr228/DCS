<UserControl x:Class="JolieCat.UI.Views.Properties.GradientToolOptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:JolieCat.UI.Controls"
             xmlns:views="clr-namespace:JolieCat.UI.Views"
             xmlns:opts="clr-namespace:JolieCat.UI.ViewModels.ToolOptions"
             mc:Ignorable="d">
    <StackPanel Margin="10">
        <TextBlock Text="Type" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
        <ComboBox ItemsSource="{x:Static opts:GradientToolOptionsViewModel.AllKinds}"
                  SelectedItem="{Binding Kind, Mode=TwoWay}" Margin="0,0,0,8" />

        <TextBlock Text="Colors" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
        <ComboBox SelectedIndex="{Binding Colors, Mode=TwoWay, Converter={StaticResource EnumToIndex}}" Margin="0,0,0,8">
            <ComboBoxItem Content="Foreground → Background" />
            <ComboBoxItem Content="Foreground → Transparent" />
            <ComboBoxItem Content="Custom" />
        </ComboBox>

        <!-- Presets switch to a custom gradient. -->
        <ItemsControl ItemsSource="{Binding Presets}" Margin="0,0,0,8">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding}" Padding="6,2" Margin="0,0,4,4" FontSize="11"
                            Command="{Binding DataContext.LoadPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Delete preset"
                                          Command="{Binding PlacementTarget.DataContext.DeletePresetCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Custom gradient: the preview bar and one row per color stop. -->
        <StackPanel Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8">
            <controls:GradientStopsBar Margin="0,0,0,8" />
            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="26" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Color" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Grid.Column="1" Text="At %" FontSize="10" Margin="4,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Grid.Column="2" Text="Opac. %" FontSize="10" Margin="4,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Stops}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="26" />
                            </Grid.ColumnDefinitions>
                            <controls:ColorField Hex="{Binding Hex, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Column="1" Margin="4,0,0,0" Text="{Binding Location, StringFormat=0}" ToolTip="Location along the gradient, %" />
                            <TextBox Grid.Column="2" Margin="4,0,0,0" Text="{Binding Opacity, StringFormat=0}" ToolTip="Opacity, %" />
                            <Button Grid.Column="3" Content="&#xE711;" Style="{StaticResource IconButtonStyle}" ToolTip="Remove this stop"
                                    Command="{Binding DataContext.RemoveStopCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal">
                <Button Content="Add color stop" Padding="8,2" FontSize="11" Margin="0,0,6,0" Command="{Binding AddStopCommand}" />
                <Button Content="Save as preset" Padding="8,2" FontSize="11" Command="{Binding SavePresetCommand}"
                        ToolTip="Keep this gradient as a preset button (right-click a preset to delete it)" />
            </StackPanel>
        </StackPanel>

        <controls:LabeledSlider Label="Opacity" Minimum="0" Maximum="100" Suffix="%" Value="{Binding Opacity, Mode=TwoWay}" />
        <CheckBox Content="Reverse" Foreground="{StaticResource TextPrimaryBrush}"
                  IsChecked="{Binding Reverse, Mode=TwoWay}" Margin="0,4,0,0" />

        <TextBlock Text="Drag on the canvas from where the gradient starts to where it ends. Hold Shift for 45° steps."
                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,8" />

        <views:ColorPickerPanel DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.Canvas}" />
    </StackPanel>
</UserControl>
