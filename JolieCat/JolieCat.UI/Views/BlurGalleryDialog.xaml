<Window x:Class="JolieCat.UI.Views.BlurGalleryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:JolieCat.UI.ViewModels"
        xmlns:controls="clr-namespace:JolieCat.UI.Controls"
        mc:Ignorable="d"
        Title="{Binding Title}" Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        d:DataContext="{d:DesignInstance Type=vm:BlurGalleryViewModel, IsDesignTimeCreatable=False}">
    <StackPanel Margin="16">
        <TextBlock Text="SHARP AREA" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
        <controls:LabeledSlider Label="Center across" Suffix="%" Minimum="0" Maximum="100" Value="{Binding CenterX, Mode=TwoWay}" />
        <controls:LabeledSlider Label="Center down" Suffix="%" Minimum="0" Maximum="100" Value="{Binding CenterY, Mode=TwoWay}" />
        <controls:LabeledSlider Label="Sharp band (half height)" Suffix="%" Minimum="0" Maximum="50" Value="{Binding Size, Mode=TwoWay}"
                                Visibility="{Binding IsTiltShift, Converter={StaticResource BoolToVisibility}}" />
        <controls:LabeledSlider Label="Angle" Suffix="°" Minimum="-90" Maximum="90" Value="{Binding Angle, Mode=TwoWay}"
                                Visibility="{Binding IsTiltShift, Converter={StaticResource BoolToVisibility}}" />
        <controls:LabeledSlider Label="Width (radius)" Suffix="%" Minimum="1" Maximum="70" Value="{Binding Size, Mode=TwoWay}"
                                Visibility="{Binding IsIris, Converter={StaticResource BoolToVisibility}}" />
        <controls:LabeledSlider Label="Height (radius)" Suffix="%" Minimum="1" Maximum="70" Value="{Binding SizeY, Mode=TwoWay}"
                                Visibility="{Binding IsIris, Converter={StaticResource BoolToVisibility}}" />
        <controls:LabeledSlider Label="Transition" Suffix="%" Minimum="1" Maximum="60" Value="{Binding Transition, Mode=TwoWay}" />

        <TextBlock Text="BLUR" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,6" />
        <controls:LabeledSlider Label="Blur" Suffix="px" Minimum="0" Maximum="100" Value="{Binding Blur, Mode=TwoWay}" />
        <controls:LabeledSlider Label="Saturation (blurred parts)" Suffix="%" Minimum="-100" Maximum="100" Value="{Binding Saturation, Mode=TwoWay}" />

        <TextBlock Text="The canvas previews live. Tip: Tilt-Shift with more saturation makes a photo look like a miniature model."
                   FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="OK" Width="80" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
