<Window x:Class="JolieCat.UI.Views.ResizeCanvasDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:JolieCat.UI.ViewModels"
        xmlns:controls="clr-namespace:JolieCat.UI.Controls"
        mc:Ignorable="d"
        Title="{Binding Title}" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        d:DataContext="{d:DesignInstance Type=vm:ResizeCanvasViewModel, IsDesignTimeCreatable=True}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" VerticalAlignment="Top">
            <controls:LabeledSlider Label="Scale" Minimum="1" Maximum="400" Suffix="%"
                                     Value="{Binding Percent, Mode=TwoWay}" Margin="0,0,0,8"
                                     Visibility="{Binding IsResample, Converter={StaticResource BoolToVisibility}}" />
            <controls:LabeledSlider Label="Width" Minimum="1" Maximum="16000" Suffix="px"
                                     Value="{Binding Width, Mode=TwoWay}" Margin="0,0,0,8" />
            <controls:LabeledSlider Label="Height" Minimum="1" Maximum="16000" Suffix="px"
                                     Value="{Binding Height, Mode=TwoWay}" Margin="0,0,0,10" />

            <CheckBox Content="Lock Aspect Ratio" Foreground="{StaticResource TextPrimaryBrush}"
                      IsChecked="{Binding LockAspectRatio, Mode=TwoWay}" />
            <CheckBox Content="Keep content centered" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6,0,0"
                      IsChecked="{Binding AnchorCenter, Mode=TwoWay}"
                      Visibility="{Binding IsCanvasSize, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                       Text="{Binding Description}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click" />
            <Button Content="{Binding ApplyLabel}" Width="80" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Click="Resize_Click" />
        </StackPanel>
    </Grid>
</Window>
