<Window x:Class="JolieCat.UI.Views.LiquifyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:JolieCat.UI.ViewModels"
        xmlns:controls="clr-namespace:JolieCat.UI.Controls"
        mc:Ignorable="d"
        Title="Liquify" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        d:DataContext="{d:DesignInstance Type=vm:LiquifyViewModel, IsDesignTimeCreatable=False}">
    <Window.Resources>
        <Style x:Key="ToolRow" TargetType="RadioButton">
            <Setter Property="GroupName" Value="LiquifyTools" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="3" Padding="8,7" Margin="0,0,0,2">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource OnAccentTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- Checkerboard behind the preview, so transparent areas read as such. -->
        <DrawingBrush x:Key="Checker" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FF5A5555" Geometry="M0,0 H2 V2 H0Z" />
                    <GeometryDrawing Brush="#FF6E6969" Geometry="M0,0 H1 V1 H0Z M1,1 H2 V2 H1Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="230" />
        </Grid.ColumnDefinitions>

        <!-- Tools -->
        <StackPanel Grid.Column="0" Margin="0,0,12,0">
            <TextBlock Text="TOOLS" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="4,0,0,6" />
            <RadioButton x:Name="ToolWarp" Style="{StaticResource ToolRow}" Content="Forward Warp  (W)" Checked="Tool_Checked" Tag="{x:Static vm:LiquifyTool.ForwardWarp}" />
            <RadioButton x:Name="ToolReconstruct" Style="{StaticResource ToolRow}" Content="Reconstruct  (R)" Checked="Tool_Checked" Tag="{x:Static vm:LiquifyTool.Reconstruct}" />
            <RadioButton x:Name="ToolPucker" Style="{StaticResource ToolRow}" Content="Pucker  (S)" Checked="Tool_Checked" Tag="{x:Static vm:LiquifyTool.Pucker}" />
            <RadioButton x:Name="ToolBloat" Style="{StaticResource ToolRow}" Content="Bloat  (B)" Checked="Tool_Checked" Tag="{x:Static vm:LiquifyTool.Bloat}" />
            <RadioButton x:Name="ToolTwirlCw" Style="{StaticResource ToolRow}" Content="Twirl Clockwise  (C)" Checked="Tool_Checked" Tag="{x:Static vm:LiquifyTool.TwirlClockwise}" />
            <RadioButton x:Name="ToolTwirlCcw" Style="{StaticResource ToolRow}" Content="Twirl Counter  (Alt+C)" Checked="Tool_Checked" Tag="{x:Static vm:LiquifyTool.TwirlCounterClockwise}" />
        </StackPanel>

        <!-- Preview: drag on it with the brush -->
        <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource Checker}"
                VerticalAlignment="Top" HorizontalAlignment="Center">
            <Grid x:Name="Surface" Width="{Binding PreviewWidth}" Height="{Binding PreviewHeight}" ClipToBounds="True"
                  Background="Transparent" Cursor="None"
                  MouseLeftButtonDown="Surface_MouseLeftButtonDown" MouseMove="Surface_MouseMove"
                  MouseLeftButtonUp="Surface_MouseLeftButtonUp" MouseLeave="Surface_MouseLeave" MouseEnter="Surface_MouseEnter">
                <Image Source="{Binding Preview}" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <Canvas IsHitTestVisible="False">
                    <Ellipse x:Name="BrushCircle" Width="{Binding BrushPreviewDiameter}" Height="{Binding BrushPreviewDiameter}"
                             Stroke="White" StrokeThickness="1" Visibility="Collapsed">
                        <Ellipse.Effect>
                            <DropShadowEffect ShadowDepth="0" BlurRadius="2" Color="Black" Opacity="1" />
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>
            </Grid>
        </Border>

        <!-- Options -->
        <DockPanel Grid.Column="2" Margin="12,0,0,0">
            <StackPanel DockPanel.Dock="Bottom">
                <Button Content="OK" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Click="Ok_Click" Margin="0,0,0,8" />
                <Button Content="Cancel" IsCancel="True" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="BRUSH" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,6" />
                <controls:LabeledSlider Label="Size" Suffix="px" Minimum="5" Maximum="1500" Value="{Binding BrushSize, Mode=TwoWay}" />
                <controls:LabeledSlider Label="Pressure" Suffix="%" Minimum="1" Maximum="100" Value="{Binding Pressure, Mode=TwoWay}" />
                <CheckBox Content="Show other layers" IsChecked="{Binding ShowBackdrop}" Margin="0,8,0,0"
                          Visibility="{Binding HasBackdrop, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="Undo stroke  (Ctrl+Z)" Command="{Binding UndoStrokeCommand}" IsEnabled="{Binding CanUndo}" Margin="0,12,0,8" />
                <Button Content="Restore All" Command="{Binding RestoreAllCommand}" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0"
                           Text="Drag on the image to reshape it. Pucker, Bloat, Twirl and Reconstruct keep working while you hold the mouse still. [ and ] change the brush size." />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
