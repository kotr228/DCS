<Window x:Class="JolieCat.UI.Views.FilterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:JolieCat.UI.ViewModels"
        xmlns:controls="clr-namespace:JolieCat.UI.Controls"
        mc:Ignorable="d"
        Title="{Binding Title, Converter={StaticResource Tr}}" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        d:DataContext="{d:DesignInstance Type=vm:FilterOptionsViewModel, IsDesignTimeCreatable=False}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Every filter with settings is just this one slider - see
             FilterOptionsViewModel for why one shell covers all of them. The canvas
             previews each change live behind the dialog. -->
        <StackPanel Grid.Row="0">
            <controls:LabeledSlider VerticalAlignment="Top"
                                     Label="{Binding AmountLabel, Converter={StaticResource Tr}}" Suffix="{Binding Suffix}"
                                     Minimum="{Binding AmountMin}" Maximum="{Binding AmountMax}"
                                     Value="{Binding Amount, Mode=TwoWay}" />
            <controls:LabeledSlider VerticalAlignment="Top" Margin="0,8,0,0"
                                     Visibility="{Binding HasSecondAmount, Converter={StaticResource BoolToVisibility}}"
                                     Label="{Binding SecondAmountLabel, Converter={StaticResource Tr}}" Suffix="{Binding SecondSuffix}"
                                     Minimum="{Binding SecondAmountMin}" Maximum="{Binding SecondAmountMax}"
                                     Value="{Binding SecondAmount, Mode=TwoWay}" />
            <TextBlock Text="Preview updates live on the canvas. Applies inside the selection, if there is one."
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click" />
            <Button Content="Apply" Width="80" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Click="Apply_Click" />
        </StackPanel>
    </Grid>
</Window>
