<UserControl x:Class="JolieCat.UI.Controls.LabeledSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             x:Name="Root">
    <StackPanel Margin="0,0,0,10">
        <TextBlock Text="{Binding Label, ElementName=Root}"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="58" />
            </Grid.ColumnDefinitions>

            <Slider Grid.Column="0" VerticalAlignment="Center"
                    Minimum="{Binding Minimum, ElementName=Root}"
                    Maximum="{Binding Maximum, ElementName=Root}"
                    Value="{Binding Value, ElementName=Root, Mode=TwoWay}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- Click to type an exact value; Enter or leaving the box applies it,
                     Esc restores the current value. -->
                <TextBox x:Name="ValueBox" Text="{Binding DisplayText, ElementName=Root, Mode=OneWay}"
                         MinWidth="26" Padding="0" BorderThickness="0,0,0,1" Background="Transparent"
                         BorderBrush="{StaticResource BorderBrush}" HorizontalContentAlignment="Right"
                         Foreground="{StaticResource TextPrimaryBrush}" CaretBrush="{StaticResource TextPrimaryBrush}"
                         ToolTip="Click to type a value" KeyDown="ValueBox_KeyDown" LostKeyboardFocus="ValueBox_LostKeyboardFocus"
                         GotKeyboardFocus="ValueBox_GotKeyboardFocus" />
                <TextBlock Text="{Binding Suffix, ElementName=Root}"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="1,0,0,0" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
