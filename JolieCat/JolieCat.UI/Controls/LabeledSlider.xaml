<UserControl x:Class="JolieCat.UI.Controls.LabeledSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             x:Name="Root">
    <StackPanel Margin="0,0,0,10">
        <TextBlock Text="{Binding Label, ElementName=Root}"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="48" />
            </Grid.ColumnDefinitions>

            <Slider Grid.Column="0" VerticalAlignment="Center"
                    Minimum="{Binding Minimum, ElementName=Root}"
                    Maximum="{Binding Maximum, ElementName=Root}"
                    Value="{Binding Value, ElementName=Root, Mode=TwoWay}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="{Binding Value, ElementName=Root, StringFormat={}{0:0}}"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding Suffix, ElementName=Root}"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="1,0,0,0" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
