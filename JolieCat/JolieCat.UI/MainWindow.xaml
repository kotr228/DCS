<Window x:Class="JolieCat.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JolieCat.UI"
        xmlns:vm="clr-namespace:JolieCat.UI.ViewModels"
        xmlns:views="clr-namespace:JolieCat.UI.Views"
        xmlns:timeline="clr-namespace:JolieCat.UI.Views.Timeline"
        xmlns:controls="clr-namespace:JolieCat.UI.Controls"
        xmlns:layers="clr-namespace:JolieCat.UI.ViewModels.Layers"
        mc:Ignorable="d"
        Title="JolieCat" Height="720" Width="1280" MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=True}">

    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveProjectCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenProjectCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <!-- Column that hosts the Left panel: collapses to zero width when the panel is hidden. -->
        <Style x:Key="LeftPanelColumnStyle" TargetType="ColumnDefinition">
            <Setter Property="Width" Value="260" />
            <Setter Property="MinWidth" Value="180" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLeftPanelVisible}" Value="False">
                    <Setter Property="Width" Value="0" />
                    <Setter Property="MinWidth" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Splitter column next to the Left panel: collapses along with it. -->
        <Style x:Key="LeftSplitterColumnStyle" TargetType="ColumnDefinition">
            <Setter Property="Width" Value="Auto" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLeftPanelVisible}" Value="False">
                    <Setter Property="Width" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Column that hosts the Right panel (Properties/Layers): collapses to zero width when hidden. -->
        <Style x:Key="RightPanelColumnStyle" TargetType="ColumnDefinition">
            <Setter Property="Width" Value="300" />
            <Setter Property="MinWidth" Value="220" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRightPanelVisible}" Value="False">
                    <Setter Property="Width" Value="0" />
                    <Setter Property="MinWidth" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Splitter column next to the Right panel: collapses along with it. -->
        <Style x:Key="RightSplitterColumnStyle" TargetType="ColumnDefinition">
            <Setter Property="Width" Value="Auto" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRightPanelVisible}" Value="False">
                    <Setter Property="Width" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Row that hosts the Bottom panel (Timeline): collapses to zero height when hidden. -->
        <Style x:Key="BottomPanelRowStyle" TargetType="RowDefinition">
            <Setter Property="Height" Value="260" />
            <Setter Property="MinHeight" Value="120" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBottomPanelVisible}" Value="False">
                    <Setter Property="Height" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Splitter row above the Bottom panel: collapses along with it. -->
        <Style x:Key="BottomSplitterRowStyle" TargetType="RowDefinition">
            <Setter Property="Height" Value="Auto" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBottomPanelVisible}" Value="False">
                    <Setter Property="Height" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Shared look for the four docking zone containers. -->
        <Style x:Key="DockPanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="PanelHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="8,6" />
        </Style>


        <!-- Flat ListBoxItem style for tool entries: no default chrome, accent highlight
             on the active tool, subtle hover otherwise. -->
        <Style x:Key="ToolListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact toolbar button for the Layers panel's add/delete/reorder/merge row. -->
        <Style x:Key="LayerToolButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinWidth" Value="26" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>

        <!-- Wrapping tool tile: an icon-only square, name shown only as a tooltip - this
             (rather than the old full-width icon+label row) is what lets the ListBox's
             WrapPanel actually flow tools into more than one column as the Tools panel
             gets wider, instead of every tile filling the whole row by itself. -->
        <Style x:Key="ToolTileStyle" TargetType="Border">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Background" Value="{StaticResource PanelAltBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- Collapsible category section in the Tools panel: a flat chevron+title header
             (no default Expander bubble/arrow chrome, which doesn't match this app's flat
             dark theme) toggling a ContentPresenter below it. -->
        <Style x:Key="ToolCategoryExpanderStyle" TargetType="Expander">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Top" Cursor="Hand" Focusable="False"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="Transparent" Padding="8,4,8,2">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock x:Name="Chevron" Text="&#x25BE;" Width="12" FontSize="9"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       VerticalAlignment="Center" />
                                                            <ContentPresenter ContentSource="Content" Margin="4,0,0,0"
                                                                               TextBlock.FontSize="10" TextBlock.FontWeight="SemiBold"
                                                                               TextBlock.Foreground="{StaticResource TextSecondaryBrush}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="False">
                                                            <Setter TargetName="Chevron" Property="Text" Value="&#x25B8;" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Content" Value="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" />
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <ContentPresenter x:Name="Body" Visibility="Collapsed" />
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Top toolbar -->
            <RowDefinition Height="*" MinHeight="150" /> <!-- Left / Center / Right -->
            <RowDefinition Style="{StaticResource BottomSplitterRowStyle}" />
            <RowDefinition Style="{StaticResource BottomPanelRowStyle}" /> <!-- Bottom: Timeline -->
            <RowDefinition Height="Auto" /> <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ================= Top Toolbar ================= -->
        <Border Grid.Row="0" Background="{StaticResource PanelAltBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="6">
                <ToggleButton Content="Tools" Width="70" Margin="2,0"
                              Style="{StaticResource PanelToggleButtonStyle}"
                              IsChecked="{Binding IsLeftPanelVisible, Mode=OneWay}"
                              Command="{Binding ToggleLeftPanelCommand}" />
                <ToggleButton Content="Properties" Width="80" Margin="2,0"
                              Style="{StaticResource PanelToggleButtonStyle}"
                              IsChecked="{Binding IsRightPanelVisible, Mode=OneWay}"
                              Command="{Binding ToggleRightPanelCommand}" />
                <ToggleButton Content="Timeline" Width="80" Margin="2,0"
                              Style="{StaticResource PanelToggleButtonStyle}"
                              IsChecked="{Binding IsBottomPanelVisible, Mode=OneWay}"
                              Command="{Binding ToggleBottomPanelCommand}" />

                <Border Width="1" Margin="8,2" Background="{StaticResource BorderBrush}" />

                <Button Content="Open" Width="60" Margin="2,0" ToolTip="Open a .jolie project (Ctrl+O)"
                        Command="{Binding OpenProjectCommand}" />
                <Button Content="Save" Width="60" Margin="2,0" ToolTip="Save this project as .jolie (Ctrl+S)"
                        Command="{Binding SaveProjectCommand}" />
                <Button Content="Import..." Width="70" Margin="2,0"
                        ToolTip="Import image files (PNG/JPG/BMP/WEBP) as new layers - or just drag them onto the canvas"
                        Command="{Binding ImportImageCommand}" />
                <Button Content="Export..." Width="70" Margin="2,0"
                        ToolTip="Export the flattened image (or a single layer) as PNG/JPEG/WebP"
                        Command="{Binding ExportImageCommand}" />

                <Border Width="1" Margin="8,2" Background="{StaticResource BorderBrush}" />

                <Button Content="Undo" Width="60" Margin="2,0" ToolTip="Undo (Ctrl+Z)"
                        Command="{Binding UndoCommand}" />
                <Button Content="Redo" Width="60" Margin="2,0" ToolTip="Redo (Ctrl+Y)"
                        Command="{Binding RedoCommand}" />
            </StackPanel>
        </Border>

        <!-- ================= Left / Center / Right ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Style="{StaticResource LeftPanelColumnStyle}" />
                <ColumnDefinition Style="{StaticResource LeftSplitterColumnStyle}" />
                <ColumnDefinition Width="*" MinWidth="300" /> <!-- Center: Canvas -->
                <ColumnDefinition Style="{StaticResource RightSplitterColumnStyle}" />
                <ColumnDefinition Style="{StaticResource RightPanelColumnStyle}" />
            </Grid.ColumnDefinitions>

            <!-- Left: Tools - each category is an independently collapsible Expander;
                 inside one, a WrapPanel-backed ListBox flows icon tiles into as many
                 columns as the panel's current width allows (drag the splitter wider to
                 see more columns per row), rather than one tool per full-width row. -->
            <Border Grid.Column="0" Style="{StaticResource DockPanelBorderStyle}"
                    Visibility="{Binding IsLeftPanelVisible, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <TextBlock Text="TOOLS" DockPanel.Dock="Top" Style="{StaticResource PanelHeaderStyle}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Toolbox.ToolsByCategory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Header="{Binding DisplayName}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                              Style="{StaticResource ToolCategoryExpanderStyle}" Margin="0,0,0,2">
                                        <ListBox ItemsSource="{Binding Tools}"
                                                 Background="Transparent" BorderThickness="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                 ItemContainerStyle="{StaticResource ToolListBoxItemStyle}"
                                                 SelectedItem="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.Toolbox.ActiveTool, Mode=TwoWay}">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource ToolTileStyle}" ToolTip="{Binding DisplayName}">
                                                        <!-- EvenOdd is the mini-language's default fill rule, which several icons
                                                             (marquees, zoom lens, canvas-rotate ring) rely on to punch a hole. -->
                                                        <Path Data="{Binding IconData}" Fill="{StaticResource TextPrimaryBrush}"
                                                              Stretch="Uniform" Width="16" Height="16"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Visibility="{Binding IsLeftPanelVisible, Converter={StaticResource BoolToVisibility}}" />

            <!-- Center: Canvas (software-rendered Skia surface - see CanvasView.xaml.cs).
                 SnapsToDevicePixels explicitly repeated here (on top of the Window's own
                 UseLayoutRounding/SnapsToDevicePixels) so this Border's own background -
                 a different color than the canvas's OutsideDocumentColor - can never show
                 through as a hairline seam at the SKElement's edge from a sub-pixel
                 layout mismatch between the two. -->
            <Border Grid.Column="2" Style="{StaticResource DockPanelBorderStyle}" SnapsToDevicePixels="True">
                <views:CanvasView DataContext="{Binding Canvas}" SnapsToDevicePixels="True" />
            </Border>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch"
                          Visibility="{Binding IsRightPanelVisible, Converter={StaticResource BoolToVisibility}}" />

            <!-- Right: Properties (top, dynamic per active tool) / Layers (bottom) -->
            <Grid Grid.Column="4"
                  Visibility="{Binding IsRightPanelVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="100" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="100" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource DockPanelBorderStyle}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelHeaderStyle}">
                            <Run Text="PROPERTIES" /><Run Text=" - " /><Run Text="{Binding Toolbox.ActiveTool.DisplayName, Mode=OneWay}" />
                        </TextBlock>
                        <ContentControl Content="{Binding Toolbox.CurrentToolOptions}" />
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center" />

                <Border Grid.Row="2" Style="{StaticResource DockPanelBorderStyle}">
                    <DockPanel>
                        <TextBlock Text="LAYERS" DockPanel.Dock="Top" Style="{StaticResource PanelHeaderStyle}" />

                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,8,6">
                            <Button Content="+" ToolTip="Add layer" Style="{StaticResource LayerToolButtonStyle}"
                                    Command="{Binding Layers.AddLayerCommand}" />
                            <Button Content="&#x2212;" ToolTip="Delete layer" Style="{StaticResource LayerToolButtonStyle}"
                                    Command="{Binding Layers.DeleteLayerCommand}" />
                            <Button Content="&#x25B2;" ToolTip="Move layer up" Style="{StaticResource LayerToolButtonStyle}"
                                    Command="{Binding Layers.MoveLayerUpCommand}" />
                            <Button Content="&#x25BC;" ToolTip="Move layer down" Style="{StaticResource LayerToolButtonStyle}"
                                    Command="{Binding Layers.MoveLayerDownCommand}" />
                            <Button Content="Merge" ToolTip="Merge down onto the layer below" Style="{StaticResource LayerToolButtonStyle}"
                                    Command="{Binding Layers.MergeDownCommand}" />
                            <Button Content="Mask+" ToolTip="Add a mask to the active layer" Style="{StaticResource LayerToolButtonStyle}"
                                    Command="{Binding Layers.AddMaskCommand}" />
                            <Button Content="Mask&#x2212;" ToolTip="Remove the active layer's mask" Style="{StaticResource LayerToolButtonStyle}"
                                    Command="{Binding Layers.RemoveMaskCommand}" />
                        </StackPanel>

                        <!-- Blend Mode + Opacity apply to whichever layer is currently
                             active, shown once here rather than duplicated into every row
                             below - the same layout Photoshop's own Layers panel uses. -->
                        <StackPanel DockPanel.Dock="Top" Margin="8,0,8,8">
                            <ComboBox ItemsSource="{x:Static layers:BlendModeOption.All}"
                                      DisplayMemberPath="DisplayName" SelectedValuePath="Value"
                                      SelectedValue="{Binding Layers.ActiveLayer.BlendMode, Mode=TwoWay}"
                                      ToolTip="Blend mode" Margin="0,0,0,6" />
                            <controls:LabeledSlider Label="Opacity" Minimum="0" Maximum="100" Suffix="%"
                                                     Value="{Binding Layers.ActiveLayer.OpacityPercent, Mode=TwoWay}" />
                        </StackPanel>

                        <!-- Layers.Items is already front-to-back (topmost/foreground layer
                             first), matching how this list reads top-to-bottom. -->
                        <ListBox ItemsSource="{Binding Layers.Items}" SelectedItem="{Binding Layers.ActiveLayer, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource ToolListBoxItemStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="6,4">
                                        <CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay}" ToolTip="Visible"
                                                  VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <CheckBox IsChecked="{Binding IsLocked, Mode=TwoWay}" ToolTip="Locked"
                                                  VerticalAlignment="Center" Margin="0,0,8,0" />

                                        <!-- Plain label normally; double-clicking it swaps in the
                                             textbox below for an inline rename (see MainWindow's
                                             code-behind for the edit/commit/cancel handlers). -->
                                        <TextBlock Text="{Binding Name}" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Visibility="{Binding IsNotEditingName, Converter={StaticResource BoolToVisibility}}"
                                                   MouseLeftButtonDown="LayerName_MouseLeftButtonDown" />
                                        <TextBox Text="{Binding Name, Mode=TwoWay}" FontSize="11" Width="120"
                                                 Visibility="{Binding IsEditingName, Converter={StaticResource BoolToVisibility}}"
                                                 Loaded="LayerNameEditBox_Loaded"
                                                 KeyDown="LayerNameEditBox_KeyDown"
                                                 LostFocus="LayerNameEditBox_LostFocus" />

                                        <!-- Mask thumbnail - only shown once this layer
                                             actually has a mask (see LayerViewModel.HasMask).
                                             A checked/highlighted border means this mask,
                                             not the layer's own color content, is what
                                             painting tools currently draw onto (IsMaskActive) -
                                             clicking it toggles that, the same gesture every
                                             other raster editor uses to select a layer's mask
                                             as the active paint target. -->
                                        <ToggleButton Width="22" Height="22" Margin="8,0,0,0" Padding="0"
                                                      IsChecked="{Binding IsMaskActive, Mode=TwoWay}"
                                                      Visibility="{Binding HasMask, Converter={StaticResource BoolToVisibility}}"
                                                      ToolTip="Click to paint this layer's mask instead of its content">
                                            <ToggleButton.Style>
                                                <Style TargetType="ToggleButton">
                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ToggleButton.Style>
                                            <Image Source="{Binding MaskThumbnail}" Stretch="Uniform" Width="18" Height="18" />
                                        </ToggleButton>

                                        <!-- A disabled/unchecked mask still exists (see
                                             LayerMask.IsEnabled's own remarks) - this lets it
                                             be toggled off to compare against the unmasked
                                             layer without removing it outright. -->
                                        <CheckBox IsChecked="{Binding IsMaskEnabled, Mode=TwoWay}"
                                                  Visibility="{Binding HasMask, Converter={StaticResource BoolToVisibility}}"
                                                  ToolTip="Mask enabled" VerticalAlignment="Center" Margin="4,0,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ================= Bottom: Timeline ================= -->
        <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch"
                      Visibility="{Binding IsBottomPanelVisible, Converter={StaticResource BoolToVisibility}}" />

        <Border Grid.Row="3" Style="{StaticResource DockPanelBorderStyle}"
                Visibility="{Binding IsBottomPanelVisible, Converter={StaticResource BoolToVisibility}}">
            <timeline:TimelinePanelView DataContext="{Binding Timeline}" />
        </Border>

        <!-- ================= Status Bar ================= -->
        <!-- Always present (unlike the docking zones above) rather than collapsing when
             idle - a conventional status bar's own footprint stays stable regardless of
             whether it currently has anything to say. -->
        <Border Grid.Row="4" Background="{StaticResource PanelAltBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Margin="10,3" FontSize="11" Text="{Binding SaveStatusMessage}"
                       Foreground="{StaticResource TextSecondaryBrush}">
                <TextBlock.Style>
                    <!-- Fades SaveSuccessMessage/ExportSuccessMessage out a couple of
                         seconds after either appears, rather than having it just vanish
                         the instant MainViewModel clears it back to empty. Only those
                         two exact messages fade - "Saving project..."/"Exporting
                         image..." (and anything else) stay fully opaque the whole time
                         they're showing. -->
                    <Style TargetType="TextBlock">
                        <Setter Property="Opacity" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SaveStatusMessage}" Value="{x:Static vm:MainViewModel.SaveSuccessMessage}">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="1" To="0" BeginTime="0:0:1.5" Duration="0:0:1" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SaveStatusMessage}" Value="{x:Static vm:MainViewModel.ExportSuccessMessage}">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="1" To="0" BeginTime="0:0:1.5" Duration="0:0:1" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Temporary debug readout - see MainViewModel.DimensionDebugText's own
                 remarks. Not gated behind any "debug mode" flag; remove this TextBlock
                 (and the property/wiring behind it) once the dimension-mismatch
                 investigation it's here for is resolved. -->
            <TextBlock Grid.Column="1" Margin="10,3" FontSize="11" FontFamily="Consolas"
                       Text="{Binding DimensionDebugText}"
                       Foreground="{StaticResource TextSecondaryBrush}" />
          </Grid>
        </Border>

        <!-- ================= Saving Overlay ================= -->
        <!-- Spans every row, including the toolbar - so Save/Open/Import/Undo/Redo are
             all blocked too, not just the panels - blocking further edits for exactly
             the span MainViewModel.IsSaving is true (the save's own write duration, via
             SaveProjectAsync), which is deliberately shorter than how long the status
             bar's success message stays up afterward (see MainViewModel's remarks). -->
        <Border Grid.Row="0" Grid.RowSpan="5" Background="#B0000000"
                Visibility="{Binding IsSaving, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path Width="36" Height="36" Stretch="Uniform" HorizontalAlignment="Center"
                      Stroke="{StaticResource AccentBrush}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Path.Data>
                        <PathGeometry>
                            <PathFigure StartPoint="18,2" IsClosed="False">
                                <ArcSegment Point="34,18" Size="16,16" SweepDirection="Clockwise" IsLargeArc="True" />
                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>
                    <Path.RenderTransform>
                        <RotateTransform CenterX="18" CenterY="18" />
                    </Path.RenderTransform>
                    <Path.Triggers>
                        <EventTrigger RoutedEvent="Path.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)"
                                                     From="0" To="360" Duration="0:0:0.9" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Path.Triggers>
                </Path>
                <TextBlock Text="Saving project..." Margin="0,12,0,0" HorizontalAlignment="Center"
                           FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
            </StackPanel>
        </Border>
