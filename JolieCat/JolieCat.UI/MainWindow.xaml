                            <MenuItem Header="Clouds" Command="{Binding OpenFilterDialogCommand}"
                                      CommandParameter="{x:Static vm:FilterKind.Clouds}"
                                      ToolTip="Fills the layer with clouds from the foreground to the background color" />
                            <MenuItem Header="Lens Flare..." Command="{Binding LensFlareCommand}" />
                            <MenuItem Header="Lighting Effects..." Command="{Binding LightingEffectsCommand}" />
                        </MenuItem>
                        <MenuItem Header="Pixelate">
                            <MenuItem Header="Mosaic..." Command="{Binding OpenFilterDialogCommand}"
                                      CommandParameter="{x:Static vm:FilterKind.Pixelate}" />
                            <MenuItem Header="Crystallize..." Command="{Binding OpenFilterDialogCommand}"
                                      CommandParameter="{x:Static vm:FilterKind.Crystallize}" />
                            <MenuItem Header="Color Halftone..." Command="{Binding OpenFilterDialogCommand}"
                                      CommandParameter="{x:Static vm:FilterKind.ColorHalftone}" />
                            <MenuItem Header="Mezzotint" Command="{Binding OpenFilterDialogCommand}"
                                      CommandParameter="{x:Static vm:FilterKind.Mezzotint}" />
                        </MenuItem>
                        <MenuItem Header="Stylize">
                            <MenuItem Header="Emboss..." Command="{Binding OpenFilterDialogCommand}"
                                      CommandParameter="{x:Static vm:FilterKind.Emboss}" />
                            <MenuItem Header="Find Edges" Command="{Binding OpenFilterDialogCommand}"
                                      CommandParameter="{x:Static vm:FilterKind.FindEdges}" />
                            <MenuItem Header="Oil Paint..." Command="{Binding OpenFilterDialogCommand}"
                                      CommandParameter="{x:Static vm:FilterKind.OilPaint}" />
                            <MenuItem Header="Glowing Edges..." Command="{Binding OpenFilterDialogCommand}"
                                      CommandParameter="{x:Static vm:FilterKind.GlowingEdges}" />
                            <MenuItem Header="Cutout..." Command="{Binding OpenFilterDialogCommand}"
                                      CommandParameter="{x:Static vm:FilterKind.Cutout}" />
                            <MenuItem Header="Solarize" Command="{Binding OpenFilterDialogCommand}"
                                      CommandParameter="{x:Static vm:FilterKind.Solarize}" />
                            <MenuItem Header="Wind..." Command="{Binding OpenFilterDialogCommand}"
                                      CommandParameter="{x:Static vm:FilterKind.Wind}" />
                            <MenuItem Header="Diffuse..." Command="{Binding OpenFilterDialogCommand}"
                                      CommandParameter="{x:Static vm:FilterKind.Diffuse}" />
                            <MenuItem Header="Tiles..." Command="{Binding OpenFilterDialogCommand}"
                                      CommandParameter="{x:Static vm:FilterKind.Tiles}" />
                        </MenuItem>
                        <MenuItem Header="Vignette..." Command="{Binding OpenFilterDialogCommand}"
                                  CommandParameter="{x:Static vm:FilterKind.Vignette}" />
                        <MenuItem Header="Other">
                            <MenuItem Header="High Pass..." Command="{Binding OpenFilterDialogCommand}"
                                      CommandParameter="{x:Static vm:FilterKind.HighPass}" />
                            <MenuItem Header="Custom..." Command="{Binding CustomFilterCommand}"
                                      ToolTip="Your own convolution kernel (sharpen, emboss, edge detection...), previewed live" />
                            <MenuItem Header="Maximum..." Command="{Binding OpenFilterDialogCommand}"
                                      CommandParameter="{x:Static vm:FilterKind.Maximum}" />
                            <MenuItem Header="Minimum..." Command="{Binding OpenFilterDialogCommand}"
                                      CommandParameter="{x:Static vm:FilterKind.Minimum}" />
                            <MenuItem Header="Offset..." Command="{Binding OpenFilterDialogCommand}"
                                      CommandParameter="{x:Static vm:FilterKind.Offset}" />
                        </MenuItem>
                    </MenuItem>

                    <MenuItem Header="_Animation">
                        <MenuItem Header="Convert to Clipbar Animation..." Command="{Binding ConvertToClipbarAnimationCommand}"
                                  ToolTip="Animation is made in Clipbar Animation projects: open a copy of this document as one" />
                        <Separator />
                        <MenuItem Header="Show Timeline" InputGestureText="Shift+Ctrl+T" Command="{Binding ToggleTimelineCommand}"
                                  IsCheckable="True" IsChecked="{Binding ActiveDocument.IsTimelineMode, Mode=OneWay}" />
                        <Separator />
                        <MenuItem Header="Play / Pause" Command="{Binding AnimationCommand}" CommandParameter="Play" />
                        <MenuItem Header="Next Frame" Command="{Binding AnimationCommand}" CommandParameter="NextFrame" />
                        <MenuItem Header="Previous Frame" Command="{Binding AnimationCommand}" CommandParameter="PreviousFrame" />
                        <Separator />
                        <MenuItem Header="New Frame" Command="{Binding AnimationCommand}" CommandParameter="NewFrame"
                                  ToolTip="Frame-by-frame: a blank frame (a new layer) after the current one" />
                        <MenuItem Header="Duplicate Frame" Command="{Binding AnimationCommand}" CommandParameter="DuplicateFrame" />
                        <MenuItem Header="Delete Frame" Command="{Binding AnimationCommand}" CommandParameter="DeleteFrame" />
                        <MenuItem Header="Make Frames Multi-layer" Command="{Binding AnimationCommand}" CommandParameter="MultiLayerFrames"
                                  ToolTip="Each frame becomes a group, so a frame can have several layers (lines over colors)" />
                        <MenuItem Header="Onion Skin" Command="{Binding AnimationCommand}" CommandParameter="OnionSkin"
                                  IsCheckable="True" IsChecked="{Binding ActiveDocument.Timeline.OnionSkin, Mode=OneWay}" />
                        <Separator />
                        <MenuItem Header="Animate Layer" Command="{Binding AnimationCommand}" CommandParameter="AnimateLayer"
                                  ToolTip="Keyframes: move, scale, turn and fade the active layer or group" />
                        <MenuItem Header="Move Along Path..." Command="{Binding AnimationCommand}" CommandParameter="MoveAlongPath"
                                  ToolTip="The selected layer travels along a path drawn with the Pen tool (and can turn to follow it)" />
                        <MenuItem Header="Reverse Keyframes" Command="{Binding AnimationCommand}" CommandParameter="ReverseKeys"
                                  ToolTip="The selected keys (or all of the selected layer's) play backwards" />
                        <MenuItem Header="Stretch Keyframes..." Command="{Binding AnimationCommand}" CommandParameter="StretchKeys"
                                  ToolTip="Spread the keys out in time, or squeeze them together" />
                        <MenuItem Header="Add Camera" Command="{Binding AnimationCommand}" CommandParameter="AddCamera"
                                  ToolTip="Zoom, pan and turn the whole picture with keyframes" />
                        <MenuItem Header="Add Audio..." Command="{Binding AnimationCommand}" CommandParameter="AddAudio" />
                        <Separator />
                        <MenuItem Header="Add Marker..." Command="{Binding AddMarkerCommand}" ToolTip="A named spot at the playhead (a beat, a word...)" />
                        <MenuItem Header="Next Marker" Command="{Binding AnimationCommand}" CommandParameter="NextMarker" />
                        <MenuItem Header="Previous Marker" Command="{Binding AnimationCommand}" CommandParameter="PreviousMarker" />
                        <MenuItem Header="Set Work Area Start (In)" Command="{Binding AnimationCommand}" CommandParameter="SetIn"
                                  ToolTip="Play and export only from here" />
                        <MenuItem Header="Set Work Area End (Out)" Command="{Binding AnimationCommand}" CommandParameter="SetOut"
                                  ToolTip="Play and export only up to here" />
                        <MenuItem Header="Clear Work Area" Command="{Binding AnimationCommand}" CommandParameter="ClearWorkArea" />
                        <MenuItem Header="Import Frames..." Command="{Binding ImportFramesCommand}"
                                  ToolTip="An animated GIF, or several pictures, as frames" />
                        <Separator />
                        <MenuItem Header="Export Animation..." Command="{Binding ExportAnimationCommand}"
                                  ToolTip="GIF, MP4 video, PNG files or a sprite sheet" />
                    </MenuItem>

                    <MenuItem Header="_View">
                        <MenuItem Header="Zoom In" InputGestureText="Ctrl++" Command="{Binding Canvas.ZoomInCommand}" />
                        <MenuItem Header="Zoom Out" InputGestureText="Ctrl+-" Command="{Binding Canvas.ZoomOutCommand}" />
                        <MenuItem Header="Fit on Screen" InputGestureText="Ctrl+0" Command="{Binding Canvas.ZoomToFitCommand}" />
                        <MenuItem Header="Actual Pixels (100%)" InputGestureText="Ctrl+1" Command="{Binding Canvas.ZoomActualPixelsCommand}" />
                        <MenuItem Header="Reset Rotation" InputGestureText="Esc (Rotate View tool)" Command="{Binding Canvas.ResetViewRotationCommand}" />
                        <Separator />
                        <MenuItem Header="Rulers" InputGestureText="Ctrl+R" IsCheckable="True" IsChecked="{Binding Canvas.ShowRulers, Mode=TwoWay}" />
                        <MenuItem Header="Grid" InputGestureText="Ctrl+'" IsCheckable="True" IsChecked="{Binding Canvas.ShowGrid, Mode=TwoWay}" />
                        <MenuItem Header="Guides" InputGestureText="Ctrl+;" IsCheckable="True" IsChecked="{Binding Canvas.ShowGuides, Mode=TwoWay}" />
                        <MenuItem Header="Snap to Guides and Grid" IsCheckable="True" IsChecked="{Binding Canvas.SnapToGuides, Mode=TwoWay}" />
                        <MenuItem Header="New Guide...">
                            <MenuItem Header="Vertical..." Command="{Binding NewGuideCommand}" CommandParameter="Vertical" />
                            <MenuItem Header="Horizontal..." Command="{Binding NewGuideCommand}" CommandParameter="Horizontal" />
                        </MenuItem>
                        <MenuItem Header="Clear Guides" Command="{Binding Canvas.ClearGuidesCommand}" />
                        <MenuItem Header="Grid Size..." Command="{Binding GridSizeCommand}" />
                        <Separator />
                        <MenuItem Header="Tools Panel" IsCheckable="True" IsChecked="{Binding IsLeftPanelVisible, Mode=TwoWay}" />
                        <MenuItem Header="Properties &amp; Layers Panel" IsCheckable="True" IsChecked="{Binding IsRightPanelVisible, Mode=TwoWay}" />
                    </MenuItem>

                    <MenuItem Header="_Help">
                        <MenuItem Header="Keyboard Shortcuts" InputGestureText="F1" Click="ShortcutsMenu_Click" />
                        <MenuItem Header="Edit Keyboard Shortcuts..." Click="EditShortcutsMenu_Click"
                                  ToolTip="Change the key of any menu command; kept for next time" />
                        <Separator />
                        <MenuItem Header="_About JolieCat..." Click="AboutMenu_Click" />
                    </MenuItem>
                </Menu>
            </DockPanel>
        </Border>

        <!-- ================= Left / Center / Right ================= -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Style="{StaticResource LeftPanelColumnStyle}" />
                <ColumnDefinition Style="{StaticResource LeftSplitterColumnStyle}" />
                <ColumnDefinition Width="*" MinWidth="300" /> <!-- Center: Canvas -->
                <ColumnDefinition Style="{StaticResource RightSplitterColumnStyle}" />
                <ColumnDefinition Style="{StaticResource RightPanelColumnStyle}" />
            </Grid.ColumnDefinitions>

            <!-- Left: Tools - each category is an independently collapsible Expander;
                 inside one, a WrapPanel-backed ListBox flows icon tiles into as many
                 columns as the panel's current width allows (drag the splitter wider to
                 see more columns per row), rather than one tool per full-width row. -->
            <Border Grid.Column="0" Style="{StaticResource DockPanelBorderStyle}"
                    Visibility="{Binding IsLeftPanelVisible, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <TextBlock Text="TOOLS" DockPanel.Dock="Top" Style="{StaticResource PanelHeaderStyle}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Toolbox.ToolsByCategory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Header="{Binding DisplayName, Converter={StaticResource Tr}}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                              Style="{StaticResource ToolCategoryExpanderStyle}" Margin="0,0,0,2">
                                        <ListBox ItemsSource="{Binding Tools}"
                                                 Background="Transparent" BorderThickness="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                 ItemContainerStyle="{StaticResource ToolListBoxItemStyle}">
                                            <!-- Only the group holding the active tool shows a selection. -->
                                            <ListBox.SelectedItem>
                                                <MultiBinding Converter="{StaticResource ActiveInGroup}" Mode="TwoWay">
                                                    <Binding RelativeSource="{RelativeSource AncestorType=Window}" Path="DataContext.Toolbox.ActiveTool" Mode="TwoWay" />
                                                    <Binding Path="Tools" Mode="OneWay" />
                                                </MultiBinding>
                                            </ListBox.SelectedItem>
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource ToolTileStyle}" ToolTip="{Binding ToolTip, Converter={StaticResource Tr}}">
                                                        <!-- EvenOdd is the mini-language's default fill rule, which several icons
                                                             (marquees, zoom lens, canvas-rotate ring) rely on to punch a hole. -->
                                                        <Path Data="{Binding IconData}" Stretch="Uniform" Width="16" Height="16"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <!-- The selected tool's tile fills gold (ToolListBoxItemStyle) - the
                                                                 icon's own Fill has to switch to a dark tone there too, or it stays
                                                                 the usual warm-white against a background it was never legible on. -->
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Setter Property="Fill" Value="{StaticResource TextPrimaryBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                            <Setter Property="Fill" Value="{StaticResource OnAccentTextBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Visibility="{Binding IsLeftPanelVisible, Converter={StaticResource BoolToVisibility}}" />

            <!-- Center: document tabs (top), an optional Design/Timeline workspace-mode
                 switch (Clipbar Animation projects only), then either the plain Canvas
                 or the dedicated Timeline workspace. Each tab is its own independent
                 Scene/layer stack/zoom-pan/history/undo-redo/workspace-mode (see
                 DocumentViewModel) - MainViewModel.Layers/Canvas/Timeline all forward
                 to whichever DocumentViewModel is ActiveDocument, so every other
                 binding in this window (including CanvasView below) keeps working
                 unchanged as tabs are added, closed, and switched between. -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Document tab strip -->
                    <RowDefinition Height="Auto" /> <!-- Design/Timeline workspace switch -->
                    <RowDefinition Height="*" /> <!-- Canvas -->
                    <RowDefinition Height="Auto" /> <!-- Splitter (Timeline mode) -->
                    <RowDefinition x:Name="TimelineRow" Height="0" /> <!-- Timeline, under the canvas (sized in code) -->
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource PanelAltBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="+" Width="28" Margin="4,2"
                                ToolTip="New document (Ctrl+N)" Command="{Binding NewDocumentCommand}" />

                        <!-- SelectedItem drives ActiveDocument directly - switching tabs
                             is just changing which DocumentViewModel is selected here,
                             no extra plumbing needed. -->
                        <ListBox ItemsSource="{Binding Documents}" SelectedItem="{Binding ActiveDocument, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource ToolListBoxItemStyle}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="10,6">
                                        <!-- The active tab's own tile fills gold (ToolListBoxItemStyle) -
                                             swaps to a dark tone there, same as the tool tile's icon above. -->
                                        <TextBlock Text="{Binding TabTitle}" FontSize="11" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource OnAccentTextBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button Content="&#x2715;" Width="16" Height="16" Margin="8,0,0,0" Padding="0"
                                                FontSize="9" ToolTip="Close tab (Ctrl+W)"
                                                Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.CloseDocumentCommand}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Only a Clipbar Animation project shows this - every other project
                     type stays exactly the plain canvas view below, uncluttered by a
                     switch it would have no second mode to switch to. -->
                <Border Grid.Row="1" Background="{StaticResource PanelAltBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                        Visibility="{Binding Layers.IsClipbarAnimationProject, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal" Margin="8,4">
                        <ToggleButton Content="Design" Width="70" Margin="0,0,4,0"
                                      Style="{StaticResource PanelToggleButtonStyle}"
                                      IsChecked="{Binding ActiveDocument.IsDesignMode, Mode=OneWay}"
                                      Command="{Binding SetWorkspaceModeCommand}" CommandParameter="{x:Static vm:WorkspaceMode.Design}" />
                        <ToggleButton Content="Timeline" Width="70" ToolTip="Animate: the Timeline under the canvas (Shift+Ctrl+T)"
                                      Style="{StaticResource PanelToggleButtonStyle}"
                                      IsChecked="{Binding ActiveDocument.IsTimelineMode, Mode=OneWay}"
                                      Command="{Binding SetWorkspaceModeCommand}" CommandParameter="{x:Static vm:WorkspaceMode.Timeline}" />
                    </StackPanel>
                </Border>

                <!-- SnapsToDevicePixels explicitly repeated here (on top of the
                     Window's own UseLayoutRounding/SnapsToDevicePixels) so this
                     Border's own background - a different color than the canvas's
                     OutsideDocumentColor - can never show through as a hairline seam
                     at the SKElement's edge from a sub-pixel layout mismatch between
                     the two. Hidden (not just covered) while the Timeline workspace
                     shows instead, so a hidden SKElement isn't still costing repaints. -->
                <!-- The canvas stays visible in Timeline mode too: the animation plays on it. -->
                <Border Grid.Row="2" Style="{StaticResource DockPanelBorderStyle}" SnapsToDevicePixels="True">
                    <views:CanvasView x:Name="CanvasHost" DataContext="{Binding Canvas}" SnapsToDevicePixels="True" />
                </Border>

                <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" ResizeDirection="Rows"
                              Background="{StaticResource BorderBrush}"
                              Visibility="{Binding ActiveDocument.IsTimelineMode, Converter={StaticResource BoolToVisibility}}" />

                <Border Grid.Row="4" Style="{StaticResource DockPanelBorderStyle}"
                        Visibility="{Binding ActiveDocument.IsTimelineMode, Converter={StaticResource BoolToVisibility}}">
                    <timeline:TimelineWorkspaceView DataContext="{Binding Timeline}" />
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch"
                          Visibility="{Binding IsRightPanelVisible, Converter={StaticResource BoolToVisibility}}" />

            <!-- Right: Properties (top, dynamic per active tool) / Layers (bottom) -->
            <Grid Grid.Column="4"
                  Visibility="{Binding IsRightPanelVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="100" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="100" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource DockPanelBorderStyle}">
                    <DockPanel>
                        <!-- PROPERTIES / NAVIGATOR / INFO / HISTOGRAM tabs sharing this panel. -->
                        <WrapPanel DockPanel.Dock="Top">
                            <WrapPanel.Resources>
                                <Style TargetType="RadioButton">
                                    <Setter Property="GroupName" Value="TopPanelTab" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="RadioButton">
                                                <Border x:Name="Tab" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent">
                                                    <ContentPresenter x:Name="Label" Opacity="0.55" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Label" Property="Opacity" Value="1" />
                                                        <Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Label" Property="Opacity" Value="1" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </WrapPanel.Resources>
                            <RadioButton IsChecked="{Binding Panels.ShowProperties}" AutomationProperties.Name="PROPERTIES">
                                <TextBlock Text="PROPERTIES" Style="{StaticResource PanelHeaderStyle}" />
                            </RadioButton>
                            <RadioButton IsChecked="{Binding Panels.ShowNavigator}" AutomationProperties.Name="NAVIGATOR">
                                <TextBlock Text="NAVIGATOR" Style="{StaticResource PanelHeaderStyle}" />
                            </RadioButton>
                            <RadioButton IsChecked="{Binding Panels.ShowInfo}" AutomationProperties.Name="INFO">
                                <TextBlock Text="INFO" Style="{StaticResource PanelHeaderStyle}" />
                            </RadioButton>
                            <RadioButton IsChecked="{Binding Panels.ShowHistogram}" AutomationProperties.Name="HISTOGRAM">
                                <TextBlock Text="HISTOGRAM" Style="{StaticResource PanelHeaderStyle}" />
                            </RadioButton>
                            <RadioButton IsChecked="{Binding Panels.ShowSwatches}" AutomationProperties.Name="SWATCHES">
                                <TextBlock Text="SWATCHES" Style="{StaticResource PanelHeaderStyle}" />
                            </RadioButton>
                            <RadioButton IsChecked="{Binding Panels.ShowChannels}" AutomationProperties.Name="CHANNELS">
                                <TextBlock Text="CHANNELS" Style="{StaticResource PanelHeaderStyle}" />
                            </RadioButton>
                            <RadioButton IsChecked="{Binding Panels.ShowPaths}" AutomationProperties.Name="PATHS">
                                <TextBlock Text="PATHS" Style="{StaticResource PanelHeaderStyle}" />
                            </RadioButton>
                        </WrapPanel>

                        <!-- Which tool the properties below belong to. -->
                        <TextBlock DockPanel.Dock="Top" Text="{Binding Toolbox.ActiveTool.DisplayName, Converter={StaticResource Tr}}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" Margin="10,2,10,0"
                                   Visibility="{Binding Panels.ShowProperties, Converter={StaticResource BoolToVisibility}}" />

                        <!-- Navigator: the whole image; the frame is what the canvas shows. -->
                        <StackPanel DockPanel.Dock="Top" Margin="10,6,10,0"
                                    Visibility="{Binding Panels.ShowNavigator, Converter={StaticResource BoolToVisibility}}">
                            <Grid x:Name="NavigatorSurface" Width="{Binding Panels.ThumbnailWidth}" Height="{Binding Panels.ThumbnailHeight}"
                                  HorizontalAlignment="Center" Background="Transparent" Cursor="Hand"
                                  MouseLeftButtonDown="Navigator_MouseDown" MouseMove="Navigator_MouseMove" MouseLeftButtonUp="Navigator_MouseUp">
                                <Image Source="{Binding Panels.Thumbnail}" Stretch="None" />
                                <Canvas IsHitTestVisible="False">
                                    <Rectangle Canvas.Left="{Binding Panels.ViewBox.X}" Canvas.Top="{Binding Panels.ViewBox.Y}"
                                               Width="{Binding Panels.ViewBox.Width}" Height="{Binding Panels.ViewBox.Height}"
                                               Stroke="#FFE0524A" StrokeThickness="2" />
                                </Canvas>
                            </Grid>
                            <controls:LabeledSlider Label="Zoom" Suffix="%" Minimum="1" Maximum="1600" Margin="0,10,0,0"
                                                    Value="{Binding Panels.ZoomPercent, Mode=TwoWay}" />
                        </StackPanel>

                        <!-- Info: the color under the pointer and document facts. -->
                        <StackPanel DockPanel.Dock="Top" Margin="10,8,10,0"
                                    Visibility="{Binding Panels.ShowInfo, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel Margin="0,0,0,6">
                                <Border DockPanel.Dock="Left" Width="30" Height="30" Margin="0,0,10,0" BorderThickness="1"
                                        BorderBrush="{StaticResource BorderBrush}" Background="{Binding Panels.ColorSwatch}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Panels.ColorText}" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Consolas" />
                                    <TextBlock Text="{Binding Panels.HexText}" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Consolas" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0">
                                <Run Text="Position:" /> <Run Text="{Binding Panels.PositionText, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" />
                            </TextBlock>
                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0">
                                <Run Text="Document:" /> <Run Text="{Binding Panels.DocumentText, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" />
                            </TextBlock>
                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap">
                                <Run Text="Selection:" /> <Run Text="{Binding Panels.SelectionText, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" />
                            </TextBlock>

                            <!-- Color Sampler points (Color Sampler tool, I). -->
                            <DockPanel Margin="0,10,0,2">
                                <Button DockPanel.Dock="Right" Content="Clear" Padding="8,1" FontSize="11" Command="{Binding Panels.ClearSamplersCommand}"
                                        ToolTip="Remove all color samplers" />
                                <TextBlock Text="COLOR SAMPLERS" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                            </DockPanel>
                            <TextBlock Text="Use the Color Sampler tool to place up to 10 points whose colors stay listed here."
                                       FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Panels.Samplers.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding Panels.Samplers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" Width="26" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                                            <Border DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,8,0" BorderThickness="1"
                                                    BorderBrush="{StaticResource BorderBrush}" Background="{Binding Swatch}" />
                                            <TextBlock Text="{Binding Text}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Histogram of the visible image: brightness, plus the R / G / B channels. -->
                        <StackPanel DockPanel.Dock="Top" Margin="10,8,10,0"
                                    Visibility="{Binding Panels.ShowHistogram, Converter={StaticResource BoolToVisibility}}">
                            <Border Background="#FF151313" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Height="130">
                                <Viewbox Stretch="Fill" Margin="2">
                                    <Canvas Width="256" Height="100">
                                        <Polygon Points="{Binding Panels.RedPoints}" Fill="#55FF4040" />
                                        <Polygon Points="{Binding Panels.GreenPoints}" Fill="#5540FF40" />
                                        <Polygon Points="{Binding Panels.BluePoints}" Fill="#554080FF" />
                                        <Polyline Points="{Binding Panels.LumaPoints}" Stroke="#FFE8E2D8" StrokeThickness="0.8" />
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <TextBlock Text="{Binding Panels.StatsText}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>

                        <!-- Swatches: click = foreground, Ctrl+click = background, right-click = remove. -->
                        <DockPanel DockPanel.Dock="Top" Margin="10,8,10,0"
                                   Visibility="{Binding Panels.ShowSwatches, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                <Button Content="+ Add Foreground" Padding="6,2" Command="{Binding Panels.AddSwatchCommand}"
                                        ToolTip="Adds the foreground color as a swatch" />
                                <Button Content="Reset" Padding="6,2" Margin="6,0,0,0" Command="{Binding Panels.ResetSwatchesCommand}"
                                        ToolTip="Back to the starter colors" />
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Bottom" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="Click: foreground color. Ctrl+click: background color. Right-click: remove." />
                            <ItemsControl ItemsSource="{Binding Panels.Swatches}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="22" Height="22" Margin="0,0,3,3" Background="{Binding Brush}" Cursor="Hand"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                ToolTip="{Binding Hex}" AutomationProperties.Name="{Binding Hex}">
                                            <Border.InputBindings>
                                                <MouseBinding Gesture="LeftClick" CommandParameter="{Binding}"
                                                              Command="{Binding DataContext.Panels.PickSwatchCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                <MouseBinding Gesture="Ctrl+LeftClick" CommandParameter="{Binding}"
                                                              Command="{Binding DataContext.Panels.PickBackgroundSwatchCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                <MouseBinding Gesture="RightClick" CommandParameter="{Binding}"
                                                              Command="{Binding DataContext.Panels.RemoveSwatchCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            </Border.InputBindings>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>

                        <!-- Channels: view one color channel alone; saved selections load on click. -->
                        <DockPanel DockPanel.Dock="Top" Margin="10,8,10,0"
                                   Visibility="{Binding Panels.ShowChannels, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock DockPanel.Dock="Bottom" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="Click a color channel to see it alone (gray); RGB shows all again. Saved selections (Select &gt; Save Selection) are listed below: click one to load it." />
                            <ItemsControl ItemsSource="{Binding Panels.Channels}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Row" Padding="4,3" Margin="0,0,0,2" Cursor="Hand" Background="Transparent"
                                                AutomationProperties.Name="{Binding Name}">
                                            <Border.InputBindings>
                                                <MouseBinding Gesture="LeftClick" CommandParameter="{Binding}"
                                                              Command="{Binding DataContext.Panels.ChooseChannelCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            </Border.InputBindings>
                                            <DockPanel>
                                                <Image DockPanel.Dock="Left" Source="{Binding Thumbnail}" Width="40" Height="40" Margin="0,0,8,0" />
                                                <Button DockPanel.Dock="Right" Content="✕" Padding="4,0" ToolTip="Delete this saved selection"
                                                        Command="{Binding DataContext.Panels.DeleteSavedSelectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" x:Name="Delete" Visibility="Collapsed" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Shortcut}" FontSize="11" VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsViewed}" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Channel}" Value="-1">
                                                <Setter TargetName="Delete" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>

                        <!-- Paths: named Pen paths; click one to make it the working path again. -->
                        <DockPanel DockPanel.Dock="Top" Margin="10,8,10,0"
                                   Visibility="{Binding Panels.ShowPaths, Converter={StaticResource BoolToVisibility}}">
                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <Button Content="Save Current Path" Padding="6,2" Margin="0,0,6,4" Command="{Binding Panels.SaveCurrentPathCommand}"
                                        ToolTip="Keeps the Pen tool's path under a name, with the document" />
                                <Button Content="Make Selection" Padding="6,2" Margin="0,0,6,4" Command="{Binding Canvas.ConvertPenPathToSelectionCommand}" />
                                <Button Content="Fill" Padding="6,2" Margin="0,0,6,4" Command="{Binding Canvas.FillPenPathCommand}" />
                                <Button Content="Stroke" Padding="6,2" Margin="0,0,6,4" Command="{Binding Canvas.StrokePenPathCommand}" />
                            </WrapPanel>
                            <TextBlock DockPanel.Dock="Bottom" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="Draw a path with the Pen tool, then Save Current Path. Click a saved path to bring it back to edit, fill, stroke or select with; ✕ deletes it. Saved with the project." />
                            <ItemsControl ItemsSource="{Binding Panels.Paths}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="4,3" Margin="0,0,0,2" Cursor="Hand" Background="Transparent" AutomationProperties.Name="{Binding Name}">
                                            <Border.InputBindings>
                                                <MouseBinding Gesture="LeftClick" CommandParameter="{Binding}"
                                                              Command="{Binding DataContext.Panels.LoadPathCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            </Border.InputBindings>
                                            <DockPanel>
                                                <Image DockPanel.Dock="Left" Source="{Binding Thumbnail}" Width="40" Height="40" Margin="0,0,8,0" />
                                                <Button DockPanel.Dock="Right" Content="✕" Padding="4,0" ToolTip="Delete this path"
                                                        Command="{Binding DataContext.Panels.DeletePathCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>

                        <!-- Only a SpriteSheet project shows this, above whichever
                             tool's own options follow - the grid is a project-wide
                             setting, not a per-tool one, so it isn't gated by which
                             tool happens to be active. -->
                        <!-- Scrolls, so a long panel (the sprite sheet grid plus the tool's
                             options) never gets cut off when the panel is short. -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                        Visibility="{Binding Layers.IsSpriteSheetProject, Converter={StaticResource BoolToVisibility}}">
                                    <views:SpriteSheetGridPanelView DataContext="{Binding Layers}" />
                                </Border>

                                <ContentControl Content="{Binding Toolbox.CurrentToolOptions}"
                                                Visibility="{Binding Panels.ShowProperties, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center" />

                <Border Grid.Row="2" Style="{StaticResource DockPanelBorderStyle}">
                    <DockPanel>
                        <!-- LAYERS / HISTORY tabs sharing this panel. -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                            <StackPanel.Resources>
                                <Style TargetType="RadioButton">
                                    <Setter Property="GroupName" Value="LayersPanelTab" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="RadioButton">
                                                <Border x:Name="Tab" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent">
                                                    <TextBlock x:Name="Label" Text="{TemplateBinding Content}" Style="{StaticResource PanelHeaderStyle}" Opacity="0.55" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Label" Property="Opacity" Value="1" />
                                                        <Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Label" Property="Opacity" Value="1" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </StackPanel.Resources>
                            <RadioButton x:Name="LayersTabButton" Content="LAYERS" IsChecked="True" />
                            <RadioButton x:Name="HistoryTabButton" Content="HISTORY" />
                            <RadioButton x:Name="ActionsTabButton" Content="ACTIONS" />
                        </StackPanel>

                        <!-- Actions: record a sequence of commands, play it on any document. -->
                        <!-- Docked left but as wide as the panel: the Layers view below is the fill child. -->
                        <DockPanel DataContext="{Binding ActionsPanel}" Margin="0,0,0,6" DockPanel.Dock="Left"
                                   Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=DockPanel}}"
                                   Visibility="{Binding IsChecked, ElementName=ActionsTabButton, Converter={StaticResource BoolToVisibility}}">
                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <Button Content="&#xE710;" ToolTip="New action (starts recording)" Style="{StaticResource IconButtonStyle}" Command="{Binding NewActionCommand}" />
                                <Button ToolTip="Record more steps into the selected action" Style="{StaticResource IconButtonStyle}" Command="{Binding RecordCommand}">
                                    <Ellipse Width="11" Height="11" Fill="#FFE0524A" />
                                </Button>
                                <Button Content="&#xE71A;" ToolTip="Stop recording" Style="{StaticResource IconButtonStyle}" Command="{Binding StopCommand}" />
                                <Button Content="&#xE768;" ToolTip="Play the selected action on this document" Style="{StaticResource IconButtonStyle}" Command="{Binding PlayCommand}" />
                                <Button Content="&#xE74D;" ToolTip="Delete the selected action" Style="{StaticResource IconButtonStyle}" Command="{Binding DeleteActionCommand}" />
                                <TextBlock Text="● REC" Foreground="#FFE0524A" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"
                                           Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibility}}" />
                            </WrapPanel>
                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status, Converter={StaticResource Tr}}" FontSize="11" TextWrapping="Wrap" Margin="2,6,2,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <ListBox DockPanel.Dock="Top" ItemsSource="{Binding Actions}" SelectedItem="{Binding SelectedAction}"
                                     MaxHeight="120" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource ToolListBoxItemStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontSize="11" Padding="6,3">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource OnAccentTextBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <DockPanel DockPanel.Dock="Top" Margin="0,6,0,4">
                                <TextBlock Text="Name" FontSize="11" VerticalAlignment="Center" Margin="2,0,6,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBox Text="{Binding SelectedAction.Name, UpdateSourceTrigger=PropertyChanged}" FontSize="11" LostFocus="ActionName_LostFocus" />
                            </DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,4,0,2">
                                <Button DockPanel.Dock="Right" Content="&#xE74D;" ToolTip="Delete the selected step" Style="{StaticResource IconButtonStyle}" Command="{Binding DeleteStepCommand}" />
                                <TextBlock Text="STEPS" FontSize="11" VerticalAlignment="Center" Margin="2,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                            </DockPanel>
                            <ListBox ItemsSource="{Binding SelectedAction.Steps}" SelectedItem="{Binding SelectedStep}"
                                     Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource ToolListBoxItemStyle}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Title}" FontSize="11" Padding="14,2,4,2" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource OnAccentTextBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <!-- History snapshots: saved states to jump back to (one undo step each). -->
                        <DockPanel DockPanel.Dock="Top" Margin="6,0,6,4"
                                   Visibility="{Binding IsChecked, ElementName=HistoryTabButton, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel DockPanel.Dock="Top">
                                <Button DockPanel.Dock="Right" Content="&#xE722;" Style="{StaticResource IconButtonStyle}"
                                        ToolTip="New snapshot: save the document as it is now" Command="{Binding Layers.NewSnapshotCommand}" />
                                <TextBlock Text="SNAPSHOTS" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Layers.Snapshots}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,1">
                                            <Button DockPanel.Dock="Right" Content="&#xE711;" Style="{StaticResource IconButtonStyle}" ToolTip="Delete this snapshot"
                                                    Command="{Binding DataContext.Layers.DeleteSnapshotCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <!-- The History Brush's source: lit for the snapshot it paints from. -->
                                            <Button DockPanel.Dock="Left" Content="&#xE771;" ToolTip="Paint from this state with the History Brush (Y)"
                                                    AutomationProperties.Name="History Brush source"
                                                    Command="{Binding DataContext.Layers.SetHistoryBrushSourceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                                        <Setter Property="Opacity" Value="0.3" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHistoryBrushSource}" Value="True">
                                                                <Setter Property="Opacity" Value="1" />
                                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Command="{Binding DataContext.Layers.RestoreSnapshotCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" Cursor="Hand" ToolTip="Go back to this state (can be undone)">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Row" Background="Transparent" Padding="8,3" CornerRadius="3">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"
                                                                           VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                                                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" />
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>

                        <!-- Layer comps: saved layer visibility / opacity / blend / style sets. -->
                        <DockPanel DockPanel.Dock="Top" Margin="6,0,6,4"
                                   Visibility="{Binding IsChecked, ElementName=HistoryTabButton, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel DockPanel.Dock="Top">
                                <Button DockPanel.Dock="Right" Content="&#xE710;" Style="{StaticResource IconButtonStyle}"
                                        AutomationProperties.Name="New layer comp"
                                        ToolTip="New layer comp: remember which layers are visible, and their opacity, blend mode and style"
                                        Command="{Binding Layers.NewLayerCompCommand}" />
                                <TextBlock Text="LAYER COMPS" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Layers.LayerComps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,1">
                                            <Button DockPanel.Dock="Right" Content="&#xE711;" Style="{StaticResource IconButtonStyle}" ToolTip="Delete this layer comp"
                                                    Command="{Binding DataContext.Layers.DeleteLayerCompCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Command="{Binding DataContext.Layers.ApplyLayerCompCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" Cursor="Hand" ToolTip="Show the layers this way (can be undone)">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Row" Background="Transparent" Padding="8,3" CornerRadius="3">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE81E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"
                                                                           VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                                                                <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" />
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>

                        <!-- History: the starting state, every undoable step, then undone
                             steps dimmed. Clicking a row goes back (or forward) to it. -->
                        <ListBox DockPanel.Dock="Top" ItemsSource="{Binding HistorySteps}"
                                 Visibility="{Binding IsChecked, ElementName=HistoryTabButton, Converter={StaticResource BoolToVisibility}}"
                                 Background="Transparent" BorderThickness="0" Focusable="False"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.JumpToHistoryStepCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Row" Background="Transparent" Padding="10,4" CornerRadius="3" Margin="4,1">
                                                    <TextBlock x:Name="Text" Text="{Binding Name}" FontSize="11"
                                                               Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsUndone}" Value="True">
                                                        <Setter TargetName="Text" Property="Opacity" Value="0.45" />
                                                        <Setter TargetName="Text" Property="FontStyle" Value="Italic" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentBrush}" />
                                                        <Setter TargetName="Text" Property="Foreground" Value="{StaticResource OnAccentTextBrush}" />
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <DockPanel Visibility="{Binding IsChecked, ElementName=LayersTabButton, Converter={StaticResource BoolToVisibility}}">

                        <!-- Icon buttons in a WrapPanel: the old text row ("Merge",
                             "Mask+", "Mask−", "Edit") overflowed a 300px panel. -->
                        <WrapPanel DockPanel.Dock="Top" Margin="6,0,6,6">
                            <Button Content="&#xE710;" ToolTip="New layer (Ctrl+Shift+N)" Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding Layers.AddLayerCommand}" />
                            <Button Content="&#xE8C8;" ToolTip="Duplicate layer (Ctrl+J)" Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding Layers.DuplicateLayerCommand}" />
                            <Button Content="&#xE8F4;" ToolTip="New group (Ctrl+G groups the active layer)" Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding Layers.NewGroupCommand}" />
                            <Button Content="&#xE790;" ToolTip="New adjustment layer" Style="{StaticResource IconButtonStyle}"
                                    Click="AdjustmentMenuButton_Click">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Brightness / Contrast..." Command="{Binding NewAdjustmentLayerCommand}"
                                                  CommandParameter="{x:Static adj:AdjustmentKind.BrightnessContrast}" />
                                        <MenuItem Header="Levels..." Command="{Binding NewAdjustmentLayerCommand}"
                                                  CommandParameter="{x:Static adj:AdjustmentKind.Levels}" />
                                        <MenuItem Header="Curves..." Command="{Binding NewAdjustmentLayerCommand}"
                                                  CommandParameter="{x:Static adj:AdjustmentKind.Curves}" />
                                        <MenuItem Header="Hue / Saturation..." Command="{Binding NewAdjustmentLayerCommand}"
                                                  CommandParameter="{x:Static adj:AdjustmentKind.HueSaturation}" />
                                        <Separator />
                                        <MenuItem Header="Invert" Command="{Binding NewAdjustmentLayerCommand}"
                                                  CommandParameter="{x:Static adj:AdjustmentKind.Invert}" />
                                        <MenuItem Header="Posterize..." Command="{Binding NewAdjustmentLayerCommand}"
                                                  CommandParameter="{x:Static adj:AdjustmentKind.Posterize}" />
                                        <MenuItem Header="Threshold..." Command="{Binding NewAdjustmentLayerCommand}"
                                                  CommandParameter="{x:Static adj:AdjustmentKind.Threshold}" />
                                        <Separator />
                                        <MenuItem Header="Exposure..." Command="{Binding NewAdjustmentLayerCommand}"
                                                  CommandParameter="{x:Static adj:AdjustmentKind.Exposure}" />
                                        <MenuItem Header="Black &amp; White..." Command="{Binding NewAdjustmentLayerCommand}"
                                                  CommandParameter="{x:Static adj:AdjustmentKind.BlackWhite}" />
                                        <MenuItem Header="Color Balance..." Command="{Binding NewAdjustmentLayerCommand}"
                                                  CommandParameter="{x:Static adj:AdjustmentKind.ColorBalance}" />
                                        <MenuItem Header="Photo Filter..." Command="{Binding NewAdjustmentLayerCommand}"
                                                  CommandParameter="{x:Static adj:AdjustmentKind.PhotoFilter}" />
                                        <MenuItem Header="Gradient Map..." Command="{Binding NewAdjustmentLayerCommand}"
                                                  CommandParameter="{x:Static adj:AdjustmentKind.GradientMap}" />
                                        <MenuItem Header="Channel Mixer..." Command="{Binding NewAdjustmentLayerCommand}"
                                                  CommandParameter="{x:Static adj:AdjustmentKind.ChannelMixer}" />
                                        <MenuItem Header="Selective Color..." Command="{Binding NewAdjustmentLayerCommand}"
                                                  CommandParameter="{x:Static adj:AdjustmentKind.SelectiveColor}" />
                                        <MenuItem Header="Color Lookup..." Command="{Binding NewAdjustmentLayerCommand}"
                                                  CommandParameter="{x:Static adj:AdjustmentKind.ColorLookup}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button Content="fx" FontFamily="Segoe UI" FontStyle="Italic" FontWeight="Bold"
                                    ToolTip="Layer style: shadow, glow, stroke, color overlay" Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding EditLayerStyleCommand}" />
                            <Button Content="&#xE74D;" ToolTip="Delete layer" Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding Layers.DeleteLayerCommand}" />
                            <Border Width="1" Margin="3,4" Background="{StaticResource BorderBrush}" />
                            <Button Content="&#xE70E;" ToolTip="Bring forward (Ctrl+])" Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding Layers.MoveLayerUpCommand}" />
                            <Button Content="&#xE70D;" ToolTip="Send backward (Ctrl+[)" Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding Layers.MoveLayerDownCommand}" />
                            <Button Content="&#xE8EC;" ToolTip="Merge down (Ctrl+E)" Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding Layers.MergeDownCommand}" />
                            <Border Width="1" Margin="3,4" Background="{StaticResource BorderBrush}" />
                            <Button Content="&#xE91B;" ToolTip="Add layer mask" Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding Layers.AddMaskCommand}" />
                            <Button Content="&#xE894;" ToolTip="Delete layer mask" Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding Layers.RemoveMaskCommand}" />
                            <Button Content="&#xE70F;" ToolTip="Edit Smart Object contents in their own tab"
                                    Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding EditSmartObjectContentsCommand}"
                                    CommandParameter="{Binding Layers.ActiveLayer.Model}" />
                        </WrapPanel>

                        <!-- Blend Mode + Opacity apply to whichever layer is currently
                             active, shown once here rather than duplicated into every row
                             below - the same layout Photoshop's own Layers panel uses. -->
                        <StackPanel DockPanel.Dock="Top" Margin="8,0,8,8">
                            <ComboBox ItemsSource="{x:Static layers:BlendModeOption.All}"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding Layers.ActiveLayer.BlendMode, Mode=TwoWay}"
                                      ToolTip="Blend mode" Margin="0,0,0,6" >
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName, Converter={StaticResource Tr}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <controls:LabeledSlider Label="Opacity" Minimum="0" Maximum="100" Suffix="%"
                                                     Value="{Binding Layers.ActiveLayer.OpacityPercent, Mode=TwoWay}" />
                            <controls:LabeledSlider Label="Fill" Minimum="0" Maximum="100" Suffix="%"
                                                     Value="{Binding Layers.ActiveLayer.FillPercent, Mode=TwoWay}"
                                                     ToolTip="Like Opacity, but only for the layer's own pixels: drop shadow, glow and stroke stay full strength (0% leaves just the effects)" />
                        </StackPanel>

                        <!-- Layers.Items is already front-to-back (topmost/foreground layer
                             first), matching how this list reads top-to-bottom. -->
                        <!-- Ctrl/Shift+click selects several layers; rows can be dragged to
                             reorder them or drop them into a group (MainWindow.LayersPanel.cs). -->
                        <ListBox x:Name="LayersList" ItemsSource="{Binding Layers.Items}" SelectionMode="Extended"
                                 Background="Transparent" BorderThickness="0" AllowDrop="True"
                                 SelectionChanged="LayersList_SelectionChanged"
                                 PreviewMouseLeftButtonDown="LayersList_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="LayersList_PreviewMouseMove"
                                 PreviewMouseLeftButtonUp="LayersList_PreviewMouseLeftButtonUp"
                                 DragOver="LayersList_DragOver" DragLeave="LayersList_DragLeave" Drop="LayersList_Drop"
                                 ItemContainerStyle="{StaticResource ToolListBoxItemStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                    <StackPanel Orientation="Horizontal" Margin="6,4">
                                        <!-- Indent: one step per enclosing group. -->
                                        <Border Margin="{Binding Indent}" />
                                        <!-- Clipped layer: a small down-right arrow pointing at its base. -->
                                        <Path Data="M1,0 L1,7 L7,7 M5,5 L7,7 L5,9" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.4"
                                              Width="10" Height="10" Margin="0,0,4,0" VerticalAlignment="Center"
                                              ToolTip="Clipped to the layer below (Ctrl+Alt+G releases)"
                                              Visibility="{Binding IsClipped, Converter={StaticResource BoolToVisibility}}" />
                                        <ToggleButton Content="&#xE7B3;" Style="{StaticResource GlyphToggleStyle}"
                                                      IsChecked="{Binding IsVisible, Mode=TwoWay}" ToolTip="Show / hide layer"
                                                      VerticalAlignment="Center" Margin="0,0,2,0" />
                                        <ToggleButton Content="&#xE72E;" Style="{StaticResource GlyphToggleStyle}"
                                                      IsChecked="{Binding IsLocked, Mode=TwoWay}" ToolTip="Lock layer"
                                                      VerticalAlignment="Center" Margin="0,0,6,0" />

                                        <!-- Group: an expand/collapse arrow and a folder instead of a thumbnail. -->
                                        <ToggleButton Width="16" Height="30" Margin="0,0,2,0" VerticalAlignment="Center"
                                                      IsChecked="{Binding IsExpanded, Mode=TwoWay}" ToolTip="Show / hide the group's layers"
                                                      Visibility="{Binding IsGroup, Converter={StaticResource BoolToVisibility}}">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="Transparent">
                                                        <TextBlock x:Name="Arrow" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource OnAccentTextBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="Arrow" Property="Text" Value="&#xE70D;" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                        <Border Width="30" Height="30" Margin="0,0,8,0" VerticalAlignment="Center"
                                                Visibility="{Binding IsGroup, Converter={StaticResource BoolToVisibility}}">
                                            <Path Data="M1,3 L8,3 L10,5.5 L21,5.5 L21,18 L1,18 Z" Stretch="Uniform" Width="20" Height="16"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource OnAccentTextBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Border>

                                        <!-- Layer thumbnail on a small checkerboard, so transparent
                                             areas read as transparent rather than black. -->
                                        <Border Width="30" Height="30" Margin="0,0,8,0" BorderThickness="1"
                                                Visibility="{Binding IsNotGroup, Converter={StaticResource BoolToVisibility}}"
                                                BorderBrush="{StaticResource BorderBrush}" VerticalAlignment="Center">
                                            <Border.Background>
                                                <DrawingBrush TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute">
                                                    <DrawingBrush.Drawing>
                                                        <DrawingGroup>
                                                            <GeometryDrawing Brush="#FF3A3A3D" Geometry="M0,0 H2 V2 H0 Z" />
                                                            <GeometryDrawing Brush="#FF2A2A2C" Geometry="M0,0 H1 V1 H0 Z M1,1 H2 V2 H1 Z" />
                                                        </DrawingGroup>
                                                    </DrawingBrush.Drawing>
                                                </DrawingBrush>
                                            </Border.Background>
                                            <Grid>
                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                                       PreviewMouseLeftButtonDown="LayerThumbnail_PreviewMouseLeftButtonDown"
                                                       ToolTip="Ctrl+click: select this layer's pixels (Shift adds, Alt subtracts)" />
                                                <!-- Text layers: a "T" badge; double-click edits the text. -->
                                                <Border Background="{StaticResource PanelBackgroundBrush}" Cursor="Hand"
                                                        Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}"
                                                        ToolTip="Text layer - double-click to edit the text"
                                                        MouseLeftButtonDown="TextThumbnail_MouseLeftButtonDown">
                                                    <TextBlock Text="T" FontFamily="Georgia" FontWeight="Bold" FontSize="17"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                                </Border>
                                                <!-- Fill layers: a small paint-bucket badge; double-click the thumbnail to edit. -->
                                                <Border Background="{StaticResource PanelBackgroundBrush}" Width="14" Height="14"
                                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" CornerRadius="2"
                                                        Visibility="{Binding IsFill, Converter={StaticResource BoolToVisibility}}"
                                                        ToolTip="Fill layer - double-click the thumbnail to change it">
                                                    <Path Data="M2,4 L6,0 L11,5 L7,9 Z M11,7 Q12.5,9.5 11,10.5 Q9.5,9.5 11,7 Z" Fill="{StaticResource AccentBrush}"
                                                          Width="11" Height="11" Stretch="Uniform" />
                                                </Border>
                                                <!-- Smart Object layers: a small page badge in the corner. -->
                                                <Border Background="{StaticResource PanelBackgroundBrush}" Width="14" Height="14"
                                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" CornerRadius="2"
                                                        Visibility="{Binding IsSmartObject, Converter={StaticResource BoolToVisibility}}"
                                                        ToolTip="Smart Object - double-click to edit its contents; scaling keeps full quality">
                                                    <Path Data="M1,0 H7 L10,3 V11 H1 Z M3,5 H8 V6 H3 Z M3,7.5 H8 V8.5 H3 Z" Fill="{StaticResource AccentBrush}"
                                                          Width="10" Height="11" Stretch="Uniform" />
                                                </Border>
                                                <!-- Shape layers: a small shape badge in the corner. -->
                                                <Border Background="{StaticResource PanelBackgroundBrush}" Width="14" Height="14"
                                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" CornerRadius="2"
                                                        Visibility="{Binding IsShape, Converter={StaticResource BoolToVisibility}}"
                                                        ToolTip="Shape layer - select it with the Shape tool to change it">
                                                    <Path Data="M1,1 H6 V6 H1Z M9.5,7 A3,3 0 1 1 9.49,7Z" Fill="{StaticResource AccentBrush}"
                                                          Width="11" Height="11" Stretch="Uniform" />
                                                </Border>
                                                <!-- Adjustment layers have no pixels of their own: show
                                                     an icon instead; double-click opens the settings. -->
                                                <Border Background="{StaticResource PanelBackgroundBrush}"
                                                        Visibility="{Binding IsAdjustment, Converter={StaticResource BoolToVisibility}}"
                                                        ToolTip="{Binding AdjustmentToolTip}" MouseLeftButtonDown="AdjustmentThumbnail_MouseLeftButtonDown">
                                                    <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Plain label normally; double-clicking it swaps in the
                                             textbox below for an inline rename (see MainWindow's
                                             code-behind for the edit/commit/cancel handlers). -->
                                        <!-- The active layer's own row fills gold (ToolListBoxItemStyle) -
                                             swaps to a dark tone there, same as the tool tile/document tab above. -->
                                        <TextBlock Text="{Binding Name}" FontSize="11" VerticalAlignment="Center"
                                                   Visibility="{Binding IsNotEditingName, Converter={StaticResource BoolToVisibility}}"
                                                   MouseLeftButtonDown="LayerName_MouseLeftButtonDown">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource OnAccentTextBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox Text="{Binding Name, Mode=TwoWay}" FontSize="11" Width="120"
                                                 Visibility="{Binding IsEditingName, Converter={StaticResource BoolToVisibility}}"
                                                 Loaded="LayerNameEditBox_Loaded"
                                                 KeyDown="LayerNameEditBox_KeyDown"
                                                 LostFocus="LayerNameEditBox_LostFocus" />

                                        <!-- "SF": the layer has Smart Filters. Double-click opens them. -->
                                        <TextBlock Text="SF" FontWeight="Bold" FontSize="10" Margin="6,0,0,0"
                                                   VerticalAlignment="Center" Cursor="Hand" ToolTip="Smart Filters (double-click to edit)"
                                                   Visibility="{Binding HasSmartFilters, Converter={StaticResource BoolToVisibility}}"
                                                   MouseLeftButtonDown="SmartFilterBadge_MouseLeftButtonDown">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource OnAccentTextBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- "fx": the layer has a layer style. Double-click edits it. -->
                                        <TextBlock Text="fx" FontStyle="Italic" FontWeight="Bold" FontSize="11" Margin="6,0,0,0"
                                                   VerticalAlignment="Center" Cursor="Hand" ToolTip="Layer style (double-click to edit)"
                                                   Visibility="{Binding HasStyle, Converter={StaticResource BoolToVisibility}}"
                                                   MouseLeftButtonDown="LayerStyleBadge_MouseLeftButtonDown">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource OnAccentTextBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Mask thumbnail - only shown once this layer
                                             actually has a mask (see LayerViewModel.HasMask).
                                             A checked/highlighted border means this mask,
                                             not the layer's own color content, is what
                                             painting tools currently draw onto (IsMaskActive) -
                                             clicking it toggles that, the same gesture every
                                             other raster editor uses to select a layer's mask
                                             as the active paint target. -->
                                        <ToggleButton Width="22" Height="22" Margin="8,0,0,0" Padding="0"
                                                      IsChecked="{Binding IsMaskActive, Mode=TwoWay}"
                                                      Visibility="{Binding HasMask, Converter={StaticResource BoolToVisibility}}"
                                                      ToolTip="Click to paint this layer's mask instead of its content">
                                            <ToggleButton.Style>
                                                <Style TargetType="ToggleButton">
                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <!-- This layer's mask is the active paint
                                                                 target - another "active toggle", so it
                                                                 gets the cat-eye green too. -->
                                                            <Setter Property="BorderBrush" Value="{StaticResource ActiveIndicatorBrush}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ToggleButton.Style>
                                            <Image Source="{Binding MaskThumbnail}" Stretch="Uniform" Width="18" Height="18" />
                                        </ToggleButton>

                                        <!-- A disabled/unchecked mask still exists (see
                                             LayerMask.IsEnabled's own remarks) - this lets it
                                             be toggled off to compare against the unmasked
                                             layer without removing it outright. -->
                                        <CheckBox IsChecked="{Binding IsMaskEnabled, Mode=TwoWay}"
                                                  Visibility="{Binding HasMask, Converter={StaticResource BoolToVisibility}}"
                                                  ToolTip="Mask enabled" VerticalAlignment="Center" Margin="4,0,0,0" />
                                    </StackPanel>
                                    <!-- Drop indicator while dragging a layer: a line above or
                                         below the row, or an outline for "into this group". -->
                                    <Border IsHitTestVisible="False" BorderBrush="{StaticResource ActiveIndicatorBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DropAbove}" Value="True">
                                                        <Setter Property="BorderThickness" Value="0,2,0,0" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DropBelow}" Value="True">
                                                        <Setter Property="BorderThickness" Value="0,0,0,2" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DropInto}" Value="True">
                                                        <Setter Property="BorderThickness" Value="2" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        </DockPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ================= Status Bar ================= -->
        <!-- Always present (unlike the docking zones above) rather than collapsing when
             idle - a conventional status bar's own footprint stays stable regardless of
             whether it currently has anything to say. -->
        <Border Grid.Row="3" Background="{StaticResource PanelAltBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Margin="10,3" FontSize="11" Text="{Binding SaveStatusMessage}"
                       Foreground="{StaticResource TextSecondaryBrush}">
                <TextBlock.Style>
                    <!-- Fades SaveSuccessMessage/ExportSuccessMessage out a couple of
                         seconds after either appears, rather than having it just vanish
                         the instant MainViewModel clears it back to empty. Only those
                         two exact messages fade - "Saving project..."/"Exporting
                         image..." (and anything else) stay fully opaque the whole time
                         they're showing. -->
                    <Style TargetType="TextBlock">
                        <Setter Property="Opacity" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SaveStatusMessage}" Value="{x:Static vm:MainViewModel.SaveSuccessMessage}">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="1" To="0" BeginTime="0:0:1.5" Duration="0:0:1" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SaveStatusMessage}" Value="{x:Static vm:MainViewModel.ExportSuccessMessage}">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="1" To="0" BeginTime="0:0:1.5" Duration="0:0:1" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Right side: cursor position · document size and active layer · zoom. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,3">
                <TextBlock Text="{Binding Canvas.ToolHintText, Converter={StaticResource Tr}}" FontSize="11" Margin="0,0,16,0"
                           Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="{Binding Canvas.CursorPositionText}" FontSize="11" FontFamily="Consolas"
                           MinWidth="110" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding DimensionDebugText}" FontSize="11" Margin="8,0"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <Border Width="1" Margin="4,1" Background="{StaticResource BorderBrush}" />
                <TextBlock Text="{Binding Canvas.ZoomText}" FontSize="11" MinWidth="44" TextAlignment="Right"
                           Foreground="{StaticResource TextPrimaryBrush}" ToolTip="Zoom - Ctrl+0 fit, Ctrl+1 100%" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- ================= Saving Overlay ================= -->
        <!-- Spans every row below the title bar, including the toolbar - so
             Save/Open/Import/Undo/Redo are all blocked too, not just the panels -
             blocking further edits for exactly the span MainViewModel.IsSaving is true
             (the save's own write duration, via SaveProjectAsync), which is
             deliberately shorter than how long the status bar's success message stays
             up afterward (see MainViewModel's remarks). Deliberately starts at row 1,
             not row 0: the custom title bar's minimize/restore/close buttons stay
             clickable throughout a save, same as a native title bar's always would. -->
        <Border Grid.Row="1" Grid.RowSpan="3" Background="#B0000000"
                Visibility="{Binding IsSaving, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path Width="36" Height="36" Stretch="Uniform" HorizontalAlignment="Center"
                      Stroke="{StaticResource ActiveIndicatorBrush}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Path.Data>
                        <PathGeometry>
                            <PathFigure StartPoint="18,2" IsClosed="False">
                                <ArcSegment Point="34,18" Size="16,16" SweepDirection="Clockwise" IsLargeArc="True" />
                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>
                    <Path.RenderTransform>
                        <RotateTransform CenterX="18" CenterY="18" />
                    </Path.RenderTransform>
                    <Path.Triggers>
                        <EventTrigger RoutedEvent="Path.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)"
                                                     From="0" To="360" Duration="0:0:0.9" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Path.Triggers>
                </Path>
                <TextBlock Text="{Binding SaveStatusMessage}" Margin="0,12,0,0" HorizontalAlignment="Center"
                           FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
