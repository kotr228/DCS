<Window x:Class="JolieCat.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JolieCat.UI"
        xmlns:vm="clr-namespace:JolieCat.UI.ViewModels"
        xmlns:adj="clr-namespace:JolieCat.Core.Adjustments;assembly=JolieCat.Core"
        xmlns:views="clr-namespace:JolieCat.UI.Views"
        xmlns:timeline="clr-namespace:JolieCat.UI.Views.Timeline"
        xmlns:controls="clr-namespace:JolieCat.UI.Controls"
        xmlns:layers="clr-namespace:JolieCat.UI.ViewModels.Layers"
        mc:Ignorable="d"
        Title="JolieCat" Height="720" Width="1280" MinHeight="480" MinWidth="720"
        Icon="/Assets/JolieCatLogo.ico"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        WindowStyle="None" ResizeMode="CanResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewKeyUp="Window_PreviewKeyUp" Deactivated="Window_Deactivated"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=True}">

    <!-- Custom chrome, replacing the OS-drawn title bar with our own (below, in the
         Grid's first row). WindowChrome - not a manually-transparent Window - does the
         actual work: with WindowStyle="None" alone, a maximized borderless window would
         overhang the screen edges and cover the taskbar, and every edge would lose its
         resize handles. WindowChrome's attached behavior fixes both for free by still
         participating in the OS's own non-client sizing/maximize logic, just with a
         caption area of zero height (CaptionHeight="0") - our own title bar Border below
         supplies the drag/double-click-to-maximize/min/max/close affordances instead
         (MainWindow.xaml.cs), rather than WindowChrome's normal "mark this region as
         caption" mechanism. GlassFrameThickness/CornerRadius are zeroed so nothing
         Aero-glass or rounded leaks in - flat and square, matching the rest of the
         flat/dark theme. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <!-- Ctrl+Shift+Z: the alternate Redo gesture some editors use instead of/
             alongside Ctrl+Y - both do the same thing here. -->
        <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{Binding RedoCommand}" />
        <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopySelectionCommand}" />
        <KeyBinding Key="V" Modifiers="Control" Command="{Binding PasteCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveProjectCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveProjectAsCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenProjectCommand}" />
        <!-- New/close document tab - natural companions to Ctrl+S/Ctrl+O above now
             that more than one project can be open at once (see DocumentViewModel). -->
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewDocumentCommand}" />
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding CloseDocumentCommand}" />

        <!-- Photoshop-compatible shortcuts for the menu commands. Text boxes handle
             their own Ctrl+A/Delete/etc. first, so typing is never hijacked. -->
        <KeyBinding Key="E" Modifiers="Control+Shift" Command="{Binding ExportImageCommand}" />
        <KeyBinding Key="A" Modifiers="Control" Command="{Binding Canvas.SelectAllCommand}" />
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding Canvas.DeselectCommand}" />
        <KeyBinding Key="I" Modifiers="Control+Shift" Command="{Binding Canvas.InvertSelectionCommand}" />
        <KeyBinding Key="Delete" Command="{Binding Canvas.DeleteSelectedPixelsCommand}" />
        <KeyBinding Key="Back" Modifiers="Alt" Command="{Binding Canvas.FillSelectionCommand}" />
        <KeyBinding Key="F5" Modifiers="Shift" Command="{Binding Canvas.ContentAwareFillCommand}" />
        <KeyBinding Key="X" Modifiers="Control+Shift" Command="{Binding OpenLiquifyCommand}" />
        <KeyBinding Key="W" Modifiers="Control+Alt+Shift" Command="{Binding ExportAsCommand}" />
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding PrintCommand}" />
        <KeyBinding Key="T" Modifiers="Control+Shift" Command="{Binding ToggleTimelineCommand}" />
        <KeyBinding Key="R" Modifiers="Control+Shift" Command="{Binding LensCorrectionCommand}" />
        <KeyBinding Key="A" Modifiers="Control+Shift" Command="{Binding OpenCameraRawCommand}" />
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding Canvas.ToggleRulersCommand}" />
        <KeyBinding Key="X" Modifiers="Control" Command="{Binding CutCommand}" />
        <KeyBinding Key="R" Modifiers="Control+Alt" Command="{Binding SelectAndMaskCommand}" />
        <KeyBinding Key="C" Modifiers="Control+Shift" Command="{Binding CopyMergedCommand}" />
        <KeyBinding Key="V" Modifiers="Control+Shift" Command="{Binding PasteInPlaceCommand}" />
        <KeyBinding Key="F" Modifiers="Control+Shift" Command="{Binding FadeCommand}" />
        <KeyBinding Key="OemQuotes" Modifiers="Control" Command="{Binding Canvas.ToggleGridCommand}" />
        <KeyBinding Key="OemSemicolon" Modifiers="Control" Command="{Binding Canvas.ToggleGuidesCommand}" />
        <KeyBinding Key="Back" Modifiers="Control" Command="{Binding Canvas.FillSelectionWithBackgroundCommand}" />
        <KeyBinding Key="D" Modifiers="Control+Shift" Command="{Binding Canvas.ReselectCommand}" />
        <KeyBinding Key="F6" Modifiers="Shift" Command="{Binding ModifySelectionCommand}"
                    CommandParameter="{x:Static vm:SelectionModifyKind.Feather}" />
        <KeyBinding Key="I" Modifiers="Control+Alt" Command="{Binding ImageSizeCommand}" />
        <KeyBinding Key="L" Modifiers="Control+Alt+Shift" Command="{Binding OpenFilterDialogCommand}"
                    CommandParameter="{x:Static vm:FilterKind.AutoContrast}" />
        <KeyBinding Key="B" Modifiers="Control+Shift" Command="{Binding OpenFilterDialogCommand}"
                    CommandParameter="{x:Static vm:FilterKind.AutoColor}" />
        <KeyBinding Key="D0" Modifiers="Control" Command="{Binding Canvas.ZoomToFitCommand}" />
        <KeyBinding Key="NumPad0" Modifiers="Control" Command="{Binding Canvas.ZoomToFitCommand}" />
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding Canvas.ZoomActualPixelsCommand}" />
        <KeyBinding Key="V" Modifiers="Control+Alt" Command="{Binding VanishingPointCommand}" />
        <KeyBinding Key="K" Modifiers="Control" Command="{Binding EditPreferencesCommand}" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding ViewChannelCommand}" CommandParameter="0" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding ViewChannelCommand}" CommandParameter="1" />
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding ViewChannelCommand}" CommandParameter="2" />
        <KeyBinding Key="D5" Modifiers="Control" Command="{Binding ViewChannelCommand}" CommandParameter="3" />
        <KeyBinding Key="OemPlus" Modifiers="Control" Command="{Binding Canvas.ZoomInCommand}" />
        <KeyBinding Key="Add" Modifiers="Control" Command="{Binding Canvas.ZoomInCommand}" />
        <KeyBinding Key="OemMinus" Modifiers="Control" Command="{Binding Canvas.ZoomOutCommand}" />
        <KeyBinding Key="Subtract" Modifiers="Control" Command="{Binding Canvas.ZoomOutCommand}" />
        <KeyBinding Key="N" Modifiers="Control+Shift" Command="{Binding Layers.AddLayerCommand}" />
        <KeyBinding Key="J" Modifiers="Control" Command="{Binding Layers.DuplicateLayerCommand}" />
        <KeyBinding Key="G" Modifiers="Control" Command="{Binding Layers.GroupLayersCommand}" />
        <KeyBinding Key="G" Modifiers="Control+Shift" Command="{Binding Layers.UngroupCommand}" />
        <KeyBinding Key="G" Modifiers="Control+Alt" Command="{Binding Layers.ToggleClippingMaskCommand}" />
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding Layers.MergeDownCommand}" />
        <KeyBinding Key="OemCloseBrackets" Modifiers="Control" Command="{Binding Layers.MoveLayerUpCommand}" />
        <KeyBinding Key="OemOpenBrackets" Modifiers="Control" Command="{Binding Layers.MoveLayerDownCommand}" />
        <KeyBinding Key="OemCloseBrackets" Modifiers="Control+Shift" Command="{Binding Layers.BringToFrontCommand}" />
        <KeyBinding Key="OemOpenBrackets" Modifiers="Control+Shift" Command="{Binding Layers.SendToBackCommand}" />
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding OpenLevelsDialogCommand}" />
        <KeyBinding Key="M" Modifiers="Control" Command="{Binding OpenCurvesDialogCommand}" />
        <KeyBinding Key="U" Modifiers="Control" Command="{Binding OpenSimpleAdjustmentDialogCommand}"
                    CommandParameter="{x:Static vm:SimpleAdjustmentKind.HueSaturation}" />
        <KeyBinding Key="U" Modifiers="Control+Shift" Command="{Binding OpenFilterDialogCommand}"
                    CommandParameter="{x:Static vm:FilterKind.Desaturate}" />
        <KeyBinding Key="I" Modifiers="Control" Command="{Binding OpenFilterDialogCommand}"
                    CommandParameter="{x:Static vm:FilterKind.Invert}" />
        <KeyBinding Key="C" Modifiers="Control+Alt" Command="{Binding ResizeCanvasCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <!-- ================= Custom Title Bar ================= -->
        <!-- Shared look for the Minimize/Maximize-Restore/Close buttons: no border, a
             plain hover fill, sized to fill the whole 36px-tall title bar so there's no
             dead click zone above/below each icon. -->
        <Style x:Key="WindowControlButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- A lightening overlay, not HoverBackgroundBrush's dark
                                 tint - the title bar itself is now the warm beige
                                 background, where a dark hover fill would read as a
                                 stray dark square rather than a highlight. Semi-
                                 transparent white keeps the dark glyph/text legible in
                                 both states instead of needing one. -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close gets its own hover color (a conventional warm red) rather than the
             neutral hover every other title bar button uses - the one place this chrome
             departs from the brand palette, matching the universal OS convention every
             user already reads as "this one closes the app". -->
        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowControlButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FFE81123" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Column that hosts the Left panel: collapses to zero width when the panel is hidden. -->
        <Style x:Key="LeftPanelColumnStyle" TargetType="ColumnDefinition">
            <Setter Property="Width" Value="260" />
            <Setter Property="MinWidth" Value="180" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLeftPanelVisible}" Value="False">
                    <Setter Property="Width" Value="0" />
                    <Setter Property="MinWidth" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Splitter column next to the Left panel: collapses along with it. -->
        <Style x:Key="LeftSplitterColumnStyle" TargetType="ColumnDefinition">
            <Setter Property="Width" Value="Auto" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLeftPanelVisible}" Value="False">
                    <Setter Property="Width" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Column that hosts the Right panel (Properties/Layers): collapses to zero width when hidden. -->
        <Style x:Key="RightPanelColumnStyle" TargetType="ColumnDefinition">
            <Setter Property="Width" Value="300" />
            <Setter Property="MinWidth" Value="220" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRightPanelVisible}" Value="False">
                    <Setter Property="Width" Value="0" />
                    <Setter Property="MinWidth" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Splitter column next to the Right panel: collapses along with it. -->
        <Style x:Key="RightSplitterColumnStyle" TargetType="ColumnDefinition">
            <Setter Property="Width" Value="Auto" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRightPanelVisible}" Value="False">
                    <Setter Property="Width" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>


        <!-- Shared look for the four docking zone containers - the "card" treatment:
             a dark panel body on a slightly rounded, subtly-bordered card. -->
        <Style x:Key="DockPanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <!-- Flat ListBoxItem style for tool entries: no default chrome, accent highlight
             on the active tool, subtle hover otherwise. Shared by the Tools palette, the
             Document tab strip, and the Layers panel list, so this one style is what
             makes "selected tool", "active document tab", and "selected layer" all read
             the same way. -->
        <Style x:Key="ToolListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1" CornerRadius="4">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <!-- The active/selected tool, tab, or layer - a "selected
                                     highlight"/"active tab border" in the brand spec's own
                                     terms, so it gets the golden Accent fill ringed in the
                                     warm Beige, not the cat-eye green (green is reserved
                                     for toggles/run-success/primary buttons). -->
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource BrandBeigeBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact toolbar button for the Layers panel's add/delete/reorder/merge row. -->
        <Style x:Key="LayerToolButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinWidth" Value="26" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>

        <!-- Wrapping tool tile: an icon-only square, name shown only as a tooltip - this
             (rather than the old full-width icon+label row) is what lets the ListBox's
             WrapPanel actually flow tools into more than one column as the Tools panel
             gets wider, instead of every tile filling the whole row by itself. -->
        <Style x:Key="ToolTileStyle" TargetType="Border">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Background" Value="{StaticResource PanelAltBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <!-- The selected tool's tile is gold (its icon turns dark to match), so the
                     icon never sits dark-on-dark. -->
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Collapsible category section in the Tools panel: a flat chevron+title header
             (no default Expander bubble/arrow chrome, which doesn't match this app's flat
             dark theme) toggling a ContentPresenter below it. -->
        <Style x:Key="ToolCategoryExpanderStyle" TargetType="Expander">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Top" Cursor="Hand" Focusable="False"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="Transparent" Padding="8,4,8,2">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock x:Name="Chevron" Text="&#x25BE;" Width="12" FontSize="9"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       VerticalAlignment="Center" />
                                                            <ContentPresenter ContentSource="Content" Margin="4,0,0,0"
                                                                               TextBlock.FontSize="10" TextBlock.FontWeight="SemiBold"
                                                                               TextBlock.Foreground="{StaticResource TextSecondaryBrush}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="False">
                                                            <Setter TargetName="Chevron" Property="Text" Value="&#x25B8;" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Content" Value="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" />
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <ContentPresenter x:Name="Body" Visibility="Collapsed" />
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" /> <!-- Custom title bar -->
            <RowDefinition Height="Auto" /> <!-- Top toolbar -->
            <RowDefinition Height="*" MinHeight="150" /> <!-- Left / Center / Right -->
            <RowDefinition Height="Auto" /> <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ================= Custom Title Bar ================= -->
        <!-- The whole Border drags the window (TitleBar_MouseLeftButtonDown, also
             handling double-click-to-maximize) - the three window-control buttons sit on
             top of it in their own column and simply consume their own clicks (WPF's
             Button already marks IsMouseOver/click events Handled), so they never
             trigger a drag themselves. -->
        <!-- Background is the logo's own warm beige, not a panel-tier dark - the one
             deliberately branded surface in the whole chrome, per the brand spec's own
             "header" callout. Every glyph/text on it below uses OnAccentTextBrush (dark)
             rather than the usual TextPrimaryBrush (warm milky white), which read at
             under 2:1 contrast against this beige - see OnAccentTextBrush's own remarks
             in App.xaml. -->
        <Border Grid.Row="0" Background="{StaticResource BrandBeigeBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="10,0,0,0" IsHitTestVisible="False">
                    <Image Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}"
                           Width="18" Height="18" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource OnAccentTextBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource WindowControlButtonStyle}" ToolTip="Minimize"
                            Click="MinimizeButton_Click">
                        <Rectangle Width="10" Height="1" Fill="{StaticResource OnAccentTextBrush}" />
                    </Button>
                    <Button Style="{StaticResource WindowControlButtonStyle}" ToolTip="Maximize/Restore"
                            Click="MaximizeRestoreButton_Click">
                        <Grid Width="10" Height="10">
                            <Rectangle Stroke="{StaticResource OnAccentTextBrush}" StrokeThickness="1">
                                <Rectangle.Style>
                                    <Style TargetType="Rectangle">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Rectangle.Style>
                            </Rectangle>
                            <Grid>
                                <Grid.Style>
                                    <!-- Hidden by the style (not on the element: a value set there
                                         would beat the trigger, and the glyph would never show). -->
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Rectangle Width="7" Height="7" Stroke="{StaticResource OnAccentTextBrush}" StrokeThickness="1"
                                           HorizontalAlignment="Right" VerticalAlignment="Top" />
                                <!-- This one isn't an outline - it's a solid mask matching
                                     the title bar's own background, painted over the
                                     first square's corner to fake the "two overlapping
                                     squares" restore glyph. Its Fill has to track
                                     whatever's actually behind it (now the beige title
                                     bar, not PanelAltBackgroundBrush), or the mask
                                     itself becomes a visible mismatched square. -->
                                <Rectangle Width="7" Height="7" Fill="{StaticResource BrandBeigeBrush}"
                                           HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                <Rectangle Width="7" Height="7" Stroke="{StaticResource OnAccentTextBrush}" StrokeThickness="1"
                                           HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                            </Grid>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource CloseButtonStyle}" ToolTip="Close"
                            Click="CloseButton_Click">
                        <!-- Close's hover fill is a strong, opaque red (unlike Minimize/
                             Maximize's light overlay above), so its glyph needs its own
                             color per state rather than one fixed color: dark against
                             the idle beige, white against the hovered red - each about
                             as high-contrast as the other gets. -->
                        <Path Data="M0,0 L10,10 M10,0 L0,10" StrokeThickness="1.2">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Stroke" Value="{StaticResource OnAccentTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource TextPrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Top Toolbar ================= -->
        <Border Grid.Row="1" Background="{StaticResource PanelAltBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <!-- A conventional editor menu bar (File / Edit / Image / Layer / Select /
                 Filter / View / Help) instead of the old single row of ~12 buttons that
                 overflowed on narrow windows. Every item shows its shortcut; the most
                 used actions (Undo/Redo, Save, Export) also stay one click away on the
                 right. Filters and adjustments preview live on the canvas and only
                 change the layer once their dialog's Apply is clicked. -->
            <DockPanel Margin="4,3">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- The interface language. -->
                    <ComboBox ItemsSource="{Binding InterfaceLanguages}" SelectedValuePath="Code" DisplayMemberPath="Short"
                              SelectedValue="{Binding InterfaceLanguage, Mode=TwoWay}" Width="62" Height="26" Margin="0,0,8,0"
                              VerticalAlignment="Center" ToolTip="Interface language" AutomationProperties.Name="Interface language" />
                    <Button Style="{StaticResource IconButtonStyle}" Content="&#xE7A7;" ToolTip="Undo (Ctrl+Z)" Command="{Binding UndoCommand}" />
                    <Button Style="{StaticResource IconButtonStyle}" Content="&#xE7A6;" ToolTip="Redo (Ctrl+Y)" Command="{Binding RedoCommand}" />
                    <Border Width="1" Margin="6,3" Background="{StaticResource BorderBrush}" />
                    <Button Content="Save" Margin="2,0" Padding="12,3" ToolTip="Save as .jolie project (Ctrl+S)"
                            Command="{Binding SaveProjectCommand}" />
                    <Button Content="Export" Margin="2,0,4,0" Padding="12,3" ToolTip="Export PNG / JPEG / WebP (Ctrl+Shift+E)"
                            Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ExportImageCommand}" />
                </StackPanel>

                <Menu x:Name="MainMenu" VerticalAlignment="Center">
                    <MenuItem Header="_File">
                        <MenuItem Header="New..." InputGestureText="Ctrl+N" Command="{Binding NewDocumentCommand}" />
                        <MenuItem Header="Open..." InputGestureText="Ctrl+O" Command="{Binding OpenProjectCommand}"
                                  ToolTip="Open a .jolie project, a Photoshop .psd or an image (PNG, JPEG, WebP...)" />
                        <MenuItem Header="Import Sprite Atlas..." Command="{Binding ImportSpriteAtlasCommand}"
