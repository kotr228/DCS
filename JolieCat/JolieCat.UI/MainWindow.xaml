<Window x:Class="JolieCat.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:JolieCat.UI.ViewModels"
        Title="MainWindow" Height="600" Width="800">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Column="0" Grid.Row="0" Background="{StaticResource BgColor}" Visibility="{Binding IsLeftPanelVisible}">
            <TextBlock Text="Tools" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <Border Grid.Column="1" Grid.Row="0" Background="{StaticResource BgColor}">
            <Border Background="{StaticResource PanelColor}">
                <TextBlock Text="SkiaSharp Canvas Here" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Border>
        <Border Grid.Column="2" Grid.Row="0" Background="{StaticResource BgColor}" Visibility="{Binding IsRightPanelVisible}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{StaticResource PanelColor}">
                    <TextBlock Text="Properties" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border Grid.Row="1" Background="{StaticResource PanelColor}">
                    <TextBlock Text="Layers" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
        <Border Grid.Column="3" Grid.Row="0" Background="{StaticResource BgColor}" Visibility="{Binding IsBottomPanelVisible}">
            <TextBlock Text="Timeline" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <GridSplitter Grid.Column="1" Grid.Row="0" Orientation="Vertical" Background="Transparent" Width="5"/>
        <GridSplitter Grid.Column="2" Grid.Row="0" Orientation="Vertical" Background="Transparent" Width="5"/>
        <GridSplitter Grid.Column="0" Grid.Row="1" Orientation="Horizontal" Background="Transparent" Height="5"/>
        <GridSplitter Grid.Column="2" Grid.Row="1" Orientation="Horizontal" Background="Transparent" Height="5"/>
    </Grid>
</Window>