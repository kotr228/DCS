<?xml version="1.0" encoding="utf-8"?>
<!-- The release build: one JolieCat.exe for 64-bit Windows 10/11 that carries .NET with it
     (nothing to install first). Used by build-release.ps1:
     dotnet publish JolieCat.UI -p:PublishProfile=win-x64 -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- SkiaSharp's native libskiasharp.dll goes inside the exe too. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Precompiled code: a faster first start. WPF doesn't support trimming. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <PublishDir>..\artifacts\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
