<Application x:Class="JolieCat.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:JolieCat.UI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/ToolOptionsTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Application-wide so every view can reference it, not just MainWindow -
                 several Properties-panel views (e.g. the color picker's conditional
                 visibility) need it too, and a resource declared only in a Window's own
                 Resources isn't guaranteed reachable by StaticResource from a separately-
                 compiled UserControl's XAML. -->
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <!-- ================= "JolieCat" Theme Palette ================= -->
            <!-- Professional dark workspace (a "BlackCat"-style neutral-charcoal card
                 UI), with the logo's own warm colors reserved strictly for small
                 accents - never a large fill. A previous pass got this backwards
                 (WindowBackgroundBrush itself was the warm beige, so the whole
                 workspace read as one giant tan block) - every structural surface
                 below (window/canvas framing, panel bodies, toolbars, borders, hover)
                 is a neutral dark charcoal now; only the four accent brushes further
                 down are ever the logo's own beige/gold/green.
                 Flat, solid-color brushes only - no gradients, no theme packages. -->

            <!-- Canvas framing / outermost window background - darkest tier, so every
                 panel "card" on top of it reads as visibly raised. -->
            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF1A1716" />

            <!-- A panel's own card body (Layers/Properties/Timeline content) - one
                 step lighter than the window behind it. -->
            <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FF242020" />

            <!-- A panel's toolbar/header strip and the document tab strip - one step
                 lighter again, reading as "raised" above the card body it tops. -->
            <SolidColorBrush x:Key="PanelAltBackgroundBrush" Color="#FF2E2929" />

            <!-- Divider/outline color - lighter than every panel tier above, so a
                 hairline border is actually visible against any of them. -->
            <SolidColorBrush x:Key="BorderBrush" Color="#FF3D3736" />

            <!-- Neutral (non-branded) hover highlight - a touch lighter than
                 BorderBrush, for a plain "something's under the cursor" cue that
                 doesn't compete with the branded accents below. -->
            <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#FF453E3D" />

            <!-- ================= Brand Accents (small elements only) ================= -->
            <!-- Golden Ochre - active tab/selected-item highlights, handle/selection
                 chrome on the canvas, and other small "this one is active" accents. -->
            <SolidColorBrush x:Key="AccentBrush" Color="#FFC29B58" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFD8B87A" />

            <!-- Warm Beige - paired with Golden Ochre on the same accents (a thin
                 border ring around a gold-filled selection highlight) and used alone
                 for small branding touches (the splash screen's own accent ring) -
                 never a fill of its own beyond that. -->
            <SolidColorBrush x:Key="BrandBeigeBrush" Color="#FFE6BA7C" />

            <!-- Emerald Green (the logo's own "cat eyes") - persistent on/active
                 toggle states, run/success/loading indicators, and primary action
                 buttons (see PrimaryButtonStyle below) - distinct from the golden
                 Accent used for selection highlights. -->
            <SolidColorBrush x:Key="ActiveIndicatorBrush" Color="#FF5DA453" />
            <SolidColorBrush x:Key="ActiveIndicatorHoverBrush" Color="#FF74BF69" />
            <SolidColorBrush x:Key="ActiveIndicatorPressedBrush" Color="#FF4A8A44" />

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF9F6F0" />
            <!-- A muted, darkened tint of the Warm Milky White - reads clearly
                 de-emphasized against primary text while staying in the same warm
                 family, against the new darker charcoal panels too. -->
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFC9C2B8" />

            <!-- ================= Base Styles ================= -->

            <Style TargetType="{x:Type Window}">
                <Setter Property="Background" Value="{StaticResource WindowBackgroundBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Style>

            <!-- A docking panel's own section header ("PROPERTIES", "LAYERS", ...).
                 Application-wide (not MainWindow.Resources, where it originally lived)
                 for the same reason as BoolToVisibility above: StaticResource resolves
                 once, at InitializeComponent() time, before a separately-compiled
                 UserControl (e.g. SpriteSheetGridPanelView) is ever attached to any
                 Window's visual tree - a Window-scoped resource isn't reachable yet at
                 that point, so any such UserControl needing this style must find it
                 here instead. -->
            <Style x:Key="PanelHeaderStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="8,6" />
            </Style>

            <Style TargetType="{x:Type GridSplitter}">
                <Setter Property="Background" Value="{StaticResource BorderBrush}" />
                <Setter Property="ShowsPreview" Value="False" />
            </Style>

            <!-- Clean, flat default Button style: solid background, a small corner
                 radius (the "clean card" look, not sharp rectangles), no drop shadows -
                 only a simple hover/pressed color swap. -->
            <Style TargetType="{x:Type Button}">
                <Setter Property="Background" Value="{StaticResource PanelAltBackgroundBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"
                                                  RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The "primary action button" BlackCat's own button styling calls for:
                 a solid Emerald Green fill (not the neutral default above), for the
                 single confirming/primary action in a toolbar or dialog - Save,
                 Export, a dialog's own Apply/Create/Resize button, Slice & Export
                 Frames, Derive Clipbar Animation. Its own green-family hover/pressed
                 shades (not the neutral HoverBackgroundBrush/golden AccentBrush the
                 default Button style swaps to) keep it reading as one consistent
                 green button through every interaction state, matching "primary
                 action buttons" being the green category's own named use case. -->
            <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}">
                <Setter Property="Background" Value="{StaticResource ActiveIndicatorBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ActiveIndicatorBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"
                                                  RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource ActiveIndicatorHoverBrush}" />
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource ActiveIndicatorHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource ActiveIndicatorPressedBrush}" />
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource ActiveIndicatorPressedBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Toggle button used on the top toolbar to show/hide a docking zone;
                 renders with the Active Indicator (cat-eye) green while its panel is
                 visible - this is exactly the "active toggle" the warm palette
                 reserves that color for, distinct from the golden Accent used for
                 selection highlights elsewhere. -->
            <Style x:Key="PanelToggleButtonStyle" TargetType="{x:Type ToggleButton}">
                <Setter Property="Background" Value="{StaticResource PanelAltBackgroundBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                            <Border x:Name="ToggleBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ToggleBorder" Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="ToggleBorder" Property="Background" Value="{StaticResource ActiveIndicatorBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
