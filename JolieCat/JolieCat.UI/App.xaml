<Application x:Class="JolieCat.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:JolieCat.UI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/ToolOptionsTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Application-wide so every view can reference it, not just MainWindow -
                 several Properties-panel views (e.g. the color picker's conditional
                 visibility) need it too, and a resource declared only in a Window's own
                 Resources isn't guaranteed reachable by StaticResource from a separately-
                 compiled UserControl's XAML. -->
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <!-- ================= Warm "JolieCat" Theme Palette ================= -->
            <!-- Flat, solid-color brushes only - no gradients, no theme packages.
                 Derived from the logo's own five brand colors (see JolieCatLogo.ico/.png):
                     Main Background / Canvas Framing - #E6BA7C (Warm Tan / Beige)
                     Panels & Toolbars                - #6B6770 (Muted Warm Gray-Brown) / #3D3A42 (Deep Charcoal)
                     Accents & Highlights              - #C29B58 (Golden Ochre)
                     Active Toggles / Indicators        - #5DA453 (Emerald Green, the logo's own "cat eyes")
                     Text & Off-white elements          - #F9F6F0 (Warm Milky White)
                 A few further brushes below (BorderBrush, AccentHoverBrush,
                 HoverBackgroundBrush, TextSecondaryBrush) aren't named in that five-color
                 list - each is a tint/shade mixed from the same five rather than an
                 unrelated color, so the whole app still reads as one warm, cohesive
                 palette rather than five brand colors plus unrelated old leftovers. -->

            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFE6BA7C" />

            <!-- The two "Panels & Toolbars" colors: the lighter Gray-Brown for a
                 panel's own body (Layers/Properties/Timeline content), the darker
                 Charcoal for its toolbar/header strip and the document tab strip -
                 giving every docked panel the same two-tier depth its dark-theme
                 predecessor had, just in the new warm register. -->
            <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FF6B6770" />
            <SolidColorBrush x:Key="PanelAltBackgroundBrush" Color="#FF3D3A42" />

            <!-- A shade darker than Deep Charcoal - no single hex was specified for
                 borders, so this is mixed from the palette's own darkest color rather
                 than reusing an unrelated gray, keeping every divider/outline in the
                 same warm-neutral family as the panels it separates. -->
            <SolidColorBrush x:Key="BorderBrush" Color="#FF2E2B32" />

            <SolidColorBrush x:Key="AccentBrush" Color="#FFC29B58" />
            <!-- A lighter tint of Golden Ochre for hover - no separate hover hex was
                 specified, so this is Golden Ochre itself lightened, the same
                 relationship the old theme's own Accent/AccentHover pair had. -->
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFD8B87A" />

            <!-- A lighter tint of the Muted Warm Gray-Brown panel color - a neutral
                 hover highlight distinct from both the golden Accent (used for
                 pressed/selected states) and the green Active Indicator below. -->
            <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#FF7D7982" />

            <!-- "Active Toggles / Indicators" - the logo's own cat-eye green. Reserved
                 for a persistent on/active state specifically (a checked toggle button,
                 the selected tool, a layer's mask as the active paint target) - not a
                 general highlight, which stays the golden Accent above. -->
            <SolidColorBrush x:Key="ActiveIndicatorBrush" Color="#FF5DA453" />

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF9F6F0" />
            <!-- A muted, darkened tint of the Warm Milky White - no separate secondary-
                 text hex was specified, so this dims that same color rather than
                 reusing an unrelated gray, keeping secondary text in the same warm
                 family as primary text while still reading as clearly de-emphasized
                 against it. -->
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFC9C2B8" />

            <!-- ================= Base Styles ================= -->

            <Style TargetType="{x:Type Window}">
                <Setter Property="Background" Value="{StaticResource WindowBackgroundBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Style>

            <!-- A docking panel's own section header ("PROPERTIES", "LAYERS", ...).
                 Application-wide (not MainWindow.Resources, where it originally lived)
                 for the same reason as BoolToVisibility above: StaticResource resolves
                 once, at InitializeComponent() time, before a separately-compiled
                 UserControl (e.g. SpriteSheetGridPanelView) is ever attached to any
                 Window's visual tree - a Window-scoped resource isn't reachable yet at
                 that point, so any such UserControl needing this style must find it
                 here instead. -->
            <Style x:Key="PanelHeaderStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="8,6" />
            </Style>

            <Style TargetType="{x:Type GridSplitter}">
                <Setter Property="Background" Value="{StaticResource BorderBrush}" />
                <Setter Property="ShowsPreview" Value="False" />
            </Style>

            <!-- Clean, flat default Button style: solid background, no rounded corners,
                 no drop shadows - only a simple hover/pressed color swap. -->
            <Style TargetType="{x:Type Button}">
                <Setter Property="Background" Value="{StaticResource PanelAltBackgroundBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"
                                                  RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Toggle button used on the top toolbar to show/hide a docking zone;
                 renders with the Active Indicator (cat-eye) green while its panel is
                 visible - this is exactly the "active toggle" the warm palette
                 reserves that color for, distinct from the golden Accent used for a
                 plain momentary press elsewhere. -->
            <Style x:Key="PanelToggleButtonStyle" TargetType="{x:Type ToggleButton}">
                <Setter Property="Background" Value="{StaticResource PanelAltBackgroundBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                            <Border x:Name="ToggleBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ToggleBorder" Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="ToggleBorder" Property="Background" Value="{StaticResource ActiveIndicatorBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
