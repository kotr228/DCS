<Window x:Class="CatSuite.Installer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CatSuite Installer" 
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <!-- Стилі -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1976D2"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#BDBDBD"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#757575"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#616161"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#F44336"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D32F2F"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Конвертер винесено у code-behind -->
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#1976D2" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="CatSuite Package Manager" 
                             FontSize="24" 
                             FontWeight="Bold" 
                             Foreground="White"/>
                    <TextBlock x:Name="SubtitleText" 
                             Text="Виберіть пакети для встановлення або оновлення" 
                             FontSize="12" 
                             Foreground="#E3F2FD" 
                             Margin="0,5,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" 
                        Content="🔄 Оновити список" 
                        Style="{StaticResource SecondaryButton}"
                        Click="RefreshButton_Click"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Список пакетів -->
        <Border Grid.Row="1" 
                Background="White" 
                Margin="20"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="#E0E0E0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PackagesListView" Margin="10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FAFAFA" 
                                    Margin="0,5"
                                    Padding="15"
                                    CornerRadius="6"
                                    BorderThickness="1"
                                    BorderBrush="#E0E0E0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Чекбокс -->
                                    <CheckBox Grid.Row="0" 
                                            Grid.Column="0"
                                            Grid.RowSpan="2"
                                            IsChecked="{Binding IsSelected}"
                                            VerticalAlignment="Center"
                                            Margin="0,0,15,0"/>

                                    <!-- Інформація про пакет -->
                                    <StackPanel Grid.Row="0" Grid.Column="1">
                                        <TextBlock Text="{Binding Info.Name}" 
                                                 FontSize="16" 
                                                 FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Info.Description}" 
                                                 FontSize="12" 
                                                 Foreground="#616161"
                                                 TextWrapping="Wrap"
                                                 Margin="0,5,0,0"/>
                                    </StackPanel>

                                    <!-- Статус -->
                                    <StackPanel Grid.Row="0" 
                                              Grid.Column="2"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Top">
                                        <Border Background="{Binding Status, Converter={StaticResource StatusColorConverter}}"
                                              Padding="10,5"
                                              CornerRadius="4">
                                            <TextBlock Text="{Binding StatusText}" 
                                                     Foreground="White"
                                                     FontSize="11"
                                                     FontWeight="SemiBold"/>
                                        </Border>

                                        <TextBlock Text="{Binding Info.Category}" 
                                                 FontSize="10" 
                                                 Foreground="#9E9E9E"
                                                 HorizontalAlignment="Right"
                                                 Margin="0,5,0,0"/>
                                    </StackPanel>

                                    <!-- Рекомендована дія -->
                                    <StackPanel Grid.Row="1" 
                                              Grid.Column="1" 
                                              Grid.ColumnSpan="2"
                                              Orientation="Horizontal"
                                              Margin="0,10,0,0">
                                        <TextBlock Text="Рекомендована дія: " 
                                                 FontSize="12" 
                                                 Foreground="#757575"/>
                                        <TextBlock Text="{Binding RecommendedAction}" 
                                                 FontSize="12" 
                                                 FontWeight="SemiBold"
                                                 Foreground="#2196F3"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Прогрес -->
        <Border Grid.Row="2" 
                x:Name="ProgressPanel"
                Background="White" 
                Margin="20,0"
                Padding="20,15"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="#E0E0E0"
                Visibility="Collapsed">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <TextBlock x:Name="ProgressText" 
                             Text="Підготовка..." 
                             FontSize="14"
                             FontWeight="SemiBold"/>
                    <TextBlock x:Name="ProgressPercentage" 
                             Text="0%" 
                             HorizontalAlignment="Right"
                             FontSize="14"
                             Foreground="#2196F3"/>
                </Grid>

                <ProgressBar x:Name="MainProgressBar" 
                           Height="8" 
                           Minimum="0" 
                           Maximum="100"
                           Value="0"
                           Background="#E0E0E0"
                           Foreground="#2196F3"/>

                <TextBlock x:Name="DetailProgressText" 
                         Text="" 
                         FontSize="11"
                         Foreground="#757575"
                         Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Кнопки дій -->
        <Border Grid.Row="3" 
                Background="White" 
                Padding="20"
                BorderThickness="0,1,0,0"
                BorderBrush="#E0E0E0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" 
                        Content="📋 Історія"
                        Style="{StaticResource SecondaryButton}"
                        Click="HistoryButton_Click"
                        Margin="0,0,10,0"/>

                <TextBlock Grid.Column="1" 
                         x:Name="SelectionInfoText"
                         Text="Нічого не вибрано" 
                         VerticalAlignment="Center"
                         FontSize="13"
                         Foreground="#757575"
                         Margin="10,0"/>

                <Button Grid.Column="2" 
                        x:Name="CancelButton"
                        Content="Скасувати"
                        Style="{StaticResource SecondaryButton}"
                        Click="CancelButton_Click"
                        Margin="0,0,10,0"
                        Visibility="Collapsed"/>

                <Button Grid.Column="3" 
                        x:Name="InstallButton"
                        Content="▶ Встановити вибране"
                        Style="{StaticResource ModernButton}"
                        Click="InstallButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>