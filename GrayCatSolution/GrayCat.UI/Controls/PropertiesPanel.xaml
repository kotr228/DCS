<UserControl x:Class="GrayCat.UI.Controls.PropertiesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="15" DataContext="{Binding SelectedBlock}">
            <TextBlock Text="Block Properties" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

            <!-- Block Type (Read-only) -->
            <TextBlock Text="Type" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Type}" IsReadOnly="True" 
                     Background="#F5F5F5" Margin="0,0,0,15"/>

            <!-- Content/Text -->
            <TextBlock Text="Content" FontWeight="SemiBold" Margin="0,0,0,5">
                <TextBlock.ToolTip>
                    <ToolTip Content="Main text content of the block"/>
                </TextBlock.ToolTip>
            </TextBlock>
            <TextBox Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}" 
                     TextWrapping="Wrap" 
                     Height="80" 
                     AcceptsReturn="True"
                     Margin="0,0,0,15"/>

            <!-- Font Size -->
            <TextBlock Text="Font Size" FontWeight="SemiBold" Margin="0,0,0,5">
                <TextBlock.ToolTip>
                    <ToolTip Content="Font size in pixels (8-72)"/>
                </TextBlock.ToolTip>
            </TextBlock>
            <Slider Value="{Binding FontSize}" 
                    Minimum="8" Maximum="72" 
                    TickFrequency="2"
                    IsSnapToTickEnabled="True"
                    Margin="0,0,0,5"/>
            <TextBlock Text="{Binding FontSize, StringFormat={}{0} px}" 
                       HorizontalAlignment="Right" 
                       FontSize="11" 
                       Foreground="#666"
                       Margin="0,0,0,15"/>

            <!-- Text Color -->
            <TextBlock Text="Text Color" FontWeight="SemiBold" Margin="0,0,0,5">
                <TextBlock.ToolTip>
                    <ToolTip Content="Font color in HEX format #RRGGBB"/>
                </TextBlock.ToolTip>
            </TextBlock>
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" 
                         Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}" 
                         MaxLength="7"
                         Margin="0,0,10,0"/>
                <Border Grid.Column="1" 
                        Background="{Binding Color}" 
                        BorderBrush="#CCC" 
                        BorderThickness="1"
                        CornerRadius="4"
                        Cursor="Hand"
                        MouseLeftButtonUp="ColorPreview_Click"
                        ToolTip="Click to pick color"/>
            </Grid>

            <!-- Background Color -->
            <TextBlock Text="Background" FontWeight="SemiBold" Margin="0,0,0,5">
                <TextBlock.ToolTip>
                    <ToolTip Content="Background color in HEX format #RRGGBB"/>
                </TextBlock.ToolTip>
            </TextBlock>
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" 
                         Text="{Binding Background, UpdateSourceTrigger=PropertyChanged}" 
                         MaxLength="7"
                         Margin="0,0,10,0"/>
                <Border Grid.Column="1" 
                        Background="{Binding Background}" 
                        BorderBrush="#CCC" 
                        BorderThickness="1"
                        CornerRadius="4"
                        Cursor="Hand"
                        MouseLeftButtonUp="BackgroundPreview_Click"
                        ToolTip="Click to pick color"/>
            </Grid>

            <!-- Text Alignment -->
            <TextBlock Text="Text Alignment" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <ComboBox SelectedValue="{Binding TextAlignment}" 
                      Margin="0,0,0,15">
                <ComboBoxItem Content="Left" Tag="Left"/>
                <ComboBoxItem Content="Center" Tag="Center"/>
                <ComboBoxItem Content="Right" Tag="Right"/>
                <ComboBoxItem Content="Justify" Tag="Justify"/>
            </ComboBox>

            <!-- Position -->
            <TextBlock Text="Position" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="X:" FontSize="11"/>
                    <TextBox Text="{Binding PositionX, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Y:" FontSize="11"/>
                    <TextBox Text="{Binding PositionY, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>

            <!-- Size -->
            <TextBlock Text="Size" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Width:" FontSize="11"/>
                    <TextBox Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Height:" FontSize="11"/>
                    <TextBox Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>

            <!-- Actions -->
            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <Button Content="Reset" Width="80" Margin="0,0,10,0" Click="Reset_Click"/>
                <Button Content="Delete" Width="80" Click="Delete_Click"/>
            </StackPanel>

            <!-- Last Modified -->
            <TextBlock Text="{Binding ModifiedAt, StringFormat='Modified: {0:g}'}" 
                       FontSize="10" 
                       Foreground="#999" 
                       Margin="0,20,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>