<Window x:Class="GrayCat.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GrayCat.UI.ViewModels"
        xmlns:controls="clr-namespace:GrayCat.UI.Controls"
        Title="GrayCat Studio v0.3.2" Height="800" Width="1400"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <DockPanel>
        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New Project..." Click="NewProject_Click" InputGestureText="Ctrl+N"/>
                <MenuItem Header="_Open Project..." Click="OpenProject_Click" InputGestureText="Ctrl+O"/>
                <MenuItem Header="_Save Project" Click="SaveProject_Click" 
                          InputGestureText="Ctrl+S"
                          IsEnabled="{Binding IsProjectOpen}"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit" IsEnabled="{Binding IsProjectOpen}">
                <MenuItem Header="Cu_t" InputGestureText="Ctrl+X"/>
                <MenuItem Header="_Copy" InputGestureText="Ctrl+C"/>
                <MenuItem Header="_Paste" InputGestureText="Ctrl+V"/>
                <MenuItem Header="_Delete" InputGestureText="Del"/>
            </MenuItem>
            <MenuItem Header="_Project" IsEnabled="{Binding IsProjectOpen}">
                <MenuItem Header="_Generate Code" Click="GenerateCode_Click"/>
                <MenuItem Header="_Preview" Click="Preview_Click"/>
                <MenuItem Header="_Export..." Click="Export_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About GrayCat" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- Status Bar -->
        <StatusBar DockPanel.Dock="Bottom" Height="25">
            <StatusBarItem>
                <TextBlock Text="{Binding ProjectName}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding Blocks.Count, StringFormat='Blocks: {0}'}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="v0.3.2 - Properties Editor"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Main Content -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Block Palette -->
            <Border Grid.Column="0" Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="Block Library" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                        <Expander Header="Layout" IsExpanded="True" Margin="0,0,0,10">
                            <StackPanel Margin="5">
                                <Button Content="📄 Header" Tag="Header" 
                                        PreviewMouseLeftButtonDown="Block_PreviewMouseDown"
                                        Margin="0,0,0,5" Padding="10,8"
                                        HorizontalContentAlignment="Left"/>
                                <Button Content="📝 Text" Tag="Text" 
                                        PreviewMouseLeftButtonDown="Block_PreviewMouseDown"
                                        Margin="0,0,0,5" Padding="10,8"
                                        HorizontalContentAlignment="Left"/>
                                <Button Content="🦶 Footer" Tag="Footer" 
                                        PreviewMouseLeftButtonDown="Block_PreviewMouseDown"
                                        Margin="0,0,0,5" Padding="10,8"
                                        HorizontalContentAlignment="Left"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="Media" IsExpanded="True" Margin="0,0,0,10">
                            <StackPanel Margin="5">
                                <Button Content="🖼️ Image" Tag="Image" 
                                        PreviewMouseLeftButtonDown="Block_PreviewMouseDown"
                                        Margin="0,0,0,5" Padding="10,8"
                                        HorizontalContentAlignment="Left"/>
                                <Button Content="🎨 Gallery" Tag="Gallery" 
                                        PreviewMouseLeftButtonDown="Block_PreviewMouseDown"
                                        Margin="0,0,0,5" Padding="10,8"
                                        HorizontalContentAlignment="Left"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="Interactive" IsExpanded="True" Margin="0,0,0,10">
                            <StackPanel Margin="5">
                                <Button Content="📋 Form" Tag="Form" 
                                        PreviewMouseLeftButtonDown="Block_PreviewMouseDown"
                                        Margin="0,0,0,5" Padding="10,8"
                                        HorizontalContentAlignment="Left"/>
                                <Button Content="🛒 Product Grid" Tag="ProductGrid" 
                                        PreviewMouseLeftButtonDown="Block_PreviewMouseDown"
                                        Margin="0,0,0,5" Padding="10,8"
                                        HorizontalContentAlignment="Left"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Center Panel: Canvas -->
            <Grid Grid.Column="1">
                <!-- Welcome Screen -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsProjectOpen, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                    <TextBlock Text="Welcome to GrayCat Studio" FontSize="28" FontWeight="Light" 
                               Foreground="#495057" HorizontalAlignment="Center"/>
                    <TextBlock Text="Create stunning websites with visual blocks" 
                               FontSize="14" Foreground="#6C757D" 
                               HorizontalAlignment="Center" Margin="0,10,0,30"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="New Project" Click="NewProject_Click" 
                                Padding="20,10" Margin="5" FontSize="14"/>
                        <Button Content="Open Project" Click="OpenProject_Click" 
                                Padding="20,10" Margin="5" FontSize="14"/>
                    </StackPanel>
                </StackPanel>

                <!-- Canvas Editor -->
                <Grid Visibility="{Binding IsProjectOpen, Converter={StaticResource BoolToVis}}">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                                  VerticalScrollBarVisibility="Auto">
                        <Border Background="White" MinWidth="1200" MinHeight="800">
                            <ItemsControl ItemsSource="{Binding Blocks}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas x:Name="BlocksCanvas" 
                                                Background="White"
                                                AllowDrop="True" Drop="Canvas_Drop"
                                                MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                                                MouseMove="Canvas_MouseMove"
                                                MouseLeftButtonUp="Canvas_MouseLeftButtonUp"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding PositionX}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding PositionY}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <controls:DraggableBlock>
                                            <controls:DraggableBlock.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Edit Properties" Click="EditBlock_Click"/>
                                                    <MenuItem Header="Duplicate" Click="DuplicateBlock_Click"/>
                                                    <Separator/>
                                                    <MenuItem Header="Delete" Click="DeleteBlock_Click"/>
                                                </ContextMenu>
                                            </controls:DraggableBlock.ContextMenu>
                                        </controls:DraggableBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- Right Panel: Properties -->
            <Border Grid.Column="2" Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="1,0,0,0">
                <controls:PropertiesPanel DataContext="{Binding}"/>
            </Border>
        </Grid>
    </DockPanel>
</Window>