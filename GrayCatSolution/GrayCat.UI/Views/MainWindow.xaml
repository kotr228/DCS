<controls:ThemedWindow x:Class="GrayCat.UI.Views.MainWindow"
        xmlns:l="clr-namespace:GrayCat.UI.Localization"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GrayCat.UI.ViewModels"
        xmlns:controls="clr-namespace:GrayCat.UI.Controls"
        xmlns:conv="clr-namespace:GrayCat.UI.Converters"
        Title="{Binding WindowTitle, RelativeSource={RelativeSource Self}}" Height="850" Width="1600"
        MinWidth="1100" MinHeight="640"
        WindowStartupLocation="CenterScreen">

    <controls:ThemedWindow.DataContext>
        <vm:MainViewModel/>
    </controls:ThemedWindow.DataContext>

    <controls:ThemedWindow.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:ProjectNameConverter x:Key="ProjectName"/>

        <Style x:Key="BlockButtonStyle" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Background" Value="{StaticResource BrushSurface}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushDark}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrushAccentSoft}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </controls:ThemedWindow.Resources>

    <!-- Menu in the title bar, next to the logo and window title -->
    <controls:ThemedWindow.TitleBarContent>
        <!-- Menu Bar -->
        <Menu>
            <MenuItem Header="{l:Tr '_File'}">
                <MenuItem Header="{l:Tr '_New Project...'}" Click="NewProject_Click" InputGestureText="Ctrl+N"/>
                <MenuItem Header="{l:Tr '_Open Project...'}" Click="OpenProject_Click" InputGestureText="Ctrl+O"/>
                <MenuItem Header="{l:Tr '_Save Project'}" Click="SaveProject_Click"
                          InputGestureText="Ctrl+S"
                          IsEnabled="{Binding IsProjectOpen}"/>
                <MenuItem Header="{l:Tr 'Save Project _As...'}" Click="SaveProjectAs_Click"
                          InputGestureText="Ctrl+Shift+S"
                          IsEnabled="{Binding IsProjectOpen}"/>
                <MenuItem Header="{l:Tr 'Open _Code Folder'}" Click="OpenFolder_Click"
                          IsEnabled="{Binding IsProjectOpen}"/>
                <MenuItem Header="{l:Tr 'Export Generated Code as _ZIP...'}" Click="ExportZip_Click"
                          IsEnabled="{Binding IsProjectOpen}"/>
                <MenuItem Header="{l:Tr 'Open _Recent'}" ItemsSource="{Binding RecentProjects}"
                          IsEnabled="{Binding HasRecentProjects}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Setter Property="Header" Value="{Binding}"/>
                            <EventSetter Event="Click" Handler="RecentProject_Click"/>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator/>
                <MenuItem Header="{l:Tr 'E_xit'}" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="{l:Tr '_Edit'}" IsEnabled="{Binding IsProjectOpen}">
                <MenuItem Header="{l:Tr '_Undo'}" InputGestureText="Ctrl+Z" Click="Undo_Click" IsEnabled="{Binding CanUndo}"/>
                <MenuItem Header="{l:Tr '_Redo'}" InputGestureText="Ctrl+Y" Click="Redo_Click" IsEnabled="{Binding CanRedo}"/>
                <Separator/>
                <MenuItem Header="{l:Tr 'Cu_t'}" InputGestureText="Ctrl+X" Click="Cut_Click" IsEnabled="{Binding IsBlockSelected}"/>
                <MenuItem Header="{l:Tr '_Copy'}" InputGestureText="Ctrl+C" Click="Copy_Click" IsEnabled="{Binding IsBlockSelected}"/>
                <MenuItem Header="{l:Tr '_Paste'}" InputGestureText="Ctrl+V" Click="Paste_Click" IsEnabled="{Binding CanPaste}"/>
                <MenuItem Header="{l:Tr '_Duplicate'}" InputGestureText="Ctrl+D" Click="DuplicateSelected_Click" IsEnabled="{Binding IsBlockSelected}"/>
                <MenuItem Header="{l:Tr '_Delete'}" InputGestureText="Del" Click="DeleteSelected_Click" IsEnabled="{Binding IsBlockSelected}"/>
            </MenuItem>
            <MenuItem Header="{l:Tr '_Project'}" IsEnabled="{Binding IsProjectOpen}">
                <MenuItem Header="{l:Tr '_Run App'}" Click="RunApp_Click" InputGestureText="F5"/>
                <MenuItem Header="{l:Tr '_Stop App'}" Click="StopApp_Click" InputGestureText="Shift+F5"
                          IsEnabled="{Binding IsAppRunning}"/>
                <MenuItem Header="{l:Tr 'Show Run _Log'}" Click="RunLog_Click"/>
                <Separator/>
                <MenuItem Header="{l:Tr '_Generate Code'}" Click="GenerateCode_Click" InputGestureText="Ctrl+G"/>
                <MenuItem Header="{l:Tr '_Build for Production'}" Click="BuildProduction_Click"/>
                <MenuItem Header="{l:Tr 'Static _HTML Preview'}" Click="Preview_Click"/>
                <MenuItem Header="{l:Tr '_Export Static Site...'}" Click="Export_Click"/>
                <Separator/>
                <MenuItem Header="{l:Tr '_Arrange Blocks in a Column'}" Click="Arrange_Click"/>
                <MenuItem Header="{l:Tr '_Validate All Blocks'}" Click="ValidateAll_Click"/>
                <Separator/>
                <MenuItem Header="{l:Tr '_Pages...'}" Click="Pages_Click"/>
                <MenuItem Header="{l:Tr 'Project _Settings and Theme...'}" Click="Settings_Click"/>
            </MenuItem>
            <MenuItem Header="{l:Tr '_Help'}">
                <MenuItem Header="{l:Tr '_Documentation'}" Click="Documentation_Click"/>
                <MenuItem Header="{l:Tr 'Open .graycat Files with GrayCat Studio'}" Click="Associate_Click"/>
                <MenuItem Header="{l:Tr '_About GrayCat'}" Click="About_Click"/>
            </MenuItem>
        </Menu>
    </controls:ThemedWindow.TitleBarContent>

    <DockPanel>

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="10,6"
                Visibility="{Binding IsProjectOpen, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="{l:Tr '▶  Run App'}" Click="RunApp_Click" Padding="14,6" Margin="0,0,6,0" Style="{StaticResource RunButton}"
                            ToolTip="{l:Tr 'Install packages if needed, start the project and open it in the browser (F5)'}"/>
                    <Button Content="{l:Tr '■  Stop'}" Click="StopApp_Click" Padding="14,6" Margin="0,0,6,0" Style="{StaticResource DangerButton}"
                            Visibility="{Binding IsAppRunning, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="{l:Tr 'Generate Code'}" Click="GenerateCode_Click" Padding="14,6" Margin="0,0,6,0"
                            ToolTip="{l:Tr 'Write the project files into the project folder (Ctrl+G)'}"/>
                    <Button Content="{l:Tr 'Run Log'}" Click="RunLog_Click" Padding="14,6" Margin="0,0,18,0" Style="{StaticResource QuietButton}"/>
                    <TextBlock Text="{l:Tr 'Page:'}" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource BrushNav}"/>
                    <ComboBox ItemsSource="{Binding Pages}" SelectedItem="{Binding CurrentPage}" DisplayMemberPath="Title"
                              MinWidth="140" Margin="0,0,4,0" VerticalContentAlignment="Center" ToolTip="{l:Tr 'Page being edited'}"/>
                    <Button Content="{l:Tr 'Pages…'}" Click="Pages_Click" Padding="12,6" Margin="0,0,18,0" Style="{StaticResource QuietButton}"
                            ToolTip="{l:Tr 'Add, rename, reorder or delete pages'}"/>
                    <Button Content="{l:Tr 'Undo'}" Click="Undo_Click" Padding="12,6" Margin="0,0,4,0" Style="{StaticResource QuietButton}"
                            IsEnabled="{Binding CanUndo}" ToolTip="{l:Tr 'Ctrl+Z'}"/>
                    <Button Content="{l:Tr 'Redo'}" Click="Redo_Click" Padding="12,6" Style="{StaticResource QuietButton}"
                            IsEnabled="{Binding CanRedo}" ToolTip="{l:Tr 'Ctrl+Y'}"/>
                </StackPanel>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource BrushNav}"
                           Text="{l:TrFormat 'Project type: {0}', Path=ProjectTypeName}"/>
            </DockPanel>
        </Border>

        <!-- Status Bar -->
        <StatusBar DockPanel.Dock="Bottom" Height="28">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📁 " FontSize="12"/>
                    <TextBlock Text="{Binding ProjectName}" FontWeight="SemiBold"/>
                </StackPanel>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🧩 " FontSize="12"/>
                    <TextBlock Text="{l:TrFormat 'Blocks: {0}', Path=Blocks.Count}"/>
                </StackPanel>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding ProjectTypeName}" Foreground="{StaticResource BrushMuted}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <ProgressBar Width="60" Height="10" IsIndeterminate="True" Margin="0,0,8,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding StatusMessage}"/>
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="LanguageBox" SelectionChanged="Language_Changed" MinWidth="120" Margin="0,0,12,0"
                              Style="{StaticResource CompactComboBox}" VerticalAlignment="Center" ToolTip="{l:Tr 'Interface language'}">
                        <ComboBoxItem Tag="uk" Content="Українська"/>
                        <ComboBoxItem Tag="en" Content="English"/>
                    </ComboBox>
                    <TextBlock x:Name="VersionText" FontSize="11" Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- Main Content -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Enhanced Block Palette -->
            <Border Grid.Column="0" Background="{StaticResource BrushSurfaceAlt}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0">
                <ScrollViewer x:Name="PaletteScroll" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <StackPanel Margin="2,2,0,14">
                            <TextBlock Text="{l:Tr 'Block Library'}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrushDark}"/>
                            <TextBlock Text="{l:Tr 'Click to add, drag to place'}" FontSize="11" Foreground="{StaticResource BrushMuted}"/>
                        </StackPanel>

                        <!-- Layout Blocks -->
                        <Expander Header="{l:Tr '📐 Layout'}" IsExpanded="True" Margin="0,0,0,10">
                            <StackPanel Margin="8,5">
                                <Button Content="{l:Tr '🏠 Hero Section'}" Tag="Hero"
                                        Style="{StaticResource BlockButtonStyle}"
                                        PreviewMouseLeftButtonDown="Block_PreviewMouseDown"
                                        PreviewMouseMove="Block_PreviewMouseMove"
                                        Click="Block_Click"/>
                                <Button Content="{l:Tr '📄 Header'}" Tag="Header"
                                        Style="{StaticResource BlockButtonStyle}"
                                        PreviewMouseLeftButtonDown="Block_PreviewMouseDown"
                                        PreviewMouseMove="Block_PreviewMouseMove"
                                        Click="Block_Click"/>
                                <Button Content="{l:Tr '🧭 Navigation Bar'}" Tag="Navbar"
                                        Style="{StaticResource BlockButtonStyle}"
                                        PreviewMouseLeftButtonDown="Block_PreviewMouseDown"
                                        PreviewMouseMove="Block_PreviewMouseMove"
                                        Click="Block_Click"/>
                                <Button Content="{l:Tr '📝 Text Block'}" Tag="Text"
                                        Style="{StaticResource BlockButtonStyle}"
                                        PreviewMouseLeftButtonDown="Block_PreviewMouseDown"
                                        PreviewMouseMove="Block_PreviewMouseMove"
                                        Click="Block_Click"/>
                                <Button Content="{l:Tr '🦶 Footer'}" Tag="Footer"
                                        Style="{StaticResource BlockButtonStyle}"
                                        PreviewMouseLeftButtonDown="Block_PreviewMouseDown"
                                        PreviewMouseMove="Block_PreviewMouseMove"
                                        Click="Block_Click"/>
                                <Button Content="{l:Tr '➖ Divider'}" Tag="Divider"
                                        Style="{StaticResource BlockButtonStyle}"
                                        PreviewMouseLeftButtonDown="Block_PreviewMouseDown"
                                        PreviewMouseMove="Block_PreviewMouseMove"
                                        Click="Block_Click"/>
                            </StackPanel>
                        </Expander>

                        <!-- Content Blocks -->
                        <Expander Header="{l:Tr '📝 Content'}" IsExpanded="True" Margin="0,0,0,10">
                            <StackPanel Margin="8,5">
                                <Button Content="{l:Tr '🃏 Card'}" Tag="Card"
                                        Style="{StaticResource BlockButtonStyle}"
                                        PreviewMouseLeftButtonDown="Block_PreviewMouseDown"
                                        PreviewMouseMove="Block_PreviewMouseMove"
                                        Click="Block_Click"/>
                                <Button Content="{l:Tr '💬 Testimonial'}" Tag="Testimonial"
                                        Style="{StaticResource BlockButtonStyle}"
                                        PreviewMouseLeftButtonDown="Block_PreviewMouseDown"
                                        PreviewMouseMove="Block_PreviewMouseMove"
                                        Click="Block_Click"/>
                                <Button Content="{l:Tr '❓ Accordion/FAQ'}" Tag="Accordion"
                                        Style="{StaticResource BlockButtonStyle}"
                                        PreviewMouseLeftButtonDown="Block_PreviewMouseDown"
                                        PreviewMouseMove="Block_PreviewMouseMove"
                                        Click="Block_Click"/>
                                <Button Content="{l:Tr '📊 Statistics'}" Tag="Stats"
                                        Style="{StaticResource BlockButtonStyle}"
                                        PreviewMouseLeftButtonDown="Block_PreviewMouseDown"
                                        PreviewMouseMove="Block_PreviewMouseMove"
                                        Click="Block_Click"/>
                                <Button Content="{l:Tr '💰 Pricing Card'}" Tag="Pricing"
                                        Style="{StaticResource BlockButtonStyle}"
                                        PreviewMouseLeftButtonDown="Block_PreviewMouseDown"
                                        PreviewMouseMove="Block_PreviewMouseMove"
                                        Click="Block_Click"/>
                            </StackPanel>
                        </Expander>

                        <!-- Media Blocks -->
                        <Expander Header="{l:Tr '🎬 Media'}" IsExpanded="True" Margin="0,0,0,10">
                            <StackPanel Margin="8,5">
                                <Button Content="{l:Tr '🖼️ Image'}" Tag="Image"
                                        Style="{StaticResource BlockButtonStyle}"
                                        PreviewMouseLeftButtonDown="Block_PreviewMouseDown"
                                        PreviewMouseMove="Block_PreviewMouseMove"
                                        Click="Block_Click"/>
                                <Button Content="{l:Tr '🎥 Video Player'}" Tag="Video"
                                        Style="{StaticResource BlockButtonStyle}"
                                        PreviewMouseLeftButtonDown="Block_PreviewMouseDown"
                                        PreviewMouseMove="Block_PreviewMouseMove"
                                        Click="Block_Click"/>
                                <Button Content="{l:Tr '🎨 Gallery'}" Tag="Gallery"
                                        Style="{StaticResource BlockButtonStyle}"
                                        PreviewMouseLeftButtonDown="Block_PreviewMouseDown"
                                        PreviewMouseMove="Block_PreviewMouseMove"
                                        Click="Block_Click"/>
                            </StackPanel>
                        </Expander>

                        <!-- Interactive Blocks -->
                        <Expander Header="{l:Tr '⚡ Interactive'}" IsExpanded="True" Margin="0,0,0,10">
                            <StackPanel Margin="8,5">
                                <Button Content="{l:Tr '🔘 Button'}" Tag="Button"
                                        Style="{StaticResource BlockButtonStyle}"
                                        PreviewMouseLeftButtonDown="Block_PreviewMouseDown"
                                        PreviewMouseMove="Block_PreviewMouseMove"
                                        Click="Block_Click"/>
                                <Button Content="{l:Tr '📋 Contact Form'}" Tag="ContactForm"
                                        Style="{StaticResource BlockButtonStyle}"
                                        PreviewMouseLeftButtonDown="Block_PreviewMouseDown"
                                        PreviewMouseMove="Block_PreviewMouseMove"
                                        Click="Block_Click"/>
                                <Button Content="{l:Tr '📝 Form'}" Tag="Form"
                                        Style="{StaticResource BlockButtonStyle}"
                                        PreviewMouseLeftButtonDown="Block_PreviewMouseDown"
                                        PreviewMouseMove="Block_PreviewMouseMove"
                                        Click="Block_Click"/>
                                <Button Content="{l:Tr '🛒 Product Grid'}" Tag="ProductGrid"
                                        Style="{StaticResource BlockButtonStyle}"
                                        PreviewMouseLeftButtonDown="Block_PreviewMouseDown"
                                        PreviewMouseMove="Block_PreviewMouseMove"
                                        Click="Block_Click"/>
                            </StackPanel>
                        </Expander>

                        <!-- Social Blocks -->
                        <Expander Header="{l:Tr '🌐 Social'}" IsExpanded="True" Margin="0,0,0,10">
                            <StackPanel Margin="8,5">
                                <Button Content="{l:Tr '📱 Social Links'}" Tag="SocialLinks"
                                        Style="{StaticResource BlockButtonStyle}"
                                        PreviewMouseLeftButtonDown="Block_PreviewMouseDown"
                                        PreviewMouseMove="Block_PreviewMouseMove"
                                        Click="Block_Click"/>
                            </StackPanel>
                        </Expander>

                        <!-- Info Box -->
                        <Border Background="{StaticResource BrushAccentSoft}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                CornerRadius="6" Padding="12" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="{l:Tr '💡 Tip'}" FontWeight="Bold" Foreground="{StaticResource BrushAccent}"/>
                                <TextBlock Text="{l:Tr 'Click a block to add it after the selected one, or drag it onto the Layout canvas. Blocks appear on the page from top to bottom.'}"
                                           TextWrapping="Wrap" FontSize="11" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Center Panel: Canvas -->
            <Grid Grid.Column="1">
                <!-- Welcome Screen -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsProjectOpen, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                    <Border Width="132" Height="132" CornerRadius="28" ClipToBounds="True" HorizontalAlignment="Center" Margin="0,0,0,22">
                        <Border.Background>
                            <ImageBrush ImageSource="pack://application:,,,/GrayCat.UI;component/Assets/GrayCatMark.png"
                                        RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.18"/>
                        </Border.Effect>
                    </Border>
                    <TextBlock Text="{l:Tr 'Welcome to GrayCat Studio'}" FontSize="32" FontWeight="Light"
                               Foreground="{StaticResource BrushDark}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{l:Tr 'Build websites and apps from visual blocks'}"
                               FontSize="16" Foreground="{StaticResource BrushMuted}"
                               HorizontalAlignment="Center" Margin="0,10,0,40"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="{l:Tr '📄 New Project'}" Click="NewProject_Click"
                                Padding="25,12" Margin="5" FontSize="14" FontWeight="SemiBold"/>
                        <Button Content="{l:Tr '📂 Open Project'}" Click="OpenProject_Click"
                                Padding="25,12" Margin="5" FontSize="14" Style="{StaticResource QuietButton}"/>
                    </StackPanel>
                    <StackPanel Margin="0,30,0,0" HorizontalAlignment="Center"
                                Visibility="{Binding HasRecentProjects, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{l:Tr 'Recent projects'}" FontWeight="SemiBold" Foreground="{StaticResource BrushNav}" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding RecentProjects}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="RecentProject_Click" Tag="{Binding}" ToolTip="{Binding}"
                                            Style="{StaticResource QuietButton}" Padding="12,8" Margin="0,0,0,6"
                                            Width="460" HorizontalContentAlignment="Left">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Converter={StaticResource ProjectName}}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource BrushDark}"/>
                                            <TextBlock Text="{Binding}" FontSize="11" FontWeight="Normal" Foreground="{StaticResource BrushMuted}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>

                <!-- Editor: live page (Design) and free-form arrangement (Layout) -->
                <DockPanel Visibility="{Binding IsProjectOpen, Converter={StaticResource BoolToVis}}">
                    <Border DockPanel.Dock="Top" Background="{StaticResource BrushSurfaceAlt}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="DesignModeButton" Content="{l:Tr 'Design (live page)'}" GroupName="EditorMode" IsChecked="True"
                                         Margin="0,0,16,0" Checked="EditorMode_Changed" VerticalContentAlignment="Center"/>
                            <RadioButton x:Name="LayoutModeButton" Content="{l:Tr 'Layout (arrange blocks)'}" GroupName="EditorMode"
                                         Checked="EditorMode_Changed" VerticalContentAlignment="Center"/>
                            <TextBlock Text="{l:Tr 'Device:'}" VerticalAlignment="Center" Margin="24,0,6,0" Foreground="{StaticResource BrushNav}"/>
                            <ComboBox x:Name="DeviceBox" SelectedIndex="0" SelectionChanged="Device_Changed" MinWidth="150">
                                <ComboBoxItem Content="{l:Tr 'Desktop (full width)'}"/>
                                <ComboBoxItem Content="{l:Tr 'Tablet (820 px)'}"/>
                                <ComboBoxItem Content="{l:Tr 'Phone (390 px)'}"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>
                    <Grid>
                <controls:LivePreview x:Name="LivePage"/>
                <Grid x:Name="LayoutView" Visibility="Collapsed">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  Background="{StaticResource BrushBackground}">
                        <Border x:Name="CanvasSurface" Background="White" MinWidth="1400" MinHeight="{Binding CanvasHeight}"
                                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                Margin="20">
                            <ItemsControl ItemsSource="{Binding Blocks}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas x:Name="BlocksCanvas"
                                                Background="Transparent"
                                                AllowDrop="True" Drop="Canvas_Drop"
                                                MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                                                MouseMove="Canvas_MouseMove"
                                                MouseLeftButtonUp="Canvas_MouseLeftButtonUp"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding PositionX}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding PositionY}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <controls:DraggableBlock>
                                            <controls:DraggableBlock.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{l:Tr '✏️ Edit Properties'}" Click="EditBlock_Click"/>
                                                    <MenuItem Header="{l:Tr '✓ Validate'}" Click="ValidateBlock_Click"/>
                                                    <MenuItem Header="{l:Tr '📋 Duplicate'}" Click="DuplicateBlock_Click"/>
                                                    <Separator/>
                                                    <MenuItem Header="{l:Tr '🗑️ Delete'}" Click="DeleteBlock_Click"/>
                                                </ContextMenu>
                                            </controls:DraggableBlock.ContextMenu>
                                        </controls:DraggableBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </ScrollViewer>

                    <!-- Grid Overlay Toggle -->
                    <CheckBox Content="{l:Tr 'Show grid (snap to 20px)'}"
                              IsChecked="False"
                              VerticalAlignment="Top"
                              HorizontalAlignment="Right"
                              Margin="30"
                              Checked="GridOverlay_Changed"
                              Unchecked="GridOverlay_Changed"/>
                </Grid>
                    </Grid>
                </DockPanel>
            </Grid>

            <!-- Right Panel: Dynamic Properties -->
            <Border Grid.Column="2" Background="{StaticResource BrushSurfaceAlt}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1,0,0,0">
                <controls:DynamicPropertiesPanel DataContext="{Binding}"/>
            </Border>
        </Grid>
    </DockPanel>
</controls:ThemedWindow>
