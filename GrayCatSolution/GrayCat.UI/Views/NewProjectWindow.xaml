<controls:ThemedWindow xmlns:l="clr-namespace:GrayCat.UI.Localization"
        x:Class="GrayCat.UI.Views.NewProjectWindow"
        xmlns:controls="clr-namespace:GrayCat.UI.Controls"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GrayCat.UI.ViewModels"
        xmlns:conv="clr-namespace:GrayCat.UI.Converters"
        Title="{l:Tr 'Create New Project'}" Width="580" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <controls:ThemedWindow.DataContext>
        <vm:NewProjectViewModel/>
    </controls:ThemedWindow.DataContext>

    <controls:ThemedWindow.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <l:TrConverter x:Key="Tr"/>
        <l:ProjectTypeNameConverter x:Key="TypeName"/>
    </controls:ThemedWindow.Resources>

    <StackPanel Margin="20">
        <!-- Project Name -->
        <TextBlock Text="{l:Tr 'Project name'}" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <TextBox x:Name="NameBox" Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}"
                 FontSize="14" Padding="8" Margin="0,0,0,14"/>

        <!-- Author -->
        <TextBlock Text="{l:Tr 'Author'}" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <TextBox Text="{Binding Author, UpdateSourceTrigger=PropertyChanged}"
                 FontSize="14" Padding="8" Margin="0,0,0,14"/>

        <!-- Output Path -->
        <TextBlock Text="{l:Tr 'Location'}" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="14"/>
            <Button Grid.Column="1" Content="{l:Tr 'Browse...'}" Click="Browse_Click"
                    Width="100" Margin="10,0,0,0" Padding="8"/>
        </Grid>
        <TextBlock Text="{l:TrFormat 'Project file: {0}  (code is generated into the folder of the same name)', Path=TargetFolderPreview}"
                   Foreground="{StaticResource BrushMuted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,0,14"/>

        <!-- Project Type -->
        <TextBlock Text="{l:Tr 'Project type'}" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <ComboBox ItemsSource="{Binding ProjectTypes}"
                  SelectedItem="{Binding SelectedProjectType}"
                  FontSize="14">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource TypeName}}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="{Binding ProjectTypeDescription}" Foreground="{StaticResource BrushMuted}" FontSize="12"
                   TextWrapping="Wrap" Margin="0,6,0,14"/>

        <TextBlock Text="{l:Tr 'Start from'}" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding Template}" FontSize="14">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource Tr}}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="{Binding TemplateDescription}" Foreground="{StaticResource BrushMuted}" FontSize="12"
                   TextWrapping="Wrap" Margin="0,6,0,14"/>
        <CheckBox Content="{l:Tr 'Store form submissions in SQLite (instead of a JSON file)'}"
                  IsChecked="{Binding UseSqlite}" Margin="0,0,0,8"
                  Visibility="{Binding IsNodeApi, Converter={StaticResource BoolToVis}}"/>

        <!-- Validation -->
        <TextBlock Text="{Binding ValidationError}" Foreground="{StaticResource BrushDanger}" TextWrapping="Wrap"
                   Margin="0,6,0,0"/>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{l:Tr 'Create'}" Width="100" IsDefault="True" IsEnabled="{Binding IsValid}"
                    Click="Create_Click" Margin="0,0,10,0" Padding="8"/>
            <Button Content="{l:Tr 'Cancel'}" Width="100" IsCancel="True" Padding="8"/>
        </StackPanel>
    </StackPanel>
</controls:ThemedWindow>
