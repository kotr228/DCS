{
  "blockTemplates": {
    "Button": {
      "defaultProperties": {
        "text": "Click Me",
        "url": "#",
        "variant": "primary",
        "size": "medium",
        "fullWidth": false,
        "disabled": false,
        "icon": "",
        "target": "_self"
      },
      "validation": {
        "required": [ "text", "url" ],
        "urlFields": [ "url" ]
      }
    },
    "Hero": {
      "defaultProperties": {
        "headline": "Welcome to Our Site",
        "subheadline": "Build amazing things together",
        "ctaText": "Get Started",
        "ctaUrl": "#",
        "backgroundImage": "",
        "overlay": true,
        "overlayOpacity": 0.5,
        "alignment": "center",
        "height": "medium"
      },
      "validation": {
        "required": [ "headline" ],
        "urlFields": [ "ctaUrl", "backgroundImage" ],
        "numericRange": {
          "overlayOpacity": [ 0, 1 ]
        }
      }
    },
    "Card": {
      "defaultProperties": {
        "title": "Card Title",
        "description": "Card description text goes here",
        "image": "",
        "imagePosition": "top",
        "linkText": "Learn More",
        "linkUrl": "#",
        "shadow": true,
        "bordered": false,
        "hoverable": true
      },
      "validation": {
        "required": [ "title" ],
        "urlFields": [ "image", "linkUrl" ]
      }
    },
    "Navbar": {
      "defaultProperties": {
        "logo": "",
        "brandName": "Brand",
        "position": "static",
        "transparent": false,
        "menuItems": [
          {
            "text": "Home",
            "url": "#"
          },
          {
            "text": "About",
            "url": "#about"
          },
          {
            "text": "Contact",
            "url": "#contact"
          }
        ],
        "showSearch": false,
        "ctaText": "",
        "ctaUrl": "#"
      },
      "validation": {
        "required": [ "brandName" ],
        "urlFields": [ "logo", "ctaUrl" ],
        "arrayFields": [ "menuItems" ]
      }
    },
    "ContactForm": {
      "defaultProperties": {
        "title": "Get in Touch",
        "subtitle": "We'd love to hear from you",
        "fields": [
          {
            "name": "name",
            "type": "text",
            "label": "Name",
            "required": true
          },
          {
            "name": "email",
            "type": "email",
            "label": "Email",
            "required": true
          },
          {
            "name": "message",
            "type": "textarea",
            "label": "Message",
            "required": true
          }
        ],
        "submitText": "Send Message",
        "submitUrl": "/api/contact",
        "successMessage": "Thank you! We'll get back to you soon.",
        "errorMessage": "Oops! Something went wrong. Please try again.",
        "showPhoneField": true,
        "showSubjectField": false,
        "layout": "vertical"
      },
      "validation": {
        "required": [ "title", "submitUrl" ],
        "urlFields": [ "submitUrl" ],
        "arrayFields": [ "fields" ]
      }
    },
    "Video": {
      "defaultProperties": {
        "videoUrl": "",
        "provider": "youtube",
        "autoplay": false,
        "controls": true,
        "loop": false,
        "muted": false,
        "aspectRatio": "16:9"
      },
      "validation": {
        "required": [ "videoUrl" ],
        "urlFields": [ "videoUrl" ]
      }
    },
    "Testimonial": {
      "defaultProperties": {
        "quote": "This product changed my life!",
        "author": "John Doe",
        "role": "CEO, Company",
        "avatar": "",
        "rating": 5,
        "showRating": true,
        "layout": "default"
      },
      "validation": {
        "required": [ "quote", "author" ],
        "urlFields": [ "avatar" ],
        "numericRange": {
          "rating": [ 0, 5 ]
        }
      }
    },
    "Pricing": {
      "defaultProperties": {
        "planName": "Pro Plan",
        "price": "29",
        "currency": "$",
        "period": "month",
        "features": [ "Feature 1", "Feature 2", "Feature 3" ],
        "ctaText": "Get Started",
        "ctaUrl": "#",
        "highlighted": false,
        "badge": ""
      },
      "validation": {
        "required": [ "planName", "price" ],
        "urlFields": [ "ctaUrl" ],
        "arrayFields": [ "features" ]
      }
    },
    "Accordion": {
      "defaultProperties": {
        "title": "Frequently Asked Questions",
        "items": [
          {
            "question": "What is this?",
            "answer": "This is an answer."
          },
          {
            "question": "How does it work?",
            "answer": "It works like this."
          }
        ],
        "allowMultiple": false,
        "defaultOpen": 0
      },
      "validation": {
        "arrayFields": [ "items" ]
      }
    },
    "Stats": {
      "defaultProperties": {
        "stats": [
          {
            "number": "1000+",
            "label": "Happy Clients"
          },
          {
            "number": "50+",
            "label": "Projects Completed"
          },
          {
            "number": "24/7",
            "label": "Support"
          }
        ],
        "layout": "horizontal",
        "animated": true
      },
      "validation": {
        "arrayFields": [ "stats" ]
      }
    },
    "SocialLinks": {
      "defaultProperties": {
        "links": [
          {
            "platform": "facebook",
            "url": "#"
          },
          {
            "platform": "twitter",
            "url": "#"
          },
          {
            "platform": "instagram",
            "url": "#"
          }
        ],
        "style": "icons",
        "size": "medium",
        "alignment": "center"
      },
      "validation": {
        "arrayFields": [ "links" ],
        "urlFields": [ "links.*.url" ]
      }
    },
    "Divider": {
      "defaultProperties": {
        "style": "solid",
        "thickness": 1,
        "color": "#DDDDDD",
        "spacing": "medium",
        "withIcon": false,
        "icon": "★"
      },
      "validation": {
        "numericRange": {
          "thickness": [ 1, 10 ]
        }
      }
    }
  }
}