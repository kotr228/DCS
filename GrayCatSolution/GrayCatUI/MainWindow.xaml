<Window x:Class="GrayCat.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GrayCat.UI"
        xmlns:controls="clr-namespace:GrayCat.UI.Controls"
        xmlns:viewmodels="clr-namespace:GrayCat.UI.ViewModels"
        mc:Ignorable="d"
        Title="GrayCat Studio" Height="720" Width="1280">

    <Window.Resources>
        <local:BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <local:BooleanToVisibilityConverter x:Key="InvertedBoolToVisConverter" Invert="True"/>
    </Window.Resources>

    <Window.DataContext>
        <viewmodels:MainViewModel/>
    </Window.DataContext>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New Project..." Click="NewProject_Click"/>
                <MenuItem Header="_Open Project..." Click="OpenProject_Click"/>
                <MenuItem Header="_Save Project" Click="SaveProject_Click" IsEnabled="{Binding IsProjectOpen}"/>
                <Separator/>
                <MenuItem Header="_Exit" Click="Exit_Click"/>
            </MenuItem>
        </Menu>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Block Selector Panel -->
            <Border Grid.Column="0" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
                <StackPanel Margin="10">
                    <TextBlock Text="Blocks" FontWeight="Bold" Margin="0,0,0,10"/>
                    <Button Content="Header" Tag="Header" MouseMove="Block_MouseMove" Margin="0,0,0,5"/>
                    <Button Content="Text" Tag="Text" MouseMove="Block_MouseMove" Margin="0,0,0,5"/>
                    <Button Content="Image" Tag="Image" MouseMove="Block_MouseMove" Margin="0,0,0,5"/>
                </StackPanel>
            </Border>

            <!-- Main Canvas Area -->
            <Grid Grid.Column="1">
                <!-- Welcome Message (Visible when no project is open) -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsProjectOpen, Converter={StaticResource InvertedBoolToVisConverter}}">
                    <TextBlock FontSize="24" Text="Welcome to GrayCat!" Foreground="#333"/>
                    <TextBlock Text="Create or open a project to start." Foreground="#666"/>
                </StackPanel>

                <!-- Canvas (Visible when a project is open) -->
                <Grid Visibility="{Binding IsProjectOpen, Converter={StaticResource BoolToVisConverter}}">
                    <ItemsControl ItemsSource="{Binding Blocks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas x:Name="BlocksContainer" Background="Transparent" 
                                        AllowDrop="True" Drop="Canvas_Drop"
                                        MouseLeftButtonUp="BlocksContainer_MouseLeftButtonUp"
                                        MouseLeftButtonDown="BlocksContainer_MouseLeftButtonDown"
                                        MouseMove="BlocksContainer_MouseMove"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding PositionX}" />
                                <Setter Property="Canvas.Top" Value="{Binding PositionY}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:DraggableBlock>
                                    <controls:DraggableBlock.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Delete" Click="DeleteBlock_Click"/>
                                        </ContextMenu>
                                    </controls:DraggableBlock.ContextMenu>
                                </controls:DraggableBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>