<Window x:Class="GrayCat.UI.Windows.NewProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create New Project" Height="350" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Label Content="Project Name:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox x:Name="ProjectNameTextBox" Grid.Row="0" Grid.Column="1" Margin="5"/>

        <Label Content="Location:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox x:Name="LocationTextBox" Grid.Row="1" Grid.Column="1" Margin="5" IsReadOnly="True"/>
        <Button Content="Browse..." Grid.Row="1" Grid.Column="2" Margin="5" Padding="10,2" Click="BrowseButton_Click"/>

        <Label Content="Author:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox x:Name="AuthorTextBox" Grid.Row="2" Grid.Column="1" Margin="5" Text="Default User"/>

        <Label Content="Project Type:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
        <ComboBox x:Name="ProjectTypeComboBox" Grid.Row="3" Grid.Column="1" Margin="5"/>

        <ProgressBar x:Name="ProgressBar" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Height="10" Margin="0,15,0,0" IsIndeterminate="True" Visibility="Hidden"/>

        <StackPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Create" Width="80" IsDefault="True" Click="CreateButton_Click"/>
            <Button Content="Cancel" Width="80" Margin="10,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>